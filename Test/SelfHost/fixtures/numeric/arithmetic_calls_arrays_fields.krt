float64 sum(float64 a,float32 b,int32 n) { return a+b+n; }
class Box { public float32 f; public float64 d; }
int32 main() {
 float64 a=1.25; float32 b=2.5f;
 if(a+b!=3.75) {return 1;}
 if(sum(a,b,4)!=7.75) {return 2;}
 float32[] v=new float32[2]; v[0]=1.5; v[1]=2;
 if(v[0]+v[1]!=3.5) {return 3;}
 Box box=new Box(); box.f=-1.5; box.d=9.25;
 if(box.f+box.d!=7.75) {return 4;}
 a+=2; a*=2; a/=2; a-=2;
 if(a!=1.25) {return 5;}
 float64 old=a++; if(old!=1.25 || a!=2.25) {return 6;}
 a--; if(a!=1.25) {return 7;}
 if((int32)sum(a,b,4)!=7) {return 8;}
 delete v; delete box; return 0;
}
