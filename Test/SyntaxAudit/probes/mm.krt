public static extern int64 syscall(int64 n, int64 a1, int64 a2, int64 a3, int64 a4, int64 a5, int64 a6);
function P(string s, int32 l) { syscall(1,1,(int64)s,(int64)l,0,0,0); }
function main() {
    int32 r = 2 + 3 * 4;
    if (r == 14) { P("Y",1); } else { P("N",1); }
    int32 t = 1 < 2 ? 7 : 9;
    if (t == 7) { P("Y",1); } else { P("N",1); }
    int32 u = 2 > 3 ? 7 : (1 == 1 ? 5 : 6);
    if (u == 5) { P("Y",1); } else { P("N",1); }
    if ((1 == 2) || (2 == 2)) { P("Y",1); } else { P("N",1); }
    if ((1 == 1) || (2 == 3)) { P("Y",1); } else { P("N",1); }
    if ((1 == 2) || (2 == 3)) { P("Y",1); } else { P("N",1); }
}
