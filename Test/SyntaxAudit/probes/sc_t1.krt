public static extern int64 syscall(int64 n, int64 a1, int64 a2, int64 a3, int64 a4, int64 a5, int64 a6);
function P(string s, int32 len) { syscall(1, 1, (int64)s, (int64)len, 0, 0, 0); }
static class G { public static int32 count; }
function bump()
{
    G.count = G.count + 1;
    return true;
}
function main()
{
    bump();
    if (G.count == 1) P("A", 1);
    bool r = true && true;
    if (r) P("B", 1);
    r = false || true;
    if (r) P("C", 1);
    r = true && false;
    if (!r) P("D", 1);
}
