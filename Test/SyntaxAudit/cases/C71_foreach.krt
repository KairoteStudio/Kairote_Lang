public static extern int64 syscall(int64 n, int64 a1, int64 a2, int64 a3, int64 a4, int64 a5, int64 a6);
function P(string s, int32 len) { syscall(1, 1, (int64)s, (int64)len, 0, 0, 0); }
function D(int32 d) { if (d < 0) { P("N", 1); } else if (d == 0) { P("0", 1); } else if (d == 1) { P("1", 1); } else if (d == 2) { P("2", 1); } else if (d == 3) { P("3", 1); } else if (d == 4) { P("4", 1); } else if (d == 9) { P("9", 1); } else { P("+", 1); } }
function main() {
    /* 数组带长度头, 裸 mmap 指针强转 T[] 属未定义行为(同 C#), 改正规分配 */
    int32[] arr = new int32[3];
    arr[0] = 1; arr[1] = 2; arr[2] = 3;
    foreach (int32 x in arr) {
        D(x);
    }
}
