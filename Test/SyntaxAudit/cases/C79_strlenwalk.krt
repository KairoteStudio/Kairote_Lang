public static extern int64 syscall(int64 n, int64 a1, int64 a2, int64 a3, int64 a4, int64 a5, int64 a6);
function P(string s, int32 len) { syscall(1, 1, (int64)s, (int64)len, 0, 0, 0); }
function StrLen(string s) {
    char[] cs = (char[])s;
    int32 n = 0;
    while (cs[n] != '\0') {
        n = n + 1;
    }
    return n;
}
function main() {
    int32 n = StrLen("abcd");
    P("n=", 2);
    if (n == 4) { P("4", 1); } else if (n == 1) { P("1", 1); } else if (n == 2) { P("2", 1); } else if (n == 3) { P("3", 1); } else { P("?", 1); }
}
