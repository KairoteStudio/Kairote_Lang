public static extern int64 syscall(int64 n, int64 a1, int64 a2, int64 a3, int64 a4, int64 a5, int64 a6);
function P(string s, int32 len) { syscall(1, 1, (int64)s, (int64)len, 0, 0, 0); }
function main() {
    int8 a = 100;
    int16 b = 30000;
    int32 c = 2000000000;
    int64 d = 5000000000;
    bool ok = false;
    if (a == 100) { ok = true; }
    if (b == 30000 && ok) { ok = true; } else { ok = false; }
    if (c == 2000000000 && ok) { ok = true; } else { ok = false; }
    if (ok) { P("Y", 1); } else { P("N", 1); }
}
