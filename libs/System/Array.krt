using System.Memory;

/**
 * Operations on compiler-allocated arrays of standard integers, bool, float32 and float64.
 * Raw Memory.Allocate buffers have no array header and cannot be passed here.
 */
public static class ArrayOps {
    private static int32 get_length(void* data, int32 element_size) {
        unsafe(using krt.mem;) {
            if (data == null) {
                return 0;
            }
            // The compiler stores allocation bytes at data - 8; its heap header is 16 bytes.
            int64* header = (int64*)data;
            int64 total_size = header[-1];
            if (total_size < 16) {
                return -1;
            }
            int64 byte_length = total_size - 16;
            if (byte_length % (int64)element_size != 0) {
                return -1;
            }
            int64 count = byte_length / (int64)element_size;
            if (count > 2147483647) {
                return -1;
            }
            return (int32)count;
        }
    }

    private static bool valid_range(int32 length, int32 start, int32 count) {
        if (length < 0 || start < 0 || count < 0 || start > length) {
            return false;
        }
        return count <= length - start;
    }

    private static bool copy_range(void* source, int32 source_index, void* destination,
                                   int32 destination_index, int32 count, int32 element_size) {
        unsafe(using krt.mem;) {
            int32 source_length = get_length(source, element_size);
            int32 destination_length = get_length(destination, element_size);
            if (!valid_range(source_length, source_index, count) ||
                !valid_range(destination_length, destination_index, count)) {
                return false;
            }
            if (count == 0) {
                return true;
            }
            byte* first = (byte*)source + (int64)source_index * (int64)element_size;
            byte* target = (byte*)destination + (int64)destination_index * (int64)element_size;
            return Memory.TryMove(target, first, (int64)count * (int64)element_size);
        }
    }

    private static bool clear_range(void* data, int32 start, int32 count, int32 element_size) {
        unsafe(using krt.mem;) {
            if (!valid_range(get_length(data, element_size), start, count)) {
                return false;
            }
            if (count == 0) {
                return true;
            }
            byte* target = (byte*)data + (int64)start * (int64)element_size;
            return Memory.TryClear(target, (int64)count * (int64)element_size);
        }
    }

    /** Return element count, zero for null, or -1 for an invalid/oversized array header. */
    public static int32 Length(byte[] values) {
        unsafe(using krt.mem;) {
            return get_length((void*)values, 1);
        }
    }

    /** Copy all source elements with overlap support; false leaves destination unchanged. */
    public static bool Copy(byte[] source, byte[] destination) {
        return ArrayOps.Copy(source, 0, destination, 0, ArrayOps.Length(source));
    }

    /** Copy count elements from index zero, reporting invalid ranges without partial writes. */
    public static bool Copy(byte[] source, byte[] destination, int32 count) {
        return ArrayOps.Copy(source, 0, destination, 0, count);
    }

    /** Copy a checked range with overlap support; zero count is permitted at either array end. */
    public static bool Copy(byte[] source, int32 source_index, byte[] destination,
                            int32 destination_index, int32 count) {
        unsafe(using krt.mem;) {
            return copy_range((void*)source, source_index, (void*)destination, destination_index, count, 1);
        }
    }

    /** Clear every element, reporting whether the array header is valid. */
    public static bool Clear(byte[] values) {
        return ArrayOps.Clear(values, 0, ArrayOps.Length(values));
    }

    /** Clear a checked range; invalid ranges leave all elements unchanged. */
    public static bool Clear(byte[] values, int32 start, int32 count) {
        unsafe(using krt.mem;) {
            return clear_range((void*)values, start, count, 1);
        }
    }

    /** Fill every element with value, reporting whether the array header is valid. */
    public static bool Fill(byte[] values, byte value) {
        return ArrayOps.Fill(values, value, 0, ArrayOps.Length(values));
    }

    /** Fill a checked range; invalid ranges leave all elements unchanged. */
    public static bool Fill(byte[] values, byte value, int32 start, int32 count) {
        if (!valid_range(ArrayOps.Length(values), start, count)) {
            return false;
        }
        int32 index = start;
        int32 end = start + count;
        while (index < end) {
            values[index] = value;
            index = index + 1;
        }
        return true;
    }

    /** Reverse every element in place. */
    public static bool Reverse(byte[] values) {
        return ArrayOps.Reverse(values, 0, ArrayOps.Length(values));
    }

    /** Reverse a checked range; invalid ranges leave all elements unchanged. */
    public static bool Reverse(byte[] values, int32 start, int32 count) {
        if (!valid_range(ArrayOps.Length(values), start, count)) {
            return false;
        }
        int32 left = start;
        int32 right = start + count - 1;
        while (left < right) {
            byte temporary = values[left];
            values[left] = values[right];
            values[right] = temporary;
            left = left + 1;
            right = right - 1;
        }
        return true;
    }

    /** Find the first element equal under ==, or return -1 when absent. */
    public static int32 IndexOf(byte[] values, byte value) {
        return ArrayOps.IndexOf(values, value, 0, ArrayOps.Length(values));
    }

    /** Search a checked range: -1 means absent and -2 means invalid arguments. */
    public static int32 IndexOf(byte[] values, byte value, int32 start, int32 count) {
        if (!valid_range(ArrayOps.Length(values), start, count)) {
            return -2;
        }
        int32 index = start;
        int32 end = start + count;
        while (index < end) {
            if (values[index] == value) {
                return index;
            }
            index = index + 1;
        }
        return -1;
    }

    /** Return whether an element compares equal to value. */
    public static bool Contains(byte[] values, byte value) {
        return ArrayOps.IndexOf(values, value) >= 0;
    }

    /** Return element count, zero for null, or -1 for an invalid/oversized array header. */
    public static int32 Length(int8[] values) {
