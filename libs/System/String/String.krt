using System.Runtime;

namespace System;

public static class StringOps
{
    public static int32 Length(string value)
    {
        return (int32)Sys.InternalStringLength(value);
    }

    public static string Concat(string left, string right)
    {
        if (left == null)
        {
            left = "";
        }
        if (right == null)
        {
            right = "";
        }

        int32 leftLength = Length(left);
        int32 rightLength = Length(right);
        int32 totalLength = leftLength + rightLength;

        Point
        {
            void* allocation = KrtMalloc(totalLength + 1);
            if (allocation == null)
            {
                return null;
            }

            char[] output = (char[])allocation;
            char[] leftChars = (char[])left;
            char[] rightChars = (char[])right;

            int32 index = 0;
            while (index < leftLength)
            {
                output[index] = leftChars[index];
                index = index + 1;
            }

            index = 0;
            while (index < rightLength)
            {
                output[leftLength + index] = rightChars[index];
                index = index + 1;
            }

            output[totalLength] = '\0';
            return (string)allocation;
        }
    }

    public static string FromInt32(int32 value)
    {
        return Sys.InternalInt32ToString(value);
    }

    public static string FromInt64(int64 value)
    {
        if (value == 0)
        {
            return "0";
        }

        bool negative = value < 0;
        int64 remaining = value;
        int32 digits = 0;
        while (remaining != 0)
        {
            digits = digits + 1;
            remaining = remaining / 10;
        }

        int32 totalLength = digits;
        if (negative)
        {
            totalLength = totalLength + 1;
        }

        Point
        {
            void* allocation = KrtMalloc(totalLength + 1);
            if (allocation == null)
            {
                return null;
            }

            char[] output = (char[])allocation;
            int32 position = totalLength - 1;
            remaining = value;
            while (remaining != 0)
            {
                int32 digit = (int32)(remaining % 10);
                if (digit < 0)
                {
                    digit = 0 - digit;
                }
                output[position] = (char)(48 + digit);
                position = position - 1;
                remaining = remaining / 10;
            }

            if (negative)
            {
                output[0] = '-';
            }
            output[totalLength] = '\0';
            return (string)allocation;
        }
    }

    public static int32 Compare(string left, string right)
    {
        if (left == right)
        {
            return 0;
        }
        if (left == null)
        {
            return -1;
        }
        if (right == null)
        {
            return 1;
        }

        int32 leftLength = Length(left);
        int32 rightLength = Length(right);
        int32 commonLength = leftLength;
        if (rightLength < commonLength)
        {
            commonLength = rightLength;
        }

        Point
        {
            char[] leftChars = (char[])left;
            char[] rightChars = (char[])right;
            int32 index = 0;
            while (index < commonLength)
            {
                if (leftChars[index] != rightChars[index])
                {
                    return (int32)leftChars[index] - (int32)rightChars[index];
                }
                index = index + 1;
            }
        }

        return leftLength - rightLength;
    }

    public static bool Equals(string left, string right)
    {
        return Compare(left, right) == 0;
    }

    public static int32 IndexOf(string value, char target)
    {
        if (value == null)
        {
            return -1;
        }

        int32 length = Length(value);
        Point
        {
            char[] chars = (char[])value;
            int32 index = 0;
            while (index < length)
            {
                if (chars[index] == target)
                {
                    return index;
                }
                index = index + 1;
            }
        }
        return -1;
    }

    public static int32 LastIndexOf(string value, char target)
    {
        if (value == null)
        {
            return -1;
        }

        int32 length = Length(value);
        Point
        {
            char[] chars = (char[])value;
            int32 index = length - 1;
            while (index >= 0)
            {
                if (chars[index] == target)
                {
                    return index;
                }
                index = index - 1;
            }
        }
        return -1;
    }

    public static string Substring(string value, int32 start)
    {
        if (value == null)
        {
            return null;
        }

        int32 length = Length(value);
        if (start < 0)
        {
            start = 0;
        }
        if (start >= length)
        {
            return "";
        }
        return Substring(value, start, length - start);
    }

    public static string Substring(string value, int32 start, int32 length)
    {
        if (value == null)
        {
            return null;
        }

        int32 sourceLength = Length(value);
        if (start < 0)
        {
            start = 0;
        }
        if (start >= sourceLength)
        {
            return "";
        }
        if (length <= 0)
        {
            return "";
        }
        if (start + length > sourceLength)
        {
            length = sourceLength - start;
        }

        Point
        {
            void* allocation = KrtMalloc(length + 1);
            if (allocation == null)
            {
                return null;
            }

            char[] source = (char[])value;
            char[] output = (char[])allocation;
            int32 index = 0;
            while (index < length)
            {
                output[index] = source[start + index];
                index = index + 1;
            }
            output[length] = '\0';
            return (string)allocation;
        }
    }

    public static bool StartsWith(string value, string prefix)
    {
        if (value == null)
        {
            return false;
        }
        if (prefix == null)
        {
            return false;
        }

        int32 valueLength = Length(value);
        int32 prefixLength = Length(prefix);
        if (prefixLength > valueLength)
        {
            return false;
        }

        Point
        {
            char[] valueChars = (char[])value;
            char[] prefixChars = (char[])prefix;
            int32 index = 0;
            while (index < prefixLength)
            {
                if (valueChars[index] != prefixChars[index])
                {
                    return false;
                }
                index = index + 1;
            }
        }
        return true;
    }

    public static bool EndsWith(string value, string suffix)
    {
        if (value == null)
        {
            return false;
        }
        if (suffix == null)
        {
            return false;
        }

        int32 valueLength = Length(value);
        int32 suffixLength = Length(suffix);
        if (suffixLength > valueLength)
        {
            return false;
        }

        int32 offset = valueLength - suffixLength;
        Point
        {
            char[] valueChars = (char[])value;
            char[] suffixChars = (char[])suffix;
            int32 index = 0;
            while (index < suffixLength)
            {
                if (valueChars[offset + index] != suffixChars[index])
                {
                    return false;
                }
                index = index + 1;
            }
        }
        return true;
    }
}
