/** Linux x86-64 runtime primitives. Strings are zero-terminated byte sequences. */
public static class Sys {
    public const int64 SYS_read = 0;
    public const int64 SYS_write = 1;
    public const int64 SYS_open = 2;
    public const int64 SYS_close = 3;
    public const int64 SYS_mmap = 9;
    public const int64 SYS_munmap = 11;
    public const int64 SYS_brk = 12;
    public const int64 SYS_exit = 60;

    /** Forward six integer arguments to the native syscall instruction. */
    public static int64 Syscall(int64 number, int64 arg1, int64 arg2, int64 arg3,
                               int64 arg4, int64 arg5, int64 arg6) {
        return syscall(number, arg1, arg2, arg3, arg4, arg5, arg6);
    }

    /** Borrow the string's data address; no storage is allocated. */
    public static int64 InternalStringPtr(string value) {
        return (int64)value;
    }

    /** Return the byte length without the terminator; null has length zero. */
    public static int64 InternalStringLength(string value) {
        if (value == null) {
            return 0;
        }
        unsafe(using krt.mem;) {
            byte* data = (byte*)(int64)value;
            int64 length = 0;
            while (data[length] != 0) {
                length++;
            }
            return length;
        }
    }

    /** Return an owned allocation base, or null; free with byte length plus one. */
    public static string InternalInt32ToString(int32 value) {
        int64 number = (int64)value;
        bool negative = number < 0;
        if (negative) {
            number = -number;
        }
        int64 remaining = number;
        int32 digits = 1;
        while (remaining >= 10) {
            digits++;
            remaining /= 10;
        }
        int32 length = digits + (negative ? 1 : 0);
        int64 buffer = syscall(SYS_mmap, 0, (int64)length + 1, 3, 0x22, -1, 0);
        if (buffer <= 0) {
            return null;
        }
        unsafe(using krt.mem;) {
            byte* data = (byte*)buffer;
            data[length] = 0;
            int32 position = length;
            do {
                position--;
                data[position] = (byte)(48 + number % 10);
                number /= 10;
            } while (number != 0);
            if (negative) {
                data[0] = (byte)45;
            }
            return (string)buffer;
        }
    }

    /** Terminate the process with the platform's low-byte exit status. */
    public static void Exit(int32 code) {
        syscall(SYS_exit, (int64)code, 0, 0, 0, 0, 0);
    }
}
