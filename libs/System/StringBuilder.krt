using System.Memory;
using System.Sys;
using System.String;

namespace System.Runtime;

/**
 * Explicit byte-buffer builder. Capacity excludes the extra zero terminator byte.
 * Callers own buffers and lengths; invalid arguments or insufficient capacity return -1.
 * Clear returns a new logical length only; the next mutation writes the terminator.
 */
public static class StringBuilder {
    private static bool valid_buffer(int64 buffer, int32 buffer_size, int32 current_length) {
        return buffer > 0 && buffer_size >= 0 && current_length >= 0 && current_length <= buffer_size;
    }

    /** Allocates capacity + 1 zero-initialized bytes; returns zero for invalid capacity or allocation failure. */
    public static int64 AllocateBuffer(int32 capacity) {
        unsafe(using krt.mem;) {
            if (capacity < 0) {
                return 0;
            }
            byte* buffer = (byte*)Memory.Allocate((int64)capacity + 1);
            if (buffer == null) {
                return 0;
            }
            buffer[0] = 0;
            return (int64)buffer;
        }
    }

    /** Releases a buffer with the same capacity passed to AllocateBuffer; null is ignored. */
    public static void FreeBuffer(int64 buffer, int32 capacity) {
        unsafe(using krt.mem;) {
            if (buffer > 0 && capacity >= 0) {
                Memory.Free((void*)buffer, (int64)capacity + 1);
            }
        }
    }

    /** Appends bytes and a terminator; null is empty, overlap is allowed, failure leaves bytes unchanged. */
    public static int32 AppendString(int64 buffer, int32 buffer_size, int32 current_length, string value) {
        unsafe(using krt.mem;) {
            if (!valid_buffer(buffer, buffer_size, current_length)) {
                return -1;
            }
            int32 value_length = StringOps.Length(value);
            if (value_length < 0 || value_length > buffer_size - current_length) {
                return -1;
            }
            byte* data = (byte*)buffer;
            Memory.Move((void*)(data + current_length), (void*)Sys.InternalStringPtr(value), value_length);
            int32 length = current_length + value_length;
            data[length] = 0;
            return length;
        }
    }

    /** Appends one byte and a terminator; embedded zero bytes are counted in the explicit length. */
    public static int32 AppendChar(int64 buffer, int32 buffer_size, int32 current_length, char value) {
        unsafe(using krt.mem;) {
            if (!valid_buffer(buffer, buffer_size, current_length) || current_length == buffer_size) {
                return -1;
            }
            byte* data = (byte*)buffer;
            data[current_length] = (byte)value;
            data[current_length + 1] = 0;
            return current_length + 1;
        }
    }

    private static int32 append_owned(int64 buffer, int32 buffer_size, int32 current_length, string value) {
        unsafe(using krt.mem;) {
            if (value == null) {
                return -1;
            }
            int32 length = AppendString(buffer, buffer_size, current_length, value);
            Memory.Free((void*)Sys.InternalStringPtr(value), (int64)StringOps.Length(value) + 1);
            return length;
        }
    }

    /** Appends the full signed int32 decimal range without retaining a temporary allocation. */
    public static int32 AppendInt32(int64 buffer, int32 buffer_size, int32 current_length, int32 value) {
        return AppendInt64(buffer, buffer_size, current_length, (int64)value);
    }

    /** Appends the full signed int64 decimal range; allocation failure leaves the buffer unchanged. */
    public static int32 AppendInt64(int64 buffer, int32 buffer_size, int32 current_length, int64 value) {
        if (!valid_buffer(buffer, buffer_size, current_length)) {
            return -1;
        }
        return append_owned(buffer, buffer_size, current_length, StringOps.FromInt64(value));
    }

    /** Appends the full unsigned uint64 decimal range; allocation failure leaves the buffer unchanged. */
    public static int32 AppendUInt64(int64 buffer, int32 buffer_size, int32 current_length, uint64 value) {
        if (!valid_buffer(buffer, buffer_size, current_length)) {
            return -1;
        }
        return append_owned(buffer, buffer_size, current_length, StringOps.FromUInt64(value));
    }

    /** Appends True or False. */
    public static int32 AppendBool(int64 buffer, int32 buffer_size, int32 current_length, bool value) {
        if (value) {
            return AppendString(buffer, buffer_size, current_length, "True");
        }
        return AppendString(buffer, buffer_size, current_length, "False");
    }

    /** Appends a string and newline atomically with respect to capacity validation. */
    public static int32 AppendLine(int64 buffer, int32 buffer_size, int32 current_length, string value) {
        if (!valid_buffer(buffer, buffer_size, current_length) || current_length == buffer_size) {
            return -1;
        }
        int32 value_length = StringOps.Length(value);
        if (value_length < 0 || value_length > buffer_size - current_length - 1) {
            return -1;
        }
        int32 length = AppendString(buffer, buffer_size, current_length, value);
        if (length < 0) {
            return -1;
        }
        return AppendChar(buffer, buffer_size, length, '\n');
    }

    /** Appends one newline. */
    public static int32 AppendLine(int64 buffer, int32 buffer_size, int32 current_length) {
        return AppendChar(buffer, buffer_size, current_length, '\n');
    }

    /** Inserts at a clamped index, preserving overlapping source bytes before moving the suffix. */
    public static int32 Insert(int64 buffer, int32 buffer_size, int32 current_length, int32 index, string value) {
        unsafe(using krt.mem;) {
            if (!valid_buffer(buffer, buffer_size, current_length)) {
                return -1;
            }
            int32 value_length = StringOps.Length(value);
            if (value_length < 0 || value_length > buffer_size - current_length) {
                return -1;
            }
            if (index < 0) {
                index = 0;
            }
            if (index > current_length) {
                index = current_length;
            }
            byte* data = (byte*)buffer;
            byte* source = (byte*)Sys.InternalStringPtr(value);
            byte* snapshot = (byte*)0;
            int64 source_address = (int64)source;
            if (value_length > 0 && source_address < buffer + (int64)current_length &&
                buffer < source_address + (int64)value_length) {
                snapshot = (byte*)Memory.Allocate((int64)value_length);
                if (snapshot == null) {
                    return -1;
                }
                Memory.Copy((void*)snapshot, (void*)source, value_length);
                source = snapshot;
            }
            Memory.Move((void*)(data + index + value_length), (void*)(data + index), current_length - index);
            Memory.Copy((void*)(data + index), (void*)source, value_length);
            int32 length = current_length + value_length;
            data[length] = 0;
            if (snapshot != null) {
                Memory.Free((void*)snapshot, (int64)value_length);
            }
            return length;
        }
    }

    /** Removes a clamped byte range; an out-of-range index or nonpositive count is a no-op. */
    public static int32 Remove(int64 buffer, int32 current_length, int32 index, int32 length) {
        unsafe(using krt.mem;) {
            if (buffer <= 0 || current_length < 0) {
                return -1;
            }
            if (index < 0 || index >= current_length || length <= 0) {
                return current_length;
            }
            if (length > current_length - index) {
                length = current_length - index;
            }
            byte* data = (byte*)buffer;
            int32 tail_start = index + length;
            Memory.Move((void*)(data + index), (void*)(data + tail_start), current_length - tail_start);
            int32 result = current_length - length;
            data[result] = 0;
            return result;
        }
    }

    /** Returns zero as the new logical length; this legacy overload does not access the buffer. */
    public static int32 Clear(int32 current_length) {
        return 0;
    }

    /** Allocates an independent terminated copy, including empty; free with the supplied length + 1. */
    public static string BufferToString(int64 buffer, int32 length) {
        unsafe(using krt.mem;) {
            if (length < 0 || (buffer <= 0 && length != 0)) {
                return null;
            }
            byte* result = (byte*)Memory.Allocate((int64)length + 1);
            if (result == null) {
                return null;
            }
            Memory.Copy((void*)result, (void*)buffer, length);
            result[length] = 0;
            return (string)(int64)result;
        }
    }

    /** Finds the first matching byte within the explicit length, including embedded zero bytes. */
    public static int32 IndexOf(int64 buffer, int32 length, char character) {
        unsafe(using krt.mem;) {
            if (buffer <= 0 || length < 0) {
                return -1;
            }
            byte* data = (byte*)buffer;
            int32 index = 0;
            while (index < length) {
                if ((int32)data[index] == (int32)character) {
                    return index;
                }
                index = index + 1;
            }
            return -1;
        }
    }

    /** Finds the last matching byte within the explicit length. */
    public static int32 LastIndexOf(int64 buffer, int32 length, char character) {
        unsafe(using krt.mem;) {
            if (buffer <= 0 || length <= 0) {
                return -1;
            }
            byte* data = (byte*)buffer;
            int32 index = length - 1;
            while (index >= 0) {
                if ((int32)data[index] == (int32)character) {
                    return index;
                }
                index = index - 1;
            }
            return -1;
        }
    }

    /** Replaces matching bytes in place and returns the count, or -1 for invalid buffer/length. */
    public static int32 Replace(int64 buffer, int32 length, char old_character, char new_character) {
        unsafe(using krt.mem;) {
            if (buffer <= 0 || length < 0) {
                return -1;
            }
            byte* data = (byte*)buffer;
            int32 count = 0;
            int32 index = 0;
            while (index < length) {
                if ((int32)data[index] == (int32)old_character) {
                    data[index] = (byte)new_character;
                    count = count + 1;
                }
                index = index + 1;
            }
            data[length] = 0;
            return count;
        }
    }
}
