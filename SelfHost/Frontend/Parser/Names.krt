// Namespace scopes retain source spans and imports; no source text is rewritten.
void KrtParserMarkScope(KrtAstNode node, KrtAstNode scope) {
    if (node == null) { return; }
    node.native_scope = scope;
    KrtParserMarkScope(node.syntax_type,scope);KrtParserMarkScope(node.syntax_parameter_types,scope);
    KrtParserMarkScope(node.syntax_array_size,scope);KrtParserMarkScope(node.syntax_permissions,scope);
    KrtParserMarkScope(node.native_constraints,scope);
    KrtParserMarkScope(node.native_base_call, scope);
    KrtParserMarkScope(node.left, scope); KrtParserMarkScope(node.right, scope);
    KrtParserMarkScope(node.alternate, scope); KrtParserMarkScope(node.body, scope);
    KrtParserMarkScope(node.declarations, scope); KrtParserMarkScope(node.next, scope);
}

KrtAstNode KrtParserNamePath(KrtParser parser) {
    if (parser.token.category != KrtTokenCategory.Identifier) { KrtParserRecordError(parser); return null; }
    int64 start = parser.token.start; int64 end = start + parser.token.length; bool wildcard=false; int64 full_end=end;
    KrtLexerNext(parser.lexer, parser.token);
    while (KrtParserTokenText(parser, 46)) {
        KrtLexerNext(parser.lexer, parser.token);
        if (KrtParserTokenText(parser, 42)) { wildcard=true;full_end=parser.token.start+parser.token.length;KrtLexerNext(parser.lexer, parser.token);break; }
        if (parser.token.category != KrtTokenCategory.Identifier) { KrtParserRecordError(parser); return null; }
        end = parser.token.start + parser.token.length; KrtLexerNext(parser.lexer, parser.token);
    }
    KrtAstNode name = KrtAstMake(KrtAstKind.Type, start, end - start);
    name.name_start = start; name.name_length = end - start;name.syntax_wildcard=wildcard;if(wildcard){name.length=full_end-start;}return name;
}

void KrtParserAppendDeclaration(KrtAstNode unit, KrtAstNode declaration) {
    if (declaration == null) { return; }
    if (declaration.kind == KrtAstKind.TypeDeclaration) {
        if (unit.declarations == null) { unit.declarations = declaration; }
        else { KrtAstNode tail = unit.declarations; while (tail.next != null) { tail = tail.next; } tail.next = declaration; }
    } else if (declaration.kind == KrtAstKind.Function) {
        if (unit.left == null) { unit.left = declaration; }
        else { KrtAstNode tail = unit.left; while (tail.next != null) { tail = tail.next; } tail.next = declaration; }
        unit.child_count = unit.child_count + 1;
    } else {
        if (unit.body == null) { unit.body = declaration; }
        else { KrtAstNode tail = unit.body; while (tail.next != null) { tail = tail.next; } tail.next = declaration; }
    }
}

bool KrtParserParseDeclarations(KrtParser parser, KrtAstNode unit, bool nested) {
    int32 declaration_count = 0;
    while (parser.token.kind != KrtTokenKind.Eof && declaration_count < 16384) {
        int64 start = parser.token.start; int32 previous_errors = parser.errors;
        if (KrtParserTokenText(parser, 125)) {
            if (nested) { KrtLexerNext(parser.lexer, parser.token); return true; }
            KrtParserRecordExpected(parser, KrtTokenKind.Identifier, "unexpected closing brace");
            KrtLexerNext(parser.lexer, parser.token); continue;
        }
        if (KrtParserIsWord(parser, "namespace")) {
            KrtLexerNext(parser.lexer, parser.token);
            if (KrtParserTokenText(parser, 59)) {
                parser.native_scope = KrtAstMake(KrtAstKind.Program, 0, 0);
                parser.current_using_scope = KrtParserUsingScope(null, parser.native_scope, parser.token.start);
                parser.syntax_scope=unit;KrtAstNode boundary=KrtAstMake(KrtAstKind.NamespaceDeclaration,start,parser.token.start-start);boundary.value=1;KrtParserAppendSyntax(parser,boundary);
                KrtLexerNext(parser.lexer, parser.token); continue;
            }
            KrtAstNode path = KrtParserNamePath(parser);
            if (path == null) { KrtParserSynchronize(parser, start, true); continue; }
            KrtAstNode previous = parser.native_scope;
            KrtUsingScope previous_using = parser.current_using_scope;
            KrtAstNode previous_syntax=parser.syntax_scope;
            KrtAstNode namespace_node=KrtAstMake(KrtAstKind.NamespaceDeclaration,start,path.start+path.length-start);namespace_node.name_start=path.name_start;namespace_node.name_length=path.name_length;
            KrtAstNode namespace_syntax=KrtParserAppendSyntax(parser,namespace_node);parser.syntax_scope=namespace_syntax;
            path.left = previous; parser.native_scope = path;
            parser.current_using_scope = KrtParserUsingScope(previous_using, path, path.start);
            if (KrtParserTokenText(parser, 123)) {
                KrtLexerNext(parser.lexer, parser.token);
                KrtParserParseDeclarations(parser, unit, true);
                parser.native_scope = previous; parser.current_using_scope = previous_using;parser.syntax_scope=previous_syntax;
            } else if (KrtParserTokenText(parser, 59)) { KrtLexerNext(parser.lexer, parser.token); }
            else {
                KrtParserRecordExpected(parser, KrtTokenKind.LeftBrace, "expected namespace body or semicolon");
                parser.native_scope = previous; parser.current_using_scope = previous_using;parser.syntax_scope=previous_syntax;
                KrtParserSynchronize(parser, start, true);
            }
            continue;
        }
        if (KrtParserIsWord(parser, "using")) {
            KrtLexerNext(parser.lexer, parser.token);
            KrtAstNode imported = KrtParserNamePath(parser);
            if (imported != null && KrtParserTokenText(parser, 61)) {
                KrtLexerNext(parser.lexer, parser.token); KrtAstNode target = KrtParserNamePath(parser);
                if (target != null) { target.type_start = imported.name_start; target.type_length = imported.name_length; }
                imported = target;
            }
            if (imported == null || !KrtParserExpect(parser, KrtTokenKind.Semicolon)) {
                KrtParserSynchronize(parser, start, true); continue;
            }
            KrtAstNode using_node=KrtAstMake(KrtAstKind.UsingDirective,start,parser.token.start-start);using_node.left=imported;KrtParserAppendSyntax(parser,using_node);
            KrtAstNode typed_import = KrtAstMake(KrtAstKind.Type, imported.start, imported.length);
            typed_import.name_start = imported.name_start; typed_import.name_length = imported.name_length;
            typed_import.type_start = imported.type_start; typed_import.type_length = imported.type_length;typed_import.syntax_wildcard=imported.syntax_wildcard;
            typed_import.next = parser.current_using_scope.imports; parser.current_using_scope.imports = typed_import;
            continue;
        }
        KrtAstNode declaration = null;
        if (KrtParserIsWord(parser, "const")) { declaration = KrtParserParseGlobalConstant(parser); }
        else if (KrtParserTypeDeclarationAhead(parser)) { declaration = KrtParserParseTypeDeclaration(parser); }
        else {
            declaration = KrtParserParseGlobalVariable(parser);
            if (declaration == null) { declaration = KrtParserParseFunction(parser); }
        }
        if (declaration == null || declaration.kind == KrtAstKind.Invalid) {
            KrtParserRecordError(parser); KrtParserSynchronize(parser, start, true);
            declaration = KrtParserMalformed(declaration, start, parser.token.start);
        } else if (parser.errors != previous_errors) { KrtParserSynchronize(parser, start, true); }
        if (parser.token.start == start && parser.token.kind != KrtTokenKind.Eof) { KrtLexerNext(parser.lexer, parser.token); }
        KrtParserMarkScope(declaration, parser.native_scope);
        KrtParserMarkUsingScope(declaration, parser.current_using_scope);
        KrtParserAppendSyntax(parser,declaration);
        KrtParserAppendDeclaration(unit, declaration); declaration_count = declaration_count + 1;
    }
    if (nested) { KrtParserRecordExpected(parser, KrtTokenKind.RightBrace, "expected closing namespace brace"); return false; }
    return parser.errors == 0;
}

bool KrtNameSpace(byte value) { return value == 32 || value == 9 || value == 10 || value == 13; }

// Qualified names are lexer spans and may contain comments between their
// identifier and dot tokens. Compare their token text without rewriting the
// source, retaining the original spans for diagnostics.
int64 KrtNameSkipTrivia(int64 source, int64 start, int64 length, int64 index) {
    unsafe(using krt.mem;) {
        byte* text = (byte*)source;
        while (index < length) {
            if (KrtNameSpace(text[start + index])) { index = index + 1; }
            else if (index + 1 < length && text[start + index] == 47 && text[start + index + 1] == 47) {
                index = index + 2;
                while (index < length && text[start + index] != 10 && text[start + index] != 13) { index = index + 1; }
            } else if (index + 1 < length && text[start + index] == 47 && text[start + index + 1] == 42) {
                index = index + 2;
                while (index + 1 < length && !(text[start + index] == 42 && text[start + index + 1] == 47)) { index = index + 1; }
                if (index + 1 >= length) { return length; }
                index = index + 2;
            } else { return index; }
        }
    }
    return index;
}

int64 KrtNameLength(int64 source, int64 start, int64 length) {
    int64 count = 0; int64 i = 0;
    while (i < length) { i = KrtNameSkipTrivia(source, start, length, i); if (i < length) { count = count + 1; i = i + 1; } }
    return count;
}
int64 KrtNameAt(int64 source, int64 start, int64 length, int64 index) {
    unsafe(using krt.mem;) { byte* text = (byte*)source; int64 i = 0;
        while (i < length) { i = KrtNameSkipTrivia(source, start, length, i); if (i < length) { if (index == 0) { return text[start + i]; } index = index - 1; i = i + 1; } }
    }
    return -1;
}
int64 KrtScopeLength(KrtAstNode scope, int64 source) {
    if (scope == null || scope.name_length == 0) { return 0; }
    int64 length = KrtScopeLength(scope.left, source);
    if (length > 0) { length = length + 1; }
    return length + KrtNameLength(source, scope.name_start, scope.name_length);
}
int64 KrtScopeAt(KrtAstNode scope, int64 source, int64 index) {
    if (scope == null) { return -1; }
    int64 prefix = KrtScopeLength(scope.left, source);
    if (index < prefix) { return KrtScopeAt(scope.left, source, index); }
    if (prefix > 0) { if (index == prefix) { return 46; } prefix = prefix + 1; }
    return KrtNameAt(source, scope.name_start, scope.name_length, index - prefix);
}
bool KrtScopeEqual(KrtAstNode left, KrtAstNode right, int64 source) {
    if (left == right) { return true; }
    int64 length = KrtScopeLength(left, source);
    if (length != KrtScopeLength(right, source)) { return false; }
    int64 i = 0; while (i < length) { if (KrtScopeAt(left, source, i) != KrtScopeAt(right, source, i)) { return false; } i = i + 1; }
    return true;
}
int64 KrtDeclarationLength(KrtAstNode declaration, int64 source) {
    int64 prefix = KrtScopeLength(declaration.native_scope, source);
    return prefix + (prefix > 0 ? 1 : 0) + KrtNameLength(source, declaration.name_start, declaration.name_length);
}
int64 KrtDeclarationAt(KrtAstNode declaration, int64 source, int64 index) {
    int64 prefix = KrtScopeLength(declaration.native_scope, source);
    if (index < prefix) { return KrtScopeAt(declaration.native_scope, source, index); }
    if (prefix > 0) { if (index == prefix) { return 46; } prefix = prefix + 1; }
    return KrtNameAt(source, declaration.name_start, declaration.name_length, index - prefix);
}
bool KrtDeclarationMatches(KrtAstNode declaration, KrtAstNode prefix, int64 source, int64 start, int64 length) {
    int64 prefix_length = KrtScopeLength(prefix, source); int64 suffix = KrtNameLength(source, start, length);
    int64 total = prefix_length + (prefix_length > 0 ? 1 : 0) + suffix;
    if (total != KrtDeclarationLength(declaration, source)) { return false; }
    int64 i = 0;
    while (i < total) {
        int64 value = 0;
        if (i < prefix_length) { value = KrtScopeAt(prefix, source, i); }
        else if (prefix_length > 0 && i == prefix_length) { value = 46; }
        else { value = KrtNameAt(source, start, length, i - prefix_length - (prefix_length > 0 ? 1 : 0)); }
        if (value != KrtDeclarationAt(declaration, source, i)) { return false; }
        i = i + 1;
    }
    return true;
}

KrtAstNode KrtParserTypeParameters(KrtParser parser) {
    if (!KrtParserTokenText(parser, 60)) { return null; }
    KrtLexerNext(parser.lexer, parser.token);
    KrtAstNode first = null; KrtAstNode tail = null;
    while (parser.token.category == KrtTokenCategory.Identifier) {
        KrtAstNode previous = first;
        while (previous != null) {
            if (KrtParserSameSourceName(parser, parser.token.start, parser.token.length, previous.name_start, previous.name_length)) { KrtParserRecordError(parser); return first; }
            previous = previous.next;
        }
        KrtAstNode parameter = KrtAstMake(KrtAstKind.Type, parser.token.start, parser.token.length);
        parameter.name_start = parser.token.start; parameter.name_length = parser.token.length;
        if (first == null) { first = parameter; } else { tail.next = parameter; } tail = parameter;
        KrtLexerNext(parser.lexer, parser.token);
        if (!KrtParserTokenText(parser, 44)) { break; }
        KrtLexerNext(parser.lexer, parser.token);
    }
    if (!KrtParserTokenText(parser, 62) || first == null) { KrtParserRecordError(parser); return first; }
    KrtLexerNext(parser.lexer, parser.token); return first;
}

bool KrtParserGenericCallAhead(KrtParser parser) {
    if (!KrtParserTokenText(parser, 60)) { return false; }
    KrtParser probe = KrtParserFork(parser);
    KrtAstNode arguments = KrtParserParseTypeArguments(probe);
    return arguments != null && probe.errors == 0 && (KrtParserTokenText(probe, 40) || KrtParserTokenText(probe, 46));
}

KrtAstNode KrtParserCallTypeArguments(KrtParser parser) {
    return KrtParserParseTypeArguments(parser);
}

// Reference wrappers retain source declaration order without reusing sibling links
// from the semantic function/type/global lists.
KrtAstNode KrtParserAppendSyntax(KrtParser parser,KrtAstNode declaration){
    KrtAstNode reference=KrtAstMake(declaration.kind,declaration.start,declaration.length);reference.left=declaration;
    reference.native_scope=parser.native_scope;reference.native_using_scope=parser.current_using_scope;
    if(parser.syntax_scope!=null){
        if(parser.syntax_scope.syntax_declarations==null){parser.syntax_scope.syntax_declarations=reference;}
        else{KrtAstNode tail=parser.syntax_scope.syntax_declarations;while(tail.next!=null){tail=tail.next;}tail.next=reference;}
    }
    return reference;
}
