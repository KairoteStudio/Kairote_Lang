// Constraints retain their parameter and type spans, including unused templates.
KrtAstNode KrtParserConstraints(KrtParser parser, KrtAstNode parameters) {
    KrtAstNode first = null; KrtAstNode tail = null;
    while (KrtParserIsWord(parser, "where")) {
        KrtLexerNext(parser.lexer, parser.token);
        if (parser.token.kind != KrtTokenKind.Identifier) { KrtParserRecordError(parser); return first; }
        int64 start = parser.token.start; int64 length = parser.token.length;
        KrtAstNode parameter = parameters;
        while (parameter != null && !KrtParserSameSourceName(parser, start, length, parameter.name_start, parameter.name_length)) { parameter = parameter.next; }
        if (parameter == null) { KrtParserRecordError(parser); return first; }
        KrtAstNode previous = first;
        while (previous != null) {
            if (KrtParserSameSourceName(parser, start, length, previous.name_start, previous.name_length)) { KrtParserRecordError(parser); return first; }
            previous = previous.next;
        }
        KrtLexerNext(parser.lexer, parser.token);
        if (!KrtParserTokenText(parser, 58)) { KrtParserRecordError(parser); return first; }
        KrtLexerNext(parser.lexer, parser.token);
        int32 flags = 0;
        while (true) {
            KrtAstNode constraint = KrtAstMake(KrtAstKind.Type, parser.token.start, parser.token.length);
            constraint.name_start = start; constraint.name_length = length;
            constraint.type_start = parser.token.start;
            if (KrtParserIsWord(parser, "class")) { constraint.op = 1; }
            else if (KrtParserIsWord(parser, "struct")) { constraint.op = 2; }
            else if (KrtParserIsWord(parser, "new")) { constraint.op = 3; }
            else if (KrtParserIsWord(parser, "unmanaged")) { constraint.op = 4; }
            else { constraint.op = 6; }
            if (constraint.op != 6) {
                int32 flag = 1 << constraint.op;
                if ((flags & flag) != 0 || (constraint.op == 1 && (flags & 20) != 0) ||
                    ((constraint.op == 2 || constraint.op == 4) && (flags & 2) != 0)) { KrtParserRecordError(parser); return first; }
                flags = flags | flag; KrtLexerNext(parser.lexer, parser.token);
                if (constraint.op == 3) {
                    if (!KrtParserTokenText(parser, 40)) { KrtParserRecordError(parser); return first; }
                    KrtLexerNext(parser.lexer, parser.token);
                    if (!KrtParserTokenText(parser, 41)) { KrtParserRecordError(parser); return first; }
                    KrtLexerNext(parser.lexer, parser.token);
                }
            } else if (!KrtParserSkipNativeType(parser)) { return first; }
            constraint.type_length = KrtParserTypeSpanLength(parser, constraint.type_start, parser.token.start - constraint.type_start);
            constraint.length = constraint.type_length;
            if (first == null) { first = constraint; } else { tail.next = constraint; } tail = constraint;
            if (!KrtParserTokenText(parser, 44)) { break; }
            KrtLexerNext(parser.lexer, parser.token);
        }
    }
    return first;
}
