// Keep the complete base type spelling, including namespaces and type arguments.
KrtAstNode KrtParserBaseTypes(KrtParser parser) {
    if (!KrtParserTokenText(parser, 58)) { return null; }
    KrtLexerNext(parser.lexer, parser.token);
    KrtAstNode first = null; KrtAstNode tail = null;
    while (parser.errors == 0) {
        int64 start = parser.token.start;
        if (!KrtParserSkipNativeType(parser)) { KrtParserRecordError(parser); return first; }
        KrtAstNode base_type = KrtAstMake(KrtAstKind.Type, start, parser.token.start - start);
        base_type.type_start = start; base_type.type_length = KrtParserTypeSpanLength(parser, start, base_type.length);
        if (first == null) { first = base_type; } else { tail.next = base_type; } tail = base_type;
        if (!KrtParserTokenText(parser, 44)) { break; }
        KrtLexerNext(parser.lexer, parser.token);
    }
    return first;
}

bool KrtParserBaseConstructor(KrtParser parser, KrtAstNode method) {
    if (!KrtParserTokenText(parser, 58)) { return true; }
    KrtLexerNext(parser.lexer, parser.token);
    if (!KrtParserIsWord(parser, "base")) { KrtParserRecordError(parser); return false; }
    KrtAstNode call = KrtAstMake(KrtAstKind.Call, parser.token.start, parser.token.length); call.op = 222;
    KrtLexerNext(parser.lexer, parser.token);
    if (!KrtParserTokenText(parser, 40)) { KrtParserRecordError(parser); return false; }
    KrtLexerNext(parser.lexer, parser.token); KrtAstNode tail = null;
    while (!KrtParserTokenText(parser, 41) && parser.errors == 0) {
        KrtAstNode argument = KrtParserParseExpression(parser, 1);
        if (call.right == null) { call.right = argument; } else { tail.next = argument; } tail = argument;
        call.parameter_count = call.parameter_count + 1;
        if (!KrtParserTokenText(parser, 44)) { break; }
        KrtLexerNext(parser.lexer, parser.token);
    }
    if (!KrtParserTokenText(parser, 41)) { KrtParserRecordError(parser); return false; }
    KrtLexerNext(parser.lexer, parser.token); method.native_base_call = call; return true;
}
