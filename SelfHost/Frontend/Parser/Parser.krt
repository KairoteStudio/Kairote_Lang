        unsafe(using krt.mem;) {
            byte* source = (byte*)parser.lexer.source;
            if (source[parser.token.start] == 114 && source[parser.token.start + 1] == 101 &&
                source[parser.token.start + 2] == 116 && source[parser.token.start + 3] == 117 &&
                source[parser.token.start + 4] == 114 && source[parser.token.start + 5] == 110) {
                int64 start = parser.token.start;
                KrtLexerNext(parser.lexer, parser.token);
                KrtAstNode value = null;
                if (!KrtParserTokenText(parser, 59)) { value = KrtParserParseExpression(parser, 1); }
                if (!KrtParserTokenText(parser, 59)) { KrtParserRecordError(parser); }
                else { KrtLexerNext(parser.lexer, parser.token); }
                KrtAstNode result = KrtAstMake(KrtAstKind.Return, start, parser.token.start - start);
                result.left = value; result.child_count = value == null ? 0 : 1;
                return result;
            }
        }
    }
    if (parser.token.kind == KrtTokenKind.Identifier || KrtParserTokenText(parser, 40) || KrtParserTokenText(parser, 42) || KrtParserTokenText(parser, 38)) {
        int64 start = parser.token.start;
        KrtAstNode expression = KrtParserParseExpression(parser, 1);
        if (parser.token.kind == KrtTokenKind.Punctuation && parser.token.length == 2) {
            int32 operation = KrtParserOperator(parser);
            if (operation >= 108 && operation <= 112) {
                KrtLexerNext(parser.lexer, parser.token);
                KrtAstNode value = KrtParserParseExpression(parser, 1);
                if (!KrtParserTokenText(parser, 59)) { KrtParserRecordError(parser); }
                else { KrtLexerNext(parser.lexer, parser.token); }
                KrtAstNode compound = KrtAstMake(KrtAstKind.CompoundAssign, start, parser.token.start - start);
                compound.left = expression; compound.right = value; compound.op = operation; compound.child_count = 2;
                return compound;
            }
        }
        if (KrtParserTokenText(parser, 61)) {
            KrtLexerNext(parser.lexer, parser.token);
            KrtAstNode value = KrtParserParseExpression(parser, 1);
            if (!KrtParserTokenText(parser, 59)) { KrtParserRecordError(parser); }
            else { KrtLexerNext(parser.lexer, parser.token); }
            KrtAstNode assignment = KrtAstMake(KrtAstKind.Assign, start, parser.token.start - start);
            assignment.left = expression; assignment.right = value; assignment.child_count = 2;
            return assignment;
        }
        if (!KrtParserTokenText(parser, 59)) { KrtParserRecordError(parser); }
        else { KrtLexerNext(parser.lexer, parser.token); }
        KrtAstNode statement = KrtAstMake(KrtAstKind.Expression, start, parser.token.start - start);
        statement.left = expression; statement.child_count = 1;
        return statement;
    }
    KrtParserRecordError(parser);
    KrtAstNode invalid = KrtAstMake(KrtAstKind.Invalid, parser.token.start, parser.token.length);
    KrtLexerNext(parser.lexer, parser.token);
    return invalid;
}

bool KrtParserSameSourceName(KrtParser parser, int64 left, int64 left_length, int64 right, int64 right_length) {
    if (left_length != right_length) { return false; }
    unsafe(using krt.mem;) {
        byte* source = (byte*)parser.lexer.source; int64 index = 0;
        while (index < left_length) { if (source[left + index] != source[right + index]) { return false; } index = index + 1; }
    }
    return true;
}

// Field initializers run in declaration order before the constructor body.
void KrtParserInitializeConstructors(KrtAstNode declaration) {
    if (declaration.value == 4 || declaration.value == 3) { return; }
    bool initialized = false; bool has_constructor = false;
    KrtAstNode field = declaration.body;
    while (field != null) { if (!field.native_static && field.left != null) { initialized = true; } field = field.next; }
    if (!initialized && declaration.left == null) { return; }
    KrtAstNode method = declaration.declarations;
    while (method != null) { if (method.op == 220) { has_constructor = true; } method = method.next; }
    if (!has_constructor) {
        method = KrtAstMake(KrtAstKind.Function, declaration.start, declaration.length);
        method.name_start = declaration.name_start; method.name_length = declaration.name_length;
        method.native_owner = declaration; method.op = 220; method.parameter_count = 1;
        method.parameter_starts = new int64[32]; method.parameter_lengths = new int64[32];
        method.parameter_type_starts = new int64[32]; method.parameter_type_lengths = new int64[32]; method.parameter_refs = new bool[32];
        method.parameter_starts[0] = declaration.name_start;
        method.parameter_type_starts[0] = declaration.name_start; method.parameter_type_lengths[0] = declaration.name_length;
        method.left = KrtAstMake(KrtAstKind.Block, declaration.start, declaration.length);
        method.next = declaration.declarations; declaration.declarations = method;
    }
    method = declaration.declarations;
    while (method != null) {
        if (method.op == 220) {
            KrtAstNode first = null; KrtAstNode tail = null; field = declaration.body;
            while (field != null) {
                if (!field.native_static && field.left != null) {
                    KrtAstNode receiver = KrtAstMake(KrtAstKind.Identifier, field.start, 0); receiver.op = 211;
                    receiver.local_slot = -2; receiver.native_type = declaration;
                    KrtAstNode target = KrtAstMake(KrtAstKind.Member, field.start, field.length);
                    target.left = receiver; target.name_start = field.name_start; target.name_length = field.name_length;
                    KrtAstNode assignment = KrtAstMake(KrtAstKind.Assign, field.start, field.length);
                    assignment.left = target; assignment.right = field.left;
                    if (first == null) { first = assignment; } else { tail.next = assignment; }
                    tail = assignment; method.left.child_count = method.left.child_count + 1;
                }
                field = field.next;
            }
            if (tail != null) { tail.next = method.left.left; method.left.left = first; }
        }
        method = method.next;
    }
}
