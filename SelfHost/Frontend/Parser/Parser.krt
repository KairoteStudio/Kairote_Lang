// Parser contract: consumes KrtToken values and never depends on Kro output.
class KrtParser {
    public KrtLexer lexer;
    public KrtToken token;
    public int32 errors;
    public int64 error_start;
    public KrtAstNode native_scope;
}

void KrtParserInit(KrtParser parser, KrtLexer lexer, KrtToken token) {
    parser.lexer = lexer; parser.token = token; parser.errors = 0; parser.error_start = -1; KrtLexerNext(lexer, token);
}

void KrtParserRecordError(KrtParser parser) { if (parser.errors == 0) { parser.error_start = parser.token.start; } parser.errors = parser.errors + 1; }

bool KrtParserAccept(KrtParser parser, KrtTokenKind kind) {
    if (parser.token.kind != kind) { return false; }
    KrtLexerNext(parser.lexer, parser.token); return true;
}

bool KrtParserExpect(KrtParser parser, KrtTokenKind kind) {
    if (KrtParserAccept(parser, kind)) { return true; }
    KrtParserRecordError(parser); return false;
}

KrtAstNode KrtParserParsePrimary(KrtParser parser) {
    KrtToken token = parser.token;
    KrtAstKind kind = KrtAstKind.Invalid;
    if (KrtParserIsWord(parser, "sizeof") || KrtParserIsWord(parser, "default")) {
        bool is_sizeof = KrtParserIsWord(parser, "sizeof");
        int64 start = token.start;
        KrtLexerNext(parser.lexer, parser.token);
        if (!KrtParserTokenText(parser, 40)) { KrtParserRecordError(parser); return KrtAstMake(KrtAstKind.Invalid, start, 0); }
        KrtLexerNext(parser.lexer, parser.token);
        if (parser.token.kind != KrtTokenKind.Identifier) { KrtParserRecordError(parser); return KrtAstMake(KrtAstKind.Invalid, start, 0); }
        int64 type_start = parser.token.start; int64 type_length = parser.token.length;
        KrtLexerNext(parser.lexer, parser.token);
        KrtParserSkipGenericArguments(parser); KrtParserSkipQualifiedType(parser);
        KrtParserSkipArrayTypeSuffix(parser);
        while (KrtParserTokenText(parser, 42)) { KrtLexerNext(parser.lexer, parser.token); }
        if (!KrtParserTokenText(parser, 41)) { KrtParserRecordError(parser); return KrtAstMake(KrtAstKind.Invalid, start, 0); }
        type_length = parser.token.start - type_start;
        KrtLexerNext(parser.lexer, parser.token);
        KrtAstNode result = KrtAstMake(is_sizeof ? KrtAstKind.Sizeof : KrtAstKind.DefaultValue, start, parser.token.start - start);
        result.type_start = type_start; result.type_length = type_length; return result;
    }
    if (KrtParserIsWord(parser, "stackalloc")) {
        int64 start = token.start;
        KrtLexerNext(parser.lexer, parser.token);
        if (parser.token.kind != KrtTokenKind.Identifier) { KrtParserRecordError(parser); return KrtAstMake(KrtAstKind.Invalid, start, 0); }
        int64 type_start = parser.token.start;
        int64 type_length = parser.token.length;
        int32 element_width = 0;
        if (KrtParserIsWord(parser, "byte")) { element_width = 1; }
        KrtLexerNext(parser.lexer, parser.token);
        if (!KrtParserTokenText(parser, 91)) { KrtParserRecordError(parser); return KrtAstMake(KrtAstKind.Invalid, start, 0); }
        KrtLexerNext(parser.lexer, parser.token);
        KrtAstNode count = KrtParserParseExpression(parser, 1);
        if (!KrtParserTokenText(parser, 93)) { KrtParserRecordError(parser); return KrtAstMake(KrtAstKind.Invalid, start, 0); }
        KrtLexerNext(parser.lexer, parser.token);
        KrtAstNode node = KrtAstMake(KrtAstKind.StackAlloc, start, parser.token.start - start);
        node.type_start = type_start; node.type_length = type_length;
        node.name_start = type_start; node.name_length = type_length; node.left = count; node.child_count = 1;
        node.element_width = element_width;
        return node;
    }
    if (KrtParserIsWord(parser, "new")) {
        int64 start = token.start;
        KrtLexerNext(parser.lexer, parser.token);
        if (parser.token.kind != KrtTokenKind.Identifier) { KrtParserRecordError(parser); return KrtAstMake(KrtAstKind.Invalid, start, 0); }
        int64 type_start = parser.token.start;
        int64 type_length = parser.token.length;
        KrtLexerNext(parser.lexer, parser.token);
        KrtParserSkipGenericArguments(parser);
        KrtParserSkipQualifiedType(parser);
        type_length = KrtParserTypeSpanLength(parser, type_start, parser.token.start - type_start);
        KrtAstNode count = null; KrtAstNode arguments = null; KrtAstNode last_argument = null; int32 argument_count = 0;
        if (KrtParserTokenText(parser, 40)) {
            KrtLexerNext(parser.lexer, parser.token);
            while (!KrtParserTokenText(parser, 41) && parser.token.kind != KrtTokenKind.Eof) {
                KrtAstNode argument = KrtParserParseExpression(parser, 1);
                if (arguments == null) { arguments = argument; } else { last_argument.next = argument; }
                last_argument = argument; argument_count = argument_count + 1;
                if (!KrtParserTokenText(parser, 44)) { break; }
                KrtLexerNext(parser.lexer, parser.token);
            }
            if (!KrtParserTokenText(parser, 41)) { KrtParserRecordError(parser); return KrtAstMake(KrtAstKind.Invalid, start, 0); }
            KrtLexerNext(parser.lexer, parser.token);
        } else if (KrtParserTokenText(parser, 91)) {
            KrtLexerNext(parser.lexer, parser.token);
            count = KrtParserParseExpression(parser, 1);
            if (!KrtParserTokenText(parser, 93)) { KrtParserRecordError(parser); return KrtAstMake(KrtAstKind.Invalid, start, 0); }
            KrtLexerNext(parser.lexer, parser.token);
        } else { KrtParserRecordError(parser); return KrtAstMake(KrtAstKind.Invalid, start, 0); }
        KrtAstNode node = KrtAstMake(KrtAstKind.New, start, parser.token.start - start);
        node.type_start = type_start; node.type_length = type_length;
        node.name_start = type_start; node.name_length = type_length;
        node.left = count; node.right = arguments; node.parameter_count = argument_count; node.child_count = count == null ? argument_count : 1;
        return KrtParserParsePostfix(parser, node);
    }
    if (KrtParserIsWord(parser, "function") || KrtParserIsWord(parser, "func") || KrtParserIsWord(parser, "fn")) {
        int64 start = token.start;
        KrtLexerNext(parser.lexer, parser.token);
        if (!KrtParserTokenText(parser, 40)) { KrtParserRecordError(parser); return KrtAstMake(KrtAstKind.Invalid, start, 0); }
        KrtAstNode lambda = KrtAstMake(KrtAstKind.Lambda, start, 0);
        lambda.parameter_starts = new int64[256]; lambda.parameter_lengths = new int64[256];
        lambda.parameter_type_starts = new int64[256]; lambda.parameter_type_lengths = new int64[256];
        lambda.parameter_refs = new bool[256];
        KrtLexerNext(parser.lexer, parser.token);
        while (!KrtParserTokenText(parser, 41)) {
            int32 index = lambda.parameter_count;
            if (index >= 256) { KrtParserRecordError(parser); return lambda; }
            if (KrtParserIsWord(parser, "ref")) {
                lambda.parameter_refs[index] = true; KrtLexerNext(parser.lexer, parser.token);
            }
            if (parser.token.kind != KrtTokenKind.Identifier) { KrtParserRecordError(parser); return lambda; }
            int64 parameter_start = parser.token.start;
            int64 parameter_length = parser.token.length;
            KrtLexerNext(parser.lexer, parser.token);
            KrtParserSkipGenericArguments(parser); KrtParserSkipQualifiedType(parser);
            KrtParserSkipArrayTypeSuffix(parser);
            while (KrtParserTokenText(parser, 42)) { KrtLexerNext(parser.lexer, parser.token); }
            if (parser.token.kind == KrtTokenKind.Identifier) {
                lambda.parameter_type_starts[index] = parameter_start;
                lambda.parameter_type_lengths[index] = parser.token.start - parameter_start;
                parameter_start = parser.token.start; parameter_length = parser.token.length;
                KrtLexerNext(parser.lexer, parser.token);
            }
            lambda.parameter_starts[index] = parameter_start; lambda.parameter_lengths[index] = parameter_length;
            lambda.parameter_count = index + 1;
            if (!KrtParserTokenText(parser, 44)) { break; }
            KrtLexerNext(parser.lexer, parser.token);
            if (KrtParserTokenText(parser, 41)) { KrtParserRecordError(parser); return lambda; }
        }
        if (!KrtParserTokenText(parser, 41)) { KrtParserRecordError(parser); return lambda; }
        KrtLexerNext(parser.lexer, parser.token);
        if (!KrtParserTokenText2(parser, 61, 62)) {
            KrtParserRecordError(parser); return KrtAstMake(KrtAstKind.Invalid, start, 0);
        }
        KrtLexerNext(parser.lexer, parser.token);
        KrtAstNode body = KrtParserParseExpression(parser, 1);
        lambda.length = body.start + body.length - start;
        lambda.left = body; lambda.child_count = 1;
        return lambda;
    }
    if (KrtParserTokenText(parser, 91) || KrtParserTokenText(parser, 123)) {
        int64 start = token.start;
        byte closing = KrtParserTokenText(parser, 123) ? 125 : 93;
        KrtLexerNext(parser.lexer, parser.token);
        KrtAstNode first = null; KrtAstNode tail = null; int32 count = 0;
        while (!KrtParserTokenText(parser, closing) && parser.token.kind != KrtTokenKind.Eof) {
            KrtAstNode element = KrtParserParseExpression(parser, 1);
            if (first == null) { first = element; } else { tail.next = element; }
            tail = element; count = count + 1;
            if (!KrtParserTokenText(parser, 44)) { break; }
            KrtLexerNext(parser.lexer, parser.token);
        }
        if (!KrtParserTokenText(parser, closing)) { KrtParserRecordError(parser); }
        else { KrtLexerNext(parser.lexer, parser.token); }
        KrtAstNode array = KrtAstMake(KrtAstKind.ArrayLiteral, start, parser.token.start - start);
        array.left = first; array.child_count = count;
        return KrtParserParsePostfix(parser, array);
    }
    if (token.kind == KrtTokenKind.Punctuation && token.length == 1) {
        unsafe(using krt.mem;) {
            byte value = ((byte*)parser.lexer.source)[token.start];
            if (value == 40) {
                int64 saved_position = parser.lexer.position;
                int64 saved_line = parser.lexer.line;
                int64 saved_column = parser.lexer.column;
                KrtTokenKind saved_kind = parser.token.kind;
                int64 saved_start = parser.token.start;
                int64 saved_length = parser.token.length;
                int64 saved_token_line = parser.token.line;
                int64 saved_token_column = parser.token.column;
                int32 saved_error = parser.token.error;
                KrtLexerNext(parser.lexer, parser.token);
                bool possible_cast = KrtParserIsBuiltinType(parser);
                if (parser.token.kind == KrtTokenKind.Identifier) {
                    byte type_first = ((byte*)parser.lexer.source)[parser.token.start];
                    if (type_first >= 65 && type_first <= 90) { possible_cast = true; }
                }
                if (parser.token.kind == KrtTokenKind.Identifier && possible_cast) {
                    int64 cast_type_start = parser.token.start;
                    int64 cast_type_length = parser.token.length;
                    KrtLexerNext(parser.lexer, parser.token);
                    KrtParserSkipGenericArguments(parser);
                    KrtParserSkipQualifiedType(parser);
                    KrtParserSkipArrayTypeSuffix(parser);
                    bool pointer_cast = false;
                    while (KrtParserTokenText(parser, 42)) { pointer_cast = true; KrtLexerNext(parser.lexer, parser.token); }
                    // Recover the closing delimiter directly from the
                    // source when a preceding nested expression left the
                    // token object's kind stale.  The lexer position still
                    // points at the delimiter, so the normal Next call below
                    // remains responsible for consuming it.
                    if (!KrtParserTokenText(parser, 41)) {
                        int64 close_peek = parser.lexer.position;
                        unsafe(using krt.mem;) {
                            byte* raw = (byte*)parser.lexer.source;
                            while (close_peek < parser.lexer.length && (raw[close_peek] == 32 || raw[close_peek] == 9 || raw[close_peek] == 10 || raw[close_peek] == 13)) { close_peek = close_peek + 1; }
                            if (close_peek < parser.lexer.length && raw[close_peek] == 41) {
                                parser.lexer.position = close_peek;
                                parser.token.kind = KrtTokenKind.Punctuation; parser.token.start = close_peek; parser.token.length = 1; parser.token.error = 0;
                            }
                        }
                    }
                    if (KrtParserTokenText(parser, 41)) {
                        cast_type_length = parser.token.start - cast_type_start;
                        KrtLexerNext(parser.lexer, parser.token);
                        KrtAstNode operand = KrtParserParseUnary(parser);
                        KrtAstNode cast = KrtAstMake(KrtAstKind.Cast, cast_type_start, operand.start + operand.length - cast_type_start);
                        cast.type_start = cast_type_start; cast.type_length = cast_type_length;
                        cast.name_start = cast_type_start; cast.name_length = cast_type_length; cast.left = operand; cast.child_count = 1;
                        cast.element_width = pointer_cast ? 1 : 0;
                        return cast;
                    }
                    // A parenthesized expression can start with an identifier
                    // too. Restore the lexer checkpoint when the token after
                    // the candidate type is not a closing parenthesis.
                    parser.lexer.position = saved_position; parser.lexer.line = saved_line; parser.lexer.column = saved_column;
                    parser.token.kind = saved_kind; parser.token.start = saved_start; parser.token.length = saved_length;
                    parser.token.line = saved_token_line; parser.token.column = saved_token_column; parser.token.error = saved_error;
                    KrtLexerNext(parser.lexer, parser.token);
                    KrtAstNode grouped_identifier = KrtParserParseExpression(parser, 1);
                    if (!KrtParserTokenText(parser, 41)) { KrtParserRecordError(parser); return grouped_identifier; }
                    KrtLexerNext(parser.lexer, parser.token); grouped_identifier.grouped = true;
                    if (KrtParserTokenText(parser, 91)) {
                        KrtLexerNext(parser.lexer, parser.token);
                        KrtAstNode index = KrtParserParseExpression(parser, 1);
                        if (!KrtParserTokenText(parser, 93)) { KrtParserRecordError(parser); return grouped_identifier; }
                        KrtLexerNext(parser.lexer, parser.token);
                        KrtAstNode access = KrtAstMake(KrtAstKind.Index, grouped_identifier.start, parser.token.start - grouped_identifier.start);
                        access.left = grouped_identifier; access.right = index; access.child_count = 2; return access;
                    }
                    return grouped_identifier;
                }
                KrtAstNode grouped = KrtParserParseExpression(parser, 1);
                if (parser.token.kind != KrtTokenKind.Punctuation || parser.token.length != 1 ||
                    ((byte*)parser.lexer.source)[parser.token.start] != 41) {
                    KrtParserRecordError(parser);
                    return grouped;
                }
                KrtLexerNext(parser.lexer, parser.token);
                grouped.grouped = true;
                if (KrtParserTokenText(parser, 91)) {
                    KrtLexerNext(parser.lexer, parser.token);
                    KrtAstNode index = KrtParserParseExpression(parser, 1);
                    if (!KrtParserTokenText(parser, 93)) { KrtParserRecordError(parser); return grouped; }
                    KrtLexerNext(parser.lexer, parser.token);
                    KrtAstNode access = KrtAstMake(KrtAstKind.Index, grouped.start, parser.token.start - grouped.start);
                    access.left = grouped; access.right = index; access.child_count = 2; return access;
                }
                return grouped;
            }
        }
    }
    if (token.kind == KrtTokenKind.Floating) { kind = KrtAstKind.Floating; }
    else if (token.kind == KrtTokenKind.Integer) { kind = KrtAstKind.Integer; }
    else if (token.kind == KrtTokenKind.Identifier && (KrtParserIsWord(parser, "true") || KrtParserIsWord(parser, "false"))) { kind = KrtAstKind.Boolean; }
    else if (token.kind == KrtTokenKind.Identifier && KrtParserIsWord(parser, "null")) { kind = KrtAstKind.Null; }
    else if (token.kind == KrtTokenKind.Identifier) { kind = KrtAstKind.Identifier; }
    else if (token.kind == KrtTokenKind.Character) { kind = KrtAstKind.Integer; }
    else if (token.kind == KrtTokenKind.String) { kind = KrtAstKind.String; }
    else {
        KrtParserRecordError(parser);
        return KrtAstMake(KrtAstKind.Invalid, token.start, token.length);
    }
    KrtAstNode node = KrtAstMake(kind, token.start, token.length);
    if (kind == KrtAstKind.Integer) {
        uint64 value = 0; uint64 high = 0; int64 digit = 0; int64 radix = 10;
        unsafe(using krt.mem;) {
            byte* source = (byte*)parser.lexer.source;
            if (token.kind == KrtTokenKind.Character) {
                value = source[token.start + 1];
                if (value == 92) {
                    value = source[token.start + 2];
                    if (value == 110) { value = 10; }
                    else if (value == 114) { value = 13; }
                    else if (value == 116) { value = 9; }
                    else if (value == 48) { value = 0; }
                    else if (value != 92 && value != 39 && value != 34) { KrtParserRecordError(parser); }
                }
            } else {
                if (token.length > 2 && source[token.start] == 48 && (source[token.start + 1] == 120 || source[token.start + 1] == 88)) { radix = 16; digit = 2; }
                while (digit < token.length) {
                    int64 digit_value = lexer_hex_digit(source[token.start + digit]);
                    uint64 lower_limb = (value & (uint64)4294967295) * (uint64)radix + (uint64)digit_value;
                    uint64 upper_limb = (value >> 32) * (uint64)radix + (lower_limb >> 32);
                    uint64 carry = upper_limb >> 32;
                    if (high > ((uint64)18446744073709551615 - carry) / (uint64)radix) { KrtParserRecordError(parser); break; }
                    high = high * (uint64)radix + carry;
                    value = (upper_limb << 32) | (lower_limb & (uint64)4294967295);
                    digit = digit + 1;
                }
            }
        }
        node.value = (int64)value; node.native_high = (int64)high; node.native_wide = high != 0;
        node.native_unsigned = high == 0 ? value > (uint64)9223372036854775807 : high > (uint64)9223372036854775807;
    }
    if (kind == KrtAstKind.Floating) {
        node.native_float = 8;
        unsafe(using krt.mem;) {
            byte suffix = ((byte*)parser.lexer.source)[token.start + token.length - 1];
            if (suffix == 102 || suffix == 70) { node.native_float = 4; }
        }
    }
    if (kind == KrtAstKind.Boolean) { node.value = KrtParserIsWord(parser, "true") ? 1 : 0; }
    KrtLexerNext(parser.lexer, parser.token);
    return KrtParserParsePostfix(parser, node);
}

KrtAstNode KrtParserParsePostfix(KrtParser parser, KrtAstNode node) {
        while (true) {
            if (KrtParserGenericCallAhead(parser)) { node.native_type_arguments = KrtParserCallTypeArguments(parser); }
            if (KrtParserTokenText(parser, 40)) {
                KrtLexerNext(parser.lexer, parser.token);
                KrtAstNode argument = null;
                KrtAstNode argument_tail = null;
                int32 argument_count = 0;
                if (!KrtParserTokenText(parser, 41)) {
                    while (true) {
                        KrtAstNode current_argument = KrtParserParseExpression(parser, 1);
                        if (argument == null) { argument = current_argument; } else { argument_tail.next = current_argument; }
                        argument_tail = current_argument;
                        argument_count = argument_count + 1;
                        if (!KrtParserTokenText(parser, 44)) { break; }
                        KrtLexerNext(parser.lexer, parser.token);
                    }
                if (!KrtParserTokenText(parser, 41)) { KrtParserRecordError(parser); return node; }
                }
                KrtLexerNext(parser.lexer, parser.token);
                KrtAstNode call = KrtAstMake(KrtAstKind.Call, node.start, parser.token.start - node.start);
                call.left = node; call.right = argument; call.child_count = argument == null ? 1 : argument_count + 1; call.parameter_count = argument_count;
                node = call;
                continue;
            }
            if (KrtParserTokenText(parser, 46)) {
                KrtLexerNext(parser.lexer, parser.token);
                if (parser.token.kind != KrtTokenKind.Identifier) { KrtParserRecordError(parser); return node; }
                KrtAstNode member = KrtAstMake(KrtAstKind.Member, node.start, parser.token.start + parser.token.length - node.start);
                member.left = node; member.name_start = parser.token.start; member.name_length = parser.token.length; member.child_count = 1;
                KrtLexerNext(parser.lexer, parser.token);
                node = member;
                continue;
            }
            if (KrtParserTokenText2(parser, 63, 46)) {
                KrtLexerNext(parser.lexer, parser.token);
                if (parser.token.kind != KrtTokenKind.Identifier) { KrtParserRecordError(parser); return node; }
                KrtAstNode member = KrtAstMake(KrtAstKind.Member, node.start, parser.token.start + parser.token.length - node.start);
                member.left = node; member.name_start = parser.token.start; member.name_length = parser.token.length; member.op = 114; member.child_count = 1;
                KrtLexerNext(parser.lexer, parser.token); node = member; continue;
            }
            if (KrtParserTokenText(parser, 91)) {
                KrtLexerNext(parser.lexer, parser.token);
                KrtAstNode index = KrtParserParseExpression(parser, 1);
                if (!KrtParserTokenText(parser, 93)) { KrtParserRecordError(parser); return node; }
                KrtLexerNext(parser.lexer, parser.token);
                KrtAstNode access = KrtAstMake(KrtAstKind.Index, node.start, parser.token.start - node.start);
                access.left = node; access.right = index; access.child_count = 2;
                node = access;
                continue;
            }
            if (KrtParserTokenText2(parser, 43, 43) || KrtParserTokenText2(parser, 45, 45)) {
                int32 operation = KrtParserTokenText2(parser, 43, 43) ? 201 : 202;
                KrtLexerNext(parser.lexer, parser.token);
                node = KrtAstMakeUnary(operation, node);
                continue;
            }
            break;
        }
    return node;
}

int32 KrtParserOperator(KrtParser parser) {
    unsafe(using krt.mem;) {
        byte* source = (byte*)parser.lexer.source;
        byte first = source[parser.token.start];
        if (parser.token.length == 2) {
            byte second = source[parser.token.start + 1];
            if (first == 33 && second == 61) { return 101; }
            if (first == 60 && second == 61) { return 102; }
            if (first == 62 && second == 61) { return 103; }
            if (first == 38 && second == 38) { return 104; }
            if (first == 124 && second == 124) { return 105; }
            if (first == 60 && second == 60) { return 106; }
            if (first == 62 && second == 62) { return 107; }
            if (first == 43 && second == 61) { return 108; }
            if (first == 45 && second == 61) { return 109; }
            if (first == 42 && second == 61) { return 110; }
            if (first == 47 && second == 61) { return 111; }
            if (first == 37 && second == 61) { return 112; }
            if (first == 63 && second == 63) { return 113; }
            if (first == 63 && second == 46) { return 114; }
        }
        return (int32)first;
    }
}

KrtAstNode KrtParserParseUnary(KrtParser parser) {
    if (KrtParserIsWord(parser, "ref")) {
        KrtLexerNext(parser.lexer, parser.token);
        KrtAstNode reference = KrtAstMakeUnary(200, KrtParserParseUnary(parser));
        return reference;
    }
    if (KrtParserIsWord(parser, "await")) {
        int64 start = parser.token.start;
        KrtLexerNext(parser.lexer, parser.token);
        KrtAstNode operand = KrtParserParseUnary(parser);
        KrtAstNode result = KrtAstMake(KrtAstKind.Await, start, operand.start + operand.length - start);
        result.left = operand; result.child_count = 1; return result;
    }
    if (parser.token.kind == KrtTokenKind.Punctuation && parser.token.length == 1) {
        int32 operation = KrtParserOperator(parser);
        if (operation == 33 || operation == 45 || operation == 43 || operation == 126 || operation == 42 || operation == 38) {
            KrtLexerNext(parser.lexer, parser.token);
            return KrtAstMakeUnary(operation, KrtParserParseUnary(parser));
        }
    }
    return KrtParserParsePrimary(parser);
}

int32 KrtParserPrecedence(KrtParser parser) {
    if (KrtParserIsWord(parser, "is") || KrtParserIsWord(parser, "as")) { return 8; }
    if (parser.token.kind != KrtTokenKind.Punctuation) { return 0; }
    unsafe(using krt.mem;) {
        byte value = ((byte*)parser.lexer.source)[parser.token.start];
        if (parser.token.length == 1 && (value == 43 || value == 45)) { return 10; }
        if (parser.token.length == 1 && (value == 42 || value == 47 || value == 37)) { return 20; }
        if (parser.token.length == 2 && value == 61 && ((byte*)parser.lexer.source)[parser.token.start + 1] == 61) { return 7; }
        if (parser.token.length == 2 && value == 33 && ((byte*)parser.lexer.source)[parser.token.start + 1] == 61) { return 7; }
        if (parser.token.length == 1 && (value == 60 || value == 62)) { return 8; }
        if (parser.token.length == 2 && (value == 60 || value == 62) && ((byte*)parser.lexer.source)[parser.token.start + 1] == 61) { return 8; }
        if (parser.token.length == 2 && value == 38 && ((byte*)parser.lexer.source)[parser.token.start + 1] == 38) { return 4; }
        if (parser.token.length == 2 && value == 124 && ((byte*)parser.lexer.source)[parser.token.start + 1] == 124) { return 3; }
        if (parser.token.length == 2 && (value == 60 || value == 62) &&
            ((byte*)parser.lexer.source)[parser.token.start + 1] == value) { return 9; }
