            if (KrtParserTokenText(parser, 61)) {
                KrtLexerNext(parser.lexer, parser.token);
                KrtAstNode constant = KrtParserParseExpression(parser, 1);
                if (constant.kind == KrtAstKind.Integer) { enum_value = constant.value; }
                else if (constant.kind == KrtAstKind.Unary && constant.op == 45 && constant.left.kind == KrtAstKind.Integer) { enum_value = -constant.left.value; }
                else { KrtParserRecordError(parser); }
            }
