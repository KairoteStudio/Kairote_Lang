            KrtLexerNext(parser.lexer, parser.token);
        } else { KrtParserRecordError(parser); return KrtAstMake(KrtAstKind.Invalid, start, 0); }
        KrtAstNode node = KrtAstMake(KrtAstKind.New, start, parser.token.start - start);
