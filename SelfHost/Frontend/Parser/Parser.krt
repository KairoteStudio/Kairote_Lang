        !KrtParserIsWord(parser, "struct") && !KrtParserIsWord(parser, "interface")) {
        parser.lexer.position = saved_position; parser.lexer.line = saved_line; parser.lexer.column = saved_column;
        parser.token.kind = saved_kind; parser.token.start = saved_start; parser.token.length = saved_length;
        parser.token.line = saved_token_line; parser.token.column = saved_token_column; parser.token.error = saved_error;
