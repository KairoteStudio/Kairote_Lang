                unsafe(using krt.mem;){byte* raw=(byte*)parser.lexer.source;root_name=node.kind==KrtAstKind.Identifier&&node.length==6&&raw[node.start]==103&&raw[node.start+1]==108&&raw[node.start+2]==111&&raw[node.start+3]==98&&raw[node.start+4]==97&&raw[node.start+5]==108;}
                if(!root_name){KrtParserRecordError(parser);return node;}
                KrtLexerNext(parser.lexer,parser.token);
                if(parser.token.kind!=KrtTokenKind.Identifier){KrtParserRecordError(parser);return node;}
                node.length=parser.token.start+parser.token.length-node.start;KrtLexerNext(parser.lexer,parser.token);continue;
            }
            if (KrtParserTokenText(parser, 46)) {
                KrtLexerNext(parser.lexer, parser.token);
                if (parser.token.category != KrtTokenCategory.Identifier) { KrtParserRecordError(parser); return node; }
                KrtAstNode member = KrtAstMake(KrtAstKind.Member, node.start, parser.token.start + parser.token.length - node.start);
