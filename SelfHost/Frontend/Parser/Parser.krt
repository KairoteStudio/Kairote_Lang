bool KrtParserIsWord(KrtParser parser, string word) {
    int64 length = 0;
    unsafe(using krt.mem;) {
        byte* text = (byte*)(int64)word;
        while (text[length] != 0) { length = length + 1; }
        if (parser.token.category != KrtTokenCategory.Identifier || parser.token.length != length) { return false; }
        int64 index = 0;
        while (index < length) {
            if (((byte*)parser.lexer.source)[parser.token.start + index] != text[index]) { return false; }
            index = index + 1;
        }
    }
    return true;
}

bool KrtParserIsBuiltinType(KrtParser parser) {
    if (KrtTokenIntegerBits(parser.token.kind) != 0) { return true; }
    if (lexer_integer_type_bits(parser.lexer.source, parser.token.start, parser.token.length) != 0) { return true; }
    return KrtParserIsWord(parser,"auto") || KrtParserIsWord(parser, "void") || KrtParserIsWord(parser, "bool") || KrtParserIsWord(parser, "char") ||
