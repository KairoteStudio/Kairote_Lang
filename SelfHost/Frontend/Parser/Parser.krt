    while (KrtParserIsWord(parser, "public") || KrtParserIsWord(parser, "private") ||
           KrtParserIsWord(parser, "protected") || KrtParserIsWord(parser, "static") ||
           KrtParserIsWord(parser, "abstract") || KrtParserIsWord(parser, "partial")) {
        KrtLexerNext(parser.lexer, parser.token);
