            } else {
                if (virtual_member || abstract_member) { KrtParserRecordError(parser); break; }
                KrtAstNode field = KrtAstMake(KrtAstKind.Variable, field_start, member_start + member_length - field_start);
                field.type_start = field_start; field.type_length = KrtParserTypeSpanLength(parser, field_start, field_type_length);
                field.name_start = member_start; field.name_length = member_length;
                field.native_static = is_static; field.native_readonly = is_constant;
                field.native_offset = result.native_size;
                if (!is_static) { result.native_size = result.native_size + 8; }

                if (result.body == null) { result.body = field; } else { tail.next = field; }
                tail = field; result.child_count = result.child_count + 1;
                if (KrtParserTokenText(parser, 61)) {
                    KrtLexerNext(parser.lexer, parser.token); field.left = KrtParserParseExpression(parser, 1);

