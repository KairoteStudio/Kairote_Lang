int32 KrtParserOperator(KrtParser parser) {
    if (parser.token.kind == KrtTokenKind.Is) { return 115; }
    if (parser.token.kind == KrtTokenKind.AndAssign) { return 117; }
    if (parser.token.kind == KrtTokenKind.OrAssign) { return 118; }
    if (parser.token.kind == KrtTokenKind.XorAssign) { return 119; }
    if (parser.token.kind == KrtTokenKind.LshiftAssign) { return 120; }
    if (parser.token.kind == KrtTokenKind.RshiftAssign) { return 121; }
    unsafe(using krt.mem;) {
        byte* source = (byte*)parser.lexer.source;
        byte first = source[parser.token.start];
        if (parser.token.length == 2) {
            byte second = source[parser.token.start + 1];
            if (first == 33 && second == 61) { return 101; }
            if (first == 60 && second == 61) { return 102; }
            if (first == 62 && second == 61) { return 103; }
            if (first == 38 && second == 38) { return 104; }
            if (first == 124 && second == 124) { return 105; }
            if (first == 60 && second == 60) { return 106; }
            if (first == 62 && second == 62) { return 107; }
            if (first == 43 && second == 61) { return 108; }
            if (first == 45 && second == 61) { return 109; }
            if (first == 42 && second == 61) { return 110; }
            if (first == 47 && second == 61) { return 111; }
            if (first == 37 && second == 61) { return 112; }
            if (first == 63 && second == 63) { return 113; }
            if (first == 63 && second == 46) { return 114; }
        }
        return (int32)first;
    }
}

KrtAstNode KrtParserParseUnary(KrtParser parser) {
    if (parser.token.kind == KrtTokenKind.Power) { KrtParserSplitStars(parser); }
    if(parser.token.kind==KrtTokenKind.Increment||parser.token.kind==KrtTokenKind.Decrement){
        int64 start=parser.token.start;int32 operation=parser.token.kind==KrtTokenKind.Increment?201:202;
        KrtLexerNext(parser.lexer,parser.token);
        KrtAstNode updated=KrtAstMakeUnary(operation,KrtParserParseUnary(parser));
        updated.length=updated.start+updated.length-start;updated.start=start;updated.value=1;return updated;
    }
    if (KrtParserIsWord(parser, "ref")) {
        KrtLexerNext(parser.lexer, parser.token);
        KrtAstNode reference = KrtAstMakeUnary(200, KrtParserParseUnary(parser));
        return reference;
    }
    if (KrtParserIsWord(parser, "await")) {
        int64 start = parser.token.start;
        KrtLexerNext(parser.lexer, parser.token);
        KrtAstNode operand = KrtParserParseUnary(parser);
        KrtAstNode result = KrtAstMake(KrtAstKind.Await, start, operand.start + operand.length - start);
        result.left = operand; result.child_count = 1; return result;
