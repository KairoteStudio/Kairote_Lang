        KrtParserIsWord(parser, "long") || KrtParserIsWord(parser, "float") || KrtParserIsWord(parser, "double") ||
        KrtParserIsWord(parser, "int8") || KrtParserIsWord(parser, "int16") || KrtParserIsWord(parser, "int32") ||
        KrtParserIsWord(parser, "int64") || KrtParserIsWord(parser, "int128") || KrtParserIsWord(parser, "uint8") ||
        KrtParserIsWord(parser, "uint16") || KrtParserIsWord(parser, "uint32") || KrtParserIsWord(parser, "uint64") ||
