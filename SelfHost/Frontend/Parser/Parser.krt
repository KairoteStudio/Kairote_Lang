        if (parser.token.length == 1 && value == 94) { return 5; }
        if (parser.token.length == 1 && value == 124) { return 4; }
        if (parser.token.length == 2 && value == 63 && ((byte*)parser.lexer.source)[parser.token.start + 1] == 63) { return 2; }
