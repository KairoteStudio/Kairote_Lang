// Expressions, statements, and declarations retain typed children and spans.

bool KrtParserBuiltinCastAhead(KrtParser parser) {
    if (!KrtParserIsBuiltinType(parser)) { return false; }
    KrtParser probe = KrtParserFork(parser);
    KrtAstNode type = KrtParserParseType(probe);
    return type != null && probe.errors == 0 && KrtParserTokenText(probe, 40);
}

KrtAstNode KrtParserParseArgument(KrtParser parser) {
    KrtParser probe = KrtParserFork(parser);
    bool leading_ref = KrtParserIsWord(probe, "ref");
    int64 ref_start = probe.token.start;
    if (leading_ref) { KrtLexerNext(probe.lexer, probe.token); }
    if (probe.token.kind != KrtTokenKind.Identifier) { return KrtParserParseExpression(parser, 1); }
    int64 name_start = probe.token.start; int64 name_length = probe.token.length;
    KrtLexerNext(probe.lexer, probe.token);
    if (!KrtParserTokenText(probe, 58)) { return KrtParserParseExpression(parser, 1); }
    // A validated label commits the probe; expressions and siblings retain source order.
    KrtParserCommit(parser, probe); KrtLexerNext(parser.lexer, parser.token);
    KrtAstNode argument = KrtParserParseExpression(parser, 1);
    if (leading_ref) {
        KrtAstNode reference = KrtAstMakeUnary(200, argument);
        reference.start = ref_start; reference.length = argument.start + argument.length - ref_start;
        argument = reference;
    }
    argument.syntax_argument_name_start = name_start; argument.syntax_argument_name_length = name_length;
    return argument;
}

KrtAstNode KrtParserParsePrimary(KrtParser parser) {
