bool KrtParserTokenText(KrtParser parser, byte expected) {
    if (expected == 42 && parser.token.kind == KrtTokenKind.Power) { KrtParserSplitStars(parser); }
    if (parser.token.category != KrtTokenCategory.Punctuation || parser.token.length != 1) { return false; }
    unsafe(using krt.mem;) { return ((byte*)parser.lexer.source)[parser.token.start] == expected; }
}

bool KrtParserTokenText2(KrtParser parser, byte first, byte second) {
    if (parser.token.category != KrtTokenCategory.Punctuation || parser.token.length != 2) { return false; }
    unsafe(using krt.mem;) {
        byte* source = (byte*)parser.lexer.source;
        return source[parser.token.start] == first && source[parser.token.start + 1] == second;
