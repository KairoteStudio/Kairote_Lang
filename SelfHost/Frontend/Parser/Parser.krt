// ** is one lexical token. In type suffixes and unary indirection the parser
// consumes its stars separately, just as it consumes nested generic closers.
void KrtParserSplitStars(KrtParser parser) {
    if (parser.token.kind != KrtTokenKind.Power) { return; }
