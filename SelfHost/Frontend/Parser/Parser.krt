    else if (token.category == KrtTokenCategory.Identifier && KrtParserIsWord(parser, "null")) { kind = KrtAstKind.Null; }
    else if (token.category == KrtTokenCategory.Identifier) { kind = KrtAstKind.Identifier; }
    else if (token.category == KrtTokenCategory.Character) { kind = KrtAstKind.Integer; }
