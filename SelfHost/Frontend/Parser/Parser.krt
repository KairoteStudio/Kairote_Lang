                    while (parameter > 0) {
                        method.parameter_starts[parameter] = method.parameter_starts[parameter - 1];
                        method.parameter_lengths[parameter] = method.parameter_lengths[parameter - 1];
                        method.parameter_type_starts[parameter] = method.parameter_type_starts[parameter - 1];
                        method.parameter_type_lengths[parameter] = method.parameter_type_lengths[parameter - 1];
                        method.parameter_refs[parameter] = method.parameter_refs[parameter - 1]; parameter = parameter - 1;
                    }
                    method.parameter_starts[0] = result.name_start; method.parameter_lengths[0] = 0;
                    method.parameter_type_starts[0] = result.name_start; method.parameter_type_lengths[0] = result.name_length;
                    method.parameter_refs[0] = false; method.parameter_count = method.parameter_count + 1;
