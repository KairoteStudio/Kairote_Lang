    }
    if (!KrtParserTokenText(parser, 125)) { KrtParserRecordError(parser); }
    else { KrtLexerNext(parser.lexer, parser.token); }
    if (KrtParserTokenText(parser, 59)) { KrtLexerNext(parser.lexer, parser.token); }
    result.length = parser.token.start - start;
