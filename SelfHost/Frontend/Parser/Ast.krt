enum KrtAstKind { Invalid = 0, Program = 1, Function = 2, Block = 3, Return = 4, Integer = 5, Identifier = 6, String = 7, Binary = 8, Unary = 9, Type = 10, Variable = 11, Call = 12, If = 13, While = 14, Member = 15, Assign = 16, Expression = 17, New = 18, StackAlloc = 19, Index = 20, Boolean = 21, Cast = 22, Unsafe = 23, Delete = 24, Ternary = 25, Null = 26, Break = 27, Continue = 28, DoWhile = 29, For = 30, CompoundAssign = 31, ArrayLiteral = 32, Switch = 33, Case = 34, Default = 35, Foreach = 36, Try = 37, Catch = 38, Finally = 39, Throw = 40, Lambda = 41, YieldReturn = 42, YieldBreak = 43, Lock = 44, Await = 45, Fixed = 46, Sizeof = 47, DefaultValue = 48, TypeDeclaration = 49, Floating = 50, Print = 51, Point = 52, UsingDirective = 53, TypeTest = 54, NamespaceDeclaration = 55 }

// AST nodes own child arrays; token spans continue to borrow source storage.
class KrtAstNode {
    public KrtAstKind kind;
    public int64 start;
    public int64 length;
    public int32 child_count;
    public KrtAstNode left;
    public KrtAstNode right;
    public KrtAstNode next;
    public KrtAstNode alternate;
    // Loop bodies must not share the sibling-list link.
    public KrtAstNode body;
    public KrtAstNode declarations;
    public int32 op;
    public bool grouped;
    public int32 parameter_count;
    public int64[] parameter_starts;
    public int64[] parameter_lengths;
    public int64[] parameter_type_starts;
    public int64[] parameter_type_lengths;
    public bool[] parameter_refs;
    public int64 name_start;
    public int64 name_length;
    public int64 type_start;
    public int64 type_length;
    public KrtAstNode syntax_type;
    // Immutable source-order suffix nodes: '*' (42), '?' (63), '[]' (91).
    public KrtAstNode syntax_suffixes;
    public KrtAstNode syntax_array_size;
    public KrtAstNode syntax_parameter_types;
    // Argument labels belong to the argument, independently of member names.
    public int64 syntax_argument_name_start;
    public int64 syntax_argument_name_length;
    public int32 syntax_modifiers;
    public int32 syntax_pointer_depth;
    public int32 syntax_array_rank;
    public bool syntax_nullable;
    public int64 syntax_pointee_nullable;
    public bool syntax_wildcard;
    public KrtAstNode syntax_permissions;
    public KrtAstNode syntax_declarations;
    public int64 value;
    public int32 local_slot;
    public int32 native_argument_index;
    public int32 native_argument_slot;
    public int32 element_width;
    public KrtAstNode native_type;
    public int32 native_width;
    public int32 native_float;
    public int32 native_error;
    public int32 native_bits;
    public bool native_wide;
    public int64 native_high;
    public bool native_element_boolean;
    public int32 native_stride;
    public int32 native_offset;
    public int32 native_size;
    public bool native_ref;
    public bool native_aggregate;
    public int32 native_storage_size;
    public int32 native_alignment;
    public int32 native_fixed_length;
    public KrtAstNode native_element_type;
    public int32 native_layout_state;
    public int32 native_frame_offset;
    public int32 native_argument_frame_offset;
    public int32 native_receiver_frame_offset;
    public int32 native_frame_bytes;
    public int32 native_hidden_result_slot;
    public int32 native_locals;
    public bool native_bound;
    public bool native_unsigned;
    public bool native_element_unsigned;
    public bool native_element_string;
    public bool native_boolean;
    public bool native_character;
    public bool native_element_character;
    public bool native_void_pointer;
    public bool native_array;
    public int32 native_pointer_depth;
    public bool native_nullable;
    public uint64 native_pointee_nullable;
    public int32 native_base_width;
    public bool native_string;
    public int32 native_global;
    public KrtNativeGlobalState native_globals;
    public KrtAstNode native_function_pointer;
    public bool native_static;
    public bool native_readonly;
    public KrtAstNode native_scope;
    public KrtUsingScope native_using_scope;
    public KrtGenericRegistry native_generic_registry;
    public KrtInheritanceStack native_inheritance_stack;
    public KrtAstNode native_context;
    public KrtAstNode native_generic_parameters;
    public KrtAstNode native_constraints;
    public int32 native_constraint_depth;
    public KrtAstNode native_type_arguments;
    public KrtAstNode native_generic_origin;
    public KrtAstNode native_instances;
    public KrtAstNode native_owner;
    public KrtAstNode native_target;
    public KrtAstNode native_external_next;
    public KrtAstNode native_base;
    public KrtAstNode native_interfaces;
    public KrtAstNode native_base_call;
    public int32 native_inheritance_state;
    public bool native_virtual;
    public bool native_override;
    public bool native_abstract;
    public KrtAstNode native_dispatch_slot;
    public int32 native_dispatch_state;
}

KrtAstNode KrtAstMakeBinary(int32 operation, KrtAstNode left, KrtAstNode right) {
    KrtAstNode node = KrtAstMake(KrtAstKind.Binary, left.start, right.start + right.length - left.start);
    node.op = operation;
    node.left = left;
    node.right = right;
    node.child_count = 2;
    return node;
}

KrtAstNode KrtAstMakeUnary(int32 operation, KrtAstNode operand) {
    KrtAstNode node = KrtAstMake(KrtAstKind.Unary, operand.start, operand.length);
    node.op = operation;
    node.left = operand;
    node.child_count = 1;
    return node;
}

KrtAstNode KrtAstMake(KrtAstKind kind, int64 start, int64 length) {
    KrtAstNode node = new KrtAstNode();
    node.kind = kind;
    node.start = start;
    node.length = length;
    node.child_count = 0;
    node.local_slot = -1;
    node.native_argument_index = -1;
    node.native_argument_slot = -1;
    node.native_frame_offset = -1; node.native_argument_frame_offset = -1; node.native_hidden_result_slot = -1;
    node.native_receiver_frame_offset = -1;
    node.native_width = 8;
    return node;
}

bool KrtAstIsLeaf(KrtAstNode node) {
    if (node == null) { return false; }
    return node.kind == KrtAstKind.Integer || node.kind == KrtAstKind.Boolean || node.kind == KrtAstKind.Identifier || node.kind == KrtAstKind.String;
}
