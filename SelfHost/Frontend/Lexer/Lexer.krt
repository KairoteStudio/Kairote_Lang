KrtTokenKind KrtLexerPunctuationKind(KrtLexer lexer, ref int32 length) {
    int64 first = lexer_at(lexer, 0); int64 second = lexer_at(lexer, 1); int64 third = lexer_at(lexer, 2);
    length = 1;
    if (first == 43) {
        if (second == 43) { length = 2; return KrtTokenKind.Increment; }
        if (second == 61) { length = 2; return KrtTokenKind.PlusAssign; }
        return KrtTokenKind.Plus;
    }
    if (first == 45) {
        if (second == 45) { length = 2; return KrtTokenKind.Decrement; }
        if (second == 61) { length = 2; return KrtTokenKind.MinusAssign; }
        if (second == 62) { length = 2; return KrtTokenKind.Arrow; }
        return KrtTokenKind.Minus;
    }
    if (first == 42) {
        if (second == 61) { length = 2; return KrtTokenKind.MulAssign; }
        if (second == 42) { length = 2; return KrtTokenKind.Power; }
        return KrtTokenKind.Multiply;
    }
    if (first == 47) {
        if (second == 61) { length = 2; return KrtTokenKind.DivAssign; }
        return KrtTokenKind.Divide;
    }
    if (first == 37) {
        if (second == 61) { length = 2; return KrtTokenKind.ModAssign; }
        return KrtTokenKind.Modulo;
    }
    if (first == 61) {
        if (second == 61) { length = 2; return KrtTokenKind.Equal; }
        if (second == 62) { length = 2; return KrtTokenKind.Lambda; }
        return KrtTokenKind.Assign;
    }
    if (first == 33) {
        if (second == 61) { length = 2; return KrtTokenKind.NotEqual; }
        return KrtTokenKind.Not;
    }
    if (first == 60) {
        if (second == 60 && third == 61) { length = 3; return KrtTokenKind.LshiftAssign; }
        if (second == 61) { length = 2; return KrtTokenKind.LessEqual; }
        if (second == 60) { length = 2; return KrtTokenKind.Lshift; }
        return KrtTokenKind.Less;
    }
    if (first == 62) {
        if (second == 62 && third == 61) { length = 3; return KrtTokenKind.RshiftAssign; }
        if (second == 61) { length = 2; return KrtTokenKind.GreaterEqual; }
        if (second == 62) { length = 2; return KrtTokenKind.Rshift; }
        return KrtTokenKind.Greater;
    }
    if (first == 38) {
        if (second == 38) { length = 2; return KrtTokenKind.And; }
        if (second == 61) { length = 2; return KrtTokenKind.AndAssign; }
        return KrtTokenKind.BitwiseAnd;
    }
    if (first == 124) {
        if (second == 124) { length = 2; return KrtTokenKind.Or; }
        if (second == 61) { length = 2; return KrtTokenKind.OrAssign; }
        return KrtTokenKind.Pipe;
    }
    if (first == 94) {
        if (second == 61) { length = 2; return KrtTokenKind.XorAssign; }
        return KrtTokenKind.BitwiseXor;
    }
    if (first == 40) {
        return KrtTokenKind.LeftParen;
    }
    if (first == 41) {
        return KrtTokenKind.RightParen;
    }
    if (first == 36) {
        return KrtTokenKind.Dollar;
    }
    if (first == 123) {
        return KrtTokenKind.LeftBrace;
    }
    if (first == 125) {
        return KrtTokenKind.RightBrace;
    }
    if (first == 91) {
        return KrtTokenKind.LeftBracket;
    }
    if (first == 93) {
        return KrtTokenKind.RightBracket;
    }
    if (first == 44) {
        return KrtTokenKind.Comma;
    }
    if (first == 59) {
        return KrtTokenKind.Semicolon;
    }
    if (first == 58) {
        if (second == 58) { length = 2; return KrtTokenKind.DoubleColon; }
        return KrtTokenKind.Colon;
    }
    if (first == 46) {
        return KrtTokenKind.Dot;
    }
    if (first == 63) {
        if (second == 58) { length = 2; return KrtTokenKind.QuestionColon; }
        if (second == 63) { length = 2; return KrtTokenKind.NullCoalescing; }
        if (second == 46) { length = 2; return KrtTokenKind.QuestionDot; }
        return KrtTokenKind.Question;
    }
    if (first == 126) {
        return KrtTokenKind.Tilde;
    }
    return KrtTokenKind.Unknown;
}
