        if (bits == 120) { return KrtTokenKind.Int120; }
        if (bits == 122) { return KrtTokenKind.Int122; }
        if (bits == 124) { return KrtTokenKind.Int124; }
        if (bits == 126) { return KrtTokenKind.Int126; }
        if (bits == 128) { return KrtTokenKind.Int128; }
    }
    return KrtTokenKind.Eof;
}

bool KrtLexerWordEqual(int64 source, int64 start, int64 length, string word, int64 word_length) {
    if (length != word_length) { return false; }
    unsafe(using krt.mem;) {
        byte* bytes = (byte*)source; byte* expected = (byte*)(int64)word;
        int64 index = 0;
        while (index < length) { if (bytes[start + index] != expected[index]) { return false; } index = index + 1; }
    }
    return true;
}

KrtTokenKind KrtLexerWordKind(int64 source, int64 start, int64 length) {
    unsafe(using krt.mem;) {
        byte* bytes = (byte*)source; int64 index = start; int64 end = start + length;
        bool unsigned_value = index < end && bytes[index] == 117;
        if (unsigned_value) { index = index + 1; }
        if (index + 3 < end && bytes[index] == 105 && bytes[index + 1] == 110 && bytes[index + 2] == 116 && bytes[index + 3] != 48) {
            index = index + 3; int32 width = 0;
            while (index < end && bytes[index] >= 48 && bytes[index] <= 57 && width <= 128) { width = width * 10 + bytes[index] - 48; index = index + 1; }
            if (index == end && width >= 2 && width <= 128 && width % 2 == 0) { return KrtTokenIntegerType(width, unsigned_value); }
        }
        if (length == 0) { return KrtTokenKind.Identifier; }
        int64 first = bytes[start];
        if (first == 95) {
            if (KrtLexerWordEqual(source, start, length, "_", 1)) { return KrtTokenKind.Underscore; }
        }
        if (first == 97) {
            if (KrtLexerWordEqual(source, start, length, "async", 5)) { return KrtTokenKind.Async; }
            if (KrtLexerWordEqual(source, start, length, "await", 5)) { return KrtTokenKind.Await; }
            if (KrtLexerWordEqual(source, start, length, "abstract", 8)) { return KrtTokenKind.Abstract; }
            if (KrtLexerWordEqual(source, start, length, "as", 2)) { return KrtTokenKind.As; }
        }
        if (first == 98) {
            if (KrtLexerWordEqual(source, start, length, "byte", 4)) { return KrtTokenKind.Uint8; }
            if (KrtLexerWordEqual(source, start, length, "base", 4)) { return KrtTokenKind.Base; }
            if (KrtLexerWordEqual(source, start, length, "break", 5)) { return KrtTokenKind.Break; }
            if (KrtLexerWordEqual(source, start, length, "bool", 4)) { return KrtTokenKind.Bool; }
            if (KrtLexerWordEqual(source, start, length, "by", 2)) { return KrtTokenKind.By; }
        }
        if (first == 99) {
            if (KrtLexerWordEqual(source, start, length, "class", 5)) { return KrtTokenKind.Class; }
            if (KrtLexerWordEqual(source, start, length, "catch", 5)) { return KrtTokenKind.Catch; }
            if (KrtLexerWordEqual(source, start, length, "case", 4)) { return KrtTokenKind.Case; }
            if (KrtLexerWordEqual(source, start, length, "continue", 8)) { return KrtTokenKind.Continue; }
            if (KrtLexerWordEqual(source, start, length, "char", 4)) { return KrtTokenKind.Char; }
            if (KrtLexerWordEqual(source, start, length, "console", 7)) { return KrtTokenKind.Console; }
            if (KrtLexerWordEqual(source, start, length, "const", 5)) { return KrtTokenKind.Const; }
        }
        if (first == 100) {
            if (KrtLexerWordEqual(source, start, length, "do", 2)) { return KrtTokenKind.Do; }
            if (KrtLexerWordEqual(source, start, length, "delete", 6)) { return KrtTokenKind.Delete; }
            if (KrtLexerWordEqual(source, start, length, "default", 7)) { return KrtTokenKind.Default; }
            if (KrtLexerWordEqual(source, start, length, "double", 6)) { return KrtTokenKind.Float64; }
            if (KrtLexerWordEqual(source, start, length, "delegate", 8)) { return KrtTokenKind.Delegate; }
        }
        if (first == 101) {
            if (KrtLexerWordEqual(source, start, length, "else", 4)) { return KrtTokenKind.Else; }
            if (KrtLexerWordEqual(source, start, length, "enum", 4)) { return KrtTokenKind.Enum; }
            if (KrtLexerWordEqual(source, start, length, "exception", 9)) { return KrtTokenKind.Exception; }
            if (KrtLexerWordEqual(source, start, length, "equals", 6)) { return KrtTokenKind.Equals; }
            if (KrtLexerWordEqual(source, start, length, "extern", 6)) { return KrtTokenKind.Extern; }
        }
        if (first == 102) {
            if (KrtLexerWordEqual(source, start, length, "function", 8)) { return KrtTokenKind.Function; }
            if (KrtLexerWordEqual(source, start, length, "func", 4)) { return KrtTokenKind.Function; }
            if (KrtLexerWordEqual(source, start, length, "fn", 2)) { return KrtTokenKind.Fn; }
            if (KrtLexerWordEqual(source, start, length, "for", 3)) { return KrtTokenKind.For; }
            if (KrtLexerWordEqual(source, start, length, "foreach", 7)) { return KrtTokenKind.Foreach; }
            if (KrtLexerWordEqual(source, start, length, "false", 5)) { return KrtTokenKind.False; }
            if (KrtLexerWordEqual(source, start, length, "fixed", 5)) { return KrtTokenKind.Fixed; }
            if (KrtLexerWordEqual(source, start, length, "finally", 7)) { return KrtTokenKind.Finally; }
            if (KrtLexerWordEqual(source, start, length, "float", 5)) { return KrtTokenKind.Float32; }
            if (KrtLexerWordEqual(source, start, length, "float32", 7)) { return KrtTokenKind.Float32; }
            if (KrtLexerWordEqual(source, start, length, "float64", 7)) { return KrtTokenKind.Float64; }
            if (KrtLexerWordEqual(source, start, length, "from", 4)) { return KrtTokenKind.From; }
        }
        if (first == 103) {
            if (KrtLexerWordEqual(source, start, length, "get", 3)) { return KrtTokenKind.Get; }
            if (KrtLexerWordEqual(source, start, length, "group", 5)) { return KrtTokenKind.Group; }
        }
        if (first == 105) {
            if (KrtLexerWordEqual(source, start, length, "if", 2)) { return KrtTokenKind.If; }
            if (KrtLexerWordEqual(source, start, length, "in", 2)) { return KrtTokenKind.In; }
            if (KrtLexerWordEqual(source, start, length, "interface", 9)) { return KrtTokenKind.Interface; }
            if (KrtLexerWordEqual(source, start, length, "int", 3)) { return KrtTokenKind.Int32; }
            if (KrtLexerWordEqual(source, start, length, "into", 4)) { return KrtTokenKind.Into; }
            if (KrtLexerWordEqual(source, start, length, "is", 2)) { return KrtTokenKind.Is; }
        }
        if (first == 106) {
            if (KrtLexerWordEqual(source, start, length, "join", 4)) { return KrtTokenKind.Join; }
        }
        if (first == 108) {
            if (KrtLexerWordEqual(source, start, length, "let", 3)) { return KrtTokenKind.Let; }
            if (KrtLexerWordEqual(source, start, length, "long", 4)) { return KrtTokenKind.Int64; }
