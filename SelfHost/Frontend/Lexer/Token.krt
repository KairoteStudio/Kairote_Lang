// Identifier covers identifier-shaped words; kind distinguishes reserved words.
// Re.KrtC NUMBER includes integer/floating spellings, distinguished by category.
enum KrtTokenCategory { Eof = 0, Identifier = 1, Integer = 2, String = 3, Character = 4, Punctuation = 5, Invalid = 6, Floating = 7 }

KrtTokenCategory KrtTokenCategoryForKind(KrtTokenKind value) {
    if (value == KrtTokenKind.Eof) { return KrtTokenCategory.Eof; }
    if (value == KrtTokenKind.Number) { return KrtTokenCategory.Integer; }
    if (value == KrtTokenKind.String) { return KrtTokenCategory.String; }
    if (value == KrtTokenKind.CharLiteral) { return KrtTokenCategory.Character; }
    if (value == KrtTokenKind.Unknown) { return KrtTokenCategory.Invalid; }
    if ((value >= KrtTokenKind.Plus && value <= KrtTokenKind.Dollar) ||
        (value >= KrtTokenKind.And && value <= KrtTokenKind.Not) ||
        (value >= KrtTokenKind.Increment && value <= KrtTokenKind.ModAssign) ||
        (value >= KrtTokenKind.Tilde && value <= KrtTokenKind.Rshift) ||
        value == KrtTokenKind.Power ||
        (value >= KrtTokenKind.Question && value <= KrtTokenKind.QuestionDot) ||
        value == KrtTokenKind.Lambda ||
        value == KrtTokenKind.Attribute ||
        (value >= KrtTokenKind.AndAssign && value <= KrtTokenKind.RshiftAssign)) { return KrtTokenCategory.Punctuation; }
    return KrtTokenCategory.Identifier;
}

class KrtToken {
    public KrtTokenKind kind;
    public KrtTokenCategory category;
    public int64 start;
    public int64 length;
    public int64 line;
    public int64 column;
    public int32 error;

    public void Reset(int64 source_start, int64 source_line, int64 source_column) {
        start = source_start; length = 0; line = source_line; column = source_column;
        error = 0; kind = KrtTokenKind.Eof; category = KrtTokenCategory.Eof;
    }
    public void SetKind(KrtTokenKind value) { kind = value; category = KrtTokenCategoryForKind(value); }
    public void SetCategory(KrtTokenCategory value) {
        category = value;
        if (value == KrtTokenCategory.Floating) { kind = KrtTokenKind.Number; }
    }
    public void SetError(int32 value) { error = value; kind = KrtTokenKind.Unknown; category = KrtTokenCategory.Invalid; }
    public void SetLength(int64 value) { length = value; }
}

void Reset(KrtToken token, int64 source_start, int64 source_line, int64 source_column) {
    token.start = source_start; token.length = 0; token.line = source_line; token.column = source_column;
    token.error = 0; token.kind = KrtTokenKind.Eof; token.category = KrtTokenCategory.Eof;
}
void SetKind(KrtToken token, KrtTokenKind value) { token.kind = value; token.category = KrtTokenCategoryForKind(value); }
void SetCategory(KrtToken token, KrtTokenCategory value) {
    token.category = value;
    if (value == KrtTokenCategory.Floating) { token.kind = KrtTokenKind.Number; }
}
void SetError(KrtToken token, int32 value) { token.error = value; token.kind = KrtTokenKind.Unknown; token.category = KrtTokenCategory.Invalid; }
void SetLength(KrtToken token, int64 value) { token.length = value; }
