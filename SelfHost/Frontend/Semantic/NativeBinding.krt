                int32 score = KrtNativeFunctionScopeScore(candidate, node.left, binding);
                if (candidate.native_owner != null && owner != null) { score = score - KrtNativeInheritanceDistance(owner, candidate.native_owner); }
                if (specialized == null) { score = -1; if (binding.candidate_error != 0) { failure_kind = binding.candidate_error; } }
                int32 index = extra; argument = node.right;
                while (argument != null && score >= 0) {
                    binding.candidate_error = 0;
                    int32 argument_score = KrtNativeArgumentScore(argument, specialized, index, binding);
                    if (argument_score < 0) { score = -1; if (binding.candidate_error != 0) { failure_kind = binding.candidate_error; } } else { score = score + argument_score; }
                    index = index + 1; argument = argument.next;
                }
                if (score > best) { selected = specialized; best = score; ambiguous = false; }
                else if (score >= 0 && score == best) {
                    bool equivalent = selected != null && selected.native_owner != null && candidate.native_owner != null && selected.native_owner.value == 3 && candidate.native_owner.value == 3 && KrtNativeMethodSignatureEqual(selected, candidate, binding.module, binding.source, true);
                    if (!equivalent) { ambiguous = true; }
