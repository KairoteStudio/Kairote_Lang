// Native binding keeps lexical names separate from AST sibling links.
class KrtNativeName {
    public int64 start;
    public int64 length;
    public KrtAstNode declaration;
    public int32 slot;
    public bool by_ref;
    public int32 depth;
    public KrtNativeName next;
}

class KrtNativeBinding {
    public KrtAstNode module;
    public KrtAstNode unit;
    public KrtAstNode catch_target;
    public int32 constant_depth;
    public int32 candidate_error;
    public int64 source;
    public KrtNativeName names;
    public int32 slots;
    public int32 depth;
    public int64 error_start;
}

bool KrtNativeSpanWord(int64 source, int64 start, int64 length, string word) {
    unsafe(using krt.mem;) {
        byte* input = (byte*)source;
        byte* text = (byte*)(int64)word;
        int64 index = 0;
        while (index < length && text[index] != 0) {
            if (input[start + index] != text[index]) { return false; }
            index = index + 1;
        }
        return index == length && text[index] == 0;
    }
}

KrtAstNode KrtNativeFindType(KrtAstNode module, int64 source, int64 start, int64 length) {
    return KrtNativeFindScopedType(module, source, start, length, null);
}

void KrtNativeCopyType(KrtAstNode target, KrtAstNode original) {
    target.native_function_pointer = original.native_function_pointer;
    target.native_bits = original.native_bits; target.native_wide = original.native_wide; target.native_element_boolean = original.native_element_boolean;
    target.native_float = original.native_float;
    target.native_type = original.native_type;
    target.native_width = original.kind == KrtAstKind.Member && original.element_width > 0 ? original.element_width : original.native_width;
    target.native_stride = KrtNativeSemanticStride(original);
    target.native_size = original.native_size;
    target.native_void_pointer = original.native_void_pointer;
    target.native_unsigned = original.native_unsigned;
    target.native_element_unsigned = original.native_element_unsigned;
    target.native_boolean = original.native_boolean;
    target.native_string = original.native_string; target.native_element_string = original.native_element_string;
    target.native_array = original.kind == KrtAstKind.Index ? false : original.native_array;
}

bool KrtNativeAnnotateType(KrtAstNode node, KrtAstNode module, int64 source, int64 start, int64 length) {
