        KrtNativeSpanWord(source, start, base_length, "uint16") || KrtNativeSpanWord(source, start, base_length, "uint32") || KrtNativeSpanWord(source, start, base_length, "uint64") || KrtNativeSpanWord(source, start, base_length, "uint128");
