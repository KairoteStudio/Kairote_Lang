            (candidate.native_owner == owner || KrtNativeDerivesFrom(owner, candidate.native_owner) || (!static_receiver && candidate.native_owner == null)) &&
            !(owner != null && owner.value == 1 && candidate.native_owner != null && candidate.native_owner.value == 3)) {
            found_name = true;
            bool instance = candidate.native_owner != null && !candidate.native_static;
            bool extension = explicit_member && !static_receiver && candidate.native_owner == null;
            int32 extra = instance || extension ? 1 : 0;
            bool receiver_valid = !(instance && (static_receiver || (!explicit_member && binding.unit.native_static)));
            if (receiver_valid && candidate.parameter_count == node.parameter_count + extra) {
                found_arity = true;
