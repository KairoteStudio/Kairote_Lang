// Index nodes retain their address scale separately from their result type.
int32 KrtNativeSemanticStride(KrtAstNode node) {
    if (node.kind == KrtAstKind.Index) { return node.native_string ? 1 : 0; }
    return node.native_stride;
}

// Literal casts remain eligible for the numeric coercions used by the standard library.
bool KrtNativeLiteralArgument(KrtAstNode node) {
    if (node == null) { return false; }
    if (node.kind == KrtAstKind.Integer || node.kind == KrtAstKind.Floating || node.kind == KrtAstKind.Boolean) { return true; }
    if (node.kind == KrtAstKind.Cast || (node.kind == KrtAstKind.Unary && (node.op == 43 || node.op == 45))) { return KrtNativeLiteralArgument(node.left); }
    return false;
}
