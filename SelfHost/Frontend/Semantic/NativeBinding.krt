    if (!KrtNativeContextArguments(node.right, selected, argument_index, binding)) { return false; }
    KrtAstNode result_type = KrtAstMake(KrtAstKind.Type, node.start, node.length);
    result_type.native_scope = selected.native_scope; result_type.native_context = selected.native_context;
    if (!KrtNativeAnnotateType(result_type, binding.module, binding.source, selected.type_start, selected.type_length)) { return KrtNativeBindingError(binding, node); }
    KrtNativeCopyType(node, result_type);
