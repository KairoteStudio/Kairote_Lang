    if (declaration == null || declaration.native_generic_parameters == null) { return false; }
    KrtAstNode projection = KrtNativeInferenceProjection(candidate.native_type,declaration);
    if (projection == null) { return false; }
    KrtAstNode pattern = last.left.left; KrtAstNode argument = projection.native_type_arguments;
    while (pattern != null && argument != null) {
        if (!KrtNativeInferPattern(pattern,argument,state,depth + 1)) { return false; }
        pattern = pattern.next; argument = argument.next;
    }
    return pattern == null && argument == null;
}

KrtAstNode KrtNativeInferTypeArguments(KrtAstNode function_node, KrtAstNode arguments, int32 extra, KrtNativeBinding binding) {
    KrtAstNode result = null; KrtAstNode tail = null; KrtAstNode generic_parameter = function_node.native_generic_parameters;
    while (generic_parameter != null) {
        KrtGenericInference state = new KrtGenericInference(); state.parameter = generic_parameter;
        state.declaration = function_node; state.binding = binding;
        int32 index = extra;
        while (index < function_node.parameter_count) {
            KrtAstNode argument = arguments;
            while (argument != null && argument.native_argument_index != index) { argument = argument.next; }
            if (argument == null) { return null; }
            bool reference = argument.kind == KrtAstKind.Unary && argument.op == 200;
            if (reference != function_node.parameter_refs[index]) { return null; }
            KrtAstNode actual = argument; if (reference) { actual = argument.left; }
            KrtAstNode formal = KrtNativeInferenceFormal(function_node,index,binding.source);
            if (!KrtNativeInferPattern(formal,actual,state,0)) { return null; }
            index = index + 1;
        }
        if (state.inferred == null) { return null; }
        if (result == null) { result = state.inferred; } else { tail.next = state.inferred; } tail = state.inferred;
        generic_parameter = generic_parameter.next;
    }
    return result;
}

KrtAstNode KrtNativeSpecializeCall(KrtAstNode candidate, KrtAstNode node, int32 extra, KrtNativeBinding binding) {
    if (candidate.native_generic_parameters == null) {
        if (node.left.native_type_arguments != null && candidate.native_generic_origin == null) { return null; }
        return candidate;
    }
    KrtAstNode arguments = null;
    if (node.left.native_type_arguments != null) {
        KrtAstNode source_arguments = node.left.native_type_arguments;
        arguments = KrtNativeParseTypeArguments(node, binding.module, binding.source, source_arguments.type_start, source_arguments.type_length);
    } else {
        KrtAstNode supplied = node.right; int32 first_parameter = extra;
        if (extra == 1 && candidate.native_owner == null && node.left.kind == KrtAstKind.Member) {
            // Extension syntax omits its receiver from the ordinary argument
            // list, but that receiver still participates in type inference.
            KrtAstNode receiver = node.left.left;
            supplied = KrtAstMake(KrtAstKind.Type,receiver.start,receiver.length);
            KrtNativeCopyType(supplied,receiver); supplied.native_argument_index = 0; supplied.next = node.right; first_parameter = 0;
        }
        arguments = KrtNativeInferTypeArguments(candidate,supplied,first_parameter,binding);
    }
    if (arguments == null) { return null; }
    if (!KrtNativeCheckConstraints(candidate, arguments, binding.module, binding.source)) { binding.candidate_error = 6; return null; }
    return KrtNativeInstantiateFunction(candidate, arguments, binding.module);
}

bool KrtNativeIsTemplate(KrtAstNode function_node) {
    return function_node.native_generic_parameters != null ||
        (function_node.native_owner != null && function_node.native_owner.native_generic_parameters != null);
}

bool KrtNativePrepareModule(KrtAstNode module, int64 source, KrtNativeModule output) {
    if (!KrtNativePrepareExternals(module, source, output)) { return false; }
    KrtNativeGlobalState state = module.native_globals;
    bool changed = true; int32 passes = 0;
    while (changed && passes < 16384) {
        state.changed = false; changed = false;
        KrtAstNode function_node = module.left; int32 count = 0; bool all_bound = true;
        while (function_node != null && count < 16384) {
            if (function_node.op != 221 && !KrtNativeIsTemplate(function_node) && !function_node.native_bound) {
                module.native_error = 0;
                if (!KrtNativeBindFunction(function_node, module, source)) {
                    if (all_bound) { output.error_start = function_node.native_offset; }
                    KrtNativeBindingDiagnostic(module,function_node.native_offset); all_bound = false;
                }
                changed = true;
            }
            function_node = function_node.next; count = count + 1;
        }
        if (!all_bound) { return false; }
        if (function_node != null || !KrtNativeBindGlobalInitializers(module, source)) { return false; }
        changed = changed || state.changed;
        if (!changed) {
            // Bind all signatures before slots: forward derived references must
            // not recursively validate an incomplete base dispatch table.
            int32 instances_before = module.native_locals;
            KrtAstNode dispatch_type = module.declarations;
            while (dispatch_type != null) {
                if (!KrtNativePrepareDispatch(dispatch_type, module, source)) { output.error_start = dispatch_type.start; return false; }
                dispatch_type = dispatch_type.next;
            }
            // Any specialization discovered by signature comparison must also
            // finish binding before function indices and symbols are assigned.
            changed = module.native_locals != instances_before;
        }
        passes = passes + 1;
    }
    if (changed || !KrtNativeFinishGlobals(module)) { return false; }
    if(!KrtNativePrepareExternals(module,source,output)){return false;}
    KrtAstNode previous = null; KrtAstNode function_node = module.left;
    while (function_node != null) {
        KrtAstNode next = function_node.next;
        if (function_node.op == 221 || KrtNativeIsTemplate(function_node)) {
            if (previous == null) { module.left = next; } else { previous.next = next; }
            module.child_count = module.child_count - 1;
        } else { previous = function_node; }
        function_node = next;
    }
    return true;
}
