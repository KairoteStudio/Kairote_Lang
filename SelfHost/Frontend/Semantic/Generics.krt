bool KrtNativePrepareModule(KrtAstNode module, int64 source, KrtNativeModule output) {
    if (!KrtNativePrepareExternals(module, source, output)) { return false; }
    KrtNativeGlobalState state = module.native_globals;
    bool changed = true; int32 passes = 0;
    while (changed && passes < 1024) {
        state.changed = false; changed = false;
        KrtAstNode function_node = module.left; int32 count = 0;
        while (function_node != null && count < 1024) {
