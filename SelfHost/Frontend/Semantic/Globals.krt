KrtAstNode KrtNativeFindGlobalExpression(KrtAstNode node, KrtNativeBinding binding) {
    if (node.kind == KrtAstKind.Identifier) { return KrtNativeFindGlobal(binding, node.start, node.length); }
    if (node.kind != KrtAstKind.Member) { return null; }
    KrtAstNode first = node;
    while (first.kind == KrtAstKind.Member) { first = first.left; }
    if (first.kind != KrtAstKind.Identifier || KrtNativeFindName(binding, first.start, first.length) != null) { return null; }
    return KrtNativeFindGlobal(binding, first.start, node.name_start + node.name_length - first.start);
