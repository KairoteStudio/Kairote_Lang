    initializer.op = 230; initializer.native_static = true; initializer.native_bound = true;
    initializer.left = KrtAstMake(KrtAstKind.Block, 0, 0); state.initializer = initializer;
    return KrtNativeCollectGlobals(module, source);
}

bool KrtNativeBindGlobalInitializers(KrtAstNode module, int64 source) {
    if (!KrtNativeCollectGlobals(module, source)) { return false; }
    KrtNativeGlobalState state = module.native_globals;
    KrtAstNode initializer = state.initializer; KrtNativeGlobalEntry entry = state.first;
    while (entry != null) {
        KrtAstNode declaration = entry.declaration;
