        if(offset<0||entry.storage_size>16777216-offset){state.output.error_start=declaration.start;return false;}
        declaration.native_global=offset/8+1;state.output.global_count=(offset+entry.storage_size+7)/8;
        if(state.output.global_count>65536){state.output.error_start=declaration.start;return false;}
        entry.symbol_name=KrtModuleGlobalName(declaration,owner,source,71);entry.guard_name=KrtModuleGlobalName(declaration,owner,source,74);
        entry.initializer_name=KrtModuleGlobalName(declaration,owner,source,76);
        if(!entry.symbol_name.valid||!entry.guard_name.valid||!entry.initializer_name.valid){state.output.error_start=declaration.start;return false;}
        entry.imported=declaration.native_imported||(owner!=null&&owner.native_imported)||(declaration.syntax_modifiers&1024)!=0;
        entry.weak=owner!=null&&owner.native_generic_origin!=null&&(declaration.syntax_modifiers&1024)==0;
        entry.guard_slot=state.output.global_count;
        state.output.global_count=state.output.global_count+2;
        if(state.output.global_count>65536){state.output.error_start=declaration.start;return false;}
    }
    return true;
}

bool KrtNativeCollectGlobals(KrtAstNode module, int64 source) {
    KrtAstNode owner = null; KrtAstNode declaration = module.body;
    while (true) {
        while (declaration != null) {
            if ((owner == null || declaration.native_static) &&
                !KrtNativeRegisterGlobal(declaration, owner, module, source)) { return false; }
            declaration = declaration.next;
        }
        if (owner == null) { owner = module.declarations; } else { owner = owner.next; }
        while (owner != null && owner.native_generic_parameters != null) { owner = owner.next; }
        if (owner == null) { break; }
        declaration = owner.body;
    }
    return true;
}

bool KrtNativePrepareGlobals(KrtAstNode module, int64 source, KrtNativeModule output) {
    KrtNativeGlobalState state = new KrtNativeGlobalState(); state.output = output; module.native_globals = state;
    output.initializer_guard_slot=-1;
