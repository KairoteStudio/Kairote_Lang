KrtAstNode KrtNativeFindGlobal(KrtNativeBinding binding, int64 start, int64 length) {
    KrtAstNode scope = binding.unit.native_scope; KrtAstNode hidden = null;
    while (true) {
        KrtAstNode declaration = binding.module.body; KrtAstNode chosen = null; int32 best = 0;
        while (declaration != null) {
            if (KrtDeclarationMatches(declaration, scope, binding.source, start, length)) {
                int32 priority = KrtNativeNameFilePriority(declaration,binding.unit.start);
                if (priority > best) { chosen = declaration; best = priority; }
