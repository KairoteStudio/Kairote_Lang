        }
        if (chosen != null) { return chosen; }
        if (scope == null) { break; }
        scope = scope.left;
    }
    scope = binding.unit.native_scope;
    KrtAstNode found = null; KrtAstNode declaration = binding.module.body; int32 best = 0;
    while (declaration != null) {
        bool visible = KrtNativeVisibleUsingName(declaration, scope, binding.using_scope, binding.source, start, length);
        KrtUsingScope frame = binding.using_scope;
        while (frame != null) {
            KrtAstNode imported = frame.imports;
            while (imported != null) {
