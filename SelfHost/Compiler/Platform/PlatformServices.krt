// Compiler host services. This is NOT a user-syscall translation pass:
// source syscall() always uses the selected output platform's native ABI.
static int64 KrtMiniOSArguments = 0;
static int64 KrtMiniOSEnvironment = 0;

int64 KrtMiniOSPackArguments(int64 vector) {
    if (vector == 0) { return 0; }
    int64 block = KrtDriverAlloc(66568);
    if (block == 0) { return 0; }
    unsafe(using krt.mem;) {
        byte* data = (byte*)block; int64 zero = 0;
        while (zero < 66568) { data[zero] = 0; zero = zero + 1; }
        uint32* header = (uint32*)block; header[0] = 0x41524731;
        uint16* offsets = (uint16*)(block + 8); int64* values = (int64*)vector;
        int32 count = 0; int64 position = 0;
        while (values[count] != 0) {
            if (count >= 512) { return 0; }
            int64 length = KrtDriverStringLength(values[count]);
            if (length >= 65536 - position) { return 0; }
            offsets[count] = (uint16)position; byte* source = (byte*)values[count]; int64 index = 0;
            while (index < length) { data[1032 + position] = source[index]; position = position + 1; index = index + 1; }
            data[1032 + position] = 0; position = position + 1; count = count + 1;
        }
        header[1] = (uint32)count;
    }
    return block;
}

// Normalize only compiler-internal POSIX-shaped metadata to its existing ABI.
int64 KrtMiniOSStat(int64 descriptor, int64 destination) {
    unsafe(using krt.mem;) {
        int64* info = stackalloc int64[2];
        int64 result = syscall(28,descriptor,(int64)info,0,0,0,0);
        if (result < 0) { return result; }
        byte* out = (byte*)destination; int32 index = 0;
        while (index < 144) { out[index] = 0; index = index + 1; }
        int32* flags = (int32*)info;
        ((int32*)(destination + 24))[0] = flags[3] != 0 ? 16877 : (flags[2] != 0 ? 33060 : 33188);
        ((int64*)(destination + 48))[0] = info[0];
        return 0;
    }
}

int64 KrtMiniOSDirectory(int64 descriptor, int64 destination, int64 capacity) {
    if (capacity < 64) { return -22; }
    unsafe(using krt.mem;) {
        byte* entry = stackalloc byte[56];
        int64 result = syscall(20,descriptor,(int64)entry,56,0,0,0);
        if (result != 0) { return result == -2 ? 0 : result; }
        byte* out = (byte*)destination; int32 index = 0;
        while (index < 64) { out[index] = 0; index = index + 1; }
        ((int64*)out)[0] = 1; ((uint16*)(destination + 16))[0] = 64;
        out[18] = ((int32*)((int64)entry + 8))[0] != 0 ? 4 : 8;
        index = 0;
        while (index < 43 && entry[12 + index] != 0) { out[19 + index] = entry[12 + index]; index = index + 1; }
        return 64;
    }
}

int64 KrtPlatformCall(int64 number, int64 a, int64 b, int64 c, int64 d, int64 e, int64 f) {
    if (!__krt_target_minios()) { return syscall(number,a,b,c,d,e,f); }
    if (number == 0) { return syscall(2,a,b,c,0,0,0); }
    if (number == 1) { return syscall(1,a,b,c,0,0,0); }
    if (number == 2) { return syscall(18,a,b & 1731,0,0,0,0); }
    if (number == 3) { return syscall(16,a,0,0,0,0,0); }
    if (number == 4 || number == 6) {
        int64 descriptor = syscall(18,a,0,0,0,0,0);
        if (descriptor < 0) { return descriptor; }
        int64 result = KrtMiniOSStat(descriptor,b); syscall(16,descriptor,0,0,0,0,0); return result;
    }
    if (number == 5) { return KrtMiniOSStat(a,b); }
    if (number == 8) { return syscall(27,a,b,c,0,0,0); }
    if (number == 9) {
        // The VM also reaches this service boundary; preserve known Linux flags
        // rather than silently dropping MAP_FIXED or MAP_SHARED.
        if ((d & ~51) != 0) { return -38; }
        if ((d & 3) == 0 || (d & 3) == 3) { return -22; }
        int64 flags = ((d & 1) != 0 ? 2 : 1) | ((d & 16) != 0 ? 4 : 0) | ((d & 32) != 0 ? 8 : 0);
        return syscall(49,a,b,c,flags,e,f);
    }
    if (number == 11) { return syscall(50,a,b,0,0,0,0); }
    if (number == 33) { return syscall(17,a,b,0,0,0,0); }
    if (number == 39) { return syscall(3,0,0,0,0,0,0); }
    if (number == 57) { return syscall(33,0,0,0,0,0,0); }
    if (number == 59) {
        int64 block = KrtMiniOSPackArguments(b);
        if (block == 0) { return -7; }
        return syscall(75,a,block,0,0,0,0);
    }
    if (number == 60) { return syscall(0,a,0,0,0,0,0); }
    if (number == 61) {
        unsafe(using krt.mem;) {
            int32* status = stackalloc int32[1]; status[0] = 0;
            int64 result = syscall(8,a,(int64)status,c,0,0,0);
            if (result > 0 && b != 0) { ((int32*)b)[0] = (status[0] & 255) << 8; }
            return result;
        }
    }
    if (number == 79) { return syscall(38,a,b,0,0,0,0); }
    if (number == 82) { return syscall(30,a,b,0,0,0,0); }
    if (number == 83) { return syscall(35,a,0,0,0,0,0); }
    if (number == 84) { return syscall(36,a,0,0,0,0,0); }
    if (number == 87) { return syscall(19,a,0,0,0,0,0); }
    if (number == 217) { return KrtMiniOSDirectory(a,b,c); }
    // chmod/readlink and other absent services fail honestly, never succeed silently.
    return -38;
}

KrtDriverPath KrtMiniOSReadArguments() {
    if (KrtMiniOSArguments == 0) { return null; }
    KrtDriverPath result = null;
    unsafe(using krt.mem;) {
        uint32* header = (uint32*)KrtMiniOSArguments;
        if (header[0] == 0x41524731) {
            if (header[1] > 512) { return null; }
            uint16* offsets = (uint16*)(KrtMiniOSArguments + 8); int32 index = 0;
            while (index < (int32)header[1]) {
                int64 offset = offsets[index]; int64 length = 0;
                byte* text = (byte*)(KrtMiniOSArguments + 1032 + offset);
                while (offset + length < 65536 && text[length] != 0) { length = length + 1; }
                if (offset + length >= 65536) { return null; }
                result = KrtDriverAppend(result,KrtDriverCopyString((int64)text,length)); index = index + 1;
            }
            return result;
        }
        // Legacy shell launch: whitespace tokens, copied without modifying entry memory.
        byte* text = (byte*)KrtMiniOSArguments; int64 position = 0;
        while (text[position] != 0) {
            while (text[position] == 32 || text[position] == 9) { position = position + 1; }
            int64 start = position;
            while (text[position] != 0 && text[position] != 32 && text[position] != 9) { position = position + 1; }
            if (position > start) { result = KrtDriverAppend(result,KrtDriverCopyString(KrtMiniOSArguments + start,position - start)); }
        }
    }
    return result;
}

int64 KrtMiniOSGetEnv(string name) {
    if (KrtMiniOSEnvironment == 0) { return (int64)""; }
    int64 length = KrtDriverStringLength((int64)name); int64 position = 0;
    unsafe(using krt.mem;) {
        byte* data = (byte*)KrtMiniOSEnvironment;
        while (data[position] != 0) {
            int64 start = position;
            while (data[position] != 0) { position = position + 1; }
            if (position - start > length && data[start + length] == 61 && KrtDriverStartsWith(KrtMiniOSEnvironment + start,name)) { return KrtMiniOSEnvironment + start + length + 1; }
            position = position + 1;
        }
    }
    return (int64)"";
}
