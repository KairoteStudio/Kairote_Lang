        if (parameter == null) { KrtParserRecordError(parser); return first; }
        KrtAstNode previous = first;
        while (previous != null) {
            if (KrtParserSameSourceName(parser, start, length, previous.name_start, previous.name_length)) { KrtParserRecordError(parser); return first; }
            previous = previous.next;
