            if (KrtParserTokenText(parser, 125)) { return; }
            if (KrtParserTokenText(parser, 59)) { KrtLexerNext(parser.lexer, parser.token); return; }
            if (parser.token.start > failed_start && (declaration ? KrtParserDeclarationBoundary(parser) : KrtParserStatementBoundary(parser))) { return; }
        }
        if (KrtParserTokenText(parser, 123)) { braces = braces + 1; }
        else if (KrtParserTokenText(parser, 125)) {
            braces = braces - 1;
