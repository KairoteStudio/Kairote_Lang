    KrtAstNode result = KrtAstMake(compound ? KrtAstKind.CompoundAssign : KrtAstKind.Assign, start, parser.token.start - start);
    result.left = expression; result.right = value; result.op = operation; result.child_count = 2;
    return result;
}

// Constraint and declaration type parsing.
