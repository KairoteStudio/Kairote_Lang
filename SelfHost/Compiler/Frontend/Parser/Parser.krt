// Statement and declaration error recovery.
// Synchronize on grammar boundaries and retain malformed syntax as Invalid AST.
bool KrtParserStatementBoundary(KrtParser parser) {
    return KrtParserIsWord(parser, "return") || KrtParserIsWord(parser, "if") || KrtParserIsWord(parser, "while") ||
        KrtParserIsWord(parser, "do") || KrtParserIsWord(parser, "for") || KrtParserIsWord(parser, "foreach") ||
        KrtParserIsWord(parser, "switch") || KrtParserIsWord(parser, "try") || KrtParserIsWord(parser, "throw") ||
        KrtParserIsWord(parser, "break") || KrtParserIsWord(parser, "continue") || KrtParserIsWord(parser, "unsafe") ||
        KrtParserIsWord(parser, "delete") || KrtParserIsWord(parser, "yield") || KrtParserIsWord(parser, "lock") ||
        KrtParserIsWord(parser, "fixed") || KrtParserIsWord(parser, "const") || KrtParserIsWord(parser,"case") || KrtParserIsWord(parser,"default") || KrtParserTypeDeclarationAhead(parser) ||
        KrtParserFunctionDeclarationAhead(parser) || KrtParserLocalTypeAhead(parser) != null;
}

bool KrtParserDeclarationBoundary(KrtParser parser) {
    if (KrtParserIsWord(parser, "namespace") || KrtParserIsWord(parser, "using") || KrtParserIsWord(parser, "const") ||
        KrtParserIsWord(parser, "template") || KrtParserIsWord(parser, "delegate") || KrtParserTypeDeclarationAhead(parser)) { return true; }
    KrtParser probe = KrtParserFork(parser);
    while (KrtParserModifierFlag(probe)!=0) { KrtLexerNext(probe.lexer, probe.token); }
    if (KrtParserIsWord(probe, "function") || KrtParserIsWord(probe, "func")) { return true; }
    KrtAstNode type = KrtParserParseType(probe);
    return type != null && probe.errors == 0 && probe.token.kind == KrtTokenKind.Identifier;
}

void KrtParserSynchronize(KrtParser parser, int64 failed_start, bool declaration) {
    int32 braces = 0; int32 parens = 0; int32 brackets = 0;
    while (parser.token.kind != KrtTokenKind.Eof) {
