            else if (KrtParserIsWord(parser, "struct")) { constraint.op = 2; }
            else if (KrtParserIsWord(parser, "new")) { constraint.op = 3; }
            else if (KrtParserIsWord(parser, "unmanaged")) { constraint.op = 4; }
            else { constraint.op = 6; }
