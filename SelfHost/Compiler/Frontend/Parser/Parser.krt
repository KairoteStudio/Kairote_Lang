        else if (KrtParserTokenText(parser, 41) && parens > 0) { parens = parens - 1; }
        else if (KrtParserTokenText(parser, 91)) { brackets = brackets + 1; }
        else if (KrtParserTokenText(parser, 93) && brackets > 0) { brackets = brackets - 1; }
