void KrtParserRecordError(KrtParser parser) {
    KrtParserRecordExpected(parser, KrtTokenKind.Unknown, "invalid syntax");
}

bool KrtParserAccept(KrtParser parser, KrtTokenKind kind) {
    if (parser.token.kind != kind) { return false; }
    KrtLexerNext(parser.lexer, parser.token); return true;
}

bool KrtParserExpect(KrtParser parser, KrtTokenKind kind) {
    if (KrtParserAccept(parser, kind)) { return true; }
    KrtParserRecordExpected(parser, kind, "expected token"); return false;
}

// Named arguments and for-loop increment parsing.
bool KrtParserIsCompoundOperation(int32 operation) {
    return (operation >= 108 && operation <= 112) || (operation >= 117 && operation <= 121);
}

KrtAstNode KrtParserParseForIncrement(KrtParser parser) {
    int64 start = parser.token.start;
