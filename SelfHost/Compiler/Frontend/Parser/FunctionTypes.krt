// Consume one complete type without consuming a following declaration name.
bool KrtParserSkipNativeType(KrtParser parser) {
    return KrtParserParseType(parser) != null;
}

KrtAstNode KrtParserParseFunctionType(KrtParser parser) {
    if (!KrtParserIsWord(parser, "fn")) { KrtParserRecordError(parser); return null; }
    int64 start = parser.token.start;
    KrtLexerNext(parser.lexer, parser.token);
    if (!KrtParserTokenText(parser, 40)) { KrtParserRecordError(parser); return null; }
    KrtLexerNext(parser.lexer, parser.token);
    KrtAstNode signature = KrtAstMake(KrtAstKind.Function, start, 0);
    signature.parameter_type_starts = new int64[128]; signature.parameter_type_lengths = new int64[128];
    signature.parameter_refs = new bool[128];bool overflow_reported=false;
    while (!KrtParserTokenText(parser, 41)) {
        bool parameter_fits=signature.parameter_count<128;
        if(!parameter_fits&&!overflow_reported){KrtParserRecordExpected(parser,KrtTokenKind.RightParen,"function type exceeds 128 parameters");overflow_reported=true;}
        int32 index = signature.parameter_count;
        bool by_reference=KrtParserIsWord(parser,"ref");
        if (by_reference) { KrtLexerNext(parser.lexer, parser.token); }
        int64 type_start = parser.token.start;
        if (!KrtParserSkipNativeType(parser)) { return null; }
        if(parameter_fits){
            KrtParserAppendParameterType(signature, parser.last_type);signature.parameter_refs[index]=by_reference;
            signature.parameter_type_starts[index] = type_start;
            signature.parameter_type_lengths[index] = KrtParserTypeSpanLength(parser, type_start, parser.token.start - type_start);
            signature.parameter_count = index + 1;
        }
        if (!KrtParserTokenText(parser, 44)) { break; }
        KrtLexerNext(parser.lexer, parser.token);
    }
    if (!KrtParserTokenText(parser, 41)) { KrtParserRecordError(parser); return null; }
    KrtLexerNext(parser.lexer, parser.token);
    if (parser.token.kind == KrtTokenKind.Arrow) { KrtLexerNext(parser.lexer, parser.token); }
    else {
        if (!KrtParserTokenText(parser, 45)) { KrtParserRecordError(parser); return null; }
        KrtLexerNext(parser.lexer, parser.token);
        if (!KrtParserTokenText(parser, 62)) { KrtParserRecordError(parser); return null; }
        KrtLexerNext(parser.lexer, parser.token);
    }
    signature.type_start = parser.token.start;
    if (!KrtParserSkipNativeType(parser)) { return null; }
    signature.syntax_type = parser.last_type;
    signature.type_length = KrtParserTypeSpanLength(parser, signature.type_start, parser.token.start - signature.type_start);
    signature.length = parser.token.start - start;
    return signature;
}

KrtAstNode KrtParserParseGlobalVariable(KrtParser parser) {
    if (parser.token.category != KrtTokenCategory.Identifier) { return null; }
    KrtParser probe = KrtParserFork(parser); bool readonly_global = false;int32 modifiers=0;
    while (KrtParserIsWord(probe, "public") || KrtParserIsWord(probe, "private") || KrtParserIsWord(probe, "protected") || KrtParserIsWord(probe, "internal") || KrtParserIsWord(probe, "static") || KrtParserIsWord(probe, "readonly") || KrtParserIsWord(probe,"const")) {
        modifiers=KrtParserAddModifierFlag(modifiers,KrtParserModifierFlag(probe));
        if (KrtParserIsWord(probe, "readonly") || KrtParserIsWord(probe,"const")) { readonly_global = true; }
        KrtLexerNext(probe.lexer, probe.token);
    }
    int64 start = probe.token.start; KrtAstNode type = KrtParserParseType(probe);
    if (type == null || probe.errors != 0 || probe.token.kind != KrtTokenKind.Identifier) { return null; }
    KrtParser named_probe = KrtParserFork(probe); KrtLexerNext(named_probe.lexer, named_probe.token);
    if (!KrtParserTokenText(named_probe, 61) && !KrtParserTokenText(named_probe, 59)) { return null; }
    KrtParserCommit(parser, probe);
    KrtAstNode declaration = KrtAstMake(KrtAstKind.Variable, start, 0);
    declaration.syntax_modifiers=modifiers;declaration.syntax_type = type;
    declaration.type_start = start; declaration.type_length = KrtParserTypeSpanLength(parser, start, parser.token.start - start);
    declaration.name_start = parser.token.start; declaration.name_length = parser.token.length;
    declaration.native_static = true; declaration.native_readonly = readonly_global;
    KrtLexerNext(parser.lexer, parser.token);
    if (KrtParserTokenText(parser, 61)) { KrtLexerNext(parser.lexer, parser.token); declaration.left = KrtParserParseExpression(parser, 1); }
    if (!KrtParserTokenText(parser, 59)) { KrtParserRecordError(parser); return declaration; }
    KrtLexerNext(parser.lexer, parser.token); declaration.length = parser.token.start - start;
    return declaration;
}
