// ===== Access checking =====
// Omitted access modifiers preserve Kairote's existing public default.
int32 KrtNativeAccessMode(KrtAstNode declaration) {
    if (declaration == null) { return 1; }
    int32 access = declaration.syntax_modifiers & 8199;
    if (access == 0) { return 1; }
    return access;
}

KrtAstNode KrtNativeAccessOwner(KrtAstNode declaration) {
    if (declaration == null) { return null; }
    if (declaration.native_owner != null) { return declaration.native_owner; }
    KrtAstNode context = declaration.native_context; int32 depth = 0;
    while (context != null && depth < 64) {
        if (context.kind == KrtAstKind.TypeDeclaration) { return context; }
        if (context.native_owner != null) { return context.native_owner; }
        context = context.native_context; depth = depth + 1;
    }
    return null;
}

KrtAstNode KrtNativeAccessOrigin(KrtAstNode declaration) {
    int32 depth = 0;
    while (declaration != null && declaration.native_generic_origin != null && depth < 64) {
        declaration = declaration.native_generic_origin; depth = depth + 1;
    }
    return declaration;
}

bool KrtNativeAccessSameOwner(KrtAstNode first, KrtAstNode second) {
    return first != null && second != null && KrtNativeAccessOrigin(first) == KrtNativeAccessOrigin(second);
}

bool KrtNativeAccessSameFile(KrtAstNode declaration, KrtAstNode caller) {
    if (declaration == null || caller == null) { return false; }
    KrtSourceBundle bundle = KrtDriverActiveBundle;
    if (bundle == null) { return true; }
    declaration = KrtNativeAccessOrigin(declaration); caller = KrtNativeAccessOrigin(caller);
    KrtSourceFile file = bundle.files;
    while (file != null) {
        if (declaration.start >= file.start && declaration.start < file.start + file.length) {
            return caller.start >= file.start && caller.start < file.start + file.length;
        }
        file = file.order_next;
    }
    return false;
}

// File-private declarations and declarations internal to another module
// have separate declaration identities. Unknown source positions never
// grant this exception.
bool KrtNativeAccessSeparateFiles(KrtAstNode first, KrtAstNode second) {
    if (first == null || second == null || KrtDriverActiveBundle == null) { return false; }
    bool file_private = KrtNativeAccessMode(first) == 2 && KrtNativeAccessOwner(first) == null;
    file_private = file_private || (KrtNativeAccessMode(second) == 2 && KrtNativeAccessOwner(second) == null);
    bool module_internal = KrtNativeAccessMode(first) == 8192 || KrtNativeAccessMode(second) == 8192;
    if (!file_private && !module_internal) { return false; }
    first = KrtNativeAccessOrigin(first); second = KrtNativeAccessOrigin(second);
    KrtSourceFile first_file = null; KrtSourceFile second_file = null;
    KrtSourceFile file = KrtDriverActiveBundle.files;
    while (file != null) {
        if (first.start >= file.start && first.start < file.start + file.length) { first_file = file; }
        if (second.start >= file.start && second.start < file.start + file.length) { second_file = file; }
        file = file.order_next;
    }
    if (first_file == null || second_file == null) { return false; }
    if (module_internal && !KrtModulesSameModule(first.start,second.start)) { return true; }
    return file_private && first_file != second_file;
}

bool KrtNativeAccessAllowedDepth(KrtAstNode declaration, KrtNativeBinding binding, KrtAstNode receiver_type, bool base_receiver, int32 depth) {
    if (declaration == null || binding == null || binding.unit == null || depth > 64) { return false; }
    KrtAstNode owner = KrtNativeAccessOwner(declaration);
    if (owner != null && !KrtNativeAccessAllowedDepth(owner,binding,null,false,depth + 1)) { return false; }
    int32 access = KrtNativeAccessMode(declaration);
    KrtAstNode origin=KrtNativeAccessOrigin(declaration);KrtAstNode caller_origin=KrtNativeAccessOrigin(binding.unit);
    bool same_module=KrtModulesSameModule(origin.start,caller_origin.start);
    if (access == 1 || ((access == 8192 || access == 8196)&&same_module)) { return true; }
    if(access==8192){return false;}if(access==8196){access=4;}
    if (owner == null) { return access == 2 && KrtNativeAccessSameFile(declaration,binding.unit); }
    KrtAstNode caller = KrtNativeAccessOwner(binding.unit);
    if (KrtNativeAccessSameOwner(owner,caller)) { return true; }
    if (access == 2 || caller == null || !KrtNativeDerivesFrom(caller,owner)) { return false; }
    if (access != 4 && access != 6) { return false; }
    if(access==6&&!same_module){return false;}
    // A derived class may use a protected instance member through its own
    // static receiver type (or a descendant), and through this/base. Merely
    // holding an unrelated Base or sibling instance grants no access.
    return declaration.native_static || base_receiver || receiver_type == null || KrtNativeDerivesFrom(receiver_type,caller);
}

bool KrtNativeAccessAllowed(KrtAstNode declaration, KrtNativeBinding binding, KrtAstNode receiver_type, bool base_receiver) {
    return KrtNativeAccessAllowedDepth(declaration,binding,receiver_type,base_receiver,0);
