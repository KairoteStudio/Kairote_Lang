    return true;
}

bool KrtNativeBoxContextNeedsType(KrtAstNode node) {
    return node!=null&&!node.native_bound&&(node.kind==KrtAstKind.Ternary||
        (node.kind==KrtAstKind.Binary&&node.op==113));
