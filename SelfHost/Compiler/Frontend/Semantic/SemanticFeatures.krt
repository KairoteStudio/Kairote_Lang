// ===== Generators =====
// A generator owns a persistent activation and a finite set of resume edges.
// Its source body is bound once, using the same locals, captures and types as
// an ordinary function. Generated methods expose the ordinary iterator ABI.
class KrtNativeGeneratorPlan {
    public KrtAstNode factory;
    public KrtAstNode body;
    public KrtAstNode sequence_type;
    public KrtAstNode cursor_type;
    public KrtAstNode enumerable_type;
    public KrtAstNode enumerator_type;
    public KrtAstNode element_type;
    public KrtAstNode get_method;
    public KrtAstNode move_method;
    public KrtAstNode current_method;
    public KrtAstNode dispose_method;
    public KrtAstNode get_requirement;
    public KrtAstNode move_requirement;
    public KrtAstNode current_requirement;
    public KrtAstNode dispose_requirement;
    public KrtAstNode parameters;
    public int32 body_locals;
    public int32 body_frame_bytes;
    public int32 slots_offset;
    public int32 aggregate_offset;
    public int32 current_offset;
    public int32 object_size;
    public int32 receiver_slot;
    public int32 scratch_slot;
    public int32 state_count;
    public int32 factory_slot;
    public int32 handler_slot;
    public KrtNativeGeneratorResume resumes;
}

class KrtNativeGeneratorResume {
    public int32 state;
    public int32 target;
    public KrtNativeExceptionFrame frames;
    public KrtNativeGeneratorResume next;
}

bool KrtNativeGeneratorContainsYield(KrtAstNode node) {
    while (node != null) {
        if (node.kind == KrtAstKind.YieldReturn || node.kind == KrtAstKind.YieldBreak) { return true; }
