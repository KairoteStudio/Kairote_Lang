bool KrtNativeAccessDeclarationValid(KrtAstNode declaration) {
    if ((declaration.syntax_modifiers & 16384) != 0) { return false; }
    int32 access = KrtNativeAccessMode(declaration);
    if (access != 1 && access != 2 && access != 4 && access != 6 && access != 8192 && access != 8196) { return false; }
    KrtAstNode owner = KrtNativeAccessOwner(declaration);
    if (owner == null && (access & 4) != 0) { return false; }
    if (owner != null && (owner.value == 3 || owner.value == 4) && access != 1) { return false; }
    if (declaration.kind == KrtAstKind.Function && access == 2 && (declaration.native_virtual || declaration.native_abstract || declaration.native_override)) { return false; }
    return true;
}

bool KrtNativeValidateAccess(KrtAstNode module, int64 source, KrtNativeModule output) {
    bool valid = true; KrtAstNode declaration = module.declarations;
    while (declaration != null) {
        if (!KrtNativeAccessDeclarationValid(declaration)) {
            if (valid) { output.error_start = declaration.start; }
            KrtDiagnostic("E_MODIFIER",10,declaration.start); valid = false;
        }
        KrtAstNode field = declaration.body;
        while (field != null) {
            if (!KrtNativeAccessDeclarationValid(field)) {
                if (valid) { output.error_start = field.start; }
                KrtDiagnostic("E_MODIFIER",10,field.start); valid = false;
            }
            field = field.next;
        }
        declaration = declaration.next;
    }
    declaration = module.left;
    while (declaration != null) {
        if (!KrtNativeAccessDeclarationValid(declaration)) {
            if (valid) { output.error_start = declaration.start; }
            KrtDiagnostic("E_MODIFIER",10,declaration.start); valid = false;
        }
        declaration = declaration.next;
    }
    declaration = module.body;
    while (declaration != null) {
        if (!KrtNativeAccessDeclarationValid(declaration)) {
            if (valid) { output.error_start = declaration.start; }
            KrtDiagnostic("E_MODIFIER",10,declaration.start); valid = false;
        }
        declaration = declaration.next;
    }
    if (!valid) { module.native_error = 11; }
    return valid;
}

// ===== Boxing and conversions =====
// Object values are references. A value conversion owns a separate typed heap
// allocation; reference class/interface conversions retain their original
// object. Canonical type descriptions never depend on a use's source spelling.
KrtAstNode KrtNativeObjectType(KrtAstNode module) {
    if (module.native_object_type == null) {
        KrtAstNode type = KrtAstMake(KrtAstKind.TypeDeclaration,0,0);
        if (type == null) { return null; }
        type.value = 5; type.native_size = 8;
        type.native_storage_size = 8; type.native_alignment = 8;
        type.native_layout_state = 2; type.native_inheritance_state = 2;
        type.native_dispatch_state = 2;
        module.native_object_type = type;
    }
    return module.native_object_type;
}

bool KrtNativeAnnotateObjectType(KrtAstNode node, KrtAstNode module, int64 source, int64 start, int64 length) {
    node.native_type = KrtNativeObjectType(module);
