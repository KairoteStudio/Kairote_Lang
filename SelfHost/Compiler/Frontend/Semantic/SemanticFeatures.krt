        node = node.next;
    }
    return false;
}

// Catch/finally bodies cannot suspend. A try/finally protects suspended
// execution, whereas the body of a try with catches cannot yield a value.
bool KrtNativeGeneratorValidateSource(KrtAstNode node, KrtNativeBinding binding, bool suspended, bool cleanup) {
    while (node != null) {
        if (node.kind == KrtAstKind.Lambda) { node = node.next; continue; }
        if (node.kind == KrtAstKind.Return || node.kind == KrtAstKind.StackAlloc ||
