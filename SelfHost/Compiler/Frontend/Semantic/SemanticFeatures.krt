int64 KrtNativeBoxArgumentScore(KrtAstNode expected, KrtAstNode actual, bool reference) {
    if (reference) { return -1; }
    if (KrtNativeObjectValue(expected) && !KrtNativeObjectValue(actual) &&
        KrtNativeObjectConversion(expected,actual)) { return KrtNativeRankingUnit; }
    if (KrtNativeBoxingConversion(expected,actual)) {
        return 2 * KrtNativeRankingUnit - KrtNativeInterfaceDistance(actual.native_type,expected.native_type);
    }
    return -1;
