        while (item != null && item.native_fixed_length > 0) { item = item.native_element_type; }
        if (item == null || item.native_pointer_depth > 0 || item.native_array || item.native_string ||
            item.native_function_pointer != null || (item.native_type != null && item.native_type.value != 2 && item.native_type.value != 4)) {
            delete pending; return true;
