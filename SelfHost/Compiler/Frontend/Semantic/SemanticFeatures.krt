KrtAstNode KrtNativeIteratorBlock(KrtAstNode first, KrtAstNode site) {
    KrtAstNode block = KrtAstMake(KrtAstKind.Block,site.start,site.length);
    block.left = first; block.child_count = first == null ? 0 : 1;
    block.native_scope = site.native_scope; block.native_context = site.native_context;
    block.native_using_scope = site.native_using_scope;
    return block;
}

KrtAstNode KrtNativeIteratorPresent(KrtAstNode local, KrtAstNode body, KrtAstNode site) {
    if (!KrtNativeIteratorReference(local)) { return body; }
    KrtAstNode guard = KrtAstMake(KrtAstKind.If,site.start,0);
    guard.left = KrtNativeIteratorRead(local); guard.right = body;
    return KrtNativeIteratorBlock(guard,site);
}

bool KrtNativeBindIteratorForeach(KrtAstNode statement, KrtNativeBinding binding) {
    KrtAstNode collection = statement.right;
    if (!KrtNativeIteratorNominal(collection)) { return KrtNativeIteratorError(binding,collection); }
    KrtAstNode get_name = KrtNativeIteratorMethodName(collection.native_type,"GetEnumerator",binding,true);
    if (get_name == null) { return KrtNativeIteratorError(binding,collection); }
    KrtAstNode collection_local = KrtNativeIteratorLocal(collection,binding,true);
    if (collection_local == null) { return false; }
    KrtAstNode factory = KrtNativeIteratorCall(KrtNativeIteratorRead(collection_local),get_name,statement,binding);
    if (factory == null) { return false; }
    if (!KrtNativeIteratorNominal(factory)) { return KrtNativeIteratorError(binding,statement); }
    KrtAstNode enumerator = KrtNativeIteratorLocal(factory,binding,false);
    if (enumerator == null) { return false; }
    KrtAstNode move_name = KrtNativeIteratorMethodName(enumerator.native_type,"MoveNext",binding,true);
    if (move_name == null) { return KrtNativeIteratorError(binding,statement); }
    KrtAstNode move = KrtNativeIteratorCall(KrtNativeIteratorRead(enumerator),move_name,statement,binding);
    if (move == null) { return false; }
    if (!move.native_boolean || move.native_array || move.native_pointer_depth != 0 || move.native_function_pointer != null) {
        return KrtNativeIteratorError(binding,statement);
    }
    KrtAstNode current = null;
    KrtAstNode current_name = KrtNativeIteratorFieldName(enumerator.native_type,"Current",binding);
    if (current_name != null) {
        current = KrtAstMake(KrtAstKind.Member,statement.start,0);
        current.left = KrtNativeIteratorRead(enumerator); current.name_start = current_name.name_start;
        current.name_length = current_name.name_length;
        if (!KrtNativeBindExpression(current,binding)) { return false; }
        if (current.native_static || current.native_global > 0) { return KrtNativeIteratorError(binding,statement); }
    } else {
        current_name = KrtNativeIteratorMethodName(enumerator.native_type,"Current",binding,true);
        if (current_name == null) { return KrtNativeIteratorError(binding,statement); }
        current = KrtNativeIteratorCall(KrtNativeIteratorRead(enumerator),current_name,statement,binding);
        if (current == null) { return false; }
    }
    if (KrtNativeVoidValue(current)) { return KrtNativeIteratorError(binding,statement); }
    KrtAstNode dispose = null;
    KrtAstNode dispose_name = KrtNativeIteratorMethodName(enumerator.native_type,"Dispose",binding,false);
    if (dispose_name != null) {
        dispose = KrtNativeIteratorCall(KrtNativeIteratorRead(enumerator),dispose_name,statement,binding);
        if (dispose == null) { return false; }
        if (!KrtNativeVoidValue(dispose)) { return KrtNativeIteratorError(binding,statement); }
    }

    KrtAstNode original = statement.left;
    KrtAstNode variable = KrtAstMake(KrtAstKind.Variable,original.start,original.length);
    variable.name_start = original.name_start; variable.name_length = original.name_length;
    variable.type_start = original.type_start; variable.type_length = original.type_length;
    variable.syntax_type = original.syntax_type; variable.syntax_suffixes = original.syntax_suffixes;
    variable.syntax_modifiers = original.syntax_modifiers;
    variable.native_scope = original.native_scope; variable.native_context = original.native_context;
    variable.native_using_scope = original.native_using_scope; variable.left = current;
    if (!KrtNativeAnnotateType(variable,binding.module,binding.source,variable.type_start,variable.type_length)) {
        return KrtNativeBindingError(binding,variable);
    }
    if (KrtNativeIsInferredType(variable,binding.source)) { KrtNativeCopyType(variable,current); }
    if (!KrtNativeCheckValueAccess(variable,binding) || !KrtNativeBindAggregateFrame(variable,binding)) { return false; }
    if (!KrtNativeCompatibleValue(variable,current)) { return KrtNativeBindingError(binding,variable); }
    variable.native_stack_borrow = current.native_stack_borrow;
    variable.local_slot = binding.slots; binding.slots = binding.slots + 1;
    KrtAstNode iteration = KrtNativeIteratorBlock(variable,statement.body);
    variable.next = statement.body; iteration.child_count = 2;
    variable.native_lexical_block = iteration;
    KrtNativeName saved = binding.names; binding.depth = binding.depth + 1;
    bool valid = KrtNativeAddName(binding,variable,variable.local_slot,false) && KrtNativeBindBlock(statement.body,binding);
    binding.names = saved; binding.depth = binding.depth - 1;
    if (!valid) { return false; }

    KrtAstNode loop = KrtAstMake(KrtAstKind.While,statement.start,statement.length);
    loop.left = move; loop.right = iteration;
    KrtAstNode active = KrtNativeIteratorBlock(loop,statement);
    KrtAstNode boxed = null;
    if (enumerator.native_type.value == 3 || enumerator.native_type.value == 5) {
        KrtAstNode probe = KrtAstMake(KrtAstKind.Call,statement.start,0);
        KrtNativeCopyType(probe,move); probe.left = KrtNativeIteratorRead(enumerator); probe.op = 248;
        boxed = KrtNativeIteratorLocal(probe,binding,false);
        if (boxed == null) { return false; }
    }
    if (dispose != null || boxed != null) {
        KrtAstNode cleanup_call = KrtAstMake(KrtAstKind.Expression,statement.start,0); cleanup_call.left = dispose;
        KrtAstNode cleanup = KrtNativeIteratorBlock(cleanup_call,statement);
        if (boxed != null) {
            KrtAstNode release = KrtAstMake(KrtAstKind.Call,statement.start,0);
            release.op = 249; release.left = KrtNativeIteratorRead(enumerator); release.right = KrtNativeIteratorRead(boxed);
            KrtAstNode release_statement = KrtAstMake(KrtAstKind.Expression,statement.start,0); release_statement.left = release;
            KrtAstNode release_block = KrtNativeIteratorBlock(release_statement,statement);
            if (dispose != null) {
                KrtAstNode dispose_guard = KrtAstMake(KrtAstKind.Try,statement.start,0);
                dispose_guard.left = cleanup; dispose_guard.alternate = release_block;
                dispose_guard.local_slot = binding.slots; dispose_guard.native_size = binding.slots + 6;
                binding.slots = binding.slots + 12; cleanup = KrtNativeIteratorBlock(dispose_guard,statement);
            } else { cleanup = release_block; }
        }
        KrtAstNode guarded = KrtAstMake(KrtAstKind.Try,statement.start,statement.length);
        guarded.left = active; guarded.alternate = cleanup;
        guarded.local_slot = binding.slots; guarded.native_size = binding.slots + 6; binding.slots = binding.slots + 12;
        active = KrtNativeIteratorBlock(guarded,statement);
    }
    if (boxed != null) { boxed.next = active; active = KrtNativeIteratorBlock(boxed,statement); active.child_count = 2; }
    active = KrtNativeIteratorPresent(enumerator,active,statement);
    enumerator.next = active;
    KrtAstNode factory_body = KrtNativeIteratorBlock(enumerator,statement); factory_body.child_count = 2;
    factory_body = KrtNativeIteratorPresent(collection_local,factory_body,statement);
    collection_local.next = factory_body;
    statement.native_target = KrtNativeIteratorBlock(collection_local,statement); statement.native_target.child_count = 2;
    return true;
}
