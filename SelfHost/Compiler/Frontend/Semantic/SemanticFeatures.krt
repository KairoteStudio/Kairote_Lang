bool KrtNativeUnboxingConversion(KrtAstNode target, KrtAstNode value) {
    if (!KrtNativeReferenceObjectValue(value)) { return false; }
    if (KrtNativeReferenceObjectValue(target) && KrtNativeDerivesFrom(value.native_type,target.native_type)) { return false; }
    if (KrtNativeBoxableValue(target)) {
