    return false;
}

bool KrtNativeAccessTypeAllowedDepth(KrtAstNode type, KrtNativeBinding binding, int32 depth) {
    if (type == null) { return true; }
    if (depth > 64) { return false; }
    if (type.native_element_type != null && !KrtNativeAccessTypeAllowedDepth(type.native_element_type,binding,depth + 1)) { return false; }
    if (type.native_type != null) {
        if (!KrtNativeAccessAllowed(type.native_type,binding,null,false)) { return false; }
        KrtAstNode argument = type.native_type.native_type_arguments;
        while (argument != null) {
            if (!KrtNativeAccessTypeAllowedDepth(argument,binding,depth + 1)) { return false; }
            argument = argument.next;
