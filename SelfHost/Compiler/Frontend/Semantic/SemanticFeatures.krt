        if (node.kind == KrtAstKind.Call || (node.kind == KrtAstKind.Unary && node.op == 38)) { target = node.left; }
        if (target != null) {
            if (target.kind == KrtAstKind.Member) { position = target.name_start; }
            else if (target.kind == KrtAstKind.Identifier) { position = target.start; }
        }
        if (node.kind == KrtAstKind.New || node.kind == KrtAstKind.TypeTest) { position = node.type_start; }
        binding.error_start = position;
