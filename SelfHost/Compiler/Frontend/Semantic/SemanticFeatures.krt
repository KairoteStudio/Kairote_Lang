// ===== Closures and captures =====
// Lexical captures own shared cells. Callable values retain those cells through
// their environment; source scopes retain one owner until every exit path.
bool KrtNativeHasInstanceContext(KrtNativeBinding binding) {
    while (binding != null) {
        if (!binding.unit.native_closure_function) { return binding.unit.native_owner != null && !binding.unit.native_static; }
        binding = binding.parent;
