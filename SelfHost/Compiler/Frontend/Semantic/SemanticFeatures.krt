    }
    KrtAstNode signature = type.native_function_pointer;
    if (signature != null) {
        if (!KrtNativeAccessTypeAllowedDepth(signature.native_type,binding,depth + 1)) { return false; }
        KrtAstNode parameter = signature.declarations;
        while (parameter != null) {
            if (!KrtNativeAccessTypeAllowedDepth(parameter,binding,depth + 1)) { return false; }
            parameter = parameter.next;
        }
    }
    return true;
}

bool KrtNativeAccessTypeAllowed(KrtAstNode type, KrtNativeBinding binding) {
    return KrtNativeAccessTypeAllowedDepth(type,binding,0);
}

bool KrtNativeAccessExported(KrtAstNode declaration) {
    int32 depth = 0;
    while (declaration != null && depth < 64) {
        if (KrtNativeAccessMode(declaration) != 1) { return false; }
        declaration = KrtNativeAccessOwner(declaration); depth = depth + 1;
