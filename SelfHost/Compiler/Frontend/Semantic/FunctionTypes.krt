bool KrtNativeAnnotateFunctionType(KrtAstNode node, KrtAstNode module, int64 source, int64 start, int64 length) {
    KrtAstNode syntax = KrtNativeTypeSyntax(source,start,length);
    if (syntax == null || syntax.op != 1) { return false; }
    KrtAstNode signature = syntax.left;
    signature.native_scope = node.native_scope; signature.native_context = node.native_context;
    signature.native_using_scope = node.native_using_scope;
    node.native_function_pointer = signature; node.native_width = 8; node.native_stride = 0;
    node.native_pointer_depth = 0; node.native_base_width = 8;
    node.native_bits = 0; node.native_array = false; node.native_string = false; node.native_wide = false; node.native_float = 0;
    node.native_unsigned = false; node.native_boolean = false; node.native_character = false; node.native_void_pointer = false;
    node.native_element_unsigned = false; node.native_element_boolean = false; node.native_element_string = false; node.native_element_character = false;
    if (!KrtNativePrepareFunctionShape(signature,module,source)) { return false; }
    return KrtNativeApplySourceTypeSuffix(node,syntax);
}

bool KrtNativePrepareFunctionShape(KrtAstNode signature, KrtAstNode module, int64 source) {
    KrtNativeClosureProbeJournal(module,signature);
    KrtAstNode closure = signature.native_closure_signature;
    if (closure == null && signature.native_closure_shape) { closure = signature; }
    if (closure != null) {
        if (closure.native_type == null || closure.parameter_count != signature.parameter_count) { return false; }
        signature.native_type = closure.native_type; signature.declarations = closure.declarations;
        signature.native_readonly = closure.native_readonly;
        KrtAstNode parameter = signature.declarations; int32 count = 0;
        while (parameter != null) { count = count + 1; parameter = parameter.next; }
        return count == signature.parameter_count;
    }
    int64 start = signature.start;
    KrtAstNode result_type = KrtAstMake(KrtAstKind.Type, start, 0);
    result_type.native_scope = signature.native_scope; result_type.native_context = signature.native_context;
    result_type.native_using_scope = signature.native_using_scope;
    if (!KrtNativeAnnotateType(result_type, module, source, signature.type_start, signature.type_length)) { return false; }
    signature.native_type = result_type;
    signature.native_readonly = signature.type_length == 0 || KrtNativeSpanWord(source, signature.type_start, signature.type_length, "void");
    int32 index = 0; KrtAstNode tail = null;
    while (index < signature.parameter_count) {
        KrtAstNode parameter = KrtAstMake(KrtAstKind.Type, start, 0);
        parameter.native_scope = signature.native_scope; parameter.native_context = signature.native_context;
        parameter.native_using_scope = signature.native_using_scope;
        if (!KrtNativeAnnotateType(parameter, module, source, signature.parameter_type_starts[index], signature.parameter_type_lengths[index])) { return false; }
        parameter.native_ref = signature.parameter_refs[index];
        if (tail == null) { signature.declarations = parameter; } else { tail.next = parameter; } tail = parameter;
        index = index + 1;
    }
    return true;
}

bool KrtNativeExactFunctionValue(KrtAstNode left, KrtAstNode right) {
    if (left == null || right == null) { return false; }
    return KrtNativeTypeEqual(left,right);
}

bool KrtNativeFunctionShapesEqual(KrtAstNode left, KrtAstNode right) {
    if (left == right) { return left != null; }
    if (left == null || right == null || left.parameter_count != right.parameter_count) { return false; }
    if (left.native_readonly != right.native_readonly || !KrtNativeExactFunctionValue(left.native_type, right.native_type)) { return false; }
    KrtAstNode a = left.declarations; KrtAstNode b = right.declarations;
    int32 index = 0;
    while (index < left.parameter_count) {
        if (a == null || b == null || a.native_ref != b.native_ref || !KrtNativeExactFunctionValue(a, b)) { return false; }
        a = a.next; b = b.next;
        index = index + 1;
    }
    return true;
}

bool KrtNativeBindFunctionAddress(KrtAstNode node, KrtNativeBinding binding) {
    KrtAstNode target = node.left;
    if (target == null) { return false; }
    KrtAstNode owner = null; int64 start = target.start; int64 length = target.length;
    if (target.kind == KrtAstKind.Identifier) {
        if (KrtNativeFindName(binding, target.start, target.length) != null) { return false; }
    } else if (target.kind == KrtAstKind.Member) {
        owner = KrtNativeExpressionTypeName(target.left, binding);
        if (binding.module.native_error == 10 && binding.error_start >= 0) { return false; }
        if (owner == null) {
            if (!KrtNativeNamespaceCallable(target,binding)) { return false; }
            target.native_static = true;
        }
        start = target.name_start; length = target.name_length;
    } else { return false; }
    KrtAstNode selected = null; bool inaccessible = false;
    KrtNativeFunctionEntry entry = KrtNativeFunctionCandidates(binding.module,binding.source,start,length);
    if (binding.module.native_function_index == null || !binding.module.native_function_index.ok) { binding.module.native_error = 0; return KrtNativeBindingError(binding,node); }
    int64 best = -1; int32 best_file = -1;
    while (entry != null) {
        KrtAstNode candidate = entry.declaration;
        bool visible = owner == null ? (candidate.native_owner == null || candidate.native_owner == binding.unit.native_owner || KrtNativeDerivesFrom(binding.unit.native_owner,candidate.native_owner)) :
            candidate.native_owner == owner || KrtNativeDerivesFrom(owner,candidate.native_owner);
        bool unbound_struct=target.kind==KrtAstKind.Member&&owner!=null&&owner.value==2&&
            candidate.native_owner!=null&&!candidate.native_static;
        if (visible && (candidate.native_owner == null || candidate.native_static || unbound_struct) &&
            KrtSemanticSameName(binding.source, start, length, candidate.name_start, candidate.name_length)) {
            int64 priority = KrtNativeFunctionScopeScore(candidate,target,binding);
            KrtAstNode receiver_type = owner == null ? binding.unit.native_owner : owner;
            if (candidate.native_owner != null && receiver_type != null) { priority = priority - KrtNativeInheritanceDistance(receiver_type,candidate.native_owner); }
            if (priority >= 0) {
                if (!KrtNativeAccessAllowed(candidate,binding,owner,false)) { inaccessible = true; }
                else {
                    int32 file_score = KrtNativeNameFilePriority(candidate,binding.unit.start);
                    if (candidate.native_generic_parameters != null || (selected != null && priority == best && file_score == best_file)) { return false; }
                    if (priority > best || (priority == best && file_score > best_file)) { selected = candidate; best = priority; best_file = file_score; }
                }
            }
        }
        entry = KrtNativeFunctionCandidateNext(entry,binding.module,binding.source);
    }
    if (binding.module.native_function_index == null || !binding.module.native_function_index.ok) { binding.module.native_error = 0; return KrtNativeBindingError(binding,node); }
    if (selected == null) { if (inaccessible) { return KrtNativeAccessError(binding,node); } return false; }
    KrtAstNode signature = KrtAstMake(KrtAstKind.Function, selected.start, selected.length);
    signature.native_closure_signature = selected.native_closure_signature;
    signature.type_start = selected.type_start; signature.type_length = selected.type_length;
    signature.parameter_count = selected.parameter_count;
    signature.parameter_starts = selected.parameter_starts; signature.parameter_lengths = selected.parameter_lengths;
    signature.parameter_type_starts = selected.parameter_type_starts; signature.parameter_type_lengths = selected.parameter_type_lengths;
    signature.native_using_scope = selected.native_using_scope;
    signature.parameter_refs = selected.parameter_refs; signature.native_scope = selected.native_scope; signature.native_context = selected.native_context;
    if(selected.native_owner!=null&&selected.native_owner.value==2&&!selected.native_static){
        signature.parameter_refs=new bool[selected.parameter_count];int32 index=0;
        while(index<selected.parameter_count){signature.parameter_refs[index]=selected.parameter_refs[index];index=index+1;}
        signature.parameter_refs[0]=true;
    }
    if (!KrtNativePrepareFunctionShape(signature, binding.module, binding.source)) { return false; }
    node.native_target = selected; node.native_function_pointer = signature; node.native_width = 8;
    return KrtNativeCheckValueAccess(node,binding);
}

bool KrtNativeBindIndirectCall(KrtAstNode node, KrtNativeBinding binding) {
    if (node.left.native_array || node.left.native_pointer_depth != 0 || KrtNativeInlineValue(node.left)) { return KrtNativeBindingError(binding,node); }
    if (node.left.native_nullable) { binding.module.native_error=5; return KrtNativeBindingError(binding,node.left); }
    KrtAstNode signature = node.left.native_function_pointer;
    if (signature == null || signature.parameter_count != node.parameter_count) { return KrtNativeBindingError(binding, node); }
    KrtAstNode invalid = KrtNativeMapArguments(node.right,signature,0,binding.source);
    if (invalid != null) { return KrtNativeArgumentNameError(binding,invalid); }
    KrtAstNode argument = node.right; int32 index = 0;
    while (argument != null) {
        KrtAstNode expected = KrtAstMake(KrtAstKind.Type,argument.start,argument.length);
        if (!KrtNativeSignatureType(expected,signature,argument.native_argument_index,binding.module,binding.source) ||
            !KrtNativeBindContextExpression(argument,expected,binding)) { return false; }
        binding.candidate_error=0;
        if(KrtNativeArgumentScore(argument,signature,argument.native_argument_index,binding)<0){
            if(binding.candidate_error>0){binding.module.native_error=binding.candidate_error;}
            return KrtNativeBindingError(binding,argument);
        }
        argument = argument.next; index = index + 1;
    }
    if (!KrtNativeCommitArguments(node.right,signature,0,binding)) { return false; }
    node.op = 232; node.native_scope = signature.native_scope; node.native_context = signature.native_context;
    int32 delete_slot = node.native_size;
    if (!KrtNativeSignatureType(node,signature,-1,binding.module,binding.source)) { return KrtNativeBindingError(binding,node); }
    if (node.left.kind == KrtAstKind.Lambda && node.native_closure_record_slot < 0) {
        node.native_closure_record_slot = binding.slots; binding.slots = binding.slots + 6;
        node.native_closure_descriptor_slot = binding.slots; binding.slots = binding.slots + 1;
        node.native_closure_environment_temp_slot = binding.slots; binding.slots = binding.slots + 1;
        node.native_size = binding.slots; binding.slots = binding.slots + 4;
    } else if (node.left.kind == KrtAstKind.Lambda) { node.native_size = delete_slot; }
    return KrtNativeCheckValueAccess(node,binding) && KrtNativeBindAggregateFrame(node,binding);
}

void KrtNativeNormalizeQualifiedSyscall(KrtAstNode node, KrtNativeBinding binding) {
    KrtAstNode callee = node.left;
    if (callee == null || callee.kind != KrtAstKind.Member ||
        !KrtNativeSpanWord(binding.source, callee.name_start, callee.name_length, "syscall")) { return; }
    KrtAstNode owner = KrtNativeExpressionTypeName(callee.left, binding);
    if (owner == null || !KrtNativeSpanWord(binding.source, owner.name_start, owner.name_length, "Sys")) { return; }
    // An explicitly declared method still wins. The runtime also exposes the
    // native intrinsic as Sys.syscall, alongside its ordinary Syscall wrapper.
    KrtAstNode method = owner.declarations;
    while (method != null) {
        if (KrtSemanticSameName(binding.source, method.name_start, method.name_length, callee.name_start, callee.name_length)) { return; }
        method = method.next;
    }
    node.left = KrtAstMake(KrtAstKind.Identifier, callee.name_start, callee.name_length);
}
