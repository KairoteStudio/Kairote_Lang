bool KrtNativeBindIndirectCall(KrtAstNode node, KrtNativeBinding binding) {
    if (node.left.native_array || node.left.native_pointer_depth != 0 || KrtNativeInlineValue(node.left)) { return KrtNativeBindingError(binding,node); }
    if (node.left.native_nullable) { binding.module.native_error=5; return KrtNativeBindingError(binding,node.left); }
    KrtAstNode signature = node.left.native_function_pointer;
    if (signature == null || signature.parameter_count != node.parameter_count) { return KrtNativeBindingError(binding, node); }
    KrtAstNode invalid = KrtNativeMapArguments(node.right,signature,0,binding.source);
    if (invalid != null) { return KrtNativeArgumentNameError(binding,invalid); }
