    type.native_dispatch_state = 1;
    if (type.native_base != null && !KrtNativePrepareDispatch(type.native_base, module, source)) { type.native_dispatch_state = 3; return false; }
    KrtAstNode method = KrtNativeTypeMemberFirst(type);
    while (method != null && method.native_owner == type) {
        KrtNativeClosureProbeJournal(module,method);
        if ((method.op == 223 && !method.native_abstract) || (method.native_abstract && !type.native_abstract) ||
            (method.native_virtual && (method.native_static || method.op == 220 || method.native_external_constructor || method.native_generic_parameters != null))) { type.native_dispatch_state = 3; return false; }
        if (method.native_virtual) {
            KrtAstNode previous = KrtNativeTypeMemberFirst(type);
            while (previous != method) {
                if (KrtNativeMethodSignatureEqual(method, previous, module, source, false)) { type.native_dispatch_state = 3; return false; }
                previous = KrtNativeTypeMemberNext(previous);
            }
            method.native_dispatch_slot = method;
        }
        if (method.native_override) {
            KrtAstNode base_type = type.native_base; KrtAstNode overridden = null; bool inaccessible = false;
            KrtNativeBinding access_binding = new KrtNativeBinding(); access_binding.module = module;
            access_binding.unit = method; access_binding.source = source; access_binding.error_start = -1;
            while (base_type != null && overridden == null) {
                KrtAstNode candidate = KrtNativeTypeMemberFirst(base_type);
                while (candidate != null && candidate.native_owner == base_type) {
                    if (KrtNativeMethodSignatureEqual(method, candidate, module, source, false)) {
                        if (KrtNativeAccessAllowed(candidate,access_binding,null,true)) { overridden = candidate; break; }
                        inaccessible = true;
                    }
                    candidate = KrtNativeTypeMemberNext(candidate);
                }
                base_type = base_type.native_base;
            }
            if (overridden == null) {
                if (!KrtNativeMethodImplementsInterface(method, module, source)) {
                    type.native_dispatch_state = 3;
                    if (inaccessible) { module.native_error = 10; KrtDiagnostic("E_ACCESS",8,method.start); }
                    return false;
