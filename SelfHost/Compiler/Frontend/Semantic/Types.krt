            if (distance < entry.native_offset) { entry.native_offset = distance; }
            return;
        }
        entry = entry.next;
    }
    entry = KrtAstMake(KrtAstKind.Type, interface_type.start, 0);
    entry.native_type = interface_type; entry.native_offset = distance;
    entry.next = type.native_interfaces; type.native_interfaces = entry;
