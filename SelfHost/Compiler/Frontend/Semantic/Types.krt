    if (state.function_tail != null) { state.function_tail.next = null; }
    if (state.type_tail != null) { state.type_tail.next = null; }
    if (state.global_tail != null) { state.global_tail.next = null; }
    module.child_count = state.child_count; module.native_locals = state.native_locals;
    module.native_error = state.native_error; module.native_constraint_depth = state.constraint_depth;
    KrtNativeFunctionIndexInvalidate(module); module.native_function_index = state.function_index;
    KrtGenericRegistry registry = module.native_generic_registry;
    if (registry != null) { delete registry.declarations; delete registry.arguments; delete registry.instances; delete registry.states; delete registry; }
    module.native_generic_registry = state.registry;
