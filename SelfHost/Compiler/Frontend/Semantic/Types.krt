                if (!KrtNativeAccessOverrideAllowed(method,overridden)) {
                    module.native_error = 11; KrtDiagnostic("E_MODIFIER",10,method.start); type.native_dispatch_state = 3; return false;
                }
                if (!overridden.native_virtual || !KrtNativeMethodSignatureEqual(method, overridden, module, source, true)) { type.native_dispatch_state = 3; return false; }
                method.native_dispatch_slot = overridden.native_dispatch_slot;
            }
        }
        method = KrtNativeTypeMemberNext(method);
    }
    if (!type.native_abstract) {
        KrtAstNode base_type = type;
        while (base_type != null) {
            method = KrtNativeTypeMemberFirst(base_type);
            while (method != null && method.native_owner == base_type) {
                if (method.native_abstract) {
                    KrtAstNode implementation = KrtNativeFindVirtualImplementation(type, method.native_dispatch_slot);
                    if (implementation == null || implementation.native_abstract) { type.native_dispatch_state = 3; return false; }
                }
                method = KrtNativeTypeMemberNext(method);
            }
            base_type = base_type.native_base;
        }
    }
    type.native_dispatch_state = 2;
    return KrtNativeValidateInterfaces(type, module, source);
}

bool KrtNativeBindDispatchCall(KrtAstNode node, KrtNativeBinding binding) {
    KrtAstNode method = node.native_target;
    if (method == null || !method.native_virtual) { return true; }
    // A rejected global declaration can still be reached while collecting
    // errors from another function. Dispatch always requires an instance.
    if (method.native_owner == null || node.left == null || node.left.kind != KrtAstKind.Member || node.left.left == null) {
        return KrtNativeBindingError(binding, node);
