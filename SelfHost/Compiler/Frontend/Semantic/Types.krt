    KrtAstNode method = type.declarations;
    while (method != null && method.native_owner == type) {
        KrtNativeClosureProbeJournal(module,method);
        KrtNativeClosureProbeJournal(module,method.left);
        KrtNativeClosureProbeJournal(module,method.native_base_call); method = method.next;
    }
}

KrtAstNode KrtNativeClosureProbeTail(KrtAstNode node) {
    if (node == null) { return null; }
    while (node.next != null) { node = node.next; } return node;
}

KrtGenericRegistry KrtNativeClosureProbeRegistry(KrtGenericRegistry original) {
    if (original == null) { return null; }
