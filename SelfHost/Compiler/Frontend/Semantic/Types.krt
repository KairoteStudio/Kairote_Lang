    KrtAstNode previous = null; KrtAstNode function_node = module.left;
    while (function_node != null) {
        KrtAstNode next = function_node.next;
        if (function_node.op == 221 || KrtNativeIsTemplate(function_node)) {
            if (previous == null) { module.left = next; } else { previous.next = next; }
            module.child_count = module.child_count - 1;
