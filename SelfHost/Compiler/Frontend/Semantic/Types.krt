    KrtAstNode receiver = node.left.left;
    bool base_call = receiver.op == 212;
    if (base_call) { return !method.native_abstract || KrtNativeBindingError(binding, node); }
    node.native_virtual = true; node.local_slot = binding.slots; binding.slots = binding.slots + 1;
    return true;
}

// ===== Function values and indirect calls =====
bool KrtNativeAnnotateFunctionType(KrtAstNode node, KrtAstNode module, int64 source, int64 start, int64 length) {
    KrtAstNode syntax = KrtNativeTypeSyntax(source,start,length);
    if (syntax == null || syntax.op != 1) { return false; }
    KrtAstNode signature = syntax.left;
    signature.native_scope = node.native_scope; signature.native_context = node.native_context;
    signature.native_using_scope = node.native_using_scope;
    node.native_function_pointer = signature; node.native_width = 8; node.native_stride = 0;
    node.native_pointer_depth = 0; node.native_base_width = 8;
    node.native_bits = 0; node.native_array = false; node.native_string = false; node.native_wide = false; node.native_float = 0;
    node.native_unsigned = false; node.native_boolean = false; node.native_character = false; node.native_void_pointer = false;
    node.native_element_unsigned = false; node.native_element_boolean = false; node.native_element_string = false; node.native_element_character = false;
    if (!KrtNativePrepareFunctionShape(signature,module,source)) { return false; }
    return KrtNativeApplySourceTypeSuffix(node,syntax);
}

bool KrtNativePrepareFunctionShape(KrtAstNode signature, KrtAstNode module, int64 source) {
    KrtNativeClosureProbeJournal(module,signature);
    KrtAstNode closure = signature.native_closure_signature;
    if (closure == null && signature.native_closure_shape) { closure = signature; }
    if (closure != null) {
        if (closure.native_type == null || closure.parameter_count != signature.parameter_count) { return false; }
        signature.native_type = closure.native_type; signature.declarations = closure.declarations;
        signature.native_readonly = closure.native_readonly;
        KrtAstNode parameter = signature.declarations; int32 count = 0;
        while (parameter != null) { count = count + 1; parameter = parameter.next; }
        return count == signature.parameter_count;
    }
    int64 start = signature.start;
    KrtAstNode result_type = KrtAstMake(KrtAstKind.Type, start, 0);
    result_type.native_scope = signature.native_scope; result_type.native_context = signature.native_context;
    result_type.native_using_scope = signature.native_using_scope;
    if (!KrtNativeAnnotateType(result_type, module, source, signature.type_start, signature.type_length)) { return false; }
    signature.native_type = result_type;
    signature.native_readonly = signature.type_length == 0 || KrtNativeSpanWord(source, signature.type_start, signature.type_length, "void");
    int32 index = 0; KrtAstNode tail = null;
    while (index < signature.parameter_count) {
        KrtAstNode parameter = KrtAstMake(KrtAstKind.Type, start, 0);
        parameter.native_scope = signature.native_scope; parameter.native_context = signature.native_context;
        parameter.native_using_scope = signature.native_using_scope;
        if (!KrtNativeAnnotateType(parameter, module, source, signature.parameter_type_starts[index], signature.parameter_type_lengths[index])) { return false; }
        parameter.native_ref = signature.parameter_refs[index];
        if (tail == null) { signature.declarations = parameter; } else { tail.next = parameter; } tail = parameter;
        index = index + 1;
    }
    return true;
}

bool KrtNativeExactFunctionValue(KrtAstNode left, KrtAstNode right) {
    if (left == null || right == null) { return false; }
    return KrtNativeTypeEqual(left,right);
}

bool KrtNativeFunctionShapesEqual(KrtAstNode left, KrtAstNode right) {
    if (left == right) { return left != null; }
    if (left == null || right == null || left.parameter_count != right.parameter_count) { return false; }
    if (left.native_readonly != right.native_readonly || !KrtNativeExactFunctionValue(left.native_type, right.native_type)) { return false; }
    KrtAstNode a = left.declarations; KrtAstNode b = right.declarations;
    int32 index = 0;
    while (index < left.parameter_count) {
        if (a == null || b == null || a.native_ref != b.native_ref || !KrtNativeExactFunctionValue(a, b)) { return false; }
        a = a.next; b = b.next;
        index = index + 1;
    }
    return true;
}

bool KrtNativeBindFunctionAddress(KrtAstNode node, KrtNativeBinding binding) {
    KrtAstNode target = node.left;
