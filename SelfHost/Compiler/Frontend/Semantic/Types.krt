    return hash;
}

int32 KrtGenericRegistrySlot(KrtGenericRegistry registry, KrtAstNode declaration, KrtAstNode arguments) {
    int32 slot = (int32)(KrtGenericHash(declaration,arguments) & (uint64)(registry.capacity - 1));
    int32 probes = 0;
    while (probes < registry.capacity) {
        if (registry.states[slot] == 0 || (registry.declarations[slot] == declaration && KrtNativeTypeListEqual(registry.arguments[slot],arguments))) { return slot; }
        slot = (slot + 1) & (registry.capacity - 1); probes = probes + 1;
