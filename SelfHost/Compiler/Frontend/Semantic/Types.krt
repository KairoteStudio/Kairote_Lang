bool KrtNativeBindNullCoalescing(KrtAstNode node, KrtNativeBinding binding) {
    if (!KrtNativeBindExpression(node.left,binding)) { return false; }
    if (node.left.kind != KrtAstKind.Null && !KrtNativeReferenceValue(node.left)) { return KrtNativeBindingError(binding,node); }
    if (node.right.kind == KrtAstKind.ArrayLiteral && node.left.native_array) {
