    KrtInheritanceStack inheritance = module.native_inheritance_stack;
    if (inheritance != null) { delete inheritance.types; delete inheritance.cycle_types; delete inheritance; }
    module.native_inheritance_stack = state.inheritance_stack;
    KrtDiagnosticRecord record = KrtCurrentDiagnostics.head;
    while (record != null) { KrtDiagnosticRecord next = record.next; delete record; record = next; }
    delete KrtCurrentDiagnostics; KrtCurrentDiagnostics = state.diagnostics; KrtDriverLastErrorCode = state.error_code;
    module.native_closure_probe_state = state.previous; delete state;
