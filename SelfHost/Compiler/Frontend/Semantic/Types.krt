            type.native_base = parent;
        } else { saw_interface = true; }
        if (!KrtNativeResolveInheritance(parent, module, source)) { return false; }
        if (parent.value == 3) { KrtNativeAddInterface(type, parent, 1); }
        KrtAstNode inherited = parent.native_interfaces;
        while (inherited != null) {
            KrtNativeAddInterface(type, inherited.native_type, inherited.native_offset + 1);
            inherited = inherited.next;
        }
        reference = reference.next;
    }
    return true;
}

bool KrtNativeImplements(KrtAstNode actual, KrtAstNode expected) {
    if (actual == null || expected == null || expected.value != 3) { return false; }
    if (actual == expected) { return true; }
    KrtAstNode entry = actual.native_interfaces;
    while (entry != null) {
        if (entry.native_type == expected) { return true; }
        entry = entry.next;
    }
    return false;
}

int32 KrtNativeInterfaceDistance(KrtAstNode actual, KrtAstNode expected) {
    if (actual == null || expected == null) { return -1; }
    if (actual == expected) { return 0; }
    KrtAstNode entry = actual.native_interfaces;
    while (entry != null) {
        if (entry.native_type == expected) { return entry.native_offset; }
        entry = entry.next;
    }
    return -1;
}

bool KrtNativeInterfaceMethodMatches(KrtAstNode implementation, KrtAstNode requirement, KrtAstNode module, int64 source) {
    return implementation != null && requirement != null && implementation.op != 220 &&
        !implementation.native_static && implementation.native_generic_parameters == null &&
        KrtSemanticSameName(source, implementation.name_start, implementation.name_length, requirement.name_start, requirement.name_length) &&
        KrtNativeMethodSignatureEqual(implementation, requirement, module, source, true);
}

KrtAstNode KrtNativeFindMatchingInterfaceMethod(KrtAstNode actual, KrtAstNode requirement, KrtAstNode module, int64 source) {
    while (actual != null) {
        KrtAstNode method = KrtNativeTypeMemberFirst(actual);
        while (method != null && method.native_owner == actual) {
            if (KrtNativeInterfaceMethodMatches(method, requirement, module, source) && KrtNativeAccessMode(method) == 1) { return method; }
            method = KrtNativeTypeMemberNext(method);
