    binding.guard_type = node.left; binding.guard_slot = node.local_slot;
    bool valid = KrtNativeBindExpression(node.right,binding);
    binding.guard_type = previous_type; binding.guard_slot = previous_slot;
    if (!valid) { return false; }
    KrtNativeCopyType(node,node.right);
    if (KrtNativePointerValue(node)) { node.native_nullable = true; }
    return KrtNativeCheckValueAccess(node,binding) && KrtNativeBindAggregateFrame(node,binding);
}

// ===== Function signature types =====
// Cache only successful concrete type descriptions, independently of mutable
// activation declarations and the source position of each use.
KrtNativeSignatureCache KrtNativeSignatureState(KrtAstNode function_node, KrtAstNode module, int64 source) {
    KrtNativeSignatureCache cache = function_node.native_signature_cache;
    if (cache == null || cache.module != module || cache.source != source ||
        cache.scope != function_node.native_scope || cache.using_scope != function_node.native_using_scope ||
        cache.context != function_node.native_context || cache.owner != function_node.native_owner ||
        cache.parameter_count != function_node.parameter_count) {
        cache = new KrtNativeSignatureCache();
        if (cache == null) { return null; }
        cache.module = module; cache.source = source;
        cache.scope = function_node.native_scope; cache.using_scope = function_node.native_using_scope;
        cache.context = function_node.native_context; cache.owner = function_node.native_owner;
        cache.parameter_count = function_node.parameter_count;
        cache.parameters = new KrtAstNode[function_node.parameter_count];
        cache.parameter_starts = new int64[function_node.parameter_count];
        cache.parameter_lengths = new int64[function_node.parameter_count];
        if (cache.parameters == null || cache.parameter_starts == null || cache.parameter_lengths == null) {
            delete cache.parameters; delete cache.parameter_starts; delete cache.parameter_lengths;
            delete cache; return null;
        }
        function_node.native_signature_cache = cache;
    }
    return cache;
}

bool KrtNativeSignatureTypeCore(KrtAstNode target, KrtAstNode function_node, int32 index, KrtAstNode module, int64 source) {
    target.native_scope = function_node.native_scope; target.native_context = function_node.native_context;
    target.native_using_scope = function_node.native_using_scope;
    if (index < -1 || index >= function_node.parameter_count) { return false; }
    int64 start = index < 0 ? function_node.type_start : function_node.parameter_type_starts[index];
    int64 length = index < 0 ? function_node.type_length : function_node.parameter_type_lengths[index];
    // Layout probes deliberately permit unresolved nominal layouts. Their
    // provisional descriptions must never replace a settled signature shape.
    if (KrtNativeLayoutProbe || module.native_closure_probe_state != null) { return KrtNativeAnnotateType(target,module,source,start,length); }
    KrtNativeSignatureCache cache = KrtNativeSignatureState(function_node,module,source);
    if (cache == null) { return KrtNativeAnnotateType(target,module,source,start,length); }
    KrtAstNode description = null;
    if (index < 0) {
        if (cache.return_start == start && cache.return_length == length) { description = cache.result; }
    } else if (cache.parameter_starts[index] == start && cache.parameter_lengths[index] == length) {
        description = cache.parameters[index];
    }
    if (description != null) {
        KrtNativeCopyType(target,description);
        // File-private and owner access depend on this use's position, even
        // when the declaration's complete type shape was resolved earlier.
        return KrtNativeFinishTypeAnnotation(target,module,source);
    }
    if (!KrtNativeAnnotateType(target,module,source,start,length)) { return false; }
    description = new KrtAstNode();
    if (description == null) { return true; }
    description.kind = KrtAstKind.Type;
    KrtNativeCopyType(description,target);
    if (index < 0) {
        cache.return_start = start; cache.return_length = length; cache.result = description;
    } else {
        cache.parameter_starts[index] = start; cache.parameter_lengths[index] = length;
        cache.parameters[index] = description;
    }
    return true;
}

bool KrtNativeSignatureType(KrtAstNode target, KrtAstNode function_node, int32 index, KrtAstNode module, int64 source) {
    KrtAstNode closure = function_node.native_closure_signature;
    if (closure == null && function_node.native_closure_shape) { closure = function_node; }
    if (closure != null) {
        if (index < -1 || index >= closure.parameter_count) { return false; }
        KrtAstNode description = closure.native_type;
        if (index >= 0) {
            description = closure.declarations; int32 parameter = 0;
            while (description != null && parameter < index) { description = description.next; parameter = parameter + 1; }
        }
        if (description == null) { return false; }
        target.native_scope = function_node.native_scope; target.native_context = function_node.native_context;
        target.native_using_scope = function_node.native_using_scope;
        KrtNativeCopyType(target,description);
        return KrtNativeFinishTypeAnnotation(target,module,source);
    }
    if (!KrtNativeSignatureTypeCore(target,function_node,index,module,source)) { return false; }
    // Prepared callback shapes retain their value's naming contract, including
    // nested callbacks. Re-resolving layout/access must not restore labels
    // erased by a dynamic choice from its original source or generic context.
    if (function_node.native_type != null && function_node.native_type.kind == KrtAstKind.Type) {
        KrtAstNode contract = function_node.native_type;
        if (index >= 0) {
            contract = function_node.declarations; int32 position = 0;
            while (contract != null && position < index) { contract = contract.next; position = position + 1; }
        }
        if (contract != null) { KrtNativeMergeCallbackLabels(target,target,contract,source); }
    }
    return true;
}

// ===== Value type layout =====
// Layout discovery walks an explicit work stack. Only fields stored by value
// create layout dependencies; pointers and reference values break cycles.
static bool KrtNativeLayoutProbe = false;

bool KrtNativeAggregateKind(KrtAstNode node) {
    return node != null && node.native_type != null && node.native_type.value == 2 &&
        node.native_pointer_depth == 0 && !node.native_array && !node.native_string;
}

bool KrtNativeInlineValue(KrtAstNode node) {
    return node != null && (KrtNativeAggregateKind(node) || node.native_fixed_length > 0 || KrtNativeWideKind(node));
}

int32 KrtNativeAlignStorage(int32 size, int32 alignment) {
    if (size < 0 || size > 16777216 || alignment <= 0 || alignment > 16 || (alignment & (alignment - 1)) != 0) { return -1; }
    int32 result = (size + alignment - 1) & ~(alignment - 1);
    return result <= 16777216 ? result : -1;
}

bool KrtNativeLayoutError(KrtAstNode module, KrtAstNode type, KrtAstNode field) {
    type.native_layout_state = 3; module.native_error = 12;
    int64 position = type.start; if (field != null) { position = field.type_start; }
    KrtDiagnostic("E_LAYOUT",8,position); return false;
}

int32 KrtNativeValueStorage(KrtAstNode node) {
    if (node.native_fixed_length > 0) { return node.native_storage_size; }
    if (KrtNativeAggregateKind(node)) { return node.native_type.native_storage_size; }
    if (KrtNativeWideKind(node)) { return 16; }
    if (node.native_array || node.native_pointer_depth > 0 || node.native_type != null || node.native_string || node.native_function_pointer != null) { return 8; }
    return node.kind == KrtAstKind.Member && node.element_width > 0 ? node.element_width : node.native_width;
}

int32 KrtNativeValueAlignment(KrtAstNode node) {
    if (node.native_fixed_length > 0) { return node.native_alignment; }
    if (KrtNativeAggregateKind(node)) { return node.native_type.native_alignment; }
    int32 size = KrtNativeValueStorage(node); return size > 16 ? 16 : size;
}

void KrtNativeDescribeAggregate(KrtAstNode node) {
    if (KrtNativeWideKind(node)) {
        node.native_storage_size = 16; node.native_alignment = 16; return;
    }
    if (!KrtNativeAggregateKind(node)) { return; }
    node.native_aggregate = true; node.native_storage_size = node.native_type.native_storage_size;
    node.native_alignment = node.native_type.native_alignment; node.native_size = node.native_storage_size;
    node.native_base_width = node.native_storage_size; node.native_width = 8;
}

bool KrtNativeResolveLayout(KrtAstNode root, KrtAstNode module, int64 source) {
    if (root.native_layout_state == 2) { return true; }
    if (root.native_layout_state != 0 || root.native_generic_parameters != null) { return false; }
    int32 capacity = 32;
    KrtAstNode[] types = new KrtAstNode[capacity]; KrtAstNode[] fields = new KrtAstNode[capacity];
    int32[] offsets = new int32[capacity]; int32[] alignments = new int32[capacity];
    int32 depth = 0; types[0] = root;
    while (depth >= 0) {
        KrtAstNode type = types[depth];
        if (type.native_layout_state == 0) {
            KrtNativeClosureProbeType(module,type);
            type.native_layout_state = 1; fields[depth] = type.body;
            offsets[depth] = type.value == 1 ? (type.native_base == null ? 8 : type.native_base.native_size) : 0;
            alignments[depth] = type.value == 1 ? 8 : 1;
        }
        KrtAstNode field = fields[depth];
        if (field == null) {
            int32 size = KrtNativeAlignStorage(offsets[depth],alignments[depth]);
            if (size < 0) { return KrtNativeLayoutError(module,type,null); }
            if (size == 0) { size = 1; }
            type.native_storage_size = size; type.native_alignment = alignments[depth]; type.native_size = size;
            type.native_layout_state = 2; depth = depth - 1; continue;
        }
        field.native_owner = type; field.native_context = type;
        if (field.native_static) { fields[depth] = field.next; continue; }
        bool previous_probe = KrtNativeLayoutProbe; KrtNativeLayoutProbe = true;
        bool valid = KrtNativeAnnotateType(field,module,source,field.type_start,field.type_length);
        KrtNativeLayoutProbe = previous_probe;
        if (!valid) { return KrtNativeLayoutError(module,type,field); }
        KrtAstNode dependency = field.native_type;
        bool inline_struct = KrtNativeAggregateKind(field);
        if (field.syntax_array_size != null && field.native_type != null && field.native_type.value == 2 && field.native_pointer_depth == 0) { inline_struct = true; }
        if (inline_struct && dependency.native_layout_state != 2) {
            if (dependency.native_layout_state != 0 || dependency.native_generic_parameters != null) { return KrtNativeLayoutError(module,type,field); }
            if (depth + 1 >= capacity) {
                int32 expanded = capacity * 2; if (expanded > 16384) { return KrtNativeLayoutError(module,type,field); }
                KrtAstNode[] next_types = new KrtAstNode[expanded]; KrtAstNode[] next_fields = new KrtAstNode[expanded];
                int32[] next_offsets = new int32[expanded]; int32[] next_alignments = new int32[expanded]; int32 index = 0;
                while (index < capacity) {
                    next_types[index] = types[index]; next_fields[index] = fields[index];
                    next_offsets[index] = offsets[index]; next_alignments[index] = alignments[index]; index = index + 1;
                }
                delete types; delete fields; delete offsets; delete alignments;
                types = next_types; fields = next_fields; offsets = next_offsets; alignments = next_alignments; capacity = expanded;
            }
            depth = depth + 1; types[depth] = dependency; continue;
        }
        KrtNativeDescribeAggregate(field);
        int32 size = KrtNativeValueStorage(field); int32 alignment = KrtNativeValueAlignment(field);
        if (type.value == 1 && !KrtNativeInlineValue(field)) { size = 8; alignment = 8; }
        if (field.syntax_array_size != null) {
            KrtAstNode element = KrtAstMake(KrtAstKind.Type,field.start,0); KrtNativeCopyType(element,field);
            int64 count = 0;
            KrtNativeBinding constants = new KrtNativeBinding(); constants.module = module; constants.source = source; constants.error_start = -1;
            constants.unit = KrtAstMake(KrtAstKind.Function,field.start,0); constants.unit.native_owner = type;
            constants.unit.native_static = true; constants.unit.native_scope = field.native_scope; constants.unit.native_context = type;
            constants.using_scope = field.native_using_scope;
            if (!KrtNativeBindExpression(field.syntax_array_size,constants)) { return KrtNativeLayoutError(module,type,field); }
            if (!KrtIrTryEvaluateConstant(field.syntax_array_size,ref count) || count <= 0 || count > 16777216) { return KrtNativeLayoutError(module,type,field); }
            // The declarator is an inline array of the preceding value type.
            size = KrtNativeValueStorage(field); alignment = KrtNativeValueAlignment(field);
            if (size <= 0 || count > 16777216 / size) { return KrtNativeLayoutError(module,type,field); }
            field.native_fixed_length = (int32)count; field.native_stride = size;
            field.native_element_type = element;
            field.native_storage_size = size * (int32)count; field.native_alignment = alignment;
            field.native_array = true; field.native_width = 8; field.native_aggregate = false;
            // Nullability belongs to the element copied above. Inline array
            // storage has no nullable reference or pointer slots of its own.
            field.native_nullable = false; field.native_pointee_nullable = 0;
            field.native_element_unsigned = field.native_unsigned; field.native_unsigned = false;
            field.native_element_boolean = field.native_boolean; field.native_boolean = false;
            field.native_element_character = field.native_character; field.native_character = false;
            field.native_element_string = field.native_string; field.native_string = false;
            size = field.native_storage_size;
        } else { field.native_storage_size = size; field.native_alignment = alignment; }
        int32 offset = KrtNativeAlignStorage(offsets[depth],alignment);
        if (offset < 0 || size <= 0 || offset > 16777216 - size) { return KrtNativeLayoutError(module,type,field); }
        field.native_offset = offset; offsets[depth] = offset + size;
        if (alignment > alignments[depth]) { alignments[depth] = alignment; }
        fields[depth] = field.next;
    }
    delete types; delete fields; delete offsets; delete alignments; return true;
}

int32 KrtNativeReserveFrame(KrtNativeBinding binding, KrtAstNode type) {
    int32 offset = KrtNativeAlignStorage(binding.unit.native_frame_bytes,type.native_alignment);
    if (offset < 0 || type.native_storage_size <= 0 || offset > 16777216 - type.native_storage_size) { return -1; }
    binding.unit.native_frame_bytes = offset + type.native_storage_size; return offset;
}

bool KrtNativeBindAggregateFrame(KrtAstNode node, KrtNativeBinding binding) {
    if (!KrtNativeInlineValue(node)) { return true; }
    KrtNativeDescribeAggregate(node);
    if (node.native_frame_offset < 0) { node.native_frame_offset = KrtNativeReserveFrame(binding,node); }
    return node.native_frame_offset >= 0 || KrtNativeBindingError(binding,node);
}

// ===== Switch binding and flow =====
bool KrtNativeSwitchError(KrtAstNode node, KrtNativeBinding binding) {
    binding.module.native_error = 7;
    return KrtNativeBindingError(binding, node);
}

int64 KrtNativeSwitchStringByte(int64 source, KrtAstNode literal, ref int64 index) {
    if (index >= literal.length - 1) { return -1; }
    unsafe(using krt.mem;) {
        byte* text = (byte*)source; int64 value = text[literal.start + index]; index = index + 1;
        if (value == 92 && index < literal.length - 1) {
            value = text[literal.start + index]; index = index + 1;
            if (value == 110) { value = 10; }
            else if (value == 114) { value = 13; }
            else if (value == 116) { value = 9; }
            else if (value == 48) { value = 0; }
        }
        return value;
    }
}

bool KrtNativeSwitchSameConstant(KrtAstNode first, KrtAstNode second, int64 source) {
    if (first.kind == KrtAstKind.String && second.kind == KrtAstKind.String) {
        int64 left = 1; int64 right = 1;
        while (true) {
            int64 a = KrtNativeSwitchStringByte(source, first, ref left);
            int64 b = KrtNativeSwitchStringByte(source, second, ref right);
            if (a != b) { return false; }
            if (a <= 0) { return true; }
        }
    }
    if (KrtNativeFloatKind(first) != 0 || KrtNativeFloatKind(second) != 0) {
        if (first.kind != KrtAstKind.Floating || second.kind != KrtAstKind.Floating ||
            KrtNativeFloatKind(first) != KrtNativeFloatKind(second)) { return false; }
        int64 left_bits = 0; int64 right_bits = 0;
        return KrtNativeFloatingBits(first, source, ref left_bits) && KrtNativeFloatingBits(second, source, ref right_bits) && left_bits == right_bits;
    }
    if (KrtNativeWideKind(first) || KrtNativeWideKind(second)) {
        if (first.kind != KrtAstKind.Integer || second.kind != KrtAstKind.Integer) { return false; }
        int64 left_high = KrtNativeWideKind(first) ? first.native_high : first.value < 0 ? -1 : 0;
        int64 right_high = KrtNativeWideKind(second) ? second.native_high : second.value < 0 ? -1 : 0;
        return first.value == second.value && left_high == right_high;
    }
    int64 left_value = 0; int64 right_value = 0;
    return KrtIrTryEvaluateConstant(first, ref left_value) && KrtIrTryEvaluateConstant(second, ref right_value) && left_value == right_value;
}

bool KrtNativeBindSwitch(KrtAstNode statement, KrtNativeBinding binding) {
    if (!KrtNativeBindExpression(statement.left, binding)) { return false; }
    statement.local_slot = binding.slots; binding.slots = binding.slots + 1;
    KrtAstNode saved = KrtAstMake(KrtAstKind.Identifier, statement.left.start, statement.left.length);
    KrtNativeCopyType(saved, statement.left); saved.local_slot = statement.local_slot;
    if (!KrtNativeBindAggregateFrame(saved, binding)) { return false; }
    statement.native_target = saved;
    bool has_default = false; KrtAstNode clause = statement.right;
    while (clause != null) {
        clause.native_offset = -1;
        if (clause.kind == KrtAstKind.Default) {
            if (has_default) { return KrtNativeSwitchError(clause, binding); }
            has_default = true;
        } else {
            if (clause.kind != KrtAstKind.Case || !KrtNativeBindExpression(clause.left, binding)) { return false; }
            if (!KrtNativeCompatibleValue(saved, clause.left) && !KrtNativeCompatibleValue(clause.left, saved)) { return KrtNativeSwitchError(clause.left, binding); }
            KrtAstNode previous = statement.right;
            while (previous != clause) {
                if (previous.kind == KrtAstKind.Case && KrtNativeSwitchSameConstant(previous.left, clause.left, binding.source)) { return KrtNativeSwitchError(clause.left, binding); }
                previous = previous.next;
            }
            KrtAstNode comparison = KrtAstMakeBinary(61, saved, clause.left);
            comparison.native_bits = 8; comparison.native_boolean = true; comparison.native_unsigned = true; comparison.native_width = 1;
            clause.native_target = comparison;
        }
        if (!KrtNativeBindBlock(clause.right, binding)) { return false; }
        clause = clause.next;
    }
    return true;
}

// Outcomes are normal completion (1), return/throw (2), break (4), and
// continue (8). Follow normal paths into the next source-order case body.
// Loops may complete normally; their break/continue belong to that loop.
int32 KrtNativeSwitchStatementFlow(KrtAstNode statement) {
    if (statement == null) { return 1; }
    if (statement.kind == KrtAstKind.Return || statement.kind == KrtAstKind.Throw || statement.kind == KrtAstKind.YieldBreak) { return 2; }
    if (statement.kind == KrtAstKind.Break) { return 4; }
    if (statement.kind == KrtAstKind.Continue) { return 8; }
    if (statement.kind == KrtAstKind.Unsafe || statement.kind == KrtAstKind.Point) { return KrtNativeSwitchStatementFlow(statement.left); }
    if (statement.kind == KrtAstKind.If) {
        return KrtNativeSwitchStatementFlow(statement.right) | KrtNativeSwitchStatementFlow(statement.alternate);
    }
    if (statement.kind == KrtAstKind.Block) {
        int32 outcomes = 1; KrtAstNode child = statement.left;
        while (child != null && (outcomes & 1) != 0) {
            outcomes = (outcomes & 14) | KrtNativeSwitchStatementFlow(child);
            child = child.next;
        }
        return outcomes;
    }
    if (statement.kind == KrtAstKind.Try) {
        int32 outcomes = KrtNativeSwitchStatementFlow(statement.left);
        KrtAstNode clause = statement.right;
        while (clause != null) {
            outcomes = outcomes | KrtNativeSwitchStatementFlow(clause.right); clause = clause.next;
        }
        if (statement.alternate != null) {
            int32 cleanup = KrtNativeSwitchStatementFlow(statement.alternate);
            outcomes = (cleanup & 14) | ((cleanup & 1) != 0 ? outcomes : 0);
        }
        return outcomes;
    }
    if (statement.kind == KrtAstKind.Switch) {
        int32 outcomes = KrtNativeSwitchOutcomes(statement);
        return (outcomes & 11) | ((outcomes & 4) != 0 ? 1 : 0);
    }
    return 1;
}

int32 KrtNativeSwitchClauseFlow(KrtAstNode clause) {
    if (clause == null) { return 1; }
    int32 outcomes = KrtNativeSwitchStatementFlow(clause.right);
    if ((outcomes & 1) != 0) {
        outcomes = (outcomes & 14) | KrtNativeSwitchClauseFlow(clause.next);
    }
    return outcomes;
}

int32 KrtNativeSwitchOutcomes(KrtAstNode statement) {
    bool has_default = false; int32 outcomes = 0; KrtAstNode clause = statement.right;
    while (clause != null) {
        if (clause.kind == KrtAstKind.Default) { has_default = true; }
        outcomes = outcomes | KrtNativeSwitchClauseFlow(clause); clause = clause.next;
    }
    return outcomes | (has_default ? 0 : 1);
}

bool KrtNativeSwitchAlwaysReturns(KrtAstNode statement) {
    return KrtNativeSwitchOutcomes(statement) == 2;
}
