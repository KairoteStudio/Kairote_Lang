void KrtNativeNormalizeQualifiedSyscall(KrtAstNode node, KrtNativeBinding binding) {
    KrtAstNode callee = node.left;
    if (callee == null || callee.kind != KrtAstKind.Member ||
        !KrtNativeSpanWord(binding.source, callee.name_start, callee.name_length, "syscall")) { return; }
    KrtAstNode owner = KrtNativeExpressionTypeName(callee.left, binding);
    if (owner == null || !KrtNativeSpanWord(binding.source, owner.name_start, owner.name_length, "Sys")) { return; }
    // An explicitly declared method still wins. The runtime also exposes the
    // native intrinsic as Sys.syscall, alongside its ordinary Syscall wrapper.
    KrtAstNode method = owner.declarations;
    while (method != null) {
        if (KrtSemanticSameName(binding.source, method.name_start, method.name_length, callee.name_start, callee.name_length)) { return; }
        method = method.next;
    }
    node.left = KrtAstMake(KrtAstKind.Identifier, callee.name_start, callee.name_length);
}

// ===== Generic type binding and inference =====
int32 KrtNativeTypeBaseWidth(KrtAstNode type) {
    if (type.native_element_type == null && type.native_type != null && type.native_type.value == 2 && type.native_type.native_layout_state == 2) { return type.native_type.native_storage_size; }
    if (type.native_base_width > 0) { return type.native_base_width; }
    if (type.native_function_pointer != null || type.native_type != null || type.native_string || type.native_element_string) { return 8; }
    if (type.native_float > 0) { return type.native_float; }
    if (type.native_bits > 0) {
        int32 width = 1; while (width * 8 < type.native_bits) { width = width * 2; } return width;
    }
    if (type.native_stride > 0) { return type.native_stride; }
    return type.native_width;
}

bool KrtNativeTypeEqualDepth(KrtAstNode left, KrtAstNode right, int32 depth) {
    if (left == right) { return true; }
    if (left == null || right == null || depth > 64) { return false; }
    if (left.native_fixed_length != right.native_fixed_length || (left.native_fixed_length > 0 &&
