        bool visible = owner == null ? (candidate.native_owner == null || candidate.native_owner == binding.unit.native_owner || KrtNativeDerivesFrom(binding.unit.native_owner,candidate.native_owner)) :
            candidate.native_owner == owner || KrtNativeDerivesFrom(owner,candidate.native_owner);
        bool unbound_struct=target.kind==KrtAstKind.Member&&owner!=null&&owner.value==2&&
            candidate.native_owner!=null&&!candidate.native_static;
        if (visible && (candidate.native_owner == null || candidate.native_static || unbound_struct) &&
            KrtSemanticSameName(binding.source, start, length, candidate.name_start, candidate.name_length)) {
            int64 priority = KrtNativeFunctionScopeScore(candidate,target,binding);
            KrtAstNode receiver_type = owner == null ? binding.unit.native_owner : owner;
            if (candidate.native_owner != null && receiver_type != null) { priority = priority - KrtNativeInheritanceDistance(receiver_type,candidate.native_owner); }
            if (priority >= 0) {
                if (!KrtNativeAccessAllowed(candidate,binding,owner,false)) { inaccessible = true; }
                else {
                    int32 file_score = KrtNativeNameFilePriority(candidate,binding.unit.start);
                    if (candidate.native_generic_parameters != null || (selected != null && priority == best && file_score == best_file)) { return false; }
                    if (priority > best || (priority == best && file_score > best_file)) { selected = candidate; best = priority; best_file = file_score; }
                }
