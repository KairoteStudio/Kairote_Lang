// Generic instance registry and type identity.
uint64 KrtGenericTypeHash(KrtAstNode type, uint64 hash, int32 depth) {
    if (type == null || depth > 64) { return (hash ^ 0) * 1099511628211; }
    // Layout-derived widths and strides can settle after registration. Keep
    // the bucket key nominal; exact type equality resolves these collisions.
    hash = (hash ^ (uint64)(int64)type.native_type) * 1099511628211;
    hash = (hash ^ (uint64)type.native_bits) * 1099511628211;
    hash = (hash ^ type.native_pointee_nullable) * 1099511628211;
    hash = (hash ^ (uint64)type.native_pointer_depth) * 1099511628211;
    hash = (hash ^ (uint64)type.native_fixed_length) * 1099511628211;
    if (type.native_element_type != null) { hash = KrtGenericTypeHash(type.native_element_type,hash,depth + 1); }
    int32 flags = 0;
    if (type.native_unsigned) { flags = flags | 1; }
    if (type.native_array) { flags = flags | 2; }
    if (type.native_string) { flags = flags | 4; }
    if (type.native_boolean) { flags = flags | 8; }
    if (type.native_wide) { flags = flags | 16; }
    if (type.native_element_unsigned) { flags = flags | 32; }
    if (type.native_element_boolean) { flags = flags | 64; }
    if (type.native_element_string) { flags = flags | 128; }
    if (type.native_void_pointer) { flags = flags | 256; }
    if (type.native_character) { flags = flags | 512; }
    if (type.native_element_character) { flags = flags | 1024; }
    if (type.native_nullable) { flags = flags | 2048; }
    flags = flags | (type.native_float << 16);
    hash = (hash ^ (uint64)flags) * 1099511628211;
    KrtAstNode signature = type.native_function_pointer;
    if (signature == null) { return (hash ^ 0) * 1099511628211; }
    hash = (hash ^ (uint64)(signature.parameter_count + 1)) * 1099511628211;
    hash = (hash ^ (uint64)(signature.native_readonly ? 1 : 0)) * 1099511628211;
    hash = KrtGenericTypeHash(signature.native_type,hash,depth + 1);
    KrtAstNode parameter = signature.declarations;
    while (parameter != null) {
        hash = (hash ^ (uint64)(parameter.native_ref ? 1 : 0)) * 1099511628211;
        hash = KrtGenericTypeHash(parameter,hash,depth + 1); parameter = parameter.next;
    }
    return hash;
}

uint64 KrtGenericHash(KrtAstNode declaration, KrtAstNode arguments) {
    uint64 hash = ((uint64)(int64)declaration >> 3) ^ 14695981039346656037;
    while (arguments != null) {
        hash = KrtGenericTypeHash(arguments,hash,0); arguments = arguments.next;
