        KrtNativeCopyType(node,node.right);
        if (node.right.kind == KrtAstKind.Null) { node.kind = KrtAstKind.Null; }
        return KrtNativeCheckValueAccess(node,binding) && KrtNativeBindAggregateFrame(node,binding);
    }
    if (node.right.kind == KrtAstKind.Null) {
        KrtNativeCopyType(node,node.left); node.native_nullable = true;
        return KrtNativeCheckValueAccess(node,binding);
    }
    if (KrtNativeObjectValue(node.right) && KrtNativeCompatibleValue(node.right,node.left)) {
        KrtNativeCopyType(node,node.right);
        node.native_stack_borrow = node.left.native_stack_borrow || node.right.native_stack_borrow;
        return KrtNativeCheckValueAccess(node,binding);
    }
    KrtAstNode contextual = node.native_closure_expected_type != null ? node.native_closure_expected_type : node.left;
    if (KrtNativeReferenceObjectValue(contextual) && KrtNativeCompatibleValue(contextual,node.left) &&
        KrtNativeCompatibleValue(contextual,node.right) &&
        (KrtNativeObjectConversion(contextual,node.right) || KrtNativeBoxingConversion(contextual,node.right))) {
        KrtNativeCopyType(node,contextual);
        node.native_stack_borrow = node.left.native_stack_borrow || node.right.native_stack_borrow;
        return KrtNativeCheckValueAccess(node,binding);
    }
    if (!KrtNativeReferenceValue(node.right)) { return KrtNativeBindingError(binding,node); }
    KrtNativeCopyType(node,node.left);
    node.native_stack_borrow = node.left.native_stack_borrow || node.right.native_stack_borrow;
    if (KrtNativePointerValue(node.left) || KrtNativePointerValue(node.right)) {
        if (!KrtNativePointerEqualIgnoringOuter(node.left,node.right)) { return KrtNativeBindingError(binding,node); }
    } else if (node.left.native_array || node.right.native_array || node.left.native_string || node.right.native_string) {
        if (!KrtNativePointerEqualIgnoringOuter(node.left,node.right)) { return KrtNativeBindingError(binding,node); }
    } else {
        KrtAstNode common = node.left.native_type;
        if (KrtNativeDerivesFrom(common,node.right.native_type)) { common = node.right.native_type; }
        while (common != null && !KrtNativeDerivesFrom(node.right.native_type,common)) { common = common.native_base; }
        if (common == null) { return KrtNativeBindingError(binding,node); }
        node.native_type = common; node.native_size = common.native_size;
    }
    node.native_nullable = node.right.native_nullable;
    KrtNativeMergeCallbackLabels(node,node.left,node.right,binding.source);
