// ===== Native ABI signatures =====
// ABI2 contracts are canonical bytes, independent of source positions and AST
// identities. Digests name symbols; exact manifests decide compatibility.
class KrtAbiBytes {
    public byte[] data;
    public int32 count;
    public int32 capacity;
    public bool ok;
}
class KrtAbiType {
    public KrtAstNode declaration;
    public KrtAbiBytes identity;
    public KrtAbiBytes layout;
