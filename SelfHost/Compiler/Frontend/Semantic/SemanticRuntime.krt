void KrtAbiWord(KrtAbiBytes bytes,int32 value){int32 index=0;while(index<4){KrtAbiByte(bytes,(value>>(index*8))&255);index=index+1;}}
void KrtAbiLong(KrtAbiBytes bytes,uint64 value){int32 index=0;while(index<8){KrtAbiByte(bytes,(int32)((value>>(index*8))&255));index=index+1;}}
