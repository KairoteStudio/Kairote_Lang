int32 KrtAbiCompare(KrtAbiBytes left,KrtAbiBytes right){int32 index=0;while(index<left.count&&index<right.count){if(left.data[index]!=right.data[index]){return(int32)left.data[index]-(int32)right.data[index];}index=index+1;}return left.count-right.count;}
