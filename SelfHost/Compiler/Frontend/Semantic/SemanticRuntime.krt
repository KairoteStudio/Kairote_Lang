    if ((!indirect && type.native_character) || (indirect && type.native_element_character)) { KrtLinkByte(name, 99); return; }
    bool boolean_value = indirect ? type.native_element_boolean : type.native_boolean;
    bool unsigned_value = indirect ? type.native_element_unsigned : type.native_unsigned;
    if (boolean_value) { KrtLinkByte(name, 98); return; }
