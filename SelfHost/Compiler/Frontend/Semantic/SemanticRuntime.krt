KrtLinkName KrtNativeFunctionLinkName(KrtAstNode function_node, KrtAstNode module, int64 source, bool include_result) {
    KrtAbiSignature signature=KrtAbiFunction(function_node,module,source,include_result);
    if(signature.supported&&signature.contract.ok&&signature.uses_struct){return KrtAbiLinkName(signature);}
    return KrtNativeFunctionLinkNameLegacy(function_node,module,source,include_result);
}

bool KrtLinkNamesEqual(KrtLinkName first, KrtLinkName second) {
    if (!first.valid || !second.valid || first.length != second.length) { return false; }
    byte[] a = first.bytes; byte[] b = second.bytes; int32 index = 0;
    while (index < first.length) { if (a[index] != b[index]) { return false; } index = index + 1; } return true;
}

bool KrtNativeAbiDeferredOwner(KrtAstNode declaration) {
    return declaration.native_generic_parameters==null&&declaration.native_owner!=null&&
        declaration.native_owner.native_generic_parameters!=null;
}

// Repeated prototypes and a matching definition share one semantic function.
// Return-type disagreement is rejected even though overload lookup ignores it.
bool KrtNativeResolvePrototypes(KrtAstNode module, int64 source) {
    KrtAstNode previous = null; KrtAstNode candidate = module.left;
    while (candidate != null) {
