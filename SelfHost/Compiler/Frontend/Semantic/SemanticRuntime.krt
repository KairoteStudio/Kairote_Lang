class KrtAbiSignature {
    public KrtAbiBytes nominal;
    public KrtAbiBytes contract;
    public KrtAbiType types;
    public bool supported;
    public bool uses_struct;
    public bool uses_named;
    public KrtAstNode module;
    public bool weak;
    public bool uses_wide_physical;
}

KrtAbiBytes KrtAbiNew() {
