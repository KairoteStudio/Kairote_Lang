    bool settled=declaration.value==4||declaration.value==5||declaration.native_layout_state==2;
    bool exported=declaration.value==5||KrtNativeAccessExported(declaration);
    if(declaration.value<1||declaration.value>5||declaration.native_generic_parameters!=null||!settled||(!exported&&!signature.uses_named)){signature.supported=false;return null;}
    KrtAbiBytes identity=declaration.value==2&&exported?KrtAbiTypeIdentity(declaration,source):KrtModuleTypeIdentity(declaration,source);KrtAbiType item=signature.types;KrtAbiType previous=null;
    while(item!=null){int32 order=KrtAbiCompare(identity,item.identity);if(order==0){return item;}if(order<0){break;}previous=item;item=item.next;}
    KrtAbiType inserted=new KrtAbiType();inserted.declaration=declaration;inserted.identity=identity;inserted.next=item;
    if(previous==null){signature.types=inserted;}else{previous.next=inserted;}return inserted;
}

bool KrtAbiWidePhysicalBoundary(KrtAstNode type,int32 depth){
    if(type==null||depth>64){return false;}
    if(KrtNativeWideKind(type)){return true;}
    if(type.native_array||type.native_pointer_depth>0||type.native_fixed_length>0){return KrtAbiWideCallback(type,depth+1);}
    return type.native_function_pointer!=null&&KrtAbiWideFunctionShape(type.native_function_pointer,depth+1);
}

bool KrtAbiWideCallback(KrtAstNode type,int32 depth){
    if(type==null||depth>64){return false;}
    if(type.native_array||type.native_pointer_depth>0||type.native_fixed_length>0){return KrtAbiWideCallback(KrtNativeArrayElement(type),depth+1);}
    return type.native_function_pointer!=null&&KrtAbiWideFunctionShape(type.native_function_pointer,depth+1);
}

bool KrtAbiWideFunctionShape(KrtAstNode shape,int32 depth){
    if(shape==null||depth>64){return false;}KrtAstNode parameter=shape.declarations;
    while(parameter!=null){if(KrtAbiWidePhysicalBoundary(parameter,depth+1)){return true;}parameter=parameter.next;}
    return !shape.native_readonly&&KrtAbiWidePhysicalBoundary(shape.native_type,depth+1);
}

void KrtAbiMarkWidePhysical(KrtAbiSignature signature){
    signature.uses_wide_physical=true;signature.uses_named=true;signature.uses_struct=true;
