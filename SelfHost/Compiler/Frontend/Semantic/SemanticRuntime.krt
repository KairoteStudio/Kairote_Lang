    }
    if(type.native_array){KrtAbiByte(bytes,65);KrtAbiWord(bytes,KrtNativeSemanticStride(type));KrtAbiShape(bytes,KrtNativeArrayElement(type),signature,source,depth+1);return;}
    if(type.native_string){KrtAbiByte(bytes,83);return;}
    if(type.native_pointer_depth>0||type.native_stride>0){KrtAbiByte(bytes,80);KrtAbiWord(bytes,KrtNativeSemanticStride(type));KrtAbiShape(bytes,KrtNativeArrayElement(type),signature,source,depth+1);return;}
    if(type.native_void_pointer){KrtAbiByte(bytes,86);return;}
    if(type.native_function_pointer!=null){
        KrtAstNode shape=type.native_function_pointer;bool wide=KrtAbiWideFunctionShape(shape,0);if(wide){KrtAbiMarkWidePhysical(signature);}
        KrtAbiByte(bytes,102);KrtAbiWord(bytes,wide?3:2);KrtAbiWord(bytes,shape.parameter_count);
        KrtAstNode parameter=shape.declarations;while(parameter!=null){KrtAbiShape(bytes,parameter,signature,source,depth+1);parameter=parameter.next;}
        KrtAbiByte(bytes,shape.native_readonly?1:0);if(!shape.native_readonly){KrtAbiShape(bytes,shape.native_type,signature,source,depth+1);}return;
    }
    if(type.native_type!=null){
        KrtAbiType item=KrtAbiRegister(signature,type.native_type,source);if(item==null){bytes.ok=false;return;}
        KrtAbiByte(bytes,type.native_type.value==2?67:78);KrtAbiAppend(bytes,item.identity);KrtAbiWord(bytes,type.native_type.native_storage_size);KrtAbiWord(bytes,type.native_type.native_alignment);return;
