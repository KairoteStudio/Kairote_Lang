                if(processed>=16384){result.supported=false;result.contract.ok=false;break;}processed=processed+1;pending=true;
                item.layout=KrtAbiNew();KrtAbiAppend(item.layout,item.identity);KrtAstNode type=item.declaration;
                KrtAbiWord(item.layout,type.native_storage_size);KrtAbiWord(item.layout,type.native_alignment);
