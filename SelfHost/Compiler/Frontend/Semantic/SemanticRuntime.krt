        if(closure==null&&function_node.native_closure_shape){closure=function_node;}
        bool result_void=closure!=null?closure.native_readonly:
            (function_node.type_length==0||KrtNativeSpanWord(source,function_node.type_start,function_node.type_length,"void"));
        if (result_void) { KrtLinkByte(name, 118); }
