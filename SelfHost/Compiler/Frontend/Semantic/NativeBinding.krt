void KrtNativeElementType(KrtAstNode element, KrtAstNode array) {
    if (array.native_element_type != null) {
        KrtNativeCopyType(element,array.native_element_type);
        KrtNativeInheritStackBorrow(element,array); return;
    }
    KrtNativeCopyType(element,array);
