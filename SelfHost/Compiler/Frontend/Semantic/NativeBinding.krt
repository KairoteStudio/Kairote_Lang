// Index nodes retain their address scale separately from their result type.
bool KrtNativePointerOffset(KrtAstNode node) {
    return node != null && node.kind != KrtAstKind.Null && KrtNativeSemanticStride(node) == 0 &&
        KrtNativeFloatKind(node) == 0 && !KrtNativeWideKind(node) && !node.native_boolean &&
        node.native_function_pointer == null && (node.native_type == null || node.native_type.value == 4);
}

int32 KrtNativeSemanticStride(KrtAstNode node) {
    if (node == null) { return 0; }
    if (node.native_element_type != null && (node.native_fixed_length > 0 || node.native_array || node.native_pointer_depth > 0)) {
        return KrtNativeValueStorage(node.native_element_type);
    }
    // Pointer fields can be annotated while their pointee layout is pending.
    // Resolve the scale from the completed type, rather than that cached width.
    if (node.native_type != null && node.native_type.value == 2 && node.native_type.native_layout_state == 2) {
        if (node.native_pointer_depth > 1 || (node.native_array && node.native_pointer_depth > 0)) { return 8; }
        if (node.native_array || node.native_pointer_depth == 1) { return node.native_type.native_storage_size; }
    }
    return node.native_stride;
}

// Literal casts remain eligible for the numeric coercions used by the standard library.
bool KrtNativeLiteralArgument(KrtAstNode node) {
    if (node == null) { return false; }
    if (node.kind == KrtAstKind.Integer || node.kind == KrtAstKind.Floating || node.kind == KrtAstKind.Boolean) { return true; }
    if (node.kind == KrtAstKind.Cast || (node.kind == KrtAstKind.Unary && (node.op == 43 || node.op == 45))) { return KrtNativeLiteralArgument(node.left); }
    return false;
}
