        if (!KrtNativeSignatureType(parameter,unit,index,module,source)) { unit.native_offset = (int32)unit.parameter_type_starts[index]; return false; }
        parameter.local_slot = -2 - index; parameter.native_ref = unit.parameter_refs[index];
        parameter.native_cell_initial_parameter = true;
        parameter.native_lexical_block = unit.left; parameter.native_lexical_function = unit;
        bool receiver = index == 0 && unit.native_owner != null && !unit.native_static;
        if (receiver && unit.native_owner.value == 2) { parameter.native_ref = true; }
        if (receiver) { parameter.native_readonly = KrtNativeAggregateKind(parameter) && (unit.syntax_modifiers & 16) != 0; }
