    // A provisional first element must not reject different derived values
    // before that contextual type has been selected. Ordinary inference and
    // committed parameter types still validate the complete literal here.
    if (!argument) {
        element = node.left;
        while (element != null) {
            if (!KrtNativeCompatibleValue(item_type, element)) { return KrtNativeBindingError(binding, element); }
            element = element.next;
        }
    }
    KrtNativeCopyType(node,item_type);
    element = node.left;
    while (element != null) {
        node.native_stack_borrow = node.native_stack_borrow || element.native_stack_borrow;
        element = element.next;
    }
    return KrtNativeApplyTypeLayer(node,true);
