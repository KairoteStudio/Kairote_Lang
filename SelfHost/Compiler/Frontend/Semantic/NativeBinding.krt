    // pointer-sized base width and unset precision do not describe its bytes.
    if (array.native_string) { element.native_base_width = 1; element.native_bits = 8; }
    element.native_array = false;
    element.native_nullable = !array.native_array && (array.native_pointee_nullable & (uint64)1) != 0;
    element.native_pointee_nullable = array.native_array ? array.native_pointee_nullable : (array.native_pointee_nullable >> 1);
    element.native_pointer_depth = array.native_pointer_depth;
    if (!array.native_array && element.native_pointer_depth > 0) { element.native_pointer_depth = element.native_pointer_depth - 1; }
    element.native_width = KrtNativeSemanticStride(array); element.native_stride = 0;
    element.native_boolean = array.native_element_boolean; element.native_unsigned = array.native_element_unsigned || array.native_string;
    element.native_character = array.native_element_character || array.native_string; element.native_element_character = false;
    element.native_string = array.native_element_string; element.native_element_unsigned = element.native_string;
    element.native_element_string = false; element.native_element_boolean = false;
    if (element.native_pointer_depth > 0) {
        element.native_width = 8; element.native_stride = KrtNativeTypeBaseWidth(array);
        if (element.native_pointer_depth > 1) { element.native_stride = 8; }
        element.native_unsigned = false; element.native_boolean = false; element.native_string = false; element.native_character = false;
        element.native_element_unsigned = array.native_element_unsigned;
        element.native_element_string = array.native_element_string; element.native_element_boolean = array.native_element_boolean;
        element.native_element_character = array.native_element_character;
    } else if (element.native_string) { element.native_stride = 1; element.native_element_unsigned = true; }
    element.native_fixed_length = 0; KrtNativeDescribeAggregate(element);
    element.native_stride = KrtNativeSemanticStride(element);
    if (!KrtNativeAggregateKind(element)) {
        element.native_storage_size = KrtNativeValueStorage(element); element.native_alignment = KrtNativeValueAlignment(element);
    }
