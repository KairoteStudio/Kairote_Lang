KrtAstNode KrtNativeArrayElement(KrtAstNode array) {
    KrtAstNode element = KrtAstMake(KrtAstKind.Type, array.start, array.length);
    KrtNativeElementType(element,array); return element;
}

bool KrtNativeArrayLiteralHasTypedElement(KrtAstNode node) {
    KrtAstNode element = node.left;
    while (element != null) {
        if (element.kind != KrtAstKind.Null) { return true; }
        element = element.next;
    }
    return false;
}

bool KrtNativeBindCallArgument(KrtAstNode node, KrtNativeBinding binding) {
    if (KrtNativeClosureNeedsContext(node)) { return true; }
    if (KrtNativeBoxContextNeedsType(node) && KrtNativeBoxContextArgumentScore(node,null,binding)<0) {
        KrtAstNode erased=KrtAstMake(KrtAstKind.Type,node.start,0);erased.native_type=KrtNativeObjectType(binding.module);erased.native_width=8;
        if(KrtNativeBoxContextArgumentScore(node,erased,binding)>=0){return true;}
    }
    if (node.kind != KrtAstKind.ArrayLiteral) {
        if (!KrtNativeBindExpression(node,binding)) { return false; }
        if (node.kind==KrtAstKind.Ternary||(node.kind==KrtAstKind.Binary&&node.op==113)) { node.native_bound=true; }
        return !KrtNativeVoidValue(node) || KrtNativeBindingError(binding,node);
