bool KrtNativePointerCastInteger(KrtAstNode node) {
    return node != null && node.native_type == null && !node.native_array && !node.native_string &&
        !node.native_boolean && node.native_function_pointer == null && node.native_pointer_depth == 0 &&
        KrtNativeFloatKind(node) == 0 && node.native_bits > 0;
