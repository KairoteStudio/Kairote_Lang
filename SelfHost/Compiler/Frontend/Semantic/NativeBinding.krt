    return KrtNativeBindArrayLiteralShape(node,null,binding,true);
}

bool KrtNativeBindArrayLiteral(KrtAstNode node, KrtAstNode expected, KrtNativeBinding binding) {
    return KrtNativeBindArrayLiteralShape(node,expected,binding,false);
}

bool KrtNativeBindArrayLiteralShape(KrtAstNode node, KrtAstNode expected, KrtNativeBinding binding, bool argument) {
    KrtAstNode element = node.left;
    KrtAstNode contextual_item = expected != null && expected.native_array ? KrtNativeArrayElement(expected) : null;
    while (element != null) {
        if (!KrtNativeBindContextExpression(element, contextual_item, binding)) { return false; }
        if (KrtNativeVoidValue(element)) { return KrtNativeBindingError(binding,element); }
        element = element.next;
    }
    KrtAstNode item_type = null;
    if (expected != null && expected.native_array) { item_type = KrtNativeArrayElement(expected); }
    else if (node.left != null) {
        KrtAstNode exemplar = node.left;
        while (exemplar != null && exemplar.kind == KrtAstKind.Null) { exemplar = exemplar.next; }
        if (exemplar == null && !argument) { return KrtNativeNullableError(binding,node); }
        item_type = KrtAstMake(KrtAstKind.Type,node.start,node.length);
        if (exemplar == null) { item_type.native_width = 8; }
        else { KrtNativeCopyType(item_type,exemplar); }
        element = node.left;
        while (element != null) {
            if (KrtNativePointerValue(item_type)) {
                if (element.kind == KrtAstKind.Null || element.native_nullable) { item_type.native_nullable = true; }
            } else if (element.kind != KrtAstKind.Null && !KrtNativeTypeEqual(item_type,element) &&
                item_type.native_stride == 0 && item_type.native_type == null &&
                element.native_stride == 0 && element.native_type == null) { KrtNativePromoteNumber(item_type,item_type,element,false); }
            element = element.next;
        }
    } else { item_type = KrtAstMake(KrtAstKind.Type, node.start, node.length); item_type.native_width = 4; }
    if (item_type.native_array && item_type.native_fixed_length == 0) { return KrtNativeBindingError(binding, node); }
