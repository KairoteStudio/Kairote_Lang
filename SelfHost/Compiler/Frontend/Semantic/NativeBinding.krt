    node.native_aggregate = false; node.native_storage_size = 0; node.native_alignment = 0; node.native_fixed_length = 0;
    node.native_function_pointer = null;
    node.native_character = false; node.native_element_character = false;
    node.native_pointer_depth = 0; node.native_base_width = 0;
    node.native_bits = 0; node.native_wide = false; node.native_element_boolean = false; node.native_float = 0; node.native_type = null; node.native_width = 8; node.native_stride = 0;
    node.native_unsigned = false; node.native_element_unsigned = false; node.native_boolean = false;
