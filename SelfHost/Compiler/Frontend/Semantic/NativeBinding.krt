    bool implicit_struct_default = KrtNativeAggregateKind(node) && node.parameter_count == 0;
    if (ambiguous || (selected == null && !implicit_struct_default && (declared || node.parameter_count != 0))) { return KrtNativeBindingError(binding, node); }
    node.native_target = selected;
    if (selected != null && (!KrtNativeCommitArguments(node.right, selected, 1, binding) ||
        !KrtNativeContextArguments(node.right, selected, 1, binding))) { return false; }
    node.local_slot = binding.slots; binding.slots = binding.slots + 1;
