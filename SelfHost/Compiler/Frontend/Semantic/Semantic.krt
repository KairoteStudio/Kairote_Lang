    KrtAstNode expression = node.left; KrtAstNode prefix = expression; KrtAstNode parent = null;
    while (prefix != null && !(prefix.kind == KrtAstKind.Call && prefix.op == 253)) {
        parent = prefix; prefix = prefix.left;
    }
    if (prefix == null) { return KrtNativeBindingError(binding, node); }
    KrtAstNode syntax = node.syntax_type;
    KrtAstNode component = syntax;
    if (syntax.right != null) { component = syntax.right; while (component.next != null) { component = component.next; } }
    int64 length = component.name_start + component.name_length - syntax.name_start;
    bool type_name = false;
    if (!KrtNativeParenthesizedValueName(prefix.left, binding)) {
        KrtAstNode context = node.native_context;
        if (context == null) { context = binding.unit.native_context; }
        if (syntax.right == null && KrtNativeTypeParameter(context, binding.source, syntax.name_start, length) != null) {
            type_name = true;
        } else {
            type_name = KrtNativeFindUsingType(binding.module, binding.source, syntax.name_start, length,
                binding.unit.native_scope, binding.using_scope) != null;
        }
    }
    KrtNativeClosureProbeJournal(binding.module, node);
    if (type_name) {
        if (parent == null) { expression = prefix.right; }
        else {
            KrtNativeClosureProbeJournal(binding.module, parent);
            parent.left = prefix.right;
            // Removing (Outer) exposes a grouped operand that may itself be
            // another cast target: (Outer)(Inner)(value). Restore the same
            // deferred ambiguity without reparsing or duplicating its tree.
            expression = KrtNativeParenthesizedOperandCandidate(expression, prefix.right, node, binding);
        }
        node.kind = KrtAstKind.Cast; node.op = 0; node.left = expression; node.child_count = 1;
    } else {
        KrtNativeClosureProbeJournal(binding.module, prefix); prefix.op = 0;
        KrtAstNode sibling = node.next;
        int64 argument_start = node.syntax_argument_name_start; int64 argument_length = node.syntax_argument_name_length;
        bool grouped = node.grouped;
        KrtNativeClosureProbeCopyNode(node, expression);
        node.next = sibling; node.syntax_argument_name_start = argument_start; node.syntax_argument_name_length = argument_length;
        node.grouped = grouped || node.grouped;
    }
    return KrtNativeBindExpression(node, binding);
}

// ===== Name lookup and overload selection =====
// Using visibility follows lexical frames and the files each directive loaded.
int32 KrtNativeNameFilePriority(KrtAstNode declaration, int64 position) {
    if(declaration==null){return 0;}
    int32 access=KrtNativeAccessMode(declaration);
    KrtAstNode origin=KrtNativeAccessOrigin(declaration);
    if(access==8192){
        return KrtModulesSameModule(origin.start,position)?2:0;
    }
    // Member access is checked separately. Public and internal overloads in
    // one module must compete by argument quality at the same visibility tier.
    if (access != 2 || KrtNativeAccessOwner(declaration) != null) {
        return KrtModulesSameModule(origin.start,position)?2:1;
    }
    KrtAstNode caller = KrtAstMake(KrtAstKind.Function,position,0);
    return KrtNativeAccessSameFile(declaration,caller) ? 3 : 0;
}

bool KrtNativeImportedFile(KrtAstNode declaration, KrtAstNode imported) {
    KrtSourceBundle bundle = KrtDriverActiveBundle;
    if (bundle == null) { return false; }
    KrtSourceFile file = bundle.files;
    while (file != null) {
        if (imported.name_start >= file.start && imported.name_start < file.start + file.length) {
            KrtSourceDirective directive = file.directives;
            while (directive != null) {
                if (imported.name_start >= file.start + directive.position && imported.name_start < file.start + directive.end) {
                    KrtDriverPath path = directive.files;
                    while (path != null) {
                        KrtSourceFile target = KrtSourcesFindFile(bundle, KrtDriverAbsolutePath(path.value));
                        if (target != null && declaration.start >= target.start && declaration.start < target.start + target.length) { return true; }
                        path = path.next;
                    }
                    return false;
                }
                directive = directive.next;
            }
            return false;
        }
        file = file.order_next;
    }
    return false;
}

bool KrtNativeUsingMatches(KrtAstNode declaration, KrtAstNode imported, int64 source, int64 start, int64 length) {
    if (imported.type_length > 0) { return false; }
    if (KrtDeclarationMatches(declaration, imported, source, start, length)) { return true; }
    return KrtSemanticSameName(source, start, length, declaration.name_start, declaration.name_length) && KrtNativeImportedFile(declaration, imported);
}

bool KrtNativeVisibleUsingName(KrtAstNode declaration, KrtAstNode scope, KrtUsingScope frame, int64 source, int64 start, int64 length) {
    KrtAstNode context = scope;
    while (true) {
        if (KrtDeclarationMatches(declaration, context, source, start, length)) { return true; }
        if (context == null) { break; } context = context.left;
    }
    int64 first_length = 0;
    unsafe(using krt.mem;) { byte* text = (byte*)source;
        while (first_length < length && (lexer_letter(text[start + first_length]) || lexer_digit(text[start + first_length]))) { first_length = first_length + 1; }
    }
    while (frame != null) {
        KrtAstNode imported = frame.imports;
        while (imported != null) {
            if (imported.type_length > 0 && KrtSemanticSameName(source, start, first_length, imported.type_start, imported.type_length)) {
                int64 suffix = KrtNameSkipTrivia(source, start, length, first_length);
                unsafe(using krt.mem;) { byte* text = (byte*)source;
                    if (suffix < length && text[start + suffix] == 46 && KrtDeclarationMatches(declaration, imported, source, start + suffix + 1, length - suffix - 1)) { return true; }
                    if (suffix < length && text[start + suffix] == 46 && KrtSemanticSameName(source,start + suffix + 1,length - suffix - 1,declaration.name_start,declaration.name_length) && KrtNativeImportedFile(declaration,imported)) { return true; }
                }
            }
            imported = imported.next;
        }
        frame = frame.parent;
    }
    return false;
}

bool KrtNativeVisibleQualifiedName(KrtAstNode declaration, KrtAstNode scope, int64 source, int64 start, int64 length) {
    KrtUsingScope frame = null; if (scope != null) { frame = scope.native_using_scope; }
    return KrtNativeVisibleUsingName(declaration, scope, frame, source, start, length);
}

KrtAstNode KrtNativeFindUsingType(KrtAstNode module, int64 source, int64 start, int64 length, KrtAstNode scope, KrtUsingScope frame) {
    KrtAstNode context = scope; KrtAstNode hidden = null;
    while (true) {
        KrtAstNode declaration = module.declarations; KrtAstNode chosen = null; int32 best = 0;
        while (declaration != null) {
            if (declaration.native_generic_origin == null && KrtDeclarationMatches(declaration, context, source, start, length)) {
                int32 priority = KrtNativeNameFilePriority(declaration,start);
                if (priority > best) { chosen = declaration; best = priority; }
                if (priority == 0 && hidden == null) { hidden = declaration; }
            }
            declaration = declaration.next;
        }
        if (chosen != null) { return chosen; }
        if (context == null) { break; } context = context.left;
    }
    KrtUsingScope active = frame;
    while (active != null) {
        KrtAstNode imported = active.imports;
        while (imported != null) {
            if (imported.type_length > 0 && KrtSemanticSameName(source, start, length, imported.type_start, imported.type_length)) {
                return KrtNativeFindUsingType(module, source, imported.name_start, imported.name_length, null, null);
            }
            imported = imported.next;
        }
        KrtAstNode found = null; KrtAstNode candidate = module.declarations; int32 best = 0;
        while (candidate != null) {
            if (candidate.native_generic_origin == null) {
                bool visible = KrtNativeVisibleUsingName(candidate, null, active, source, start, length);
                imported = active.imports;
                while (!visible && imported != null) {
                    visible = KrtNativeUsingMatches(candidate, imported, source, start, length); imported = imported.next;
                }
                if (visible) {
                    int32 priority = KrtNativeNameFilePriority(candidate,start);
                    if (priority == 0) { if (hidden == null) { hidden = candidate; } }
                    else if (priority > best) { found = candidate; best = priority; }
                    else if (priority == best && found != null && found != candidate) { return null; }
                }
            }
            candidate = candidate.next;
        }
        if (found != null) { return found; } active = active.parent;
    }
    return hidden;
}

KrtAstNode KrtNativeFindScopedType(KrtAstNode module, int64 source, int64 start, int64 length, KrtAstNode scope) {
    KrtUsingScope frame = null; if (scope != null) { frame = scope.native_using_scope; }
    return KrtNativeFindUsingType(module, source, start, length, scope, frame);
}

KrtAstNode KrtNativeExpressionTypeName(KrtAstNode node, KrtNativeBinding binding) {
    if (node == null) { return null; }
    KrtAstNode first = node; while (first.kind == KrtAstKind.Member) { first = first.left; }
    if (first.op == 247) { return null; }
    if (first.kind != KrtAstKind.Identifier || KrtNativeFindName(binding, first.start, first.length) != null) { return null; }
    if (node.native_type_arguments != null) {
        KrtAstNode descriptor = KrtAstMake(KrtAstKind.Type, first.start, 0);
        descriptor.native_scope = binding.unit.native_scope; descriptor.native_context = binding.unit.native_context;
        descriptor.native_using_scope = binding.using_scope;
        int64 type_length = node.native_type_arguments.type_start + node.native_type_arguments.type_length - first.start;
        if (!KrtNativeAnnotateType(descriptor, binding.module, binding.source, first.start, type_length)) { return null; }
        if (!KrtNativeCheckValueAccess(descriptor,binding)) { return null; }
        return descriptor.native_type;
    }
    int64 length = node.length; if (node.kind == KrtAstKind.Member) { length = node.name_start + node.name_length - first.start; }
    KrtAstNode type = KrtNativeFindUsingType(binding.module, binding.source, first.start, length, binding.unit.native_scope, binding.using_scope);
    if (type != null && !KrtNativeAccessAllowed(type,binding,null,false)) { KrtNativeAccessError(binding,node); return null; }
    return type;
}

bool KrtNativeNamespaceCallable(KrtAstNode callee, KrtNativeBinding binding) {
    if (callee.kind != KrtAstKind.Member) { return false; }
    KrtAstNode first = callee; while (first.kind == KrtAstKind.Member) { first = first.left; }
    if (first.op == 247) { return false; }
    if (first.kind != KrtAstKind.Identifier || KrtNativeFindName(binding, first.start, first.length) != null) { return false; }
    int64 length = callee.name_start + callee.name_length - first.start;
    KrtAstNode function_node = binding.module.left;
    while (function_node != null) {
        if (function_node.native_owner == null && KrtNativeVisibleUsingName(function_node, binding.unit.native_scope, binding.using_scope, binding.source, first.start, length)) { return true; }
        function_node = function_node.next;
    }
    return false;
}

int64 KrtNativeFunctionScopeScore(KrtAstNode function_node, KrtAstNode callee, KrtNativeBinding binding) {
    if (function_node.native_owner != null) { return 4 * KrtNativeRankingUnit; }
    if (callee.kind == KrtAstKind.Member && callee.native_static) {
        KrtAstNode first = callee; while (first.kind == KrtAstKind.Member) { first = first.left; }
        return KrtNativeVisibleUsingName(function_node, binding.unit.native_scope, binding.using_scope, binding.source, first.start, callee.name_start + callee.name_length - first.start) ? 3 * KrtNativeRankingUnit : -1;
    }
    KrtAstNode scope = binding.unit.native_scope; int64 priority = 3 * KrtNativeRankingUnit;
    while (scope != null) {
        if (KrtScopeEqual(function_node.native_scope, scope, binding.source)) { return priority; }
        scope = scope.left; priority = priority - 1;
    }
    if (KrtScopeLength(function_node.native_scope, binding.source) == 0) { return 2 * KrtNativeRankingUnit; }
    KrtUsingScope frame = binding.using_scope; priority = KrtNativeRankingUnit;
    while (frame != null) {
        KrtAstNode imported = frame.imports;
        while (imported != null) {
            if (KrtNativeUsingMatches(function_node, imported, binding.source,
                callee.kind == KrtAstKind.Member ? callee.name_start : callee.start,
                callee.kind == KrtAstKind.Member ? callee.name_length : callee.length)) { return priority; }
            imported = imported.next;
        }
        frame = frame.parent; priority = priority - 1;
    }
    return -1;
}

// Function-name index maintenance.
// This index narrows only the simple-name scan. Scope, access, receiver and
// overload ranking remain the responsibility of each lookup caller.
uint64 KrtNativeFunctionNameHash(int64 source, int64 start, int64 length) {
    uint64 hash = 14695981039346656037; int64 index = 0;
    unsafe(using krt.mem;) {
        byte* bytes = (byte*)source;
        while (index < length) {
            hash = (hash ^ (uint64)bytes[start + index]) * 1099511628211;
            index = index + 1;
        }
    }
    return hash;
}

int32 KrtNativeFunctionBucketSlot(KrtNativeFunctionIndex index, int64 source,
    int64 start, int64 length, uint64 hash) {
    int32 slot = (int32)(hash & (uint64)(index.capacity - 1)); int32 probes = 0;
    while (probes < index.capacity) {
        KrtNativeFunctionBucket bucket = index.buckets[slot];
        if (bucket == null || (bucket.hash == hash &&
            KrtSemanticSameName(source,start,length,bucket.name_start,bucket.name_length))) { return slot; }
        slot = (slot + 1) & (index.capacity - 1); probes = probes + 1;
    }
    return -1;
}

bool KrtNativeFunctionIndexGrow(KrtNativeFunctionIndex index) {
    int32 previous = index.capacity; int32 capacity = previous == 0 ? 256 : previous * 2;
    if (capacity > 65536) { index.ok = false; return false; }
    KrtNativeFunctionBucket[] expanded = new KrtNativeFunctionBucket[capacity];
    if (expanded == null) { index.ok = false; return false; }
    KrtNativeFunctionBucket[] old = index.buckets;
    int32 item = 0;
    while (item < previous) {
        KrtNativeFunctionBucket bucket = old[item];
        if (bucket != null) {
            int32 slot = (int32)(bucket.hash & (uint64)(capacity - 1));
            while (expanded[slot] != null) { slot = (slot + 1) & (capacity - 1); }
            expanded[slot] = bucket;
        }
        item = item + 1;
    }
    index.capacity = capacity; index.buckets = expanded;
    if (previous != 0) { delete old; }
    return true;
}

bool KrtNativeFunctionIndexAppend(KrtNativeFunctionIndex index, KrtAstNode declaration, int64 source) {
    uint64 hash = KrtNativeFunctionNameHash(source,declaration.name_start,declaration.name_length);
    int32 slot = KrtNativeFunctionBucketSlot(index,source,declaration.name_start,declaration.name_length,hash);
    if (slot < 0) { index.ok = false; return false; }
    KrtNativeFunctionBucket bucket = index.buckets[slot];
    if (bucket == null) {
        if ((index.name_count + 1) * 2 >= index.capacity) {
            if (!KrtNativeFunctionIndexGrow(index)) { return false; }
            slot = KrtNativeFunctionBucketSlot(index,source,declaration.name_start,declaration.name_length,hash);
            if (slot < 0) { index.ok = false; return false; }
        }
        bucket = new KrtNativeFunctionBucket();
        if (bucket == null) { index.ok = false; return false; }
        bucket.hash = hash;
        bucket.name_start = declaration.name_start; bucket.name_length = declaration.name_length;
        index.buckets[slot] = bucket; index.name_count = index.name_count + 1;
    }
    KrtNativeFunctionEntry entry = new KrtNativeFunctionEntry();
    if (entry == null) { index.ok = false; return false; }
    entry.declaration = declaration;
    if (bucket.last == null) { bucket.first = entry; } else { bucket.last.next = entry; }
    bucket.last = entry; return true;
}

// Generic resolution appends functions to module.left. Index only the unseen
// tail, including append operations performed while a candidate is examined.
bool KrtNativeFunctionIndexSynchronize(KrtAstNode module, int64 source) {
    if (module.native_function_index == null) {
        module.native_function_index = new KrtNativeFunctionIndex();
        if (module.native_function_index == null) { return false; }
        module.native_function_index.ok = true;
        if (!KrtNativeFunctionIndexGrow(module.native_function_index)) { return false; }
    }
    KrtNativeFunctionIndex index = module.native_function_index;
    if (!index.ok) { return false; }
    KrtAstNode declaration = index.last_indexed_function == null ? module.left : index.last_indexed_function.next;
    while (declaration != null) {
        if (!KrtNativeFunctionIndexAppend(index,declaration,source)) { return false; }
        index.last_indexed_function = declaration; declaration = declaration.next;
    }
    return true;
}

KrtNativeFunctionEntry KrtNativeFunctionCandidates(KrtAstNode module, int64 source, int64 start, int64 length) {
    if (!KrtNativeFunctionIndexSynchronize(module,source)) { return null; }
    KrtNativeFunctionIndex index = module.native_function_index;
    uint64 hash = KrtNativeFunctionNameHash(source,start,length);
    int32 slot = KrtNativeFunctionBucketSlot(index,source,start,length,hash);
    if (slot < 0 || index.buckets[slot] == null) { return null; }
    return index.buckets[slot].first;
}

KrtNativeFunctionEntry KrtNativeFunctionCandidateNext(KrtNativeFunctionEntry entry, KrtAstNode module, int64 source) {
    if (!KrtNativeFunctionIndexSynchronize(module,source)) { return null; }
    return entry.next;
}

void KrtNativeFunctionIndexInvalidate(KrtAstNode module) {
    KrtNativeFunctionIndex index = module.native_function_index;
    module.native_function_index = null;
    if (index == null) { return; }
    int32 slot = 0;
    while (slot < index.capacity) {
        KrtNativeFunctionBucket bucket = index.buckets[slot];
        if (bucket != null) {
            KrtNativeFunctionEntry entry = bucket.first;
            while (entry != null) {
                KrtNativeFunctionEntry next = entry.next; delete entry; entry = next;
            }
            delete bucket;
        }
        slot = slot + 1;
    }
    delete index.buckets; delete index;
}

// ===== Semantic analysis =====
enum KrtSemanticError { NoError = 0, DuplicateName = 1, UndefinedName = 2, TypeMismatch = 3, MissingReturn = 4 }

class KrtSymbol {
    public string name;
    public KrtIrType type;
    public bool mutable;
}

class KrtScope {
    public KrtScope parent;
    public int32 count;
    public KrtSymbol[] symbols;
}

bool KrtSemanticValidateBlockShape(KrtAstNode block) {
    if (block == null || block.kind != KrtAstKind.Block) { return false; }
    KrtAstNode statement = block.left;
    int32 checked = 0;
    while (statement != null && checked < block.child_count) {
        if (statement.kind == KrtAstKind.If) {
            if (!KrtSemanticValidateIfShape(statement)) { return false; }
        } else if (statement.kind == KrtAstKind.While) {
            if (statement.left == null || statement.right == null || !KrtSemanticValidateBlockShape(statement.right)) { return false; }
        } else if (statement.kind == KrtAstKind.Unsafe) {
            if (!KrtSemanticValidateBlockShape(statement.left)) { return false; }
        } else if (statement.kind == KrtAstKind.Delete) {
            if (statement.left == null) { return false; }
        } else if (statement.kind == KrtAstKind.Break || statement.kind == KrtAstKind.Continue) {
        } else if (statement.kind == KrtAstKind.Variable) {
            if (statement.left == null) { return false; }
        } else if (statement.kind == KrtAstKind.Return) {
            // Empty returns are valid in void functions; the function-level type checker
            // will reject them when a non-void return is required.
        } else if (statement.kind == KrtAstKind.Assign || statement.kind == KrtAstKind.Expression) {
            if (statement.left == null || (statement.kind == KrtAstKind.Assign && statement.right == null)) { return false; }
        } else { return false; }
        statement = statement.next;
        checked = checked + 1;
    }
    return checked == block.child_count;
}

bool KrtSemanticValidateIfShape(KrtAstNode conditional) {
    if (conditional == null || conditional.kind != KrtAstKind.If || conditional.left == null || conditional.right == null ||
        !KrtSemanticValidateBlockShape(conditional.right)) { return false; }
    if (conditional.alternate == null) { return true; }
    if (conditional.alternate.kind == KrtAstKind.If) { return KrtSemanticValidateIfShape(conditional.alternate); }
    return KrtSemanticValidateBlockShape(conditional.alternate);
}

bool KrtSemanticValidateLoopControl(KrtAstNode block, bool in_loop) {
    if (block == null || block.kind != KrtAstKind.Block) { return false; }
    KrtAstNode statement = block.left;
    while (statement != null) {
        if (statement.kind == KrtAstKind.Break || statement.kind == KrtAstKind.Continue) {
            if (!in_loop) { return false; }
        } else if (statement.kind == KrtAstKind.While) {
            if (!KrtSemanticValidateLoopControl(statement.right, true)) { return false; }
        } else if (statement.kind == KrtAstKind.If) {
            if (!KrtSemanticValidateLoopControl(statement.right, in_loop)) { return false; }
            if (statement.alternate != null && statement.alternate.kind == KrtAstKind.Block &&
                !KrtSemanticValidateLoopControl(statement.alternate, in_loop)) { return false; }
            if (statement.alternate != null && statement.alternate.kind == KrtAstKind.If) {
                if (!KrtSemanticValidateLoopControl(statement.alternate.right, in_loop)) { return false; }
            }
        } else if (statement.kind == KrtAstKind.Unsafe) {
            if (!KrtSemanticValidateLoopControl(statement.left, in_loop)) { return false; }
        }
        statement = statement.next;
    }
    return true;
}

bool KrtSemanticValidateFunction(KrtAstNode unit) {
    if (unit.kind != KrtAstKind.Function || unit.left == null || unit.left.kind != KrtAstKind.Block) { return false; }
    if (unit.parameter_count > 8 || unit.left.child_count == 0 || unit.left.left == null) { return false; }
    if (!KrtSemanticValidateBlockShape(unit.left)) { return false; }
    if (!KrtSemanticValidateLoopControl(unit.left, false)) { return false; }
    KrtAstNode statement = unit.left.left;
    int32 checked = 0;
    while (statement != null && checked < unit.left.child_count) {
        if (statement.kind == KrtAstKind.If || statement.kind == KrtAstKind.While) {
            checked = checked + 1;
            statement = statement.next;
            continue;
        } else if (statement.kind == KrtAstKind.Unsafe) {
            checked = checked + 1;
            statement = statement.next;
            continue;
        } else if (statement.kind == KrtAstKind.Assign || statement.kind == KrtAstKind.Expression) {
            checked = checked + 1;
            statement = statement.next;
            continue;
        } else if (statement.kind == KrtAstKind.Variable) {
            if (statement.left == null || statement.left.kind != KrtAstKind.Integer &&
                statement.left.kind != KrtAstKind.Binary && statement.left.kind != KrtAstKind.Unary &&
                statement.left.kind != KrtAstKind.String && statement.left.kind != KrtAstKind.New &&
                statement.left.kind != KrtAstKind.Call && statement.left.kind != KrtAstKind.StackAlloc && statement.left.kind != KrtAstKind.Boolean && statement.left.kind != KrtAstKind.Null && statement.left.kind != KrtAstKind.Ternary && statement.left.kind != KrtAstKind.Cast && statement.left.kind != KrtAstKind.Member && statement.left.kind != KrtAstKind.Index) { return false; }
        } else if (statement.kind == KrtAstKind.Delete || statement.kind == KrtAstKind.Break || statement.kind == KrtAstKind.Continue) {
            if (statement.left == null) { return false; }
        } else {
            if (statement.kind != KrtAstKind.Return) { return false; }
            if (statement.left == null) { checked = checked + 1; statement = statement.next; continue; }
            if (statement.left.kind != KrtAstKind.Integer && statement.left.kind != KrtAstKind.Boolean && statement.left.kind != KrtAstKind.Null && statement.left.kind != KrtAstKind.String && statement.left.kind != KrtAstKind.Identifier && statement.left.kind != KrtAstKind.Call &&
                statement.left.kind != KrtAstKind.Binary && statement.left.kind != KrtAstKind.Unary && statement.left.kind != KrtAstKind.Index && statement.left.kind != KrtAstKind.Ternary && statement.left.kind != KrtAstKind.Cast && statement.left.kind != KrtAstKind.Member && statement.left.kind != KrtAstKind.New && statement.left.kind != KrtAstKind.StackAlloc) { return false; }
        }
        checked = checked + 1;
        statement = statement.next;
    }
    return checked == unit.left.child_count;
}

bool KrtSemanticSameName(int64 source, int64 first, int64 first_length, int64 second, int64 second_length) {
    if (first_length != second_length) { return false; }
    int64 index = 0;
    unsafe(using krt.mem;) {
        byte* bytes = (byte*)source;
        while (index < first_length) {
            if (bytes[first + index] != bytes[second + index]) { return false; }
            index = index + 1;
        }
    }
    return true;
}

bool KrtSemanticBindExpression(KrtAstNode expression, KrtAstNode unit, KrtAstNode statement, int64 source) {
    if (expression == null) { return false; }
    if (expression.kind == KrtAstKind.Identifier) {
        int32 parameter = 0;
        while (parameter < unit.parameter_count) {
            if (KrtSemanticSameName(source, unit.parameter_starts[parameter], unit.parameter_lengths[parameter],
                expression.start, expression.length)) { expression.local_slot = -2 - parameter; return true; }
            parameter = parameter + 1;
        }
        KrtAstNode previous = unit.left.left;
        expression.local_slot = -1;
        while (previous != statement) {
            if (previous.kind == KrtAstKind.Variable && KrtSemanticSameName(source,
                previous.name_start, previous.name_length, expression.start, expression.length)) {
                expression.local_slot = previous.local_slot;
            }
            previous = previous.next;
        }
        return expression.local_slot >= 0;
    }
    if (expression.kind == KrtAstKind.Member) { return KrtSemanticBindExpression(expression.left, unit, statement, source); }
    if (expression.kind == KrtAstKind.Index) {
        return KrtSemanticBindExpression(expression.left, unit, statement, source) &&
            KrtSemanticBindExpression(expression.right, unit, statement, source);
    }
    if (expression.kind == KrtAstKind.Call) {
        if (expression.left == null || (expression.left.kind != KrtAstKind.Identifier && expression.left.kind != KrtAstKind.Member)) { return false; }
        if (expression.left.kind == KrtAstKind.Member && !KrtSemanticBindExpression(expression.left.left, unit, statement, source)) { return false; }
        KrtAstNode argument = expression.right;
        while (argument != null) {
            if (!KrtSemanticBindExpression(argument, unit, statement, source)) { return false; }
            argument = argument.next;
        }
        return true;
    }
    if (expression.kind == KrtAstKind.Assign) {
        return KrtSemanticBindExpression(expression.left, unit, statement, source) &&
            KrtSemanticBindExpression(expression.right, unit, statement, source);
    }
    if (expression.kind == KrtAstKind.New) { return expression.left == null || KrtSemanticBindExpression(expression.left, unit, statement, source); }
    if (expression.kind == KrtAstKind.Cast) { return KrtSemanticBindExpression(expression.left, unit, statement, source); }
    if (expression.kind == KrtAstKind.String || expression.kind == KrtAstKind.Null) { return true; }
    if (expression.kind == KrtAstKind.StackAlloc) { return KrtSemanticBindExpression(expression.left, unit, statement, source); }
    if (expression.kind == KrtAstKind.Unary) { return KrtSemanticBindExpression(expression.left, unit, statement, source); }
    if (expression.kind == KrtAstKind.Binary) {
        return KrtSemanticBindExpression(expression.left, unit, statement, source) &&
            KrtSemanticBindExpression(expression.right, unit, statement, source);
    }
    if (expression.kind == KrtAstKind.Ternary) {
        return KrtSemanticBindExpression(expression.left, unit, statement, source) &&
            KrtSemanticBindExpression(expression.right, unit, statement, source) &&
            KrtSemanticBindExpression(expression.alternate, unit, statement, source);
    }
    return expression.kind == KrtAstKind.Integer || expression.kind == KrtAstKind.Boolean || expression.kind == KrtAstKind.Null;
}

KrtAstNode KrtSemanticFindFunction(KrtAstNode module, KrtAstNode callee, int64 source) {
    if (module == null || callee == null || callee.kind != KrtAstKind.Identifier) { return null; }
    KrtAstNode current = module.left;
    while (current != null) {
        if (KrtSemanticSameName(source, current.name_start, current.name_length, callee.start, callee.length)) { return current; }
        current = current.next;
    }
    return null;
}

bool KrtSemanticResolveCallExpression(KrtAstNode expression, KrtAstNode module, KrtAstNode unit, KrtAstNode statement, int64 source) {
    if (expression == null) { return false; }
    if (expression.kind == KrtAstKind.Call) {
        if (expression.left == null || (expression.left.kind != KrtAstKind.Identifier && expression.left.kind != KrtAstKind.Member)) { return false; }
        KrtAstNode target = null;
        if (expression.left.kind == KrtAstKind.Identifier) { target = KrtSemanticFindFunction(module, expression.left, source); }
        else if (!KrtSemanticBindExpression(expression.left.left, unit, statement, source)) { return false; }
        if (target != null && expression.parameter_count != target.parameter_count) { return false; }
        KrtAstNode argument = expression.right;
        int32 count = 0;
        while (argument != null) {
            if (!KrtSemanticBindExpression(argument, unit, statement, source)) { return false; }
            argument = argument.next; count = count + 1;
        }
        if (count != expression.parameter_count) { return false; }
        return true;
    }
    if (expression.kind == KrtAstKind.Binary || expression.kind == KrtAstKind.Assign || expression.kind == KrtAstKind.Index) {
        return KrtSemanticResolveCallExpression(expression.left, module, unit, statement, source) &&
            KrtSemanticResolveCallExpression(expression.right, module, unit, statement, source);
    }
    if (expression.kind == KrtAstKind.Ternary) {
        return KrtSemanticResolveCallExpression(expression.left, module, unit, statement, source) &&
            KrtSemanticResolveCallExpression(expression.right, module, unit, statement, source) &&
            KrtSemanticResolveCallExpression(expression.alternate, module, unit, statement, source);
    }
    if (expression.kind == KrtAstKind.Unary || expression.kind == KrtAstKind.Member) {
        return KrtSemanticResolveCallExpression(expression.left, module, unit, statement, source);
    }
    return true;
}

bool KrtSemanticBindNestedExpression(KrtAstNode expression, KrtAstNode unit, int64 source) {
    if (expression == null) { return false; }
    if (expression.kind == KrtAstKind.Identifier) {
        int32 parameter = 0;
        while (parameter < unit.parameter_count) {
            if (KrtSemanticSameName(source, unit.parameter_starts[parameter], unit.parameter_lengths[parameter], expression.start, expression.length)) {
                expression.local_slot = -2 - parameter; return true;
            }
            parameter = parameter + 1;
        }
        KrtAstNode declaration = unit.left.left;
        while (declaration != null) {
            if (declaration.kind == KrtAstKind.Variable && KrtSemanticSameName(source, declaration.name_start, declaration.name_length, expression.start, expression.length)) {
                expression.local_slot = declaration.local_slot; return true;
            }
            declaration = declaration.next;
        }
        return false;
    }
    if (expression.kind == KrtAstKind.Call) {
        if (expression.left == null || (expression.left.kind != KrtAstKind.Identifier && expression.left.kind != KrtAstKind.Member)) { return false; }
        if (expression.left.kind == KrtAstKind.Member && !KrtSemanticBindNestedExpression(expression.left.left, unit, source)) { return false; }
        KrtAstNode argument = expression.right;
        while (argument != null) {
            if (!KrtSemanticBindNestedExpression(argument, unit, source)) { return false; }
            argument = argument.next;
        }
        return true;
    }
    if (expression.kind == KrtAstKind.Binary || expression.kind == KrtAstKind.Assign || expression.kind == KrtAstKind.Index || expression.kind == KrtAstKind.Ternary) {
        return KrtSemanticBindNestedExpression(expression.left, unit, source) && KrtSemanticBindNestedExpression(expression.right, unit, source) &&
            (expression.kind != KrtAstKind.Ternary || KrtSemanticBindNestedExpression(expression.alternate, unit, source));
    }
    if (expression.kind == KrtAstKind.Unary || expression.kind == KrtAstKind.Member) { return KrtSemanticBindNestedExpression(expression.left, unit, source); }
    if (expression.kind == KrtAstKind.New || expression.kind == KrtAstKind.StackAlloc || expression.kind == KrtAstKind.Cast) { return expression.left == null || KrtSemanticBindNestedExpression(expression.left, unit, source); }
    return expression.kind == KrtAstKind.Integer || expression.kind == KrtAstKind.Boolean || expression.kind == KrtAstKind.String || expression.kind == KrtAstKind.Null;
}

bool KrtSemanticBindNestedBlock(KrtAstNode block, KrtAstNode unit, int64 source) {
    if (block == null || block.kind != KrtAstKind.Block) { return false; }
    KrtAstNode statement = block.left;
    while (statement != null) {
        if (statement.kind == KrtAstKind.If || statement.kind == KrtAstKind.While) {
            if (!KrtSemanticBindNestedExpression(statement.left, unit, source) || !KrtSemanticBindNestedBlock(statement.right, unit, source)) { return false; }
            if (statement.alternate != null && statement.alternate.kind == KrtAstKind.Block && !KrtSemanticBindNestedBlock(statement.alternate, unit, source)) { return false; }
        } else if (statement.kind == KrtAstKind.Assign) {
            if (!KrtSemanticBindNestedExpression(statement.left, unit, source) || !KrtSemanticBindNestedExpression(statement.right, unit, source)) { return false; }
        } else if (statement.kind == KrtAstKind.Variable || statement.kind == KrtAstKind.Return || statement.kind == KrtAstKind.Expression || statement.kind == KrtAstKind.Delete) {
            if (statement.left != null && !KrtSemanticBindNestedExpression(statement.left, unit, source)) { return false; }
        } else if (statement.kind == KrtAstKind.Break || statement.kind == KrtAstKind.Continue) {
        }
        statement = statement.next;
    }
    return true;
}

bool KrtSemanticResolveCallsInBlock(KrtAstNode block, KrtAstNode module, KrtAstNode unit, int64 source) {
    if (block == null || block.kind != KrtAstKind.Block) { return false; }
    KrtAstNode statement = block.left;
    while (statement != null) {
        if (statement.kind == KrtAstKind.Return || statement.kind == KrtAstKind.Expression) {
            if (statement.left != null && !KrtSemanticResolveCallExpression(statement.left, module, unit, statement, source)) { return false; }
        } else if (statement.kind == KrtAstKind.Variable) {
            if (!KrtSemanticResolveCallExpression(statement.left, module, unit, statement, source)) { return false; }
        } else if (statement.kind == KrtAstKind.Assign) {
            if (!KrtSemanticResolveCallExpression(statement.right, module, unit, statement, source)) { return false; }
        } else if (statement.kind == KrtAstKind.Unsafe) {
            if (!KrtSemanticResolveCallsInBlock(statement.left, module, unit, source)) { return false; }
        } else if (statement.kind == KrtAstKind.Delete) {
            if (!KrtSemanticResolveCallExpression(statement.left, module, unit, statement, source)) { return false; }
        } else if (statement.kind == KrtAstKind.If || statement.kind == KrtAstKind.While) {
            if (!KrtSemanticResolveCallExpression(statement.left, module, unit, statement, source) ||
                !KrtSemanticResolveCallsInBlock(statement.right, module, unit, source)) { return false; }
            if (statement.alternate != null && statement.alternate.kind == KrtAstKind.Block &&
                !KrtSemanticResolveCallsInBlock(statement.alternate, module, unit, source)) { return false; }
            if (statement.alternate != null && statement.alternate.kind == KrtAstKind.If) {
                if (!KrtSemanticResolveCallExpression(statement.alternate.left, module, unit, statement, source) ||
                    !KrtSemanticResolveCallsInBlock(statement.alternate.right, module, unit, source)) { return false; }
            }
        }
        statement = statement.next;
    }
    return true;
}

bool KrtSemanticResolveModuleCalls(KrtAstNode module, int64 source) {
    if (!KrtSemanticValidateCompilationUnit(module)) { return false; }
    KrtAstNode current = module.left;
    while (current != null) {
        if (!KrtSemanticBindLocals(current, source)) { return false; }
        if (!KrtSemanticResolveCallsInBlock(current.left, module, current, source)) { return false; }
        current = current.next;
    }
    return true;
}

bool KrtSemanticBindLocals(KrtAstNode unit, int64 source) {
    if (!KrtSemanticValidateFunction(unit)) { return false; }
    KrtAstNode statement = unit.left.left;
    int32 slot = 0;
    bool returned = false;
    while (statement != null) {
        if (statement.kind == KrtAstKind.Variable) {
            KrtAstNode previous = unit.left.left;
            while (previous != statement) {
                if (previous.kind == KrtAstKind.Variable && KrtSemanticSameName(source,
                    previous.name_start, previous.name_length, statement.name_start, statement.name_length)) { return false; }
                previous = previous.next;
            }
            statement.local_slot = slot;
            slot = slot + 1;
        } else if (statement.kind == KrtAstKind.Assign) {
            if (!KrtSemanticBindExpression(statement.left, unit, statement, source) ||
                !KrtSemanticBindExpression(statement.right, unit, statement, source)) { return false; }
        } else if (statement.kind == KrtAstKind.Expression) {
            if (!KrtSemanticBindExpression(statement.left, unit, statement, source)) { return false; }
        } else if (statement.kind == KrtAstKind.If || statement.kind == KrtAstKind.While) {
            if (!KrtSemanticBindExpression(statement.left, unit, statement, source) ||
                !KrtSemanticBindNestedBlock(statement.right, unit, source)) { return false; }
            if (statement.alternate != null && statement.alternate.kind == KrtAstKind.Block &&
                !KrtSemanticBindNestedBlock(statement.alternate, unit, source)) { return false; }
            returned = true;
        } else if (statement.kind == KrtAstKind.Unsafe) {
            if (!KrtSemanticBindNestedBlock(statement.left, unit, source)) { return false; }
            returned = true;
        } else if (statement.kind == KrtAstKind.Delete) {
            if (!KrtSemanticBindExpression(statement.left, unit, statement, source)) { return false; }
        } else if (statement.kind == KrtAstKind.Break || statement.kind == KrtAstKind.Continue) {
            returned = true;
        } else {
            returned = true;
            if (statement.left != null && !KrtSemanticBindExpression(statement.left, unit, statement, source)) { return false; }
        }
        statement = statement.next;
    }
    return returned;
}

bool KrtSemanticValidateCompilationUnit(KrtAstNode unit) {
    if (unit == null || unit.kind != KrtAstKind.Program || unit.child_count <= 0 || unit.child_count > 256 || unit.left == null) { return false; }
    KrtAstNode current = unit.left;
    int32 checked = 0;
    while (current != null && checked < unit.child_count) {
        if (!KrtSemanticValidateFunction(current)) { return false; }
        current = current.next;
        checked = checked + 1;
    }
    if (checked != unit.child_count) { return false; }
    return current == null;
}

bool KrtSemanticValidateFunctionNames(KrtAstNode unit, int64 source) {
    if (unit == null || unit.kind != KrtAstKind.Program) { return false; }
    KrtAstNode declaration = unit.declarations;
    while (declaration != null) {
        KrtAstNode other_type = declaration.next;
        while (other_type != null) {
            if (declaration.native_generic_origin == null && other_type.native_generic_origin == null && !KrtNativeAccessSeparateFiles(declaration,other_type) && KrtScopeEqual(declaration.native_scope, other_type.native_scope, source) &&
                KrtSemanticSameName(source, declaration.name_start, declaration.name_length, other_type.name_start, other_type.name_length)) { return false; }
            other_type = other_type.next;
        }
        declaration = declaration.next;
    }
    KrtAstNode current = unit.left;
    while (current != null) {
        KrtAstNode other = current.next;
        while (other != null) {
            if (current.native_owner == other.native_owner && !KrtNativeAccessSeparateFiles(current,other) && KrtScopeEqual(current.native_scope, other.native_scope, source) && current.parameter_count == other.parameter_count &&
                KrtSemanticSameName(source, current.name_start, current.name_length, other.name_start, other.name_length)) {
                bool same = true; int32 index = 0;
                while (index < current.parameter_count) {
                    if (current.parameter_refs[index] != other.parameter_refs[index] || !KrtSemanticSameName(source,
                        current.parameter_type_starts[index], current.parameter_type_lengths[index], other.parameter_type_starts[index], other.parameter_type_lengths[index])) { same = false; }
                    index = index + 1;
                }
                if (same) { return false; }
            }
            other = other.next;
        }
        current = current.next;
    }
    return true;
}

bool KrtSemanticValidateEntryPoint(KrtAstNode unit, int64 source) {
    if (unit == null || unit.kind != KrtAstKind.Program) { return false; }
    KrtAstNode current = unit.left;
    int32 mains = 0;
    while (current != null) {
        if (KrtSemanticIsMain(current, source)) { mains = mains + 1; }
        current = current.next;
    }
    return mains == 1;
}

bool KrtSemanticIsMain(KrtAstNode candidate, int64 source) {
    if (candidate == null || candidate.native_owner != null || candidate.name_length != 4) { return false; }
    unsafe(using krt.mem;) {
        byte* bytes = (byte*)source;
        if (bytes[candidate.name_start] != 109) { return false; }
        if (bytes[candidate.name_start + 1] != 97) { return false; }
        if (bytes[candidate.name_start + 2] != 105) { return false; }
        if (bytes[candidate.name_start + 3] != 110) { return false; }
        return true;
    }
}

void KrtSemanticOrderHelperFirst(KrtAstNode unit, int64 source) {
    if (unit == null || unit.kind != KrtAstKind.Program || unit.child_count < 2 || unit.left == null) { return; }
    KrtAstNode previous = null;
    KrtAstNode current = unit.left;
    KrtAstNode main_function = null;
    KrtAstNode main_previous = null;
    while (current != null) {
        if (KrtSemanticIsMain(current, source)) { main_function = current; main_previous = previous; break; }
        previous = current;
        current = current.next;
    }
    if (main_function == null || main_function.next == null) { return; }
    if (main_previous == null) { unit.left = main_function.next; }
    else { main_previous.next = main_function.next; }
    current = unit.left;
    while (current.next != null) { current = current.next; }
    current.next = main_function;
    main_function.next = null;
}

bool KrtSemanticInlineConstantCall(KrtAstNode unit, int64 source) {
    if (unit == null || unit.left == null) { return true; }
    KrtAstNode main_function = unit.left;
    while (main_function != null && !KrtSemanticIsMain(main_function, source)) { main_function = main_function.next; }
    if (main_function == null || main_function.left == null || main_function.left.left == null) { return true; }
    KrtAstNode returned = main_function.left.left;
    if (returned.kind != KrtAstKind.Return || returned.left == null || returned.left.kind != KrtAstKind.Call ||
        returned.left.left == null) { return true; }
    KrtAstNode helper_function = unit.left;
    while (helper_function != null) {
        if (helper_function != main_function && helper_function.left != null && helper_function.left.left != null &&
            helper_function.left.left.kind == KrtAstKind.Return && helper_function.left.left.left != null &&
            helper_function.left.left.left.kind == KrtAstKind.Integer &&
            KrtSemanticSameName(source, returned.left.left.start, returned.left.left.length,
                helper_function.name_start, helper_function.name_length)) {
            returned.left.kind = KrtAstKind.Integer;
            returned.left.value = helper_function.left.left.left.value;
            returned.left.start = helper_function.left.left.left.start;
            returned.left.length = helper_function.left.left.left.length;
            returned.left.left = null;
            break;
        }
        helper_function = helper_function.next;
    }
    return true;
}

bool KrtSemanticValidateConstantHelperCall(KrtAstNode unit, int64 source) {
    if (!KrtSemanticValidateCompilationUnit(unit) || unit.child_count != 2) { return false; }
    KrtAstNode main_function = unit.left;
    KrtAstNode helper_function = unit.left.next;
    if (!KrtSemanticIsMain(main_function, source)) { main_function = helper_function; helper_function = unit.left; }
    if (main_function.left == null || main_function.left.left == null ||
        helper_function.left == null || helper_function.left.left == null) { return false; }
    KrtAstNode main_return = main_function.left.left;
    KrtAstNode helper_return = helper_function.left.left;
    if (main_return.kind != KrtAstKind.Return || main_return.left == null || main_return.left.kind != KrtAstKind.Call ||
        main_return.left.left == null || helper_return.kind != KrtAstKind.Return || helper_return.left == null ||
        helper_return.left.kind != KrtAstKind.Integer) { return false; }
    return KrtSemanticSameName(source, main_return.left.left.start, main_return.left.left.length,
        helper_function.name_start, helper_function.name_length);
}

bool KrtSemanticValidateConstantArgumentCall(KrtAstNode unit, int64 source) {
    if (!KrtSemanticValidateCompilationUnit(unit) || unit.child_count != 2) { return false; }
    KrtAstNode main_function = unit.left;
    KrtAstNode helper_function = unit.left.next;
    if (!KrtSemanticIsMain(main_function, source)) { main_function = helper_function; helper_function = unit.left; }
    if (helper_function.parameter_count != 1 || main_function.left == null || main_function.left.left == null ||
        helper_function.left == null || helper_function.left.left == null) { return false; }
    KrtAstNode main_return = main_function.left.left;
    KrtAstNode helper_return = helper_function.left.left;
    if (main_return.kind != KrtAstKind.Return || main_return.left == null || main_return.left.kind != KrtAstKind.Call ||
        main_return.left.child_count != 2 || main_return.left.right == null || main_return.left.right.kind != KrtAstKind.Integer ||
        helper_return.kind != KrtAstKind.Return || helper_return.left == null || helper_return.left.kind != KrtAstKind.Identifier) { return false; }
    return KrtSemanticSameName(source, main_return.left.left.start, main_return.left.left.length,
        helper_function.name_start, helper_function.name_length);
}

KrtSymbol KrtScopeLookup(KrtScope scope, string name) {
    KrtScope current = scope;
    while (current != null) {
        int32 index = 0;
        while (index < current.count) {
            if (current.symbols[index].name == name) { return current.symbols[index]; }
            index = index + 1;
        }
        current = current.parent;
    }
    return null;
}

// Floating-point type-shape helpers.
// Floating values travel as IEEE bits in the native compiler's internal ABI.
// Pointer/array annotations retain their element format, but are scalar integers.
int32 KrtNativeFloatKind(KrtAstNode node) {
    if (node == null || node.native_stride > 0) { return 0; }
    return node.native_float;
}

// Wide-integer type-shape helpers.
bool KrtNativeWideKind(KrtAstNode node) {
    return node != null && node.native_wide && node.native_stride == 0;
}

// Control-flow and return-path validation.
// Validate all source statements, including those following an abrupt exit.
// Switches introduce break targets; only loops introduce continue targets.
bool KrtNativeValidateControlFlow(KrtAstNode statement, KrtNativeBinding binding, int32 loops, int32 targets) {
    if (statement == null) { return true; }
    if (statement.kind == KrtAstKind.Break) {
        return targets > 0 || KrtNativeBindingError(binding,statement);
    }
    if (statement.kind == KrtAstKind.Continue) {
        return loops > 0 || KrtNativeBindingError(binding,statement);
    }
    if (statement.kind == KrtAstKind.Block) {
        KrtAstNode child = statement.left;
        while (child != null) {
            if (!KrtNativeValidateControlFlow(child,binding,loops,targets)) { return false; }
            child = child.next;
        }
        return true;
    }
    if (statement.kind == KrtAstKind.Unsafe || statement.kind == KrtAstKind.Point) {
        return KrtNativeValidateControlFlow(statement.left,binding,loops,targets);
    }
    if (statement.kind == KrtAstKind.If) {
        return KrtNativeValidateControlFlow(statement.right,binding,loops,targets) &&
            KrtNativeValidateControlFlow(statement.alternate,binding,loops,targets);
    }
    if (statement.kind == KrtAstKind.Try) {
        if (!KrtNativeValidateControlFlow(statement.left,binding,loops,targets)) { return false; }
        KrtAstNode clause = statement.right;
        while (clause != null) {
            if (!KrtNativeValidateControlFlow(clause.right,binding,loops,targets)) { return false; }
            clause = clause.next;
        }
        return KrtNativeValidateControlFlow(statement.alternate,binding,loops,targets);
    }
    if (statement.kind == KrtAstKind.Switch) {
        if (targets >= 64) { return KrtNativeBindingError(binding,statement); }
        KrtAstNode clause = statement.right;
        while (clause != null) {
            if (!KrtNativeValidateControlFlow(clause.right,binding,loops,targets + 1)) { return false; }
            clause = clause.next;
        }
        return true;
    }
    if (statement.kind == KrtAstKind.While || statement.kind == KrtAstKind.DoWhile ||
        statement.kind == KrtAstKind.For || statement.kind == KrtAstKind.Foreach) {
        if (targets >= 64) { return KrtNativeBindingError(binding,statement); }
        KrtAstNode body = statement.body;
        if (statement.kind == KrtAstKind.While) { body = statement.right; }
        else if (statement.kind == KrtAstKind.DoWhile) { body = statement.left; }
        return KrtNativeValidateControlFlow(body,binding,loops + 1,targets + 1);
    }
    return true;
}


// Exception binding and catch-type validation.
// Scalar exceptions use exact type identities; class throws read the object's
// runtime identity so a base-typed variable retains its actual exception type.
int64 KrtNativeExceptionType(KrtAstNode type, KrtAstNode module) {
    if (type == null || KrtNativeVoidValue(type) || type.native_array || (type.native_stride > 0 && !type.native_string)) { return -1; }
    if (type.native_type != null) {
        KrtAstNode declaration = module.declarations; int64 identity = 64;
        while (declaration != null) {
            if (declaration == type.native_type) { return identity; }
            identity = identity + 1; declaration = declaration.next;
        }
        return -1;
    }
    if (type.native_wide && type.native_bits == 128) { return type.native_unsigned ? 57 : 56; }
    if (type.native_string) { return 48; }
    if (type.native_boolean) { return 49; }
    if (type.native_character) { return 50; }
    if (type.native_float != 0) { return 32 + type.native_float; }
    // Storage slots and rounded byte widths do not identify integer types.
    // Keep the established scalar ABI, and put custom precision above the
    // module-local class identity range.
    int32 bits = type.native_bits;
    if (bits == 8 || bits == 16 || bits == 32 || bits == 64) { return bits / 8 + (type.native_unsigned ? 16 : 0); }
    if (bits > 0) { return (int64)4294967296 + bits * 2 + (type.native_unsigned ? 1 : 0); }
    return type.native_width + (type.native_unsigned ? 16 : 0);
}

bool KrtNativeBindThrow(KrtAstNode statement, KrtNativeBinding binding) {
    if (statement.left == null) {
        if (binding.catch_target == null) { return KrtNativeBindingError(binding, statement); }
        statement.native_target = binding.catch_target; return true;
    }
    if (!KrtNativeBindExpression(statement.left, binding)) { return false; }
    if (KrtNativeVoidValue(statement.left) || statement.left.kind == KrtAstKind.Null ||
        (!KrtNativeReferenceObjectValue(statement.left) && !KrtNativeBoxableValue(statement.left))) { return KrtNativeBindingError(binding, statement); }
    return true;
}

bool KrtNativeBindTry(KrtAstNode statement, KrtNativeBinding binding) {
    statement.local_slot = binding.slots; statement.native_size = binding.slots + 6; binding.slots = binding.slots + 12;
    if (!KrtNativeBindBlock(statement.left, binding)) { return false; }
    KrtAstNode clause = statement.right; bool catch_all = false;
    KrtAstNode saved_catch = binding.catch_target;
    while (clause != null) {
        if (catch_all) { return KrtNativeBindingError(binding, clause); }
        if (clause.left == null) { catch_all = true; }
        KrtNativeName saved = binding.names; binding.depth = binding.depth + 1; binding.catch_target = statement;
        if (clause.left != null) {
            KrtAstNode variable = clause.left;
            variable.native_lexical_block = clause.right; variable.native_cell_initial_parameter = true;
            if (!KrtNativeAnnotateType(variable, binding.module, binding.source, variable.type_start, variable.type_length) ||
                (!KrtNativeReferenceObjectValue(variable) && !KrtNativeBoxableValue(variable)) || variable.native_ref) { return KrtNativeBindingError(binding, variable); }
            if (variable.name_length > 0) {
                variable.local_slot = binding.slots; binding.slots = binding.slots + 1;
                if (!KrtNativeBindAggregateFrame(variable,binding)) { return false; }
                if (!KrtNativeAddName(binding, variable, variable.local_slot, false)) { return false; }
            }
        }
        bool valid = KrtNativeBindBlock(clause.right, binding);
        binding.names = saved; binding.depth = binding.depth - 1; binding.catch_target = saved_catch;
        if (!valid) { return false; }
        clause = clause.next;
    }
    if (statement.alternate != null && !KrtNativeBindBlock(statement.alternate, binding)) { return false; }
    return true;
}


// Runtime type-test binding.
bool KrtNativeBindTypeTest(KrtAstNode node, KrtNativeBinding binding) {
    if (!KrtNativeBindExpression(node.left,binding)) { return false; }
    if (KrtNativeVoidValue(node.left)) { return KrtNativeBindingError(binding,node); }
    KrtAstNode target = KrtAstMake(KrtAstKind.Type,node.type_start,node.type_length);
    target.native_scope = binding.unit.native_scope; target.native_context = binding.unit.native_context;
    target.native_using_scope = binding.using_scope;
    if (!KrtNativeAnnotateType(target,binding.module,binding.source,node.type_start,node.type_length)) { return KrtNativeBindingError(binding,node); }
    if (KrtNativeVoidValue(target)) { return KrtNativeBindingError(binding,target); }
    if (!KrtNativeCheckValueAccess(target,binding)) { return false; }
    bool runtime_source = KrtNativeReferenceObjectValue(node.left);
    bool static_box = KrtNativeObjectConversion(target,node.left) || KrtNativeBoxingConversion(target,node.left);
    if (KrtNativePointerValue(target) && target.native_nullable) { binding.module.native_error = 5; return KrtNativeBindingError(binding,target); }
    if (runtime_source && KrtNativePointerValue(target) &&
        (target.native_function_pointer == null || target.native_pointer_depth != 0)) { return KrtNativeBindingError(binding,target); }
    if (!runtime_source && !static_box && (KrtNativePointerValue(node.left) || KrtNativePointerValue(target))) {
        if (target.native_nullable) { binding.module.native_error = 5; return KrtNativeBindingError(binding,target); }
        if (!KrtNativePointerValue(target) || !KrtNativePointerEqualIgnoringOuter(node.left,target)) {
            return KrtNativeBindingError(binding,target);
        }
    }
    node.native_target = target; node.local_slot = binding.slots; binding.slots = binding.slots + 1;
    if (node.name_length > 0) {
        KrtAstNode variable = KrtAstMake(KrtAstKind.Variable,node.start,node.length);
        variable.native_lexical_block = binding.lexical_block; variable.native_lexical_function = binding.unit;
        KrtNativeCopyType(variable,target); variable.name_start = node.name_start; variable.name_length = node.name_length;
        variable.native_stack_borrow = node.left.native_stack_borrow;
        KrtNativeInheritStackBorrow(variable,node.left);
        if (KrtNativeInlineValue(variable) && !KrtNativeBindAggregateFrame(variable,binding)) { return false; }
        variable.local_slot = binding.slots; binding.slots = binding.slots + 1; node.right = variable;
    }
    node.native_width = 1; node.native_bits = 8; node.native_boolean = true; node.native_unsigned = true;
    return true;
}

bool KrtNativeBindTruePatterns(KrtAstNode expression, KrtNativeBinding binding) {
    if (expression == null) { return true; }
    if (expression.kind == KrtAstKind.TypeTest && expression.right != null) {
        return KrtNativeAddName(binding,expression.right,expression.right.local_slot,false);
    }
    if (expression.kind == KrtAstKind.Binary && expression.op == 104) {
        return KrtNativeBindTruePatterns(expression.left,binding) && KrtNativeBindTruePatterns(expression.right,binding);
    }
    return true;
}
