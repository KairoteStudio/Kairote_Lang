// ===== Native binding state and type annotation =====
// Native binding keeps lexical names separate from AST sibling links.
class KrtNativeName {
    public int64 start;
    public int64 length;
    public KrtAstNode declaration;
    public int32 slot;
    public bool by_ref;
    public int32 depth;
    public KrtNativeName next;
}

class KrtNativeBinding {
    public KrtNativeGeneratorPlan generator;
    public KrtNativeBinding parent;
    public KrtAstNode lexical_block;
    public bool closure_probe;
    public bool closure_return_known;
    public bool closure_return_seen;
    public KrtAstNode module;
    public KrtAstNode unit;
    public KrtAstNode catch_target;
    public KrtUsingScope using_scope;
    public int32 constant_depth;
    public int32 candidate_error;
    public int64 source;
    public KrtNativeName names;
    public int32 slots;
    public int32 depth;
    public int64 error_start;
    // A guarded postfix body sees the saved, non-null receiver of its own
    // activation. Nested guards save and restore this context.
    public KrtAstNode guard_type;
    public int32 guard_slot;
}

bool KrtNativeSpanWord(int64 source, int64 start, int64 length, string word) {
    unsafe(using krt.mem;) {
        byte* input = (byte*)source;
        byte* text = (byte*)(int64)word;
        int64 index = 0;
        while (index < length && text[index] != 0) {
            if (input[start + index] != text[index]) { return false; }
            index = index + 1;
        }
        return index == length && text[index] == 0;
    }
}

KrtAstNode KrtNativeFindType(KrtAstNode module, int64 source, int64 start, int64 length) {
    return KrtNativeFindScopedType(module, source, start, length, null);
}

void KrtNativeCopyType(KrtAstNode target, KrtAstNode original) {
    target.native_nullable = original.native_nullable; target.native_pointee_nullable = original.native_pointee_nullable;
    target.native_element_type = original.native_element_type;
    target.native_aggregate = original.native_aggregate; target.native_storage_size = original.native_storage_size;
    target.native_alignment = original.native_alignment; target.native_fixed_length = original.native_fixed_length;
    target.native_character = original.native_character; target.native_element_character = original.native_element_character;
    target.native_pointer_depth = original.native_pointer_depth; target.native_base_width = KrtNativeTypeBaseWidth(original);
    target.native_function_pointer = original.native_function_pointer;
    target.native_bits = original.native_bits; target.native_wide = original.native_wide; target.native_element_boolean = original.native_element_boolean;
    target.native_float = original.native_float;
    target.native_type = original.native_type;
    target.native_width = original.kind == KrtAstKind.Member && original.element_width > 0 ? original.element_width : original.native_width;
    target.native_stride = KrtNativeSemanticStride(original);
    target.native_size = original.native_size;
    target.native_void_pointer = original.native_void_pointer;
    target.native_unsigned = original.native_unsigned;
    target.native_element_unsigned = original.native_element_unsigned;
    target.native_boolean = original.native_boolean;
    target.native_string = original.native_string; target.native_element_string = original.native_element_string;
    target.native_array = original.native_array;
    target.native_stack_borrow = original.native_stack_borrow;
    if(KrtNativeWideKind(target)){target.native_storage_size=16;target.native_alignment=16;}
}

bool KrtNativeAnnotateTypeCore(KrtAstNode node, KrtAstNode module, int64 source, int64 start, int64 length) {
    node.native_nullable = false; node.native_pointee_nullable = 0; node.native_void_pointer = false;
    node.native_element_type = null;
    node.native_aggregate = false; node.native_storage_size = 0; node.native_alignment = 0; node.native_fixed_length = 0;
    node.native_function_pointer = null;
    node.native_character = false; node.native_element_character = false;
    node.native_pointer_depth = 0; node.native_base_width = 0;
    node.native_bits = 0; node.native_wide = false; node.native_element_boolean = false; node.native_float = 0; node.native_type = null; node.native_width = 8; node.native_stride = 0;
    node.native_unsigned = false; node.native_element_unsigned = false; node.native_boolean = false;
    node.native_string = false; node.native_element_string = false; node.native_array = false;
    if (length <= 0) { return true; }
    int64 base_length = 0;
    unsafe(using krt.mem;) {
        byte* input = (byte*)source;
        while (base_length < length && ((input[start + base_length] >= 65 && input[start + base_length] <= 90) ||
               (input[start + base_length] >= 97 && input[start + base_length] <= 122) ||
               (input[start + base_length] >= 48 && input[start + base_length] <= 57) || input[start + base_length] == 95)) {
            base_length = base_length + 1;
        }

    }
    if (KrtNativeSpanWord(source, start, base_length, "fn")) { return KrtNativeAnnotateFunctionType(node, module, source, start, length); }
    if (KrtNativeSpanWord(source, start, base_length, "object")) { return KrtNativeAnnotateObjectType(node,module,source,start,length); }
    node.native_boolean = KrtNativeSpanWord(source, start, base_length, "bool");
    node.native_character = KrtNativeSpanWord(source,start,base_length,"char");
    node.native_unsigned = node.native_boolean || KrtNativeSpanWord(source, start, base_length, "byte") ||
        KrtNativeSpanWord(source, start, base_length, "char") || KrtNativeSpanWord(source, start, base_length, "uint8") ||
        KrtNativeSpanWord(source, start, base_length, "uint16") || KrtNativeSpanWord(source, start, base_length, "uint32") || KrtNativeSpanWord(source, start, base_length, "uint64") || KrtNativeSpanWord(source, start, base_length, "uint128") || KrtNativeSpanWord(source,start,base_length,"usize");
    int32 width = 8; int32 integer_bits = lexer_integer_type_bits(source, start, base_length);
    if (integer_bits != 0) {
        node.native_bits = integer_bits; node.native_wide = integer_bits > 64; width = 1;
        while (width * 8 < integer_bits) { width = width * 2; }
        unsafe(using krt.mem;) { node.native_unsigned = ((byte*)source)[start] == 117; }
    }
    else if (KrtNativeSpanWord(source, start, base_length, "byte") || KrtNativeSpanWord(source, start, base_length, "bool") ||
        KrtNativeSpanWord(source, start, base_length, "int8") || KrtNativeSpanWord(source, start, base_length, "uint8") || KrtNativeSpanWord(source, start, base_length, "char")) { width = 1; }
    else if (KrtNativeSpanWord(source, start, base_length, "int16") || KrtNativeSpanWord(source, start, base_length, "uint16")) { width = 2; }
    else if (KrtNativeSpanWord(source, start, base_length, "int32") || KrtNativeSpanWord(source, start, base_length, "int") || KrtNativeSpanWord(source, start, base_length, "uint32")) { width = 4; }
    else if (KrtNativeSpanWord(source, start, base_length, "int128") || KrtNativeSpanWord(source, start, base_length, "uint128")) { width = 16; node.native_wide = true; }
    else if (KrtNativeSpanWord(source, start, base_length, "float32") || KrtNativeSpanWord(source, start, base_length, "float")) { width = 4; node.native_float = 4; }
    else if (KrtNativeSpanWord(source, start, base_length, "float64") || KrtNativeSpanWord(source, start, base_length, "double")) { width = 8; node.native_float = 8; }
    else if (KrtNativeSpanWord(source, start, base_length, "string")) { node.native_stride = 1; node.native_string = true; node.native_element_unsigned = true; }
    else if (!KrtNativeSpanWord(source, start, base_length, "int64") && !KrtNativeSpanWord(source, start, base_length, "long") && !KrtNativeSpanWord(source, start, base_length, "uint64") && !KrtNativeSpanWord(source,start,base_length,"usize") &&
             !KrtNativeSpanWord(source, start, base_length, "void") &&
             !KrtNativeSpanWord(source, start, base_length, "var") && !KrtNativeSpanWord(source, start, base_length, "let") && !KrtNativeSpanWord(source, start, base_length, "auto")) {
        return KrtNativeResolveNamedType(node, module, source, start, length);
    }
    node.native_width = width;
    node.native_storage_size = width; node.native_alignment = width;
    node.native_base_width = width;
    if (node.native_bits == 0 && node.native_float == 0 && !node.native_string && node.native_type == null) { node.native_bits = width * 8; }
    node.native_void_pointer = KrtNativeSpanWord(source,start,base_length,"void");
    KrtAstNode syntax = KrtNativeTypeSyntax(source,start,length);
    return syntax != null && KrtNativeApplySourceTypeSuffix(node,syntax);
}

bool KrtNativeAnnotateType(KrtAstNode node, KrtAstNode module, int64 source, int64 start, int64 length) {
    if (!KrtNativeAnnotateTypeCore(node,module,source,start,length)) { return false; }
    return KrtNativeFinishTypeAnnotation(node,module,source);
}

bool KrtNativeFinishTypeAnnotation(KrtAstNode node, KrtAstNode module, int64 source) {
    if (!KrtNativeAggregateKind(node)) {
        node.native_storage_size = KrtNativeValueStorage(node); node.native_alignment = KrtNativeValueAlignment(node);
    }
    KrtNativeBinding context = new KrtNativeBinding();
    context.module = module; context.source = source; context.error_start = -1;
    context.unit = KrtAstMake(KrtAstKind.Function,node.start,0);
    context.unit.native_owner = KrtNativeAccessOwner(node);
    if (!KrtNativeAccessTypeAllowed(node,context)) { module.native_error = 10; return false; }
    return true;
}

bool KrtNativeCheckValueAccess(KrtAstNode node, KrtNativeBinding binding) {
    if (!KrtNativeAccessTypeAllowed(node,binding)) { return KrtNativeAccessError(binding,node); }
    return true;
}

KrtNativeName KrtNativeFindName(KrtNativeBinding binding, int64 start, int64 length) {
    KrtNativeName name = binding.names;
    while (name != null) {
        if (KrtSemanticSameName(binding.source, start, length, name.start, name.length)) { return name; }
        name = name.next;
    }
    return KrtNativeClosureFindName(binding,start,length);
}

bool KrtNativeAddName(KrtNativeBinding binding, KrtAstNode declaration, int32 slot, bool by_ref) {
    if (declaration.native_lexical_function == null) { declaration.native_lexical_function = binding.unit; }
    if (declaration.native_lexical_block == null) { declaration.native_lexical_block = binding.lexical_block; }
    KrtNativeName previous = binding.names;
    while (previous != null) {
        if ((previous.depth == binding.depth || (previous.slot < 0 && previous.declaration.native_capture_index < 0)) && KrtSemanticSameName(binding.source, declaration.name_start, declaration.name_length, previous.start, previous.length)) {
            return KrtNativeBindingError(binding, declaration);
        }
        previous = previous.next;
    }
    KrtNativeName name = new KrtNativeName();
    name.start = declaration.name_start; name.length = declaration.name_length;
    name.declaration = declaration; name.slot = slot; name.by_ref = by_ref; name.depth = binding.depth;
    name.next = binding.names; binding.names = name; return true;
}

bool KrtNativeBindingError(KrtNativeBinding binding, KrtAstNode node) {
    if (binding.error_start < 0 && node != null) { binding.error_start = node.start; }
    return false;
}

KrtAstNode KrtNativeFindFunctionType(KrtNativeBinding binding, int64 start, int64 length) {
    KrtNativeFunctionEntry entry = KrtNativeFunctionCandidates(binding.module,binding.source,start,length);
    return entry == null ? null : entry.declaration;
}

bool KrtNativeIsLvalue(KrtAstNode node) {
    if (node == null || node.native_readonly) { return false; }
    if (node.kind == KrtAstKind.Member && KrtNativeAggregateKind(node.left)) { return KrtNativeIsLvalue(node.left); }
    if (node.kind == KrtAstKind.Index && node.left.native_fixed_length > 0) { return KrtNativeIsLvalue(node.left); }
    return node.kind == KrtAstKind.Identifier || node.kind == KrtAstKind.Member || node.kind == KrtAstKind.Index || (node.kind == KrtAstKind.Unary && node.op == 42);
}

KrtAstNode KrtNativeThis(KrtNativeBinding binding, int64 start) {
    return KrtNativeClosureThis(binding,start,false);
}

bool KrtNativeBindConstant(KrtAstNode node, KrtAstNode declaration, KrtNativeBinding binding) {
    if (declaration.left == null || binding.constant_depth >= 64) { return KrtNativeBindingError(binding, node); }
    binding.constant_depth = binding.constant_depth + 1;
    bool valid = KrtNativeBindExpression(declaration.left, binding);
    binding.constant_depth = binding.constant_depth - 1;
    if (!valid || !KrtNativeAnnotateType(node, binding.module, binding.source, declaration.type_start, declaration.type_length)) { return KrtNativeBindingError(binding, node); }
    if (declaration.left.kind == KrtAstKind.String && node.native_string) {
        node.kind = KrtAstKind.String; node.start = declaration.left.start; node.length = declaration.left.length;
    } else if (KrtNativeFloatKind(node) != 0 || KrtNativeWideKind(node)) {
        node.kind = KrtAstKind.Cast; node.left = declaration.left; node.type_start = declaration.type_start; node.type_length = declaration.type_length; node.native_readonly = true; return true;
    } else {
        int64 value = 0;
        if (!KrtIrTryEvaluateConstant(declaration.left, ref value)) { return KrtNativeBindingError(binding, node); }
        node.kind = KrtAstKind.Integer; node.value = value;
    }
    node.left = null; node.native_readonly = true; return true;
}

// Separate conversion categories from their int32 inheritance distance. A
// compatible conversion keeps a nonnegative rank at every representable depth.
const int64 KrtNativeRankingUnit = 4294967296;

bool KrtNativePointerValue(KrtAstNode type) {
    return type != null && !type.native_array && (type.native_pointer_depth > 0 || type.native_function_pointer != null);
}

bool KrtNativeVoidValue(KrtAstNode type) {
    return type != null && type.native_void_pointer && type.native_pointer_depth == 0 &&
        !type.native_array && type.native_function_pointer == null;
}

bool KrtNativePointerEqualIgnoringOuter(KrtAstNode left, KrtAstNode right) {
    if (left == null || right == null) { return false; }
    KrtAstNode a = KrtAstMake(KrtAstKind.Type,left.start,0); KrtNativeCopyType(a,left); a.native_nullable = false;
    KrtAstNode b = KrtAstMake(KrtAstKind.Type,right.start,0); KrtNativeCopyType(b,right); b.native_nullable = false;
    return KrtNativeTypeEqual(a,b);
}

bool KrtNativeNullableArgumentType(KrtAstNode type) {
    if (type == null || KrtNativeInlineValue(type)) { return false; }
    if (KrtNativePointerValue(type)) { return type.native_nullable; }
    if (type.native_string || type.native_array) { return true; }
    return KrtNativeReferenceObjectValue(type);
}

bool KrtNativeNullableValueCompatible(KrtAstNode target, KrtAstNode value, bool reference) {
    if (reference && (target.native_nullable != value.native_nullable || target.native_pointee_nullable != value.native_pointee_nullable)) { return false; }
    if (!reference && (KrtNativeObjectConversion(target,value) || KrtNativeBoxingConversion(target,value))) { return true; }
    if (!KrtNativePointerValue(target) && !KrtNativePointerValue(value)) { return true; }
    if (value.native_nullable && !target.native_nullable) { return false; }
    return target.native_pointee_nullable == value.native_pointee_nullable;
}

bool KrtNativePointerCastInteger(KrtAstNode node) {
    return node != null && node.native_type == null && !node.native_array && !node.native_string &&
        !node.native_boolean && node.native_function_pointer == null && node.native_pointer_depth == 0 &&
        KrtNativeFloatKind(node) == 0 && node.native_bits > 0;
}

// Arrays and strings carry addresses too; their unsafe byte views use the
// underlying element nullability without admitting floating point casts.
bool KrtNativeAddressStorage(KrtAstNode node) {
    return node != null && (node.native_array || node.native_string);
}

uint64 KrtNativeAddressPointeeNullable(KrtAstNode node) {
    if (!node.native_array) { return node.native_pointee_nullable; }
    KrtAstNode element = KrtNativeArrayElement(node);
    return (element.native_pointee_nullable << 1) | (element.native_nullable ? (uint64)1 : (uint64)0);
}

// Array casts retain element shape. They may add nullability to element
// wrappers, while callback parameters and results retain their exact types.
int32 KrtNativeArrayCastElementError(KrtAstNode target, KrtAstNode value, int32 depth) {
    if (target == null || value == null || depth > 64) { return -1; }
    if ((value.native_nullable && !target.native_nullable) ||
        (value.native_pointee_nullable & ~target.native_pointee_nullable) != 0) { return 5; }
    KrtAstNode a = KrtAstMake(KrtAstKind.Type,target.start,0); KrtNativeCopyType(a,target);
    KrtAstNode b = KrtAstMake(KrtAstKind.Type,value.start,0); KrtNativeCopyType(b,value);
    a.native_nullable = false; a.native_pointee_nullable = 0; a.native_element_type = null;
    b.native_nullable = false; b.native_pointee_nullable = 0; b.native_element_type = null;
    if (!KrtNativeTypeEqualDepth(a,b,depth)) { return -1; }
    if (target.native_element_type == null && value.native_element_type == null) { return 0; }
    return KrtNativeArrayCastElementError(target.native_element_type,value.native_element_type,depth + 1);
}

bool KrtNativePointerUnsized(KrtAstNode node) {
    return KrtNativePointerValue(node) && node.native_void_pointer && node.native_pointer_depth == 1;
}

bool KrtNativeNullableConversionError(KrtAstNode target, KrtAstNode value) {
    if (value == null) { return false; }
    if (value.kind == KrtAstKind.Null) { return !KrtNativeNullableArgumentType(target); }
    return !KrtNativeNullableValueCompatible(target,value,false);
}

bool KrtNativeNullableError(KrtNativeBinding binding, KrtAstNode node) {
    binding.module.native_error = 5; return KrtNativeBindingError(binding,node);
}

int64 KrtNativeArgumentScore(KrtAstNode argument, KrtAstNode function_node, int32 index, KrtNativeBinding binding) {
    bool reference = argument.kind == KrtAstKind.Unary && argument.op == 200;
    if (function_node.parameter_refs[index] != reference) { binding.candidate_error = 3; return -1; }
    KrtAstNode expected = KrtAstMake(KrtAstKind.Type, argument.start, argument.length);
    int32 previous_error = binding.module.native_error;
    if (!KrtNativeSignatureType(expected,function_node,index,binding.module,binding.source)) {
        if (binding.module.native_error == 10) { binding.candidate_error = 10; }
        binding.module.native_error = previous_error; return -1;
    }
    if (!KrtNativeAccessTypeAllowed(expected,binding)) { binding.candidate_error = 10; return -1; }
    if (!reference && KrtNativeClosureNeedsContext(argument)) {
        if (KrtNativeObjectValue(expected)) { return KrtNativeBoxContextArgumentScore(argument,expected,binding); }
        return KrtNativeClosureArgumentScore(argument,expected,binding);
    }
    if (!reference && KrtNativeBoxContextNeedsType(argument)) { return KrtNativeBoxContextArgumentScore(argument,expected,binding); }
    return KrtNativeArgumentTypeScore(argument,expected,reference,binding);
}

int64 KrtNativeArgumentTypeScore(KrtAstNode argument,KrtAstNode expected,bool reference,KrtNativeBinding binding) {
    KrtAstNode actual = argument;
    if (reference) { actual = argument.left; }
    if (KrtNativeVoidValue(actual) || KrtNativeVoidValue(expected)) { return -1; }
    if (actual.kind == KrtAstKind.Null) {
        if (!reference && KrtNativeNullableArgumentType(expected)) { return KrtNativeRankingUnit; }
        binding.candidate_error = 5; return -1;
    }
    if (!KrtNativeNullableValueCompatible(expected,actual,reference)) { binding.candidate_error = 5; return -1; }
    // A literal acquires its container type from the selected parameter. Match
    // its values before comparing the provisional recursive element descriptor.
    // Existing arrays and writable refs still require the complete stored shape.
    if (!reference && actual.kind == KrtAstKind.ArrayLiteral && expected.native_array && expected.native_fixed_length == 0) {
        KrtAstNode item = KrtNativeArrayElement(expected); KrtAstNode child = actual.left;
        while (child != null) {
            if (!KrtNativeCompatibleValue(item,child)) { return -1; }
            child = child.next;
        }
        bool exact = KrtNativeArrayLiteralHasTypedElement(actual) &&
            KrtNativeTypeEqual(item,KrtNativeArrayElement(actual));
        return (exact ? 12 : 2) * KrtNativeRankingUnit;
    }
    int64 boxing_score = KrtNativeBoxArgumentScore(expected,actual,reference);
    if (boxing_score >= 0) { return boxing_score; }
    if (expected.native_fixed_length != actual.native_fixed_length) { return -1; }
    if (actual.kind != KrtAstKind.Null && (expected.native_element_type != null || actual.native_element_type != null) &&
        !KrtNativeTypeEqual(expected.native_element_type,actual.native_element_type)) { return -1; }
    if (expected.native_function_pointer != null || actual.native_function_pointer != null) {
        if (expected.native_array != actual.native_array || expected.native_pointer_depth != actual.native_pointer_depth) { return -1; }
        return KrtNativeFunctionShapesEqual(expected.native_function_pointer, actual.native_function_pointer) ? 40 * KrtNativeRankingUnit : -1;
    }
    int32 width = actual.kind == KrtAstKind.Member ? actual.element_width : actual.native_width;
    int32 stride = KrtNativeSemanticStride(actual); int32 expected_stride = KrtNativeSemanticStride(expected);
    if (reference) {
        if (expected.native_character != actual.native_character || expected.native_element_character != actual.native_element_character) { return -1; }
        if (expected.native_pointer_depth != actual.native_pointer_depth || expected.native_bits != actual.native_bits || expected.native_wide != actual.native_wide || expected.native_float != actual.native_float || expected.native_width != width || expected_stride != stride || expected.native_type != actual.native_type || expected.native_unsigned != actual.native_unsigned || expected.native_string != actual.native_string || expected.native_array != actual.native_array) { return -1; }
        return 20 * KrtNativeRankingUnit;
    }
    if (expected.native_type != null && actual.native_type != null && expected_stride == 0 && stride == 0 && KrtNativeDerivesFrom(actual.native_type, expected.native_type)) { return 40 * KrtNativeRankingUnit - KrtNativeInheritanceDistance(actual.native_type, expected.native_type); }
    if (expected.native_void_pointer && expected.native_pointer_depth == 1 && stride > 0 && !actual.native_array && !actual.native_string) { return 3 * KrtNativeRankingUnit; }
    if (expected.native_pointer_depth != actual.native_pointer_depth || expected.native_string != actual.native_string || expected.native_type != actual.native_type || expected_stride != stride || expected.native_array != actual.native_array) { return -1; }
    if (stride > 0 && (expected.native_bits != actual.native_bits || expected.native_float != actual.native_float || expected.native_wide != actual.native_wide || expected.native_element_unsigned != actual.native_element_unsigned || expected.native_element_boolean != actual.native_element_boolean || expected.native_element_string != actual.native_element_string)) { return -1; }
    if (stride > 0 && expected.native_element_character != actual.native_element_character) { return -1; }
    bool same_numeric_domain = (KrtNativeFloatKind(expected) == 0) == (KrtNativeFloatKind(actual) == 0);
    if (stride == 0 && expected.native_type == null && actual.native_type == null && same_numeric_domain && expected.native_width < width && !KrtNativeLiteralArgument(actual)) { return -1; }
    int32 score = 4;
    if (KrtNativeWideKind(expected) == KrtNativeWideKind(actual)) { score = score + 16; }
    else if (!KrtNativeWideKind(expected) && KrtNativeWideKind(actual) && KrtNativeFloatKind(expected) == 0) { return -1; }
    if (KrtNativeFloatKind(expected) == KrtNativeFloatKind(actual)) { score = score + 16; }
    else if (KrtNativeFloatKind(expected) == 0 && KrtNativeFloatKind(actual) != 0) { return -1; }
    if (expected.native_width == width) { score = score + 4; }
    if (expected.native_bits == actual.native_bits) { score = score + 2; }
    if (expected.native_unsigned == actual.native_unsigned) { score = score + 2; }
    if (expected.native_boolean == actual.native_boolean) { score = score + 2; }
    if (expected.native_character == actual.native_character) { score = score + 4; }
    return score * KrtNativeRankingUnit;
}

bool KrtNativeBindCall(KrtAstNode node, KrtNativeBinding binding) {
    KrtNativeNormalizeQualifiedSyscall(node, binding);
    if (binding.module.native_error == 10 && binding.error_start >= 0) { return false; }
    bool indirect = node.left.kind != KrtAstKind.Identifier && node.left.kind != KrtAstKind.Member;
    if (node.left.kind == KrtAstKind.Identifier) {
        indirect = KrtNativeFindName(binding, node.left.start, node.left.length) != null || KrtNativeFindGlobal(binding, node.left.start, node.left.length) != null;
        if (binding.module.native_error == 14 && binding.error_start >= 0) { return false; }
    }
    if (indirect) {
        if (!KrtNativeBindExpression(node.left, binding)) { return false; }
        return KrtNativeBindIndirectCall(node, binding);
    }
    int64 name_start = 0; int64 name_length = 0;
    KrtAstNode owner = null; bool explicit_member = node.left.kind == KrtAstKind.Member; bool static_receiver = false;
    if (node.left.kind == KrtAstKind.Identifier) {
        name_start = node.left.start; name_length = node.left.length;
        owner = binding.unit.native_owner;
