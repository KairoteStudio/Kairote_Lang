bool KrtPrintRuntimeRequired(int64 source, int32 length) {
    KrtLexer lexer = new KrtLexer(); KrtToken token = new KrtToken();
    unsafe(using krt.mem;) { if (!KrtLexerInit(lexer,(byte*)source,length)) { return false; } }
