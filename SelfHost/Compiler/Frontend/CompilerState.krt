// ===== Compiler state =====
// Shared compiler records retain one layout across AST, binding and IR.
// Algorithms live in their component files; these records carry only state.

// A concrete function owns immutable resolved signature shapes. Activation
// parameters, call-site positions and access results remain separate.
class KrtNativeCapture {
    public KrtAstNode provider;
    public KrtAstNode declaration;
    public int32 index;
    public KrtNativeCapture next;
}
class KrtNativeCellOwner {
    public KrtAstNode declaration;
    public KrtNativeCellOwner next;
}

// A contextual overload probe restores mutations through a nested journal.
// Registry entries keep canonical nominal identities while each probe owns its
// bucket storage, lookup index, globals and diagnostics.
class KrtNativeClosureProbeMutation {
    public KrtAstNode declaration;
    public KrtAstNode snapshot;
    public KrtNativeClosureProbeMutation next;
}
class KrtNativeClosureProbeState {
    public KrtNativeClosureProbeState previous;
    public KrtNativeClosureProbeMutation mutations;
    public KrtAstNode functions; public KrtAstNode function_tail;
    public KrtAstNode types; public KrtAstNode type_tail;
    public KrtAstNode globals; public KrtAstNode global_tail;
    public int32 child_count; public int32 native_locals;
    public int32 native_error; public int32 constraint_depth;
    public KrtGenericRegistry registry;
    public KrtNativeFunctionIndex function_index;
    public KrtNativeGlobalState global_state;
    public KrtInheritanceStack inheritance_stack;
    public KrtCompilerDiagnostics diagnostics;
    public int64 error_code;
}

class KrtNativeSignatureCache {
    public KrtAstNode module;
    public int64 source;
    public KrtAstNode scope;
    public KrtUsingScope using_scope;
    public KrtAstNode context;
    public KrtAstNode owner;
    public int32 parameter_count;
    public KrtAstNode[] parameters;
    public int64[] parameter_starts;
    public int64[] parameter_lengths;
    public KrtAstNode result;
    public int64 return_start;
    public int64 return_length;
}

// Mutable program storage is separate from activation-record local slots.
class KrtNativeGlobalEntry {
    public KrtAstNode declaration;
    public KrtAstNode owner;
    public KrtNativeGlobalEntry next;
    public KrtAstNode assignment;
    public bool bound;
    public int32 guard_slot;
    public int32 exception_slot;
    public int32 storage_size;
    public int32 data_offset;
    public KrtLinkName symbol_name;
    public KrtLinkName guard_name;
    public KrtLinkName initializer_name;
    public bool imported;
    public bool weak;
    public bool module_guard;
    public bool static_data;
    public int64 static_low;
    public int64 static_high;
}

// The program registry stays live while binding discovers concrete generic classes.
class KrtNativeGlobalState {
    public KrtNativeModule output;
    public KrtNativeGlobalEntry first;
    public KrtAstNode initializer;
    public bool changed;
}

// A compilation owns one canonical instance registry. The declaration and the
// complete semantic argument list form the key; source spelling is immaterial.
class KrtGenericRegistry {
    public int32 capacity;
    public int32 count;
    public KrtAstNode[] declarations;
    public KrtAstNode[] arguments;
    public KrtAstNode[] instances;
    public int32[] states;
}

// Name buckets retain declaration order independently of the AST sibling link.
// Entries stay stable when the bucket table grows during generic expansion.
class KrtNativeFunctionEntry {
    public KrtAstNode declaration;
    public KrtNativeFunctionEntry next;
}
class KrtNativeFunctionBucket {
    public int64 name_start;
    public int64 name_length;
    public uint64 hash;
    public KrtNativeFunctionEntry first;
    public KrtNativeFunctionEntry last;
}
class KrtNativeFunctionIndex {
    public int32 capacity;
    public int32 name_count;
    public KrtNativeFunctionBucket[] buckets;
    public KrtAstNode last_indexed_function;
    public bool ok;
}

// Keep the active type-resolution path separate from cached layout states.
class KrtInheritanceStack {
    public KrtAstNode[] types;
    public int32 depth;
    public int32 capacity;
    public KrtAstNode[] cycle_types;
    public int32 cycle_depth;
    public int64 error_start;
    public int64 source;
}

// args and extra have one entry per instruction.  The instruction stream is
// deliberately flat: starts[f] is the first instruction of function f and
// the next start (or count) is its end.
class KrtNativeModule {
    public KrtAstNode ast;
    public int64 source;
    public KrtNativeRuntimeType runtime_types;
    public KrtNativeRuntimeType runtime_type_tail;
    public int32 runtime_type_count;
    public KrtNativeRuntimeType[] runtime_buckets;
    public int32 runtime_bucket_count;
    public byte[] runtime_bytes;
    public int32 runtime_length;
    public int64 runtime_pointer;
    public int32[] runtime_offsets;
    public KrtNativeRuntimeRelocation runtime_relocations;
    public int32 runtime_relocation_count;
    public int32 runtime_code_count;
    public int32[] runtime_code_offsets;
    public int32[] runtime_code_targets;
    public KrtNativeGeneratorPlan generator;
    public bool generator_raw_emit;
    public KrtSsaModule ssa;
    public int32 capacity;
    public int32 count;
    public int32[] ops;
    public int64[] args;
    public int64[] extra;
    public int32 function_count;
    public int32 lower_function_index;
    public int32[] starts;
    public int32[] local_counts;
    public int32[] parameter_counts;
    // Source parameters retain their existing indices. Aggregate returns add
    // one physical ABI parameter without becoming a source-level parameter.
    public int32[] aggregate_return_sizes;
    public int32[] aggregate_return_alignments;
    public int32[] hidden_result_slots;
    public int32[] function_frame_bytes;
    public int32 global_count;
    public KrtNativeGlobalEntry[] global_entries;
    public int32 global_reloc_count;
    public int32[] global_reloc_offsets;
    public int32[] global_reloc_slots;
    public int32 initializer_index;
    public int32 initializer_guard_slot;
    public int32 initializer_exception_slot;
    public bool library_mode;
    public int32[] function_offsets;
    public int32[] function_sizes;
    public KrtAstNode function_ast;
    public KrtAstNode external_head;
    public int32 external_count;
    public bool[] external_used;
    public int32 external_reloc_count;
    public int32[] external_reloc_offsets;
    public int32[] external_reloc_targets;
    public int32 entry;
    public KrtNativeExceptionFrame exception_frame;
    // Data storage is byte[] so the self-host language does not require an
    // unsafe pointer field on this metadata class.
    public int64 data;
    public int32 data_length;
    public int32 errors;
    public int64 error_start;
    public int32[] function_name_starts;
    public int32[] function_name_lengths;
    // Keeping ownership here makes Data instructions safe after the source
    // buffer is released.  Backends may use this field instead of data.
    public byte[] data_storage;
}

// Value ids are unique within the module. Phi operands carry their predecessor
// block ids in phi_predecessors; ordinary operands name dominating definitions.
class KrtSsaModule {
    public KrtNativeModule source;
    public int32 count; public int32 operand_count; public int32 operand_capacity;
    public int32[] ops; public int64[] args; public int64[] extra;
    public int32[] types; public int32[] widths; public bool[] results;
    public int32[] semantic_types; public int32[] semantic_widths;
    public int32[] operand_starts; public int32[] operand_counts; public int32[] operands;
    public int32[] phi_predecessors; public int32[] uses; public int32[] value_blocks;
    public int32 function_count; public int32[] starts; public int32[] ends;
    public int32[] function_blocks; public int32[] function_block_counts;
    public int32 block_count; public int32[] block_starts; public int32[] block_ends;
    public int32[] block_phis; public int32[] block_phi_counts;
    public int32[] block_functions; public int32[] block_left; public int32[] block_right;
    public bool[] handlers;
}

// Handler contexts are compile-time state. Native TryEnter records unwind state.
class KrtNativeExceptionFrame {
    public KrtNativeExceptionFrame previous;
    public KrtAstNode finally_body;
    public int32 record_slot;
    public int32 loop_depth;
    public bool active_handler;
    public int32 handler_enter;
    public bool owns_packet;
    public int32 packet_slot;
}

// ===== Diagnostics =====
// Diagnostic records are shared by compiler state and component fixtures.
// Reporting and driver algorithms stay in ErrorReports.krt.
enum KrtDiagnosticStage { Lexer = 0, Parser = 1, Names = 2, Types = 3, Generics = 4, Lowering = 5, Optimization = 6, Backend = 7 }

class KrtDiagnosticRecord {
    public string code;
    public int32 code_length;
    public int64 position;
    public string message;
    public KrtDiagnosticStage stage;
    public KrtDiagnosticRecord next;
}

class KrtCompilerDiagnostics {
    public KrtDiagnosticRecord head;
    public KrtDiagnosticRecord tail;
    public int32 count;
    public int32 limit;
    public KrtDiagnosticStage stage;
}


static KrtCompilerDiagnostics KrtCurrentDiagnostics = null;

void KrtErrorReportAdd(KrtCompilerDiagnostics report, string code, int32 code_length, int64 position, string message) {
    if (report == null || report.count >= report.limit) { return; }
    if (position < 0) { position = 0; }
    KrtDiagnosticRecord existing = report.head;
    while (existing != null) {
        if (existing.position == position && KrtDriverStringEqual((int64)existing.code,(int64)code)) { return; }
        existing = existing.next;
    }
    KrtDiagnosticRecord record = new KrtDiagnosticRecord(); record.code = code; record.code_length = code_length;
    record.position = position; record.message = message; record.stage = report.stage;
    if (report.head == null) { report.head = record; } else { report.tail.next = record; }
    report.tail = record; report.count = report.count + 1;
}

void KrtDiagnosticMessage(string code, int32 code_length, int64 position, string message) {
    KrtDriverLastErrorCode = (int64)code;
    if (KrtCurrentDiagnostics != null) { KrtErrorReportAdd(KrtCurrentDiagnostics,code,code_length,position,message); }
    else { KrtDiagnosticWrite(code,code_length,position,message); }
}

void KrtErrorReportFlush(KrtCompilerDiagnostics report) {
    KrtDiagnosticRecord record = report.head;
    while (record != null) { KrtDiagnosticWrite(record.code,record.code_length,record.position,record.message); record = record.next; }
}

bool KrtErrorReportHasErrors() { return KrtCurrentDiagnostics != null && KrtCurrentDiagnostics.count > 0; }

void KrtNativeBindingDiagnostic(KrtAstNode module, int64 position) {
    if (module.native_error == 1) { KrtDiagnostic("E_CONDITIONAL_ARRAY",19,position); }
    else if (module.native_error == 2) { KrtDiagnostic("E_ARGUMENT_COUNT",16,position); }
    else if (module.native_error == 3) { KrtDiagnostic("E_WRITABLE_REF",14,position); }
    else if (module.native_error == 4) { KrtDiagnostic("E_UNDEFINED_METHOD",18,position); }
    else if (module.native_error == 5) { KrtDiagnostic("E_NOT_NULLABLE",14,position); }
    else if (module.native_error == 6) { KrtDiagnostic("E_GENERIC_CONSTRAINT",20,position); }
    else if (module.native_error == 7) { KrtDiagnostic("E_SWITCH",8,position); }
    else if (module.native_error == 8) { KrtInheritanceDiagnostic(module,position); }
    else if (module.native_error == 9) { KrtDiagnostic("E_ARGUMENT_NAME",15,position); }
    else if (module.native_error == 10) { KrtDiagnostic("E_ACCESS",8,position); }
    else if (module.native_error == 11) { KrtDiagnostic("E_MODIFIER",10,position); }
    else if (module.native_error == 12) { KrtDiagnostic("E_LAYOUT",8,position); }
    else if (module.native_error == 13) { KrtDiagnostic("E_ABI_UNSUPPORTED",17,position); }
    else if (module.native_error == 14) { KrtDiagnostic("E_CAPTURE_BORROW",16,position); }
    else if (module.native_error == 15) { KrtDiagnostic("E_BOXING",8,position); }
    else if (module.native_error == 16) { KrtDiagnostic("E_ITERATOR",10,position); }
    else { KrtDiagnostic("E_LOWER",7,position); }
}

// ===== Print runtime declarations =====
// Runtime helper source is parsed and compiled by the native compiler when print is used.
string KrtPrintRuntimeSource() { return "\nnamespace;\nint64 __KrtPrintLength(int64 text){unsafe(using krt.mem;){if(text==0){return 0;}byte* data=(byte*)text;int64 n=0;while(data[n]!=0){n++;}return n;}}\nint64 __KrtPrintAllocate(int64 size){byte[] data=new byte[size];unsafe(using krt.mem;){return (int64)(byte*)data;}}\nint64 __KrtPrintConcat(int64 first,int64 second){int64 a=__KrtPrintLength(first);int64 b=__KrtPrintLength(second);int64 text=__KrtPrintAllocate(a+b+1);unsafe(using krt.mem;){byte* out=(byte*)text;byte* left=(byte*)first;byte* right=(byte*)second;int64 i=0;while(i<a){out[i]=left[i];i++;}i=0;while(i<b){out[a+i]=right[i];i++;}out[a+b]=0;}return text;}\nint64 __KrtPrintUnsigned(uint64 n){int64 text=__KrtPrintAllocate(24);unsafe(using krt.mem;){byte* data=(byte*)text;int32 i=23;data[i]=0;do{i--;data[i]=(byte)(48+n%10);n=n/10;}while(n!=0);return text+i;}}\nint64 __KrtPrintSigned(int64 n){uint64 magnitude=(uint64)n;if(n<0){magnitude=(uint64)(-(n+1))+1;return __KrtPrintConcat((int64)\"-\",__KrtPrintUnsigned(magnitude));}return __KrtPrintUnsigned(magnitude);}\nint64 __KrtPrintWideUnsigned(uint128 n){int64 text=__KrtPrintAllocate(48);unsafe(using krt.mem;){byte* data=(byte*)text;int32 i=47;data[i]=0;do{i--;data[i]=(byte)(48+n%10);n=n/10;}while(n!=0);return text+i;}}\nint64 __KrtPrintWideSigned(int128 n){uint128 magnitude=(uint128)n;if(n<0){magnitude=(uint128)(-(n+1))+1;return __KrtPrintConcat((int64)\"-\",__KrtPrintWideUnsigned(magnitude));}return __KrtPrintWideUnsigned(magnitude);}\nint64 __KrtPrintBoolean(bool value){if(value){return (int64)\"True\";}return (int64)\"False\";}\nint64 __KrtPrintCharacter(char value){int64 text=__KrtPrintAllocate(2);unsafe(using krt.mem;){byte* data=(byte*)text;data[0]=(byte)value;data[1]=0;}return text;}\nvoid __KrtPrintWrite(int64 text){syscall(1,1,text,__KrtPrintLength(text),0,0,0);}\nvoid __KrtPrintLine(){syscall(1,1,(int64)\"\\n\",1,0,0,0);}\n// Exact binary-double to six-significant-digit general format (%g).\n// Decimal rounding uses integer digits and ties to even.\nint64 __KrtPrintFloatBits(int64 bits) {\n    uint64 raw = (uint64)bits; bool negative = (raw >> 63) != 0;\n    int32 exponent_bits = (int32)((raw >> 52) & 2047); uint64 significand = raw & 4503599627370495;\n    int64 result = 0;\n    if (exponent_bits == 2047) {\n        result = (int64)\"inf\"; if (significand != 0) { result = (int64)\"nan\"; }\n        if (negative) { result = __KrtPrintConcat((int64)\"-\",result); } return result;\n    }\n    if (exponent_bits == 0 && significand == 0) { if (negative) { return (int64)\"-0\"; } return (int64)\"0\"; }\n    int32 power = -1074;\n    if (exponent_bits != 0) { significand = significand | 4503599627370496; power = exponent_bits - 1075; }\n    uint32[] limbs = new uint32[128]; int32 count = 1;\n    limbs[0] = (uint32)(significand % 1000000000); uint64 high = significand / 1000000000;\n    if (high != 0) { limbs[1] = (uint32)high; count = 2; }\n    int32 scale = 0; int32 repetitions = power; int32 multiplier = 2;\n    if (power < 0) { scale = -power; repetitions = -power; multiplier = 5; }\n    int32 repeat = 0;\n    while (repeat < repetitions) {\n        uint64 carry = 0; int32 index = 0;\n        while (index < count) {\n            uint64 value = (uint64)limbs[index] * (uint64)multiplier + carry;\n            limbs[index] = (uint32)(value % 1000000000); carry = value / 1000000000; index = index + 1;\n        }\n        if (carry != 0) { if (count >= 128) { return 0; } limbs[count] = (uint32)carry; count = count + 1; }\n        repeat = repeat + 1;\n    }\n    int64 digits = __KrtPrintAllocate((int64)count * 9 + 1); if (digits == 0) { return 0; }\n    int64 first = __KrtPrintSigned(limbs[count - 1]); int64 length = __KrtPrintLength(first);\n    unsafe(using krt.mem;) {\n        byte* output = (byte*)digits; byte* source = (byte*)first; int64 index = 0;\n        while (index < length) { output[index] = source[index]; index = index + 1; }\n        int32 limb = count - 2;\n        while (limb >= 0) {\n            uint32 number = limbs[limb]; int32 place = 8;\n            while (place >= 0) { output[length + place] = (byte)(48 + number % 10); number = number / 10; place = place - 1; }\n            length = length + 9; limb = limb - 1;\n        }\n        output[length] = 0;\n    }\n    int32 exponent = (int32)length - scale - 1; int32 rounded = 0;\n    unsafe(using krt.mem;) {\n        byte* source = (byte*)digits; int32 index = 0;\n        while (index < 6) { rounded = rounded * 10; if (index < length) { rounded = rounded + (int32)source[index] - 48; } index = index + 1; }\n        if (length > 6) {\n            bool remainder = false; index = 7;\n            while (index < length) { if (source[index] != 48) { remainder = true; break; } index = index + 1; }\n            if (source[6] > 53 || (source[6] == 53 && (remainder || (rounded & 1) != 0))) { rounded = rounded + 1; }\n        }\n    }\n    if (rounded == 1000000) { rounded = 100000; exponent = exponent + 1; }\n    int64 significant = __KrtPrintSigned(rounded); int64 significant_length = 6;\n    unsafe(using krt.mem;) { byte* source = (byte*)significant;\n        while (significant_length > 1 && source[significant_length - 1] == 48) { significant_length = significant_length - 1; }\n    }\n    int64 text = __KrtPrintAllocate(48); if (text == 0) { return 0; } int64 position = 0;\n    unsafe(using krt.mem;) {\n        byte* output = (byte*)text; byte* source = (byte*)significant;\n        if (negative) { output[position] = 45; position = position + 1; }\n        if (exponent < -4 || exponent >= 6) {\n            output[position] = source[0]; position = position + 1;\n            if (significant_length > 1) { output[position] = 46; position = position + 1; int32 index = 1;\n                while (index < significant_length) { output[position] = source[index]; position = position + 1; index = index + 1; }\n            }\n            output[position] = 101; position = position + 1;\n            if (exponent < 0) { output[position] = 45; exponent = -exponent; } else { output[position] = 43; } position = position + 1;\n            int64 exponent_text = __KrtPrintSigned(exponent); int64 exponent_length = __KrtPrintLength(exponent_text); byte* exponent_digits = (byte*)exponent_text;\n            if (exponent_length < 2) { output[position] = 48; position = position + 1; }\n            int32 index = 0; while (index < exponent_length) { output[position] = exponent_digits[index]; position = position + 1; index = index + 1; }\n        }\n        else if (exponent < 0) {\n            output[position] = 48; output[position + 1] = 46; position = position + 2; int32 zeros = -exponent - 1;\n            while (zeros > 0) { output[position] = 48; position = position + 1; zeros = zeros - 1; }\n            int32 index = 0; while (index < significant_length) { output[position] = source[index]; position = position + 1; index = index + 1; }\n        }\n        else {\n            int32 decimal_point = exponent + 1; int32 index = 0;\n            while (index < significant_length || index < decimal_point) {\n                if (index == decimal_point) { output[position] = 46; position = position + 1; }\n                output[position] = 48; if (index < significant_length) { output[position] = source[index]; }\n                position = position + 1; index = index + 1;\n            }\n        }\n        output[position] = 0;\n    }\n    return text;\n}\n"; }

bool KrtPrintRuntimeRequired(int64 source, int32 length) {
    KrtLexer lexer = new KrtLexer(); KrtToken token = new KrtToken();
    unsafe(using krt.mem;) { if (!KrtLexerInit(lexer,(byte*)source,length)) { return false; } }
    KrtLexerNext(lexer,token);
    while (token.kind != KrtTokenKind.Eof) {
        if (KrtNativeSpanWord(source,token.start,token.length,"print") && token.category == KrtTokenCategory.Identifier) { return true; }
        KrtLexerNext(lexer,token);
    }
    return false;
}
