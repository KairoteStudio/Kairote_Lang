    if (block.native_cell_owners != null && !block.native_closure_lowering) {
        return KrtNativeLowerCellOwnerBlock(block,module_ast,unit,module,source,breaks,continues,ref depth);
    }
    KrtNativeCellOwner owner = block.native_cell_owners;
    while (owner != null) {
        if (owner.declaration.native_cell_initial_parameter && !KrtNativeLowerCellInitialize(owner.declaration,module_ast,module,source)) { return false; }
        owner = owner.next;
