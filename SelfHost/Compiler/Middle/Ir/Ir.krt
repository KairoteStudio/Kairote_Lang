// Floating-literal parsing and emission.
// Decimal-to-binary conversion uses an exact rational and rounds once, ties-even.
// Base-65536 limbs keep all intermediate arithmetic within signed 64 bits.
int32 KrtFloatBigLength(int64[] words) {
    int32 index = 255;
    while (index >= 0 && words[index] == 0) { index = index - 1; }
    if (index < 0) { return 0; }
    int64 word = words[index]; int32 bits = 0;
    while (word != 0) { word = word >> 1; bits = bits + 1; }
    return index * 16 + bits;
}

bool KrtFloatBigMultiply(int64[] words, int32 factor, int32 addend) {
    int64 carry = addend; int32 index = 0;
    while (index < 256) {
        int64 value = words[index] * factor + carry;
        words[index] = value & 65535; carry = value >> 16; index = index + 1;
    }
    return carry == 0;
}

int64 KrtFloatBigDigit(int64[] words, int32 index, int32 shift) {
    int32 whole = shift / 16; int32 part = shift % 16; int32 source_index = index - whole;
    int64 value = 0;
    if (source_index >= 0 && source_index < 256) { value = (words[source_index] << part) & 65535; }
    if (part != 0 && source_index > 0 && source_index <= 256) { value = value | (words[source_index - 1] >> (16 - part)); }
    return value;
}

int32 KrtFloatBigCompare(int64[] left, int64[] right, int32 shift) {
    int32 left_bits = KrtFloatBigLength(left); int32 right_bits = KrtFloatBigLength(right);
    if (right_bits != 0) { right_bits = right_bits + shift; }
    if (left_bits < right_bits) { return -1; }
    if (left_bits > right_bits) { return 1; }
    int32 index = 255;
    while (index >= 0) {
        int64 other = KrtFloatBigDigit(right, index, shift);
        if (left[index] < other) { return -1; }
        if (left[index] > other) { return 1; }
        index = index - 1;
    }
    return 0;
}

bool KrtFloatBigShift(int64[] words, int32 shift) {
    if (shift < 0 || KrtFloatBigLength(words) + shift > 4096) { return false; }
    int32 index = 255;
    while (index >= 0) { words[index] = KrtFloatBigDigit(words, index, shift); index = index - 1; }
    return true;
}

void KrtFloatBigSubtract(int64[] words, int64[] other, int32 shift) {
    int32 index = 0; int64 borrow = 0;
    while (index < 256) {
        int64 value = words[index] - KrtFloatBigDigit(other, index, shift) - borrow;
        borrow = 0;
        if (value < 0) { value = value + 65536; borrow = 1; }
        words[index] = value; index = index + 1;
    }
}

bool KrtNativeFloatingBits(KrtAstNode expression, int64 source, ref int64 result) {
    int64[] numerator = new int64[256]; int64[] denominator = new int64[256]; denominator[0] = 1;
    int32 decimal_exponent = 0; bool fractional = false; int64 index = 0;
    unsafe(using krt.mem;) {
        byte* input = (byte*)source;
        while (index < expression.length) {
            int32 character = (int32)input[expression.start + index];
            if (character == 46) { fractional = true; }
            else if (character >= 48 && character <= 57) {
                if (!KrtFloatBigMultiply(numerator, 10, character - 48)) { delete numerator; delete denominator; return false; }
                if (fractional) { decimal_exponent = decimal_exponent - 1; }
            } else if (character == 101 || character == 69) {
                index = index + 1; int32 sign = 1; int32 exponent = 0;
                if (index < expression.length && input[expression.start + index] == 45) { sign = -1; index = index + 1; }
                else if (index < expression.length && input[expression.start + index] == 43) { index = index + 1; }
                while (index < expression.length && input[expression.start + index] >= 48 && input[expression.start + index] <= 57) {
                    if (exponent < 1000000) { exponent = exponent * 10 + input[expression.start + index] - 48; }
                    index = index + 1;
                }
                decimal_exponent = decimal_exponent + exponent * sign; break;
            } else { break; }
            index = index + 1;
        }
    }
    int32 fraction_bits = expression.native_float == 4 ? 23 : 52;
    int32 bias = expression.native_float == 4 ? 127 : 1023;
    int32 minimum = 1 - bias;
    int64 infinity = expression.native_float == 4 ? 2139095040 : 9218868437227405312;
    if (KrtFloatBigLength(numerator) == 0 || decimal_exponent < -2000) { result = 0; delete numerator; delete denominator; return true; }
    if (decimal_exponent > 2000) { result = infinity; delete numerator; delete denominator; return true; }
    while (decimal_exponent > 0) {
        if (!KrtFloatBigMultiply(numerator, 10, 0)) { result = infinity; delete numerator; delete denominator; return true; }
        decimal_exponent = decimal_exponent - 1;
    }
    while (decimal_exponent < 0) {
        if (!KrtFloatBigMultiply(denominator, 10, 0)) { result = 0; delete numerator; delete denominator; return true; }
        decimal_exponent = decimal_exponent + 1;
    }
    int32 exponent = KrtFloatBigLength(numerator) - KrtFloatBigLength(denominator);
    if ((exponent >= 0 && KrtFloatBigCompare(numerator, denominator, exponent) < 0) ||
        (exponent < 0 && KrtFloatBigCompare(denominator, numerator, -exponent) > 0)) { exponent = exponent - 1; }
    if (exponent > bias) { result = infinity; delete numerator; delete denominator; return true; }
    if (exponent < minimum - fraction_bits - 1) { result = 0; delete numerator; delete denominator; return true; }
    int32 shift = fraction_bits - (exponent < minimum ? minimum : exponent);
    bool shifted = shift >= 0 ? KrtFloatBigShift(numerator, shift) : KrtFloatBigShift(denominator, -shift);
    if (!shifted) { delete numerator; delete denominator; return false; }
    int64 quotient = 0;
    int32 bit = KrtFloatBigLength(numerator) - KrtFloatBigLength(denominator);
    if (bit > 53) { delete numerator; delete denominator; return false; }
    while (bit >= 0) {
        if (KrtFloatBigCompare(numerator, denominator, bit) >= 0) {
            KrtFloatBigSubtract(numerator, denominator, bit); quotient = quotient | ((int64)1 << bit);
        }
        bit = bit - 1;
    }
    int32 halfway = KrtFloatBigCompare(denominator, numerator, 1);
    if (halfway < 0 || (halfway == 0 && (quotient & 1) != 0)) { quotient = quotient + 1; }
    if (exponent < minimum) { result = quotient; }
    else {
        if (quotient == ((int64)1 << (fraction_bits + 1))) { quotient = quotient >> 1; exponent = exponent + 1; }
        if (exponent > bias) { result = infinity; }
        else { result = ((int64)(exponent + bias) << fraction_bits) | (quotient - ((int64)1 << fraction_bits)); }
    }
    delete numerator; delete denominator; return true;
}

// ===== Generator lowering =====
// Generator activations live in ordinary heap storage. Existing SSA operations
// provide every load, store, address, branch, call and exception edge.
int32 KrtNativeGeneratorRaw(KrtNativeModule module, int32 op, int64 arg, int64 extra) {
    bool previous = module.generator_raw_emit; module.generator_raw_emit = true;
    int32 result = KrtNativeEmit(module,op,arg,extra);
    module.generator_raw_emit = previous; return result;
}

bool KrtNativeGeneratorAddress(KrtNativeModule module, int32 offset) {
    KrtNativeGeneratorPlan plan = module.generator;
    return plan != null && KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.LoadLocal,plan.receiver_slot,0) >= 0 &&
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Address,0,offset) >= 0;
}

int32 KrtNativeGeneratorEmit(KrtNativeModule module, int32 op, int64 arg, int64 extra) {
    KrtNativeGeneratorPlan plan = module.generator; int32 first = module.count;
    if (plan == null || module.generator_raw_emit) { return KrtNativeGeneratorRaw(module,op,arg,extra); }
    if ((op == (int32)KrtNativeOp.LoadLocal || op == (int32)KrtNativeOp.StoreLocal || op == (int32)KrtNativeOp.Ref) &&
        arg >= 0 && arg < plan.body_locals) {
        int32 offset = plan.slots_offset + (int32)arg*8;
        if (op == (int32)KrtNativeOp.StoreLocal &&
            KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.StoreLocal,plan.scratch_slot,0) < 0) { return -1; }
        if (!KrtNativeGeneratorAddress(module,offset)) { return -1; }
        if (op == (int32)KrtNativeOp.LoadLocal && KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Load,0,8) < 0) { return -1; }
        if (op == (int32)KrtNativeOp.StoreLocal &&
            (KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.LoadLocal,plan.scratch_slot,0) < 0 ||
             KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Store,0,8) < 0)) { return -1; }
        return first;
    }
    if (op == (int32)KrtNativeOp.AggregateFrameAddress) {
        if (arg < 0 || extra <= 0 || arg > plan.body_frame_bytes-extra ||
            !KrtNativeGeneratorAddress(module,plan.aggregate_offset+(int32)arg)) { return -1; }
        return first;
    }
    return KrtNativeGeneratorRaw(module,op,arg,extra);
}

bool KrtNativeGeneratorWrite(KrtNativeModule module, int32 offset, int64 value) {
    return KrtNativeGeneratorAddress(module,offset) &&
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Const,value,0) >= 0 &&
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Store,0,8) >= 0;
}

bool KrtNativeGeneratorRead(KrtNativeModule module, int32 offset) {
    return KrtNativeGeneratorAddress(module,offset) && KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Load,0,8) >= 0;
}

bool KrtNativeGeneratorError(KrtNativeModule module, int32 value) {
    return KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Const,value,0) >= 0 &&
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Const,4,0) >= 0 &&
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Throw,0,0) >= 0;
}

bool KrtNativeGeneratorGuardBusy(KrtNativeModule module) {
    if (!KrtNativeGeneratorRead(module,24)) { return false; }
    int32 guard = KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Branch,-1,-1);
    if (guard < 0 || !KrtNativeGeneratorError(module,-2147483602)) { return false; }
    module.args[guard] = guard+1; module.extra[guard] = module.count;
    return true;
}

KrtNativeExceptionFrame KrtNativeGeneratorCopyFrames(KrtNativeExceptionFrame original) {
    KrtNativeExceptionFrame first = null; KrtNativeExceptionFrame tail = null;
    while (original != null) {
        KrtNativeExceptionFrame frame = new KrtNativeExceptionFrame();
        frame.finally_body = original.finally_body; frame.record_slot = original.record_slot;
        frame.loop_depth = original.loop_depth; frame.active_handler = original.active_handler;
        frame.handler_enter = original.handler_enter;
        frame.owns_packet = original.owns_packet; frame.packet_slot = original.packet_slot;
        if (tail == null) { first = frame; } else { tail.previous = frame; }
        tail = frame; original = original.previous;
    }
    return first;
}

bool KrtNativeGeneratorLeaveHandlers(KrtNativeExceptionFrame frame, KrtNativeModule module) {
    while (frame != null) {
        if (frame.active_handler && KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.TryLeave,frame.record_slot,0) < 0) { return false; }
        frame = frame.previous;
    }
    return true;
}

bool KrtNativeGeneratorRestoreHandlers(KrtNativeExceptionFrame frame, KrtNativeModule module) {
    if (frame == null) { return true; }
    if (!KrtNativeGeneratorRestoreHandlers(frame.previous,module)) { return false; }
    return !frame.active_handler || (frame.handler_enter >= 0 && frame.handler_enter < module.count &&
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.TryEnter,module.args[frame.handler_enter],frame.record_slot) >= 0);
}

bool KrtNativeLowerYield(KrtAstNode statement, KrtAstNode ast, KrtAstNode unit, KrtNativeModule module, int64 source, int32[] breaks, int32[] continues, ref int32 depth) {
    KrtNativeGeneratorPlan plan = module.generator;
    if (plan == null || unit.native_generator_role != 3) { return false; }
    if (statement.kind == KrtAstKind.YieldBreak) {
        return KrtNativeLowerCleanup(ast,unit,module,source,breaks,continues,ref depth,true) &&
            KrtNativeGeneratorWrite(module,8,-1) && KrtNativeGeneratorWrite(module,16,0) && KrtNativeGeneratorWrite(module,24,0) &&
            KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Const,0,0) >= 0 &&
            KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Return,0,1) >= 0;
    }
    if (!KrtNativeGeneratorAddress(module,plan.current_offset) ||
        !KrtNativeLowerExpression(statement.left,ast,module,source)) { return false; }
    if (KrtNativeInlineValue(plan.element_type)) {
        if (KrtNativeWideKind(plan.element_type) && !KrtNativeConvertValue(module,statement.left,plan.element_type)) { return false; }
        if (!KrtNativeLowerAggregateCopy(plan.element_type,module)) { return false; }
    } else {
        if (!KrtNativeConvertValue(module,statement.left,plan.element_type) ||
            KrtNativeEmit(module,(int32)KrtNativeOp.Store,0,KrtNativeWidth(plan.element_type)) < 0) { return false; }
    }
    KrtNativeGeneratorResume resume = new KrtNativeGeneratorResume();
    plan.state_count = plan.state_count+1; resume.state = plan.state_count;
    resume.frames = KrtNativeGeneratorCopyFrames(module.exception_frame);
    resume.next = plan.resumes; plan.resumes = resume;
    if (!KrtNativeGeneratorWrite(module,8,resume.state) || !KrtNativeGeneratorWrite(module,16,1) ||
        !KrtNativeGeneratorWrite(module,24,0) || !KrtNativeGeneratorLeaveHandlers(resume.frames,module) ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Const,1,0) < 0 ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Return,0,1) < 0) { return false; }
    resume.target = module.count;
    return true;
}

bool KrtNativeGeneratorAllocate(KrtAstNode type, int32 slot, KrtAstNode ast, KrtNativeModule module, int64 source) {
    KrtAstNode allocation = KrtAstMake(KrtAstKind.New,type.start,0);
    allocation.native_type = type; allocation.native_width = 8; allocation.native_size = type.native_size;
    allocation.local_slot = slot;
    return KrtNativeLowerNew(allocation,ast,module,source);
}

bool KrtNativeGeneratorAllocationGuard(KrtNativeModule module, int32 slot) {
    if (KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.LoadLocal,slot,0) < 0) { return false; }
    int32 allocated = KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Branch,-1,-1);
    if (allocated < 0 || KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Const,0,0) < 0 ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Return,0,1) < 0) { return false; }
    module.extra[allocated] = allocated+1; module.args[allocated] = module.count;
    return true;
}

bool KrtNativeGeneratorStoreParameter(KrtNativeGeneratorPlan plan, KrtAstNode parameter, int32 index, int32 object_slot, KrtNativeModule module) {
    if (KrtNativeInlineValue(parameter) || KrtNativeWideKind(parameter)) {
        int32 offset = plan.aggregate_offset+parameter.native_frame_offset;
        if (KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.LoadLocal,object_slot,0) < 0 ||
            KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Address,0,offset) < 0 ||
            KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.LoadLocal,index,0) < 0 ||
            KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.AggregateCopy,KrtNativeValueStorage(parameter),KrtNativeValueAlignment(parameter)) < 0) { return false; }
        if (!KrtNativeWideKind(parameter)) { return true; }
        return KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.LoadLocal,object_slot,0) >= 0 &&
            KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Address,0,plan.slots_offset+index*8) >= 0 &&
            KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.LoadLocal,object_slot,0) >= 0 &&
            KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Address,0,offset) >= 0 &&
            KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Store,0,8) >= 0;
    }
    return KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.LoadLocal,object_slot,0) >= 0 &&
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Address,0,plan.slots_offset+index*8) >= 0 &&
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.LoadLocal,index,0) >= 0 &&
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Store,0,8) >= 0;
}

bool KrtNativeLowerGeneratorFactory(KrtAstNode ast, KrtAstNode unit, KrtNativeModule module, int64 source) {
    KrtNativeGeneratorPlan plan = unit.native_generator;
    if (module.initializer_index >= 0 && module.lower_function_index != module.initializer_index &&
        (KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Call,module.initializer_index,0) < 0 ||
         KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Drop,0,0) < 0)) { return false; }
    KrtAstNode type = plan.sequence_type == null ? plan.cursor_type : plan.sequence_type;
    if (!KrtNativeGeneratorAllocate(type,plan.factory_slot,ast,module,source) ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Drop,0,0) < 0 ||
        !KrtNativeGeneratorAllocationGuard(module,plan.factory_slot)) { return false; }
    KrtAstNode parameter = plan.parameters; int32 index = 0;
    while (parameter != null && index < unit.parameter_count) {
        if (!KrtNativeGeneratorStoreParameter(plan,parameter,index,plan.factory_slot,module)) { return false; }
        parameter = parameter.next; index = index+1;
    }
    return index == unit.parameter_count && KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.LoadLocal,plan.factory_slot,0) >= 0 &&
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Return,0,1) >= 0;
}

bool KrtNativeLowerGeneratorGet(KrtAstNode ast, KrtAstNode unit, KrtNativeModule module, int64 source) {
    KrtNativeGeneratorPlan plan = unit.native_generator;
    if (!KrtNativeGeneratorAllocate(plan.cursor_type,1,ast,module,source) ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Drop,0,0) < 0 ||
        !KrtNativeGeneratorAllocationGuard(module,1) ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.LoadLocal,1,0) < 0 ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Address,0,8) < 0 ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.LoadLocal,0,0) < 0 ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Address,0,8) < 0 ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.AggregateCopy,plan.object_size-8,8) < 0) { return false; }
    KrtAstNode parameter = plan.parameters; int32 index = 0;
    while (parameter != null) {
        if (KrtNativeWideKind(parameter) &&
            (KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.LoadLocal,1,0) < 0 ||
             KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Address,0,plan.slots_offset+index*8) < 0 ||
             KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.LoadLocal,1,0) < 0 ||
             KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Address,0,plan.aggregate_offset+parameter.native_frame_offset) < 0 ||
             KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Store,0,8) < 0)) { return false; }
        parameter = parameter.next; index = index+1;
    }
    return KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.LoadLocal,1,0) >= 0 &&
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Return,0,1) >= 0;
}

bool KrtNativeLowerGeneratorCurrent(KrtAstNode unit, KrtNativeModule module) {
    KrtNativeGeneratorPlan plan = unit.native_generator;
    if (KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.LoadLocal,0,0) < 0 ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Address,0,16) < 0 ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Load,0,8) < 0) { return false; }
    int32 valid = KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Branch,-1,-1);
    if (valid < 0 || !KrtNativeGeneratorError(module,-2147483601)) { return false; }
    module.extra[valid] = valid+1; module.args[valid] = module.count;
    if (KrtNativeInlineValue(plan.element_type)) {
        if (KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.LoadLocal,1,0) < 0 ||
            KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.LoadLocal,0,0) < 0 ||
            KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Address,0,plan.current_offset) < 0 ||
            KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.AggregateCopy,KrtNativeValueStorage(plan.element_type),KrtNativeValueAlignment(plan.element_type)) < 0 ||
            KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.LoadLocal,1,0) < 0) { return false; }
    } else {
        if (KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.LoadLocal,0,0) < 0 ||
            KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Address,0,plan.current_offset) < 0 ||
            KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Load,0,KrtNativeWidth(plan.element_type)) < 0) { return false; }
        if (KrtNativeWideKind(plan.element_type) &&
            (KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.WideConvert,5,0) < 0 || !KrtNativeNormalizeWide(module,plan.element_type))) { return false; }
    }
    return KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Return,0,1) >= 0;
}

bool KrtNativeLowerGeneratorMove(KrtAstNode ast, KrtAstNode unit, KrtNativeModule module, int64 source) {
    KrtNativeGeneratorPlan plan = unit.native_generator; module.generator = plan;
    if (KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.LoadLocal,0,0) < 0 ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.StoreLocal,plan.receiver_slot,0) < 0 ||
        !KrtNativeGeneratorGuardBusy(module) || !KrtNativeGeneratorRead(module,8) ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Const,0,0) < 0 ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Compare,60,0) < 0) { return false; }
    int32 completed = KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Branch,-1,-1);
    if (completed < 0 || KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Const,0,0) < 0 ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Return,0,1) < 0) { return false; }
    module.args[completed] = completed+1; module.extra[completed] = module.count;
    if (!KrtNativeGeneratorWrite(module,24,1) || !KrtNativeGeneratorWrite(module,16,0)) { return false; }
    int32 dispatch = KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Jump,-1,0);
    if (dispatch < 0) { return false; }
    int32 initial = module.count;
    int32 enter = KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.TryEnter,-1,plan.handler_slot);
    if (enter < 0) { return false; }
    KrtNativeExceptionFrame frame = new KrtNativeExceptionFrame(); frame.active_handler = true;
    frame.record_slot = plan.handler_slot; frame.handler_enter = enter; frame.loop_depth = -1;
    module.exception_frame = frame;
    int32[] breaks = new int32[64]; int32[] continues = new int32[64]; int32 depth = 0;
    if (!KrtNativeLowerBlock(plan.body,ast,unit,module,source,breaks,continues,ref depth) ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.TryLeave,plan.handler_slot,0) < 0 ||
        !KrtNativeGeneratorWrite(module,8,-1) || !KrtNativeGeneratorWrite(module,16,0) || !KrtNativeGeneratorWrite(module,24,0) ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Const,0,0) < 0 ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Return,0,1) < 0) { return false; }
    module.exception_frame = null; module.args[enter] = module.count;
    if (!KrtNativeGeneratorWrite(module,8,-1) || !KrtNativeGeneratorWrite(module,16,0) || !KrtNativeGeneratorWrite(module,24,0) ||
        !KrtNativeLowerSavedThrow(module,plan.handler_slot)) { return false; }
    module.args[dispatch] = module.count;
    if (!KrtNativeGeneratorRead(module,8) || KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Const,0,0) < 0 ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Compare,61,0) < 0) { return false; }
    int32 first = KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Branch,initial,-1);
    if (first < 0) { return false; } module.extra[first] = module.count;
    KrtNativeGeneratorResume resume = plan.resumes;
    while (resume != null) {
        if (!KrtNativeGeneratorRead(module,8) || KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Const,resume.state,0) < 0 ||
            KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Compare,61,0) < 0) { return false; }
        int32 selected = KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Branch,-1,-1);
        if (selected < 0) { return false; } module.args[selected] = module.count;
        if (!KrtNativeGeneratorRestoreHandlers(resume.frames,module) ||
            KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Jump,resume.target,0) < 0) { return false; }
        module.extra[selected] = module.count; resume = resume.next;
    }
    if (!KrtNativeGeneratorWrite(module,8,-1) || !KrtNativeGeneratorWrite(module,24,0) ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Const,0,0) < 0 ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Return,0,1) < 0) { return false; }
    delete breaks; delete continues; module.generator = null;
    return true;
}

bool KrtNativeGeneratorFree(KrtNativeModule module) {
    return KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.LoadLocal,module.generator.receiver_slot,0) >= 0 &&
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Free,0,0) >= 0;
}

KrtAstNode KrtNativeGeneratorCleanupTree(KrtNativeExceptionFrame frame, KrtAstNode site) {
    KrtAstNode active = null;
    while (frame != null) {
        if (frame.finally_body != null) {
            if (active == null) { active = KrtNativeIteratorBlock(frame.finally_body,site); }
            else {
                KrtAstNode guarded = KrtAstMake(KrtAstKind.Try,site.start,0);
                guarded.left = active; guarded.alternate = frame.finally_body; guarded.local_slot = frame.record_slot;
                active = KrtNativeIteratorBlock(guarded,site);
            }
        }
        frame = frame.previous;
    }
    return active;
}

bool KrtNativeLowerGeneratorDispose(KrtAstNode ast, KrtAstNode unit, KrtNativeModule module, int64 source) {
    KrtNativeGeneratorPlan plan = unit.native_generator; module.generator = plan;
    if (KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.LoadLocal,0,0) < 0 ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.StoreLocal,plan.receiver_slot,0) < 0 ||
        !KrtNativeGeneratorGuardBusy(module) || !KrtNativeGeneratorRead(module,8) ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.StoreLocal,plan.scratch_slot,0) < 0 ||
        !KrtNativeGeneratorWrite(module,24,1) || !KrtNativeGeneratorWrite(module,8,-1) ||
        !KrtNativeGeneratorWrite(module,16,0)) { return false; }
    int32 enter = KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.TryEnter,-1,plan.handler_slot);
    if (enter < 0) { return false; }
    KrtNativeExceptionFrame frame = new KrtNativeExceptionFrame(); frame.active_handler = true;
    frame.record_slot = plan.handler_slot; frame.handler_enter = enter; frame.loop_depth = -1;
    module.exception_frame = frame;
    int32[] breaks = new int32[64]; int32[] continues = new int32[64]; int32 depth = 0; int32 exits = -1;
    KrtNativeGeneratorResume resume = plan.resumes;
    while (resume != null) {
        if (KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.LoadLocal,plan.scratch_slot,0) < 0 ||
            KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Const,resume.state,0) < 0 ||
            KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Compare,61,0) < 0) { return false; }
        int32 selected = KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Branch,-1,-1);
        if (selected < 0) { return false; } module.args[selected] = module.count;
        KrtAstNode cleanup = KrtNativeGeneratorCleanupTree(resume.frames,unit);
        if (cleanup != null && !KrtNativeLowerBlock(cleanup,ast,unit,module,source,breaks,continues,ref depth)) { return false; }
        int32 exit = KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Jump,-1,exits);
        if (exit < 0) { return false; } exits = exit;
        module.extra[selected] = module.count; resume = resume.next;
    }
    if (!KrtNativePatchLoop(module,exits,module.count) ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.TryLeave,plan.handler_slot,0) < 0 ||
        !KrtNativeGeneratorFree(module) || KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Const,0,0) < 0 ||
        KrtNativeGeneratorRaw(module,(int32)KrtNativeOp.Return,0,1) < 0) { return false; }
    module.exception_frame = null; module.args[enter] = module.count;
    if (!KrtNativeGeneratorFree(module) || !KrtNativeLowerSavedThrow(module,plan.handler_slot)) { return false; }
    delete breaks; delete continues; module.generator = null;
    return true;
}

bool KrtNativeLowerGeneratorFunction(KrtAstNode ast, KrtAstNode unit, KrtNativeModule module, int64 source, int32 index) {
    KrtNativeGeneratorPlan plan = unit.native_generator;
    if (plan == null || unit.native_generator_role <= 0) { return false; }
    module.lower_function_index = index; module.starts[index] = module.count;
    module.parameter_counts[index] = unit.parameter_count; module.local_counts[index] = unit.native_locals;
    module.function_frame_bytes[index] = 0; module.exception_frame = null; module.generator = null;
    if (KrtNativeInlineValue(unit)) {
        module.aggregate_return_sizes[index] = KrtNativeValueStorage(unit);
        module.aggregate_return_alignments[index] = KrtNativeValueAlignment(unit);
        module.hidden_result_slots[index] = unit.native_hidden_result_slot;
    }
    if (unit.native_generator_role == 1) { return KrtNativeLowerGeneratorFactory(ast,unit,module,source); }
    if (unit.native_generator_role == 2) { return KrtNativeLowerGeneratorGet(ast,unit,module,source); }
    if (unit.native_generator_role == 3) { return KrtNativeLowerGeneratorMove(ast,unit,module,source); }
    if (unit.native_generator_role == 4) { return KrtNativeLowerGeneratorCurrent(unit,module); }
    if (unit.native_generator_role == 5) { return KrtNativeLowerGeneratorDispose(ast,unit,module,source); }
    return false;
}

// ===== IR construction =====
// Call argument mapping and evaluation.
// The receiver/function pointer is already on the operand stack. Named actuals
// are evaluated once in source order, then loaded in formal parameter order.
bool KrtNativeLowerArguments(KrtAstNode arguments, KrtAstNode target, int32 extra, KrtAstNode ast, KrtNativeModule module, int64 source) {
    bool named = KrtNativeHasNamedArguments(arguments);
    KrtAstNode argument = arguments; int32 position = extra;
    while (argument != null) {
        int32 index = position;
        if (named) { index = argument.native_argument_index; }
        if (index < 0 || target == null || index >= target.parameter_count) { return false; }
        KrtAstNode expected = KrtAstMake(KrtAstKind.Type, argument.start, argument.length);
        if (!KrtNativeSignatureType(expected,target,index,ast,source)) { return false; }
        if (!target.parameter_refs[index] && KrtNativeInlineValue(expected)) {
            // Snapshot immediately after evaluating this actual. A later
            // actual can mutate its original through a ref or method call.
            if (!KrtNativeLowerAggregateArgument(argument,expected,ast,module,source)) { return false; }
        } else {
            if (!KrtNativeLowerExpression(argument,ast,module,source)) { return false; }
            if (!target.parameter_refs[index] && !KrtNativeConvertValue(module,argument,expected)) { return false; }
        }
        if (named && (argument.native_argument_slot < 0 ||
            KrtNativeEmit(module, (int32)KrtNativeOp.StoreLocal, argument.native_argument_slot, 0) < 0)) { return false; }
        position = position + 1; argument = argument.next;
    }
    if (named) {
        int32 index = extra;
        while (index < target.parameter_count) {
            argument = arguments;
            while (argument != null && argument.native_argument_index != index) { argument = argument.next; }
            if (argument == null || KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, argument.native_argument_slot, 0) < 0) { return false; }
            index = index + 1;
        }
    }
    return position == target.parameter_count;
}

// Compound assignment lowering.
int32 KrtNativeCompoundOperation(int32 operation) {
    if (operation == 108) { return 43; } if (operation == 109) { return 45; }
    if (operation == 110) { return 42; } if (operation == 111) { return 47; }
    if (operation == 112) { return 37; } if (operation == 117) { return 38; }
    if (operation == 118) { return 124; } if (operation == 119) { return 94; }
    if (operation == 120) { return 106; } if (operation == 121) { return 107; }
    return -1;
}

// Preserve the address across the read/update/store so field and index targets
// are evaluated once, including calls in the receiver and subscript.
bool KrtNativeLowerCompound(KrtAstNode statement, KrtAstNode module_ast, KrtNativeModule module, int64 source) {
    int32 operation = KrtNativeCompoundOperation(statement.op);
    if (operation < 0) { return false; }
    if (statement.left.native_string) {
        // Read the immutable string value before the RHS can update the same
        // storage. The saved lvalue address is evaluated only once.
        return operation == 43 && KrtNativeLowerLValue(statement.left,module_ast,module,source) &&
            KrtNativeEmit(module,(int32)KrtNativeOp.Dup,0,0) >= 0 &&
            KrtNativeEmit(module,(int32)KrtNativeOp.Load,0,8) >= 0 &&
            KrtNativeLowerExpression(statement.right,module_ast,module,source) &&
            KrtNativeEmit(module,(int32)KrtNativeOp.StringConcat,0,0) >= 0 &&
            KrtNativeEmit(module,(int32)KrtNativeOp.Store,0,KrtNativeWidth(statement.left)) >= 0;
    }
    if ((KrtNativeWideKind(statement.left) || KrtNativeWideKind(statement.right)) &&
        KrtNativeFloatKind(statement.left) == 0 && KrtNativeFloatKind(statement.right) == 0) {
        return KrtNativeLowerWideCompound(statement, module_ast, module, source);
    }
    if (KrtNativeFloatKind(statement.left) != 0 || KrtNativeFloatKind(statement.right) != 0) {
        return KrtNativeLowerFloatingCompound(statement, module_ast, module, source);
    }
    int32 arithmetic = KrtNativeBinaryOp(operation);
    if (arithmetic < 0 || !KrtNativeLowerLValue(statement.left, module_ast, module, source) ||
        KrtNativeEmit(module, (int32)KrtNativeOp.Dup, 0, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.Load, 0, KrtNativeValueWidth(statement.left)) < 0 ||
        !KrtNativeLowerExpression(statement.right, module_ast, module, source)) { return false; }
    int32 stride = KrtNativeSemanticStride(statement.left);
    if ((operation == 43 || operation == 45) && stride > 0) {
        if (KrtNativeEmit(module, (int32)KrtNativeOp.Const, stride, 0) < 0 ||
            KrtNativeEmit(module, (int32)KrtNativeOp.Mul, 0, 0) < 0) { return false; }
    }
    return KrtNativeEmit(module, arithmetic, 0, statement.left.native_unsigned ? 1 : 0) >= 0 &&
        KrtNativeEmit(module, (int32)KrtNativeOp.Cast, KrtNativeValueWidth(statement.left), 0) >= 0 &&
        KrtNativeEmit(module, (int32)KrtNativeOp.Store, 0, KrtNativeWidth(statement.left)) >= 0;
}

// Base-constructor and class-exception lowering.
bool KrtNativeLowerBaseConstructor(KrtAstNode expression, KrtAstNode module_ast, KrtNativeModule module, int64 source) {
    KrtAstNode target = expression.native_target;
    if (target == null) { return KrtNativeEmit(module, (int32)KrtNativeOp.Const, 0, 0) >= 0; }
    if (KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, 0, 0) < 0) { return false; }
    return KrtNativeLowerArguments(expression.right, target, 1, module_ast, module, source) &&
        KrtNativeEmit(module, (int32)KrtNativeOp.Call, target.value, target.parameter_count) >= 0;
}
bool KrtNativeLowerCatchMatch(KrtAstNode expected,int32 slot,KrtAstNode ast,KrtNativeModule module) {
    return KrtNativeLowerRuntimeCatchMatch(expected,slot,module);
}
bool KrtNativeLowerClassThrow(KrtAstNode value,KrtAstNode ast,KrtNativeModule module,int64 source) {
    return KrtNativeLowerRuntimeThrow(value,ast,module,source);
}

enum KrtIrOpcode { Nop = 0, Constant = 1, Add = 2, Sub = 3, Mul = 4, Div = 5, Compare = 6, Call = 7, Jump = 8, Branch = 9, Return = 10, StoreLocal = 11, LoadLocal = 12, StackAlloc = 13, AddressOffset = 14, Load = 15, Store = 16 }
enum KrtIrType { Void = 0, Bool = 1, Int32 = 2, Int64 = 3, Pointer = 4 }

class KrtIrFunction {
    public string name;
    public int32 block_count;
    public int32[] block_starts;
    public int32 instruction_count;
    public int32[] opcodes;
    public int32[] types;
    public int32[] results;
    public int32[] lefts;
    public int32[] rights;
    public int64[] immediates;
}

bool KrtIrIsTerminator(int32 opcode) {
    return opcode == (int32)KrtIrOpcode.Jump || opcode == (int32)KrtIrOpcode.Branch || opcode == (int32)KrtIrOpcode.Return;
}

bool KrtIrValidateFunction(KrtIrFunction ir_function) {
    if (ir_function == null || ir_function.block_count < 0 || ir_function.block_count > 32) { return false; }
    if (ir_function.instruction_count < 0 || ir_function.instruction_count > 4096) { return false; }
    if (ir_function.instruction_count == 0) { return true; }
    if (ir_function.opcodes == null || ir_function.types == null || ir_function.lefts == null) { return false; }
    if (ir_function.block_count == 0) { return false; }
    if (ir_function.block_count > 1 && ir_function.block_starts == null) { return false; }
    int32 block = 0;
    int32 end = ir_function.instruction_count;
    if (ir_function.block_count > 1) {
        if (ir_function.block_starts[0] != 0) { return false; }
        int32 block_index = 1;
        while (block_index < ir_function.block_count) {
            if (ir_function.block_starts[block_index] <= ir_function.block_starts[block_index - 1] ||
                ir_function.block_starts[block_index] >= ir_function.instruction_count) { return false; }
            block_index = block_index + 1;
        }
        end = ir_function.block_starts[1];
        if (end <= 0 || end >= ir_function.instruction_count) { return false; }
    }
    int32 index = 0;
    while (index < ir_function.instruction_count) {
        int32 opcode = ir_function.opcodes[index];
        if (opcode < (int32)KrtIrOpcode.Nop || opcode > (int32)KrtIrOpcode.Store) { return false; }
        if (opcode == (int32)KrtIrOpcode.Return || opcode == (int32)KrtIrOpcode.Jump || opcode == (int32)KrtIrOpcode.Branch) {
            if (index != end - 1) { return false; }
        }
        if (opcode == (int32)KrtIrOpcode.Jump) {
            if (ir_function.lefts[index] < 0 || ir_function.lefts[index] >= ir_function.block_count) { return false; }
        }
        if (opcode == (int32)KrtIrOpcode.Branch) {
            if (ir_function.rights == null || ir_function.immediates == null) { return false; }
            if (ir_function.rights[index] < 0 || ir_function.rights[index] >= ir_function.block_count ||
                ir_function.immediates[index] < 0 || ir_function.immediates[index] >= ir_function.block_count) { return false; }
        }
        if (opcode == (int32)KrtIrOpcode.Return || opcode == (int32)KrtIrOpcode.Branch || opcode == (int32)KrtIrOpcode.StoreLocal) {
            int32 value = ir_function.lefts[index];
            if (value < 0 || value >= index) { return false; }
            if (opcode == (int32)KrtIrOpcode.Return && ir_function.types[value] != ir_function.types[index]) { return false; }
            if (opcode == (int32)KrtIrOpcode.Branch && ir_function.types[value] != (int32)KrtIrType.Bool) { return false; }
        }
        index = index + 1;
        if (index == end) {
            if (!KrtIrIsTerminator(opcode)) { return false; }
            block = block + 1;
            if (block < ir_function.block_count) {
                end = ir_function.instruction_count;
                if (block + 1 < ir_function.block_count) { end = ir_function.block_starts[block + 1]; }
                if (end <= index || end > ir_function.instruction_count) { return false; }
            }
        }
    }
    return block == ir_function.block_count;
}

bool KrtIrTryEvaluateConstant(KrtAstNode node, ref int64 value) {
    if (node == null) { return false; }
    if (node.kind == KrtAstKind.Integer || node.kind == KrtAstKind.Boolean) { value = node.value; return true; }
    if (node.kind == KrtAstKind.Null) { value = 0; return true; }
    if (node.kind == KrtAstKind.Unary) {
        int64 operand = 0;
        if (!KrtIrTryEvaluateConstant(node.left, ref operand)) { return false; }
        if (node.op == 43) { value = operand; return true; }
        if (node.op == 45) { value = -operand; return true; }
        if (node.op == 126) { value = ~operand; return true; }
        if (node.op == 33) { value = operand == 0 ? 1 : 0; return true; }
        return false;
    }
    if (node.kind == KrtAstKind.Ternary) {
        int64 condition = 0;
        if (!KrtIrTryEvaluateConstant(node.left, ref condition)) { return false; }
        if (condition != 0) { return KrtIrTryEvaluateConstant(node.right, ref value); }
        return KrtIrTryEvaluateConstant(node.alternate, ref value);
    }
    if (node.kind != KrtAstKind.Binary) { return false; }
    int64 left = 0; int64 right = 0;
    if (!KrtIrTryEvaluateConstant(node.left, ref left) || !KrtIrTryEvaluateConstant(node.right, ref right)) { return false; }
    if (node.op == 43) { value = left + right; return true; }
    if (node.op == 45) { value = left - right; return true; }
    if (node.op == 42) { value = left * right; return true; }
    if (node.op == 47) { if (right == 0) { return false; } value = left / right; return true; }
    if (node.op == 37) { if (right == 0) { return false; } value = left % right; return true; }
    if (node.op == 61) { value = left == right ? 1 : 0; return true; }
    if (node.op == 101) { value = left != right ? 1 : 0; return true; }
    if (node.op == 60) { value = left < right ? 1 : 0; return true; }
    if (node.op == 62) { value = left > right ? 1 : 0; return true; }
    if (node.op == 102) { value = left <= right ? 1 : 0; return true; }
    if (node.op == 103) { value = left >= right ? 1 : 0; return true; }
    if (node.op == 104) { value = (left != 0 && right != 0) ? 1 : 0; return true; }
    if (node.op == 105) { value = (left != 0 || right != 0) ? 1 : 0; return true; }
    return false;
}

bool KrtIrTryEvaluateWithLocals(KrtAstNode node, KrtAstNode unit, KrtAstNode before, ref int64 value) {
    if (node == null) { return false; }
    if (node.kind == KrtAstKind.Identifier) {
        KrtAstNode statement = unit.left.left;
        bool found = false;
        while (statement != before) {
            if (statement.kind == KrtAstKind.Variable && statement.local_slot == node.local_slot) {
                if (!KrtIrTryEvaluateConstant(statement.left, ref value)) { return false; }
                found = true;
            }
            if (statement.kind == KrtAstKind.Assign && statement.left != null && statement.left.local_slot == node.local_slot) {
                if (!KrtIrTryEvaluateWithLocals(statement.right, unit, statement, ref value)) { return false; }
                found = true;
            }
            statement = statement.next;
        }
        return found;
    }
    if (node.kind == KrtAstKind.Integer || node.kind == KrtAstKind.Boolean) { value = node.value; return true; }
    if (node.kind == KrtAstKind.Null) { value = 0; return true; }
    if (node.kind == KrtAstKind.Ternary) {
        int64 condition = 0;
        if (!KrtIrTryEvaluateWithLocals(node.left, unit, before, ref condition)) { return false; }
        if (condition != 0) { return KrtIrTryEvaluateWithLocals(node.right, unit, before, ref value); }
        return KrtIrTryEvaluateWithLocals(node.alternate, unit, before, ref value);
    }
    if (node.kind == KrtAstKind.Unary) {
        int64 operand = 0;
        if (!KrtIrTryEvaluateWithLocals(node.left, unit, before, ref operand)) { return false; }
        if (node.op == 43) { value = operand; return true; }
        if (node.op == 45) { value = -operand; return true; }
        if (node.op == 126) { value = ~operand; return true; }
        if (node.op == 33) { value = operand == 0 ? 1 : 0; return true; }
        return false;
    }
    if (node.kind != KrtAstKind.Binary) { return false; }
    int64 left = 0; int64 right = 0;
    if (!KrtIrTryEvaluateWithLocals(node.left, unit, before, ref left) ||
        !KrtIrTryEvaluateWithLocals(node.right, unit, before, ref right)) { return false; }
    if (node.op == 43) { value = left + right; return true; }
    if (node.op == 45) { value = left - right; return true; }
    if (node.op == 42) { value = left * right; return true; }
    if (node.op == 47) { if (right == 0) { return false; } value = left / right; return true; }
    if (node.op == 37) { if (right == 0) { return false; } value = left % right; return true; }
    if (node.op == 61) { value = left == right ? 1 : 0; return true; }
    if (node.op == 101) { value = left != right ? 1 : 0; return true; }
    if (node.op == 60) { value = left < right ? 1 : 0; return true; }
    if (node.op == 62) { value = left > right ? 1 : 0; return true; }
    if (node.op == 102) { value = left <= right ? 1 : 0; return true; }
    if (node.op == 103) { value = left >= right ? 1 : 0; return true; }
    if (node.op == 104) { value = (left != 0 && right != 0) ? 1 : 0; return true; }
    if (node.op == 105) { value = (left != 0 || right != 0) ? 1 : 0; return true; }
    return false;
}

bool KrtIrContainsIdentifier(KrtAstNode node) {
    if (node == null) { return false; }
    if (node.kind == KrtAstKind.Identifier) { return true; }
    return KrtIrContainsIdentifier(node.left) || KrtIrContainsIdentifier(node.right);
}

bool KrtIrHasAssignment(KrtAstNode unit) {
    if (unit == null || unit.left == null) { return false; }
    KrtAstNode statement = unit.left.left;
    while (statement != null) {
        if (statement.kind == KrtAstKind.Assign) { return true; }
        statement = statement.next;
    }
    return false;
}

bool KrtIrLowerReturnFunction(KrtAstNode unit, KrtIrFunction output) {
    if (unit.kind != KrtAstKind.Function || unit.left == null || unit.left.left == null) { return false; }
    if (unit.left.left.kind == KrtAstKind.Variable && unit.left.left.left != null &&
        unit.left.left.left.kind == KrtAstKind.StackAlloc) { return KrtIrLowerByteBuffer(unit, output); }
    output.block_count = 1;
    int32 statement_count = unit.left.child_count;
    if (statement_count <= 0) { return false; }
    if (statement_count == 1 && unit.left.left.kind == KrtAstKind.If) {
        KrtAstNode conditional = unit.left.left;
        int64 condition = 0;
        KrtAstNode selected = null;
        if (KrtIrTryEvaluateConstant(conditional.left, ref condition) ||
            KrtIrTryEvaluateWithLocals(conditional.left, unit, conditional, ref condition)) {
            if (condition != 0) { selected = conditional.right; }
            else { selected = conditional.alternate; }
        }
        if (selected == null || selected.kind != KrtAstKind.Block || selected.child_count != 1 ||
            selected.left == null || selected.left.kind != KrtAstKind.Return) { return false; }
        int64 immediate_if = 0;
        if (!KrtIrTryEvaluateConstant(selected.left.left, ref immediate_if)) { return false; }
        output.instruction_count = 2;
        output.opcodes = new int32[2]; output.types = new int32[2]; output.results = new int32[2];
        output.lefts = new int32[2]; output.rights = new int32[2]; output.immediates = new int64[2];
        output.opcodes[0] = (int32)KrtIrOpcode.Constant; output.opcodes[1] = (int32)KrtIrOpcode.Return;
        output.types[0] = (int32)KrtIrType.Int32; output.types[1] = (int32)KrtIrType.Int32;
        output.immediates[0] = immediate_if; output.lefts[1] = 0;
        return KrtIrValidateFunction(output);
    }
    // A constant local may feed the final conditional after its declaration.
    // Fold that shape to the same single-return IR as a literal condition.
    KrtAstNode final_conditional = unit.left.left;
    while (final_conditional.next != null) { final_conditional = final_conditional.next; }
    if (final_conditional.kind == KrtAstKind.If) {
        int64 condition = 0;
        KrtAstNode selected = null;
        if (KrtIrTryEvaluateConstant(final_conditional.left, ref condition) ||
            KrtIrTryEvaluateWithLocals(final_conditional.left, unit, final_conditional, ref condition)) {
            if (condition != 0) { selected = final_conditional.right; }
            else { selected = final_conditional.alternate; }
        }
        if (selected == null || selected.kind != KrtAstKind.Block || selected.child_count != 1 ||
            selected.left == null || selected.left.kind != KrtAstKind.Return) { return false; }
        int64 immediate_if = 0;
        if (!KrtIrTryEvaluateConstant(selected.left.left, ref immediate_if) &&
            !KrtIrTryEvaluateWithLocals(selected.left.left, unit, final_conditional, ref immediate_if)) { return false; }
        output.instruction_count = 2;
        output.opcodes = new int32[2]; output.types = new int32[2]; output.results = new int32[2];
        output.lefts = new int32[2]; output.rights = new int32[2]; output.immediates = new int64[2];
        output.opcodes[0] = (int32)KrtIrOpcode.Constant; output.opcodes[1] = (int32)KrtIrOpcode.Return;
        output.types[0] = (int32)KrtIrType.Int32; output.types[1] = (int32)KrtIrType.Int32;
        output.immediates[0] = immediate_if; output.lefts[1] = 0;
        return KrtIrValidateFunction(output);
    }
    KrtAstNode final_statement = unit.left.left;
    while (final_statement.next != null) { final_statement = final_statement.next; }
    int64 folded_return = 0;
    if (final_statement.kind == KrtAstKind.Return && (final_statement.left.kind != KrtAstKind.Identifier || KrtIrHasAssignment(unit)) &&
        KrtIrContainsIdentifier(final_statement.left) &&
        KrtIrTryEvaluateWithLocals(final_statement.left, unit, final_statement, ref folded_return)) {
        output.instruction_count = 2;
        output.opcodes = new int32[2];
        output.types = new int32[2];
        output.results = new int32[2];
        output.lefts = new int32[2];
        output.rights = new int32[2];
        output.immediates = new int64[2];
        output.opcodes[0] = (int32)KrtIrOpcode.Constant;
        output.opcodes[1] = (int32)KrtIrOpcode.Return;
        output.types[0] = (int32)KrtIrType.Int32;
        output.types[1] = (int32)KrtIrType.Int32;
        output.immediates[0] = folded_return;
        output.lefts[1] = 0;
        return KrtIrValidateFunction(output);
    }
    int32 instruction_count = 0;
    KrtAstNode sizing = unit.left.left;
    while (sizing != null) {
        instruction_count = instruction_count + 2;
        sizing = sizing.next;
    }
    output.instruction_count = instruction_count;
    output.opcodes = new int32[output.instruction_count];
    output.types = new int32[output.instruction_count];
    output.results = new int32[output.instruction_count];
    output.lefts = new int32[output.instruction_count];
    output.rights = new int32[output.instruction_count];
    output.immediates = new int64[output.instruction_count];
    int32 index = 0;
    KrtAstNode statement = unit.left.left;
    while (statement != null && index < output.instruction_count) {
        if (statement.kind == KrtAstKind.Variable) {
            if (statement.local_slot < 0) { return false; }
            output.opcodes[index] = (int32)KrtIrOpcode.Constant;
            output.opcodes[index + 1] = (int32)KrtIrOpcode.StoreLocal;
            output.types[index] = (int32)KrtIrType.Int32;
            output.types[index + 1] = (int32)KrtIrType.Int32;
            int64 immediate = 0;
            if (!KrtIrTryEvaluateConstant(statement.left, ref immediate)) { return false; }
            output.immediates[index] = immediate;
            output.lefts[index + 1] = index;
            output.rights[index + 1] = statement.local_slot;
        } else if (statement.kind == KrtAstKind.Return) {
            if (statement.left.kind == KrtAstKind.Identifier) {
                if (statement.left.local_slot < 0 && statement.left.local_slot != -2) { return false; }
                output.lefts[index] = statement.left.local_slot;
                output.opcodes[index] = (int32)KrtIrOpcode.LoadLocal;
                output.opcodes[index + 1] = (int32)KrtIrOpcode.Return;
                output.types[index] = (int32)KrtIrType.Int32;
                output.types[index + 1] = (int32)KrtIrType.Int32;
                output.lefts[index + 1] = index;
            } else {
                output.opcodes[index] = (int32)KrtIrOpcode.Constant;
                output.opcodes[index + 1] = (int32)KrtIrOpcode.Return;
                output.types[index] = (int32)KrtIrType.Int32;
                output.types[index + 1] = (int32)KrtIrType.Int32;
                int64 immediate_return = 0;
                if (!KrtIrTryEvaluateWithLocals(statement.left, unit, statement, ref immediate_return) &&
                    !KrtIrTryEvaluateConstant(statement.left, ref immediate_return)) { return false; }
                output.immediates[index] = immediate_return;
                output.lefts[index + 1] = index;
            }
        } else { return false; }
        index = index + 2;
        statement = statement.next;
    }
    return KrtIrValidateFunction(output);
}

// Memory IR uses instruction indices as values. Width is explicit in immediates;
// address offsets are measured in bytes, never inferred by the machine backend.
int32 KrtIrAppendMemory(KrtIrFunction output, int32 opcode, int32 type, int32 left, int32 right, int64 immediate) {
    if (output.instruction_count >= 256) { return -1; }
    int32 index = output.instruction_count;
    output.opcodes[index] = opcode; output.types[index] = type;
    output.results[index] = index; output.lefts[index] = left;
    output.rights[index] = right; output.immediates[index] = immediate;
    output.instruction_count = index + 1;
    return index;
}

int32 KrtIrLowerByteAddress(KrtAstNode node, int32 slot, int32 allocation, KrtIrFunction output) {
    if (node == null || node.kind != KrtAstKind.Index || node.left == null ||
        node.left.kind != KrtAstKind.Identifier || node.left.local_slot != slot) { return -1; }
    int64 offset = 0;
    if (!KrtIrTryEvaluateConstant(node.right, ref offset)) { return -1; }
    int32 index = KrtIrAppendMemory(output, (int32)KrtIrOpcode.Constant, (int32)KrtIrType.Int64, -1, -1, offset);
    if (index < 0) { return -1; }
    return KrtIrAppendMemory(output, (int32)KrtIrOpcode.AddressOffset, (int32)KrtIrType.Pointer, allocation, index, 0);
}

bool KrtIrValidateMemory(KrtIrFunction output) {
    if (output == null || output.block_count != 1 || output.instruction_count <= 0 || output.instruction_count > 256) { return false; }
    int32 index = 0;
    while (index < output.instruction_count) {
        int32 opcode = output.opcodes[index];
        int32 type = output.types[index];
        int32 left = output.lefts[index];
        int32 right = output.rights[index];
        if (output.results[index] != index) { return false; }
        if (opcode == (int32)KrtIrOpcode.Constant) {
            if (type != (int32)KrtIrType.Int32 && type != (int32)KrtIrType.Int64) { return false; }
        } else if (opcode == (int32)KrtIrOpcode.StackAlloc) {
            if (type != (int32)KrtIrType.Pointer || output.immediates[index] <= 0) { return false; }
        } else {
            if (left < 0 || left >= index) { return false; }
            if (opcode == (int32)KrtIrOpcode.Return) {
                if (index != output.instruction_count - 1 || type != output.types[left]) { return false; }
            } else {
                if (output.types[left] != (int32)KrtIrType.Pointer) { return false; }
                if (opcode == (int32)KrtIrOpcode.AddressOffset || opcode == (int32)KrtIrOpcode.Store) {
                    if (right < 0 || right >= index) { return false; }
                }
                if (opcode == (int32)KrtIrOpcode.AddressOffset) {
                    if (type != (int32)KrtIrType.Pointer || output.types[right] != (int32)KrtIrType.Int64) { return false; }
                } else if (opcode == (int32)KrtIrOpcode.Load) {
                    if (type != (int32)KrtIrType.Int32 || output.immediates[index] != 1) { return false; }
                } else if (opcode == (int32)KrtIrOpcode.Store) {
                    if (type != (int32)KrtIrType.Void || output.types[right] != (int32)KrtIrType.Int32 || output.immediates[index] != 1) { return false; }
                } else { return false; }
            }
        }
        index = index + 1;
    }
    return output.opcodes[output.instruction_count - 1] == (int32)KrtIrOpcode.Return;
}

bool KrtIrLowerByteBuffer(KrtAstNode unit, KrtIrFunction output) {
    KrtAstNode declaration = unit.left.left;
    KrtAstNode allocation = declaration.left;
    // Until general type resolution is available, only byte allocations are accepted.
    if (allocation.element_width != 1 || declaration.local_slot < 0) { return false; }
    int64 count = 0;
    if (!KrtIrTryEvaluateConstant(allocation.left, ref count) || count <= 0 || count > 262144) { return false; }
    output.block_count = 1; output.instruction_count = 0;
    output.opcodes = new int32[256]; output.types = new int32[256]; output.results = new int32[256];
    output.lefts = new int32[256]; output.rights = new int32[256]; output.immediates = new int64[256];
    int32 pointer = KrtIrAppendMemory(output, (int32)KrtIrOpcode.StackAlloc, (int32)KrtIrType.Pointer, -1, -1, count);
    KrtAstNode statement = declaration.next;
    while (statement != null) {
        if (statement.kind == KrtAstKind.Assign) {
            int32 address = KrtIrLowerByteAddress(statement.left, declaration.local_slot, pointer, output);
            int64 value = 0;
            if (address < 0 || !KrtIrTryEvaluateConstant(statement.right, ref value)) { return false; }
            int32 stored = KrtIrAppendMemory(output, (int32)KrtIrOpcode.Constant, (int32)KrtIrType.Int32, -1, -1, value);
            if (stored < 0 || KrtIrAppendMemory(output, (int32)KrtIrOpcode.Store, (int32)KrtIrType.Void, address, stored, 1) < 0) { return false; }
        } else if (statement.kind == KrtAstKind.Return && statement.next == null) {
            int32 address = KrtIrLowerByteAddress(statement.left, declaration.local_slot, pointer, output);
            if (address < 0) { return false; }
            int32 loaded = KrtIrAppendMemory(output, (int32)KrtIrOpcode.Load, (int32)KrtIrType.Int32, address, -1, 1);
            if (loaded < 0 || KrtIrAppendMemory(output, (int32)KrtIrOpcode.Return, (int32)KrtIrType.Int32, loaded, -1, 0) < 0) { return false; }
        } else { return false; }
        statement = statement.next;
    }
    return KrtIrValidateMemory(output);
}
// A compact, backend-neutral stack IR used by the self-host compiler.
// Values occupy one 64-bit stack slot.  Local slots are 64-bit as well;
// Parameters come first in the frame, followed by bound local declarations.
enum KrtNativeOp {
    Nop = 0, Const = 1, LoadLocal = 2, StoreLocal = 3,
    Add = 4, Sub = 5, Mul = 6, Div = 7, Mod = 8,
    And = 9, Or = 10, Xor = 11, Shl = 12, Shr = 13,
    Neg = 14, Not = 15, Compare = 16,
    Jump = 17, Branch = 18, Call = 19, Return = 20,
    Address = 21, Load = 22, Store = 23, Allocate = 24,
    Data = 25, Syscall = 26, Drop = 27, Cast = 28, Ref = 29,
    StackAllocate = 30, BoolNot = 31, Dup = 32, PostIncrement = 33, Free = 34, StringEqual = 35, StringConcat = 36, StringLength = 37,
    FloatConvert = 38, FloatBinary = 39, FloatCompare = 40, FloatNeg = 41, FloatBool = 42, FloatPostIncrement = 43, WideConvert = 60, WideBinary = 61, WideCompare = 62, WideUnary = 63, WideLiteral = 66, WidePostIncrement = 67, WideFloat = 68, WideRef = 69,
    GlobalAddress = 44, FunctionAddress = 45, IndirectCall = 46,
    TryEnter = 50, TryLeave = 51, Throw = 52, CatchValue = 53, CatchType = 54,
