        function_node.value = count;
        if (function_node.op == 230) { output.initializer_index = count; }
        name_starts[count] = (int32)function_node.name_start; name_lengths[count] = (int32)function_node.name_length;
        if (KrtSemanticIsMain(function_node, source)) { entry = count; }
        count = count + 1; function_node = function_node.next;
    }
    if (function_node != null || (!output.library_mode && (count <= 0 || entry < 0))) { return false; }
    output.function_count = count; output.entry = entry;
    function_node = module_ast.left; int32 index = 0;
    while (function_node != null) {
        if ((!function_node.native_bound && !KrtNativeBindFunction(function_node, module_ast, source)) ||
            !KrtNativeLowerFunction(module_ast, function_node, output, source, index)) {
            output.error_start = function_node.native_bound ? function_node.start : function_node.native_offset;
            return false;
        }
        function_node = function_node.next; index = index + 1;
    }
    output.data = 0;
    return output.errors == 0 && KrtNativeRuntimeBuild(output);
}

bool KrtNativeLowerNew(KrtAstNode expression, KrtAstNode module_ast, KrtNativeModule module, int64 source) {
    if (KrtNativeInlineValue(expression)) { return KrtNativeLowerAggregateNew(expression,module_ast,module,source); }
    if (expression.left != null) {
        int32 stride = KrtNativeSemanticStride(expression);
        if (stride <= 0 || !KrtNativeLowerExpression(expression.left, module_ast, module, source)) { return false; }
        return KrtNativeEmit(module, (int32)KrtNativeOp.Allocate, stride, 0) >= 0;
    }
    if (KrtNativeEmit(module, (int32)KrtNativeOp.Const, expression.native_size > 0 ? expression.native_size : 8, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.Allocate, 0, 0) < 0) { return false; }
    if (expression.local_slot < 0 || KrtNativeEmit(module, (int32)KrtNativeOp.StoreLocal, expression.local_slot, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, expression.local_slot, 0) < 0) { return false; }
    // Both the header write and constructor call require a successful allocation.
    int32 allocated = KrtNativeEmit(module, (int32)KrtNativeOp.Branch, -1, -1);
    if (allocated < 0 || KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, expression.local_slot, 0) < 0 ||
        !KrtNativeLowerRuntimeDescriptor(expression,module) || KrtNativeEmit(module, (int32)KrtNativeOp.Store, 0, 8) < 0) { return false; }
    if (expression.native_target != null) {
        if (KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, expression.local_slot, 0) < 0) { return false; }
        if (!KrtNativeLowerArguments(expression.right, expression.native_target, 1, module_ast, module, source)) { return false; }
        if (KrtNativeEmit(module, (int32)KrtNativeOp.Call, expression.native_target.value, expression.native_target.parameter_count) < 0 || KrtNativeEmit(module, (int32)KrtNativeOp.Drop, 0, 0) < 0) { return false; }
    }
    module.args[allocated] = allocated + 1; module.extra[allocated] = module.count;
    return KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, expression.local_slot, 0) >= 0;
}

bool KrtNativeLowerArrayLiteral(KrtAstNode expression, KrtAstNode module_ast, KrtNativeModule module, int64 source) {
    int32 stride = KrtNativeSemanticStride(expression);
    if (stride <= 0 || KrtNativeEmit(module, (int32)KrtNativeOp.Const, expression.child_count, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.Allocate, stride, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.Dup, 0, 0) < 0) { return false; }
    int32 allocated = KrtNativeEmit(module, (int32)KrtNativeOp.Branch, -1, -1);
    if (allocated < 0) { return false; }
    KrtAstNode element = expression.left; int32 index = 0;
    KrtAstNode item_type = KrtNativeArrayElement(expression);
    while (element != null) {
        if (KrtNativeEmit(module, (int32)KrtNativeOp.Dup, 0, 0) < 0 ||
            KrtNativeEmit(module, (int32)KrtNativeOp.Address, 0, index * stride) < 0 ||
            !KrtNativeLowerExpression(element, module_ast, module, source)) { return false; }
        if (KrtNativeInlineValue(item_type)) {
            if (!KrtNativeConvertInlineValue(module,element,item_type) || !KrtNativeLowerAggregateCopy(item_type,module)) { return false; }
        } else if (!KrtNativeConvertValue(module, element, item_type) ||
            KrtNativeEmit(module, (int32)KrtNativeOp.Store, 0, stride) < 0) { return false; }
        element = element.next; index = index + 1;
    }
    module.args[allocated] = allocated + 1; module.extra[allocated] = module.count;
    return index == expression.child_count;
}

bool KrtNativeLowerForeach(KrtAstNode statement, KrtAstNode module_ast, KrtAstNode unit, KrtNativeModule module, int64 source, int32[] breaks, int32[] continues, ref int32 depth) {
    if (statement.native_target != null) { return KrtNativeLowerIteratorForeach(statement,module_ast,unit,module,source,breaks,continues,ref depth); }
    if (depth >= 64 || !KrtNativeLowerExpression(statement.right, module_ast, module, source) ||
        KrtNativeEmit(module, (int32)KrtNativeOp.StoreLocal, statement.native_offset, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.Const, 0, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.StoreLocal, statement.native_size, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, statement.native_offset, 0) < 0) { return false; }
    int32 nonnull = KrtNativeEmit(module, (int32)KrtNativeOp.Branch, -1, -1);
    if (nonnull < 0 || KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, statement.native_offset, 0) < 0) { return false; }
    if (statement.right.native_string) {
        if (KrtNativeEmit(module, (int32)KrtNativeOp.StringLength, 0, 0) < 0) { return false; }
    } else if (statement.right.native_fixed_length > 0) {
        if (KrtNativeEmit(module,(int32)KrtNativeOp.Drop,0,0) < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.Const,statement.right.native_fixed_length,0) < 0) { return false; }
    } else if (KrtNativeEmit(module, (int32)KrtNativeOp.Address, 0, -16) < 0 || KrtNativeEmit(module, (int32)KrtNativeOp.Load, 0, 8) < 0) { return false; }
    if (KrtNativeEmit(module, (int32)KrtNativeOp.StoreLocal, statement.local_slot, 0) < 0) { return false; }
    int32 condition = module.count;
    if (KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, statement.native_size, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, statement.local_slot, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.Compare, 60, 0) < 0) { return false; }
    int32 branch = KrtNativeEmit(module, (int32)KrtNativeOp.Branch, -1, -1);
    if (branch < 0) { return false; }
    if (KrtNativeInlineValue(statement.left) && !KrtNativeLowerAggregateFrame(statement.left,module)) { return false; }
    if (KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, statement.native_offset, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, statement.native_size, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.Address, 1, KrtNativeSemanticStride(statement.right)) < 0) { return false; }
    KrtAstNode item = KrtNativeArrayElement(statement.right);
    if (!KrtNativeInlineValue(item) && KrtNativeEmit(module,(int32)KrtNativeOp.Load,0,KrtNativeWidth(item)) < 0) { return false; }
    if (KrtNativeInlineValue(statement.left)) {
        if (!KrtNativeConvertInlineValue(module,item,statement.left) || !KrtNativeLowerAggregateCopy(statement.left,module)) { return false; }
    } else if (!KrtNativeConvertValue(module,item,statement.left) ||
        KrtNativeEmit(module,(int32)KrtNativeOp.StoreLocal,statement.left.local_slot,0) < 0) { return false; }
    breaks[depth] = -1; continues[depth] = -1; depth = depth + 1;
    if (!KrtNativeLowerBlock(statement.body, module_ast, unit, module, source, breaks, continues, ref depth)) { return false; }
    int32 continue_target = module.count;
    if (KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, statement.native_size, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.Const, 1, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.Add, 0, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.StoreLocal, statement.native_size, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.Jump, condition, 0) < 0) { return false; }
    int32 end = module.count; depth = depth - 1;
    module.args[nonnull] = nonnull + 1; module.extra[nonnull] = end;
    module.args[branch] = branch + 1; module.extra[branch] = end;
    return KrtNativePatchLoop(module, breaks[depth], end) && KrtNativePatchLoop(module, continues[depth], continue_target);
}

// Iterator protocol and foreach lowering.
// The binder prepares ordinary typed calls, locals, while and try/finally.
// Reusing the normal statement lowerer preserves struct copies, virtual and
// interface calls, exception edges and loop/closure owner cleanup.
bool KrtNativeLowerIteratorBoxKind(KrtAstNode expression, KrtAstNode ast, KrtNativeModule module, int64 source) {
    int32 pointer = KrtNativeBoxTemporary(module);
    if (pointer < 0 || !KrtNativeLowerExpression(expression.left,ast,module,source) ||
        KrtNativeEmit(module,(int32)KrtNativeOp.StoreLocal,pointer,0) < 0 ||
        KrtNativeEmit(module,(int32)KrtNativeOp.LoadLocal,pointer,0) < 0) { return false; }
    int32 present = KrtNativeEmit(module,(int32)KrtNativeOp.Branch,-1,-1);
    if (present < 0) { return false; } module.args[present] = module.count;
    if (!KrtNativeRuntimeLoad(module,pointer,0) || KrtNativeEmit(module,(int32)KrtNativeOp.Address,0,24) < 0 ||
        KrtNativeEmit(module,(int32)KrtNativeOp.Load,0,8) < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.Const,2,0) < 0 ||
        KrtNativeEmit(module,(int32)KrtNativeOp.Compare,61,0) < 0) { return false; }
    int32 done = KrtNativeEmit(module,(int32)KrtNativeOp.Jump,-1,0);
    if (done < 0) { return false; } module.extra[present] = module.count;
    if (KrtNativeEmit(module,(int32)KrtNativeOp.Const,0,0) < 0) { return false; }
    module.args[done] = module.count; return true;
}

bool KrtNativeLowerIteratorBoxCleanup(KrtAstNode expression, KrtAstNode ast, KrtNativeModule module, int64 source) {
    // The kind was saved before Dispose: a class can free itself there, so
    // cleanup must never inspect its former object header afterward.
    if (!KrtNativeLowerExpression(expression.right,ast,module,source)) { return false; }
    int32 owned = KrtNativeEmit(module,(int32)KrtNativeOp.Branch,-1,-1);
    if (owned < 0) { return false; } module.args[owned] = module.count;
    if (!KrtNativeLowerExpression(expression.left,ast,module,source) ||
        KrtNativeEmit(module,(int32)KrtNativeOp.Free,0,0) < 0) { return false; }
    module.extra[owned] = module.count;
    return KrtNativeEmit(module,(int32)KrtNativeOp.Const,0,0) >= 0;
}

bool KrtNativeLowerIteratorForeach(KrtAstNode statement, KrtAstNode module_ast, KrtAstNode unit, KrtNativeModule module, int64 source, int32[] breaks, int32[] continues, ref int32 depth) {
    if (statement.native_target == null || statement.native_target.left == null) { return false; }
    KrtAstNode receiver = statement.native_target.left;
    if (receiver.native_ref) {
        return receiver.next != null && KrtNativeLowerLValue(receiver.left,module_ast,module,source) &&
            KrtNativeEmit(module,(int32)KrtNativeOp.StoreLocal,receiver.local_slot,0) >= 0 &&
            KrtNativeLowerBlock(receiver.next,module_ast,unit,module,source,breaks,continues,ref depth);
    }
    return KrtNativeLowerBlock(statement.native_target,module_ast,unit,module,source,breaks,continues,ref depth);
}

// Null-coalescing and conditional-access lowering.
bool KrtNativeLowerNullCoalescing(KrtAstNode expression, KrtAstNode ast, KrtNativeModule module, int64 source) {
    if (!KrtNativeLowerExpression(expression.left,ast,module,source) ||
        KrtNativeEmit(module,(int32)KrtNativeOp.Dup,0,0) < 0) { return false; }
    int32 branch = KrtNativeEmit(module,(int32)KrtNativeOp.Branch,-1,-1);
    if (branch < 0 || !KrtNativeConvertValue(module,expression.left,expression)) { return false; }
    int32 jump = KrtNativeEmit(module,(int32)KrtNativeOp.Jump,-1,0);
    int32 fallback = module.count;
    if (jump < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.Drop,0,0) < 0 ||
        !KrtNativeLowerExpression(expression.right,ast,module,source) ||
        !KrtNativeConvertValue(module,expression.right,expression)) { return false; }
    module.args[branch] = branch + 1; module.extra[branch] = fallback; module.args[jump] = module.count;
    return true;
}

bool KrtNativeLowerNullConditional(KrtAstNode expression, KrtAstNode ast, KrtNativeModule module, int64 source) {
    if (!KrtNativeLowerExpression(expression.left,ast,module,source) ||
        KrtNativeEmit(module,(int32)KrtNativeOp.StoreLocal,expression.local_slot,0) < 0 ||
        KrtNativeEmit(module,(int32)KrtNativeOp.LoadLocal,expression.local_slot,0) < 0) { return false; }
    int32 branch = KrtNativeEmit(module,(int32)KrtNativeOp.Branch,-1,-1);
    if (branch < 0) { return false; }
    if (KrtNativeInlineValue(expression)) {
        // Both branches produce the same independent value storage. A field
        // result cannot retain a writable alias into the original receiver.
        if (!KrtNativeLowerAggregateFrame(expression,module) ||
            !KrtNativeLowerExpression(expression.right,ast,module,source) ||
            !KrtNativeConvertInlineValue(module,expression.right,expression) ||
            !KrtNativeLowerAggregateCopy(expression,module) || !KrtNativeLowerAggregateFrame(expression,module)) { return false; }
    } else if (!KrtNativeLowerExpression(expression.right,ast,module,source) ||
               !KrtNativeConvertValue(module,expression.right,expression)) { return false; }
    int32 jump = KrtNativeEmit(module,(int32)KrtNativeOp.Jump,-1,0);
    int32 absent = module.count;
    KrtAstNode zero = KrtAstMake(KrtAstKind.DefaultValue,expression.start,0);
    KrtNativeCopyType(zero,expression); zero.native_frame_offset = expression.native_frame_offset;
    if (jump < 0 || !KrtNativeLowerExpression(zero,ast,module,source)) { return false; }
    module.args[branch] = branch + 1; module.extra[branch] = absent; module.args[jump] = module.count;
    return true;
}

// Built-in print lowering.
KrtAstNode KrtNativePrintHelper(KrtAstNode ast, int64 source, string name) {
    KrtAstNode unit = ast.left;
    while (unit != null) { if (unit.op == 241 && KrtNativeSpanWord(source,unit.name_start,unit.name_length,name)) { return unit; } unit = unit.next; }
    return null;
}

bool KrtNativePrintCall(KrtAstNode ast, KrtNativeModule module, int64 source, string name, int32 count) {
    KrtAstNode helper = KrtNativePrintHelper(ast,source,name);
    return helper != null && KrtNativeEmit(module,(int32)KrtNativeOp.Call,helper.value,count) >= 0;
}

bool KrtNativeLowerPrint(KrtAstNode statement, KrtAstNode ast, KrtNativeModule module, int64 source) {
    KrtAstNode value = statement.left;
    while (value != null) {
        if (!KrtNativeLowerExpression(value,ast,module,source)) { return false; }
        if (value.native_string || value.kind == KrtAstKind.Null) { }
        else if (KrtNativeFloatKind(value) != 0) {
            int32 format = KrtNativeFloatKind(value);
            if (format != 8 && KrtNativeEmit(module,(int32)KrtNativeOp.FloatConvert,format,8) < 0) { return false; }
            if (!KrtNativePrintCall(ast,module,source,"__KrtPrintFloatBits",1)) { return false; }
        } else if (KrtNativeWideKind(value)) {
            if (!KrtNativePrintCall(ast,module,source,value.native_unsigned ? "__KrtPrintWideUnsigned" : "__KrtPrintWideSigned",1)) { return false; }
        } else if (value.native_boolean) {
            if (!KrtNativePrintCall(ast,module,source,"__KrtPrintBoolean",1)) { return false; }
        } else if (value.native_character) {
            if (!KrtNativePrintCall(ast,module,source,"__KrtPrintCharacter",1)) { return false; }
        } else {
            bool address = value.native_type != null || KrtNativeSemanticStride(value) > 0;
            if (!KrtNativePrintCall(ast,module,source,value.native_unsigned || address ? "__KrtPrintUnsigned" : "__KrtPrintSigned",1)) { return false; }
        }
        if (!KrtNativePrintCall(ast,module,source,"__KrtPrintWrite",1) || KrtNativeEmit(module,(int32)KrtNativeOp.Drop,0,0) < 0) { return false; }
        value = value.next;
    }
    return statement.value == 0 || (KrtNativePrintCall(ast,module,source,"__KrtPrintLine",0) && KrtNativeEmit(module,(int32)KrtNativeOp.Drop,0,0) >= 0);
}

// Switch control-flow lowering.
// A switch is a break target, while continue searches its enclosing loop.
// The selector travels through one reserved local, including string, IEEE and
// wide integer values. Labels use the same equality machinery as expressions.
bool KrtNativeLowerSwitch(KrtAstNode statement, KrtAstNode module_ast, KrtAstNode unit, KrtNativeModule module, int64 source, int32[] breaks, int32[] continues, ref int32 depth) {
    if (depth >= 64 || statement.native_target == null || statement.local_slot < 0) { return false; }
    if (KrtNativeInlineValue(statement.native_target)) {
        // Keep the selector's value independent of the source and of temporary
        // storage reused while evaluating later labels.
        if (!KrtNativeLowerAggregateFrame(statement.native_target,module) ||
            !KrtNativeLowerExpression(statement.left,module_ast,module,source) ||
            !KrtNativeConvertInlineValue(module,statement.left,statement.native_target) ||
            !KrtNativeLowerAggregateCopy(statement.native_target,module)) { return false; }
    } else if (!KrtNativeLowerExpression(statement.left, module_ast, module, source) ||
        KrtNativeEmit(module, (int32)KrtNativeOp.StoreLocal, statement.local_slot, 0) < 0) { return false; }
    KrtAstNode default_clause = null; KrtAstNode clause = statement.right;
    while (clause != null) {
        if (clause.kind == KrtAstKind.Default) { default_clause = clause; }
        else {
            if (!KrtNativeLowerExpression(clause.native_target, module_ast, module, source)) { return false; }
            int32 branch = KrtNativeEmit(module, (int32)KrtNativeOp.Branch, -1, -1);
            if (branch < 0) { return false; }
            clause.native_offset = branch; module.extra[branch] = module.count;
        }
        clause = clause.next;
    }
    int32 unmatched = KrtNativeEmit(module, (int32)KrtNativeOp.Jump, -1, 0);
    if (unmatched < 0) { return false; }
    breaks[depth] = -1; continues[depth] = -2; depth = depth + 1;
    clause = statement.right;
    while (clause != null) {
        if (clause == default_clause) { module.args[unmatched] = module.count; }
        else { module.args[clause.native_offset] = module.count; }
        if (!KrtNativeLowerBlock(clause.right, module_ast, unit, module, source, breaks, continues, ref depth)) { return false; }
        clause = clause.next;
    }
    if (default_clause == null) { module.args[unmatched] = module.count; }
    depth = depth - 1;
    return KrtNativePatchLoop(module, breaks[depth], module.count);
}

// Global storage, initialization, and indirect-call lowering.
bool KrtNativeLowerGlobalAddress(KrtAstNode node, KrtNativeModule module) {
    return node.native_global > 0 && KrtNativeEmit(module, 44, node.native_global - 1, 0) >= 0;
}

bool KrtNativeLowerGlobalValue(KrtAstNode node, KrtNativeModule module) {
    if (KrtNativeInlineValue(node)) { return KrtNativeLowerGlobalAddress(node,module); }
    return KrtNativeLowerGlobalAddress(node, module) &&
        KrtNativeEmit(module, (int32)KrtNativeOp.Load, 0, KrtNativeValueWidth(node)) >= 0 && KrtNativeNormalizeWide(module,node);
}

bool KrtNativeLowerGlobalInitializerBody(KrtAstNode module_ast,KrtAstNode unit,KrtNativeModule module,int64 source,int32[] breaks,int32[] continues,ref int32 depth){
    KrtNativeGlobalEntry entry=module_ast.native_globals.first;
    while(entry!=null){
        if(entry.assignment!=null){
            if(KrtNativeEmit(module,44,entry.guard_slot,0)<0||KrtNativeEmit(module,75,0,0)<0){return false;}
            int32 branch=KrtNativeEmit(module,(int32)KrtNativeOp.Branch,-1,-1);if(branch<0){return false;}module.args[branch]=module.count;
            int32 handler=KrtNativeEmit(module,(int32)KrtNativeOp.TryEnter,-1,entry.exception_slot);if(handler<0){return false;}
            if(!KrtNativeLowerStatement(entry.assignment,module_ast,unit,module,source,breaks,continues,ref depth)||
               KrtNativeEmit(module,(int32)KrtNativeOp.TryLeave,entry.exception_slot,0)<0||
               KrtNativeEmit(module,44,entry.guard_slot,0)<0||KrtNativeEmit(module,76,0,1)<0){return false;}
            int32 done=KrtNativeEmit(module,(int32)KrtNativeOp.Jump,-1,0);if(done<0){return false;}
            module.args[handler]=module.count;
            if(KrtNativeEmit(module,44,entry.guard_slot,0)<0||KrtNativeEmit(module,76,0,0)<0||!KrtNativeLowerSavedThrow(module,entry.exception_slot)){return false;}
            module.args[done]=module.count;module.extra[branch]=module.count;
        }
        entry=entry.next;
    }
    return true;
}

bool KrtNativeLowerGlobalInitializers(KrtAstNode ast,KrtAstNode unit,KrtNativeModule module,int64 source,int32 function_index){
    int32 guard=module.initializer_guard_slot;int32 record=module.initializer_exception_slot;
    if(guard<0||guard>=module.global_count||KrtNativeEmit(module,44,guard,0)<0||KrtNativeEmit(module,75,0,0)<0){return false;}
    int32 branch=KrtNativeEmit(module,(int32)KrtNativeOp.Branch,-1,-1);if(branch<0){return false;}module.args[branch]=module.count;
    int32 handler=KrtNativeEmit(module,(int32)KrtNativeOp.TryEnter,-1,record);if(handler<0){return false;}
    int32[] breaks=new int32[64];int32[] continues=new int32[64];int32 depth=0;
    bool valid=KrtNativeLowerGlobalInitializerBody(ast,unit,module,source,breaks,continues,ref depth);delete breaks;delete continues;
    if(!valid||KrtNativeEmit(module,(int32)KrtNativeOp.TryLeave,record,0)<0||KrtNativeEmit(module,44,guard,0)<0||KrtNativeEmit(module,76,0,1)<0){return false;}
    int32 done=KrtNativeEmit(module,(int32)KrtNativeOp.Jump,-1,0);if(done<0){return false;}module.args[handler]=module.count;
    if(KrtNativeEmit(module,44,guard,0)<0||KrtNativeEmit(module,76,0,0)<0||!KrtNativeLowerSavedThrow(module,record)){return false;}
    module.args[done]=module.count;module.extra[branch]=module.count;
    return KrtNativeEmit(module,(int32)KrtNativeOp.Const,0,0)>=0&&KrtNativeEmit(module,(int32)KrtNativeOp.Return,0,1)>=0;
}

bool KrtNativeLowerFunctionAddress(KrtAstNode node, KrtNativeModule module) {
    return node.native_target != null && KrtNativeEmit(module, 45, node.native_target.value, 0) >= 0;
}

bool KrtNativeLowerIndirectCall(KrtAstNode node, KrtAstNode ast, KrtNativeModule module, int64 source) {
    if (node.native_closure_record_slot >= 0 && !node.native_closure_lowering) {
        return KrtNativeLowerTemporaryClosureCall(node,ast,module,source);
    }
    KrtAstNode signature = node.left.native_function_pointer;
    if (signature == null || !KrtNativeLowerExpression(node.left, ast, module, source)) { return false; }
    if (KrtNativeInlineValue(node)) {
        return KrtNativeLowerAggregateFrame(node,module) && KrtNativeLowerArguments(node.right,signature,0,ast,module,source) &&
            KrtNativeEmit(module,(int32)KrtNativeOp.IndirectCall,0,signature.parameter_count + 1) >= 0;
    }
    return KrtNativeLowerArguments(node.right, signature, 0, ast, module, source) &&
        KrtNativeEmit(module,46,0,signature.parameter_count) >= 0 && KrtNativeNormalizeWide(module,node);
}


// Dispatch and trap lowering.
// A failed receiver/type guard terminates deterministically, like the existing
// allocation guards. Its operands never read through a null object pointer.
bool KrtNativeLowerDispatchTrap(KrtNativeModule module) {
    return KrtNativeEmit(module, (int32)KrtNativeOp.Const, 60, 0) >= 0 &&
        KrtNativeEmit(module, (int32)KrtNativeOp.Const, 126, 0) >= 0 &&
        KrtNativeEmit(module, (int32)KrtNativeOp.Syscall, 0, 2) >= 0 &&
