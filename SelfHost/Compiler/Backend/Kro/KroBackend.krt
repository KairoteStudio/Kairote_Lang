// A unit containing only constant scalar storage needs no runtime assignment.
// Probe the complete unit first: a dynamic initializer must retain its original
// order, including reads of later globals and exception retry behavior.
bool KrtKroLibraryStaticData(KrtNativeModule module,KrtAstNode ast) {
    if(ast.declarations!=null||module.external_count!=0){return false;}
    KrtAstNode declaration=module.function_ast;
    while(declaration!=null){if(declaration.op!=230){return false;}declaration=declaration.next;}
    KrtNativeGlobalEntry entry=ast.native_globals.first;
    while(entry!=null){
        declaration=entry.declaration;
        if(!entry.module_guard&&!declaration.native_readonly&&!entry.imported){
            if(declaration.native_type!=null||declaration.native_array||declaration.native_stride!=0||
                declaration.native_string||declaration.native_float!=0||declaration.native_function_pointer!=null||
                entry.storage_size<=0||entry.storage_size>16){return false;}
            int64 low=0;int64 high=0;
            if(!KrtKroLibraryValue(declaration.left,ref low,ref high)||!KrtKroLibraryNormalize(declaration,ref low,ref high)){return false;}
        }
        entry=entry.next;
    }
    entry=ast.native_globals.first;
    while(entry!=null){
        if(!entry.module_guard&&!entry.declaration.native_readonly&&!entry.imported){
            int64 low=0;int64 high=0;
            if(!KrtKroLibraryValue(entry.declaration.left,ref low,ref high)||!KrtKroLibraryNormalize(entry.declaration,ref low,ref high)){return false;}
            entry.static_data=true;entry.static_low=low;entry.static_high=high;
        }
        entry=entry.next;
    }
    // FinishGlobals appends this local guard after allocating every field. No
    // code in this data object references it, so retain only the field guards.
    entry=ast.native_globals.first;
    if(entry!=null&&entry.module_guard){
        if(module.initializer_guard_slot!=module.global_count-2){return false;}
        ast.native_globals.first=entry.next;module.global_count=module.global_count-2;
    }
    module.function_count=0;module.function_ast=null;module.initializer_index=-1;module.initializer_guard_slot=-1;
    return true;
}

bool KrtKroEmitLibrarySections(KrtNativeModule module,KrtAstNode ast,int64 source,KrtKroObject output){
    output.magic=5198411;output.version=2;output.architecture=34404;
    return KrtKroLibraryFunctions(module,ast,source,output)&&KrtKroObjectIsValid(output);
