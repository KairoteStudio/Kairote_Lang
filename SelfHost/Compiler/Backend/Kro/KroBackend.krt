    output.total_reloc_count=output.text_reloc_count+output.rodata_reloc_count+output.data_reloc_count;output.relocation_count=output.total_reloc_count;
    delete slot_symbols;delete initializer_symbols;return true;
}

// ===== KRO backend =====
// Native object ABI record emission.
// ABI2 metadata is a normal local read-only KRO object symbol.
bool KrtKroAbiRecord(KrtAbiBytes manifest,int32 symbol,bool defined,KrtAbiSignature signature){
    if(!signature.supported||!signature.contract.ok||!signature.nominal.ok){return false;}
    if(signature.uses_named||signature.weak){KrtKroLibraryWord(manifest.data,4,3);}
    KrtAbiWord(manifest,symbol);KrtAbiWord(manifest,defined?(signature.weak?5:1):0);
    KrtAbiWord(manifest,signature.nominal.count);KrtAbiWord(manifest,signature.contract.count);
    KrtAbiAppend(manifest,signature.nominal);KrtAbiAppend(manifest,signature.contract);return manifest.ok;
}
bool KrtKroAbiTypes(KrtAbiBytes manifest,KrtAstNode ast,int64 source,ref int32 count){
    KrtAstNode type=ast.declarations;
    while(type!=null){
        if(type.native_generic_parameters==null){
            KrtAbiSignature signature=KrtModuleTypeSignature(type,ast,source);
            if(!signature.supported||!signature.contract.ok||!signature.nominal.ok){return false;}
            KrtKroLibraryWord(manifest.data,4,3);
            // Type contracts have no strong symbol and may be repeated by
            // several modules. Exact layouts must agree independently of the
            // functions through which either module happens to use them.
            KrtAbiWord(manifest,-1);KrtAbiWord(manifest,2);
            KrtAbiWord(manifest,signature.nominal.count);KrtAbiWord(manifest,signature.contract.count);
            KrtAbiAppend(manifest,signature.nominal);KrtAbiAppend(manifest,signature.contract);count=count+1;
        }
        type=type.next;
    }
    if(ast.native_globals!=null){
        KrtNativeGlobalEntry entry=ast.native_globals.first;
        while(entry!=null){
            if(!entry.module_guard&&!entry.declaration.native_readonly){
                KrtAbiSignature signature=KrtModuleGlobalSignature(entry,ast,source);
                if(!signature.supported||!signature.nominal.ok||!signature.contract.ok){return false;}
                KrtAbiWord(manifest,-1);KrtAbiWord(manifest,2);KrtAbiWord(manifest,signature.nominal.count);KrtAbiWord(manifest,signature.contract.count);
                KrtAbiAppend(manifest,signature.nominal);KrtAbiAppend(manifest,signature.contract);count=count+1;
            }
            entry=entry.next;
        }
    }
    return manifest.ok;
}
bool KrtKroAbiFinishNamed(KrtKroObject output,KrtAbiBytes manifest,int32 count,ref int32 name,string marker){
