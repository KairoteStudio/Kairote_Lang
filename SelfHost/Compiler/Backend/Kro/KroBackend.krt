// ===== Wide value encoding =====
// Wide values are 16-byte values. Expression snapshots live in this function's
// frame; persistent locals, arguments, fields and results copy their bytes.
int32 KrtKroWideScratchBytes(int32 operation, int64 argument, int64 extra) {
    if (operation == 22) { return extra == 16 || extra == -16 ? 16 : 0; }
    if (operation == 60) { return argument == 2 ? 0 : 16; }
    if (operation == 61 || operation == 66 || operation == 69) { return 16; }
    if (operation == 63) { return argument == 33 ? 0 : 16; }
    if (operation == 67) { return 48; }
    if (operation == 68) { return argument == 3 || argument == 4 ? 16 : 0; }
    return 0;
}

bool KrtKroNativeWideBox(KrtKroObject output, ref int32 pc) {
    if (output.native_wide_cursor < 0 || output.native_wide_cursor > output.native_wide_limit - 16 ||
        output.native_wide_base < output.native_wide_cursor + 16) { return false; }
