// Exception frame and throw emission.
// Exception records occupy six frame slots. r15 links active records across calls.
// Layout at the lowest address: previous, saved rsp, saved rbp, value, type, handler.
bool KrtKroNativeTryEnter(KrtKroObject output, ref int32 pc, int32 slot) {
    return KrtKroNativeCode(output, ref pc, 9276744, 3) && KrtKroNativeU32(output, ref pc, -8 * (slot + 6)) &&
        KrtKroNativeCode(output, ref pc, 2359042063829324, 7) &&
        KrtKroNativeCode(output, ref pc, 1562715536066888, 7);
}

bool KrtKroNativeTryFinish(KrtKroObject output, ref int32 pc) {
    return KrtKroNativeCode(output, ref pc, 58416267480107336, 7);
}

bool KrtKroNativeTryLeave(KrtKroObject output, ref int32 pc, int32 slot) {
    return KrtKroNativeCode(output, ref pc, 12421964, 3) && KrtKroNativeU32(output, ref pc, -8 * (slot + 6));
}

bool KrtKroNativeThrow(KrtKroObject output, ref int32 pc) {
    return KrtKroNativeCode(output, ref pc, 3507440034076762, 7) &&
        KrtKroNativeCode(output, ref pc, 19913255090666680, 7) &&
        KrtKroNativeCode(output, ref pc, 38642357884682240, 7) &&
        KrtKroNativeCode(output, ref pc, 20583233637390407, 7) &&
        KrtKroNativeCode(output, ref pc, 2365647737614219, 7) &&
        KrtKroNativeCode(output, ref pc, 17886087037291337, 7) &&
        KrtKroNativeCode(output, ref pc, 57599, 2);
}

// Integer storage normalization.
// Nonstandard even integer widths use rounded byte storage plus exact normalization.
bool KrtKroNativeIntegerNormalize(KrtKroObject output, ref int32 pc, int32 code) {
    int32 bits = (code < 0 ? -code : code) - 1000;
    if (bits < 2 || bits > 64 || bits % 2 != 0) { return false; }
    if (bits == 64) { return true; }
    return KrtKroNativeCode(output, ref pc, 14729544, 3) && KrtKroNativeByte(output, ref pc, 64 - bits) &&
        KrtKroNativeByte(output, ref pc, 72) && KrtKroNativeByte(output, ref pc, 193) &&
        KrtKroNativeByte(output, ref pc, code < 0 ? 232 : 248) && KrtKroNativeByte(output, ref pc, 64 - bits);
}

int32 KrtKroNativeIntegerStorage(int32 code) {
    int32 bits = (code < 0 ? -code : code) - 1000; int32 bytes = 1;
    while (bytes * 8 < bits && bytes < 8) { bytes = bytes * 2; }
    return bytes;
}

