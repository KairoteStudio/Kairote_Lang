        bool local=!KrtKroLibraryPublicDefinition(function_node,signature);
        KrtLinkName link_name=KrtNativeFunctionLinkNameLegacy(function_node,ast,source,true);
        if(!local&&signature.uses_struct){link_name=KrtAbiLinkName(signature);}
        if(index==module.entry){link_name.length=0;KrtLinkText(link_name,"main");}
        else if(!local&&signature.uses_struct){if(!KrtKroAbiRecord(manifest,symbol_index,true,signature)){return false;}abi_records=abi_records+1;}
        if(local){KrtLinkText(link_name,"$local");KrtLinkNumber(link_name,index);}
        if (!link_name.valid) { return false; }
        KrtKroLibrarySymbol(output, symbol_index, name, offsets[index], sizes[index], 1);
        KrtKroLibraryWord(symbols, symbol_index * 32 + 16, local ? 0 : (signature.weak?2:1));
        byte[] bytes = link_name.bytes; int32 character = 0;
        while (character < link_name.length) { string_bytes[name] = bytes[character]; name = name + 1; character = character + 1; }
        string_bytes[name] = 0; name = name + 1;
        index = index + 1; symbol_index = symbol_index + 1; function_node = function_node.next;
    }
    int32[] external_symbols = new int32[module.external_count + 1]; index = 0;
    KrtAstNode external_node = module.external_head;
    while (index < module.external_count) {
        if (used[index]) {
            KrtAbiSignature signature=KrtAbiFunction(external_node,ast,source,true);
            KrtLinkName link_name=KrtNativeFunctionLinkNameLegacy(external_node,ast,source,true);
            if(signature.uses_struct){
                link_name=KrtAbiLinkName(signature);
                if(!KrtKroAbiRecord(manifest,symbol_index,false,signature)){return false;}abi_records=abi_records+1;
            }
            if (!link_name.valid) { return false; }
            external_symbols[index] = symbol_index;
            KrtKroLibrarySymbol(output, symbol_index, name, 0, 0, 0);
            KrtKroLibraryWord(symbols, symbol_index * 32 + 20, 1);
            byte[] bytes = link_name.bytes; int32 character = 0;
            while (character < link_name.length) { string_bytes[name] = bytes[character]; name = name + 1; character = character + 1; }
            string_bytes[name] = 0; name = name + 1; symbol_index = symbol_index + 1;
        }
        index = index + 1; external_node = external_node.native_external_next;
    }
    if(!KrtKroAbiFinish(output,manifest,abi_records,ref name)){return false;}
    KrtAbiBytes types_manifest=KrtAbiNew();KrtAbiWord(types_manifest,0x32494241);KrtAbiWord(types_manifest,3);KrtAbiWord(types_manifest,0);KrtAbiWord(types_manifest,0);
    int32 type_records=0;
    if(!KrtKroAbiTypes(types_manifest,ast,source,ref type_records)||!KrtKroAbiFinishNamed(output,types_manifest,type_records,ref name,"_KRT_ABI3_TYPES")){return false;}
    output.strtab_size = name;
    output.text_reloc_count = module.external_reloc_count; output.total_reloc_count = module.external_reloc_count; output.relocation_count = module.external_reloc_count;
    output.text_relocation_bytes = new byte[module.external_reloc_count * 16 + 1];
    byte[] relocations = output.text_relocation_bytes;
    int32[] relocation_offsets = module.external_reloc_offsets; int32[] relocation_targets = module.external_reloc_targets;
    index = 0;
    while (index < module.external_reloc_count) {
        KrtKroLibraryWord(relocations, index * 16, relocation_offsets[index]);
        KrtKroLibraryWord(relocations, index * 16 + 4, external_symbols[relocation_targets[index]]);
        // ArkLink's PC32 is relative to the end of the four-byte field.
        KrtKroLibraryWord(relocations, index * 16 + 8, 3);
        KrtKroLibraryWord(relocations, index * 16 + 12, 0);
        index = index + 1;
    }
    return KrtKroGlobalSymbols(module,ast,source,output)&&KrtKroRuntimeDescriptors(module,ast,source,output);
}

// ===== Module metadata =====
// A relocatable module carries its compiler-generated declaration interface.
// Consumers read these bytes through the native lexer and parser. Ordinary
// exported bodies become extern declarations; binary generic templates retain
// their source bodies and private implementation dependencies.
class KrtModuleMetadataEdit {
    public int64 start;
    public int64 body;
    public int64 end;
    public KrtAbiBytes insertion;
    public KrtModuleMetadataEdit next;
}

int64 KrtModuleMetadataClose(KrtAstNode type,int64 source){
    KrtLexer lexer=new KrtLexer();KrtToken token=new KrtToken();
    unsafe(using krt.mem;){if(!KrtLexerInit(lexer,(byte*)(source+type.start),type.length)){return -1;}}
    int32 depth=0;bool entered=false;
    while(true){
        KrtLexerNext(lexer,token);
        if(token.kind==KrtTokenKind.Eof){break;}
        if(token.category==KrtTokenCategory.Punctuation&&token.length==1){
            unsafe(using krt.mem;){byte value=((byte*)lexer.source)[token.start];
                if(value==123){depth=depth+1;entered=true;}else if(value==125){depth=depth-1;if(entered&&depth==0){return type.start+token.start;}}}
        }
    }
    return -1;
}

KrtModuleMetadataEdit KrtModuleMetadataEdits(KrtAstNode ast,int64 source) {
    KrtModuleMetadataEdit list = null; KrtAstNode declaration = ast.left;
    while (declaration != null) {
        if (!declaration.native_closure_function && (declaration.native_generator==null||declaration.native_generator_role==1) && declaration.native_generic_origin == null &&
            (declaration.native_owner==null||declaration.native_owner.native_generic_origin==null) && !KrtNativeIsTemplate(declaration) &&
            declaration.op != 221 && declaration.op != 223 && declaration.op != 230 && declaration.op != 241 &&
            KrtNativeAccessExported(declaration) && declaration.left != null && declaration.left.length > 0 &&
            !(declaration.op==220&&declaration.native_owner!=null&&declaration.start==declaration.native_owner.start)) {
            KrtModuleMetadataEdit edit = new KrtModuleMetadataEdit(); edit.start = declaration.start;
            // Parser spans can include trivia up to the next token, including
            // the driver separator between source files. Export only through
            // the matching lexical brace; strings and comments are tokens.
            int64 close=KrtModuleMetadataClose(declaration.left,source);
            if(close<0){edit.start=-1;edit.next=list;return edit;}
            edit.body = declaration.left.start; edit.end = close+1;
            KrtModuleMetadataEdit item = list; KrtModuleMetadataEdit previous = null;
            while (item != null && item.start < edit.start) { previous = item; item = item.next; }
            if (item == null || item.start != edit.start) {
                edit.next = item; if (previous == null) { list = edit; } else { previous.next = edit; }
            } else { delete edit; }
        }
        declaration = declaration.next;
    }
    KrtAstNode type=ast.declarations;
    while(type!=null){
        if((type.value==1||type.value==2)&&type.native_generic_parameters==null&&type.native_generic_origin==null&&type.native_generator==null){
            KrtAstNode method=KrtNativeTypeMemberFirst(type);
            while(method!=null&&method.native_owner==type){
                if(method.op==220&&method.start==type.start&&KrtNativeAccessExported(method)){
                    int64 close=KrtModuleMetadataClose(type,source);
                    if(close<0){KrtModuleMetadataEdit invalid=new KrtModuleMetadataEdit();invalid.start=-1;invalid.next=list;return invalid;}
                    KrtModuleMetadataEdit edit=new KrtModuleMetadataEdit();edit.start=close;edit.body=close;edit.end=close;edit.insertion=KrtAbiNew();
                    KrtAbiText(edit.insertion,"public extern ");int64 character=0;
                    while(character<type.name_length){KrtAbiByte(edit.insertion,(int32)KrtNameAt(source,type.name_start,type.name_length,character));character=character+1;}
                    KrtAbiText(edit.insertion,"();\n");KrtModuleMetadataEdit item=list;KrtModuleMetadataEdit previous=null;
                    while(item!=null&&item.start<close){previous=item;item=item.next;}
                    edit.next=item;if(previous==null){list=edit;}else{previous.next=edit;}
                }
                method=KrtNativeTypeMemberNext(method);
            }
        }
        type=type.next;
    }
    return list;
}

KrtAbiBytes KrtModuleMetadataFile(int64 source, int64 start, int64 length, KrtModuleMetadataEdit edits) {
    KrtAbiBytes bytes = KrtAbiNew(); int64 cursor = start; int64 end = start + length;
    while (edits != null && edits.end <= start) { edits = edits.next; }
    unsafe(using krt.mem;) {
        byte* input = (byte*)source;
        while (edits != null && edits.start < end) {
            if (edits.start < cursor || edits.body < edits.start || edits.end < edits.body || edits.end > end) { bytes.ok = false; return bytes; }
            while (cursor < edits.start) { KrtAbiByte(bytes,(int32)input[cursor]); cursor = cursor + 1; }
            if(edits.insertion!=null){KrtAbiAppend(bytes,edits.insertion);edits=edits.next;continue;}
            KrtAbiText(bytes,"extern ");
            while (cursor < edits.body) { KrtAbiByte(bytes,(int32)input[cursor]); cursor = cursor + 1; }
            KrtAbiText(bytes,";\n"); cursor = edits.end; edits = edits.next;
        }
        while (cursor < end) { KrtAbiByte(bytes,(int32)input[cursor]); cursor = cursor + 1; }
    }
    return bytes;
}

KrtAbiBytes KrtModuleMetadataBuild(KrtAstNode ast, int64 source) {
    KrtAbiBytes bytes = KrtAbiNew(); KrtAbiWord(bytes,0x33444f4d); KrtAbiWord(bytes,3); KrtAbiWord(bytes,0); KrtAbiWord(bytes,0);
    KrtModuleMetadataEdit edits = KrtModuleMetadataEdits(ast,source); KrtSourceFile file = KrtDriverActiveBundle != null ? KrtDriverActiveBundle.files : null;
    if(edits!=null&&edits.start<0){bytes.ok=false;return bytes;}
    int32 count = 0;
    if (file == null) {
        KrtAbiBytes body = KrtModuleMetadataFile(source,0,KrtDriverStringLength(source),edits);
        KrtAbiWord(bytes,0); KrtAbiWord(bytes,body.count); KrtAbiAppend(bytes,body); count = 1;
    }
    while (file != null) {
        if (!file.imported_metadata) {
            KrtAbiBytes body = KrtModuleMetadataFile(source,file.start,file.length,edits);
            int64 path_length = KrtDriverStringLength(file.path);
            if (path_length > 4096 || !body.ok) { bytes.ok = false; return bytes; }
            KrtAbiWord(bytes,(int32)path_length); KrtAbiWord(bytes,body.count);
            unsafe(using krt.mem;) { byte* path = (byte*)file.path; int64 index = 0; while (index < path_length) { KrtAbiByte(bytes,(int32)path[index]); index = index + 1; } }
            KrtAbiAppend(bytes,body); count = count + 1;
        }
        file = file.order_next;
    }
    KrtKroLibraryWord(bytes.data,8,count); KrtKroLibraryWord(bytes.data,12,bytes.count);
    while (edits != null) { KrtModuleMetadataEdit next = edits.next; delete edits; edits = next; }
    return bytes;
}

bool KrtKroModuleMetadata(KrtAstNode ast, int64 source, KrtKroObject output) {
    KrtAbiBytes bytes = KrtModuleMetadataBuild(ast,source);
    if (!bytes.ok || output.rodata_size > 16777216 - bytes.count) {
        KrtDiagnosticMessage("E_MODULE_METADATA",17,ast.start,"cannot serialize the module declaration interface");return false;
    }
    int32 offset = output.rodata_size; byte[] rodata = new byte[offset + bytes.count]; int32 index = 0;
    while (index < offset) { rodata[index] = output.rodata_bytes[index]; index = index + 1; }
    index = 0; while (index < bytes.count) { rodata[offset+index] = bytes.data[index]; index = index + 1; }
    output.rodata_bytes = rodata; output.rodata_size = offset + bytes.count;
    int32 symbol = output.symbol_count; byte[] symbols = new byte[(symbol+1)*32+1]; index = 0;
    while (index < symbol*32) { symbols[index] = output.symbol_bytes[index]; index = index + 1; }
    output.symbol_bytes = symbols;
    int32 name = output.strtab_size; byte[] names = new byte[name+32]; index = 0;
    while (index < name) { names[index] = output.string_bytes[index]; index = index + 1; }
    output.string_bytes = names; KrtKroLibrarySymbol(output,symbol,name,offset,bytes.count,2); KrtKroLibraryWord(output.symbol_bytes,symbol*32+16,0);
    string marker = "_KRT_MODULE3_METADATA";
    unsafe(using krt.mem;) { byte* text = (byte*)(int64)marker; index = 0; while (text[index] != 0) { names[name] = text[index]; name = name + 1; index = index + 1; } }
    names[name] = 0; output.strtab_size = name + 1; output.symbol_count = symbol + 1; return true;
}

// ===== Register allocation =====
// Allocate local values after IR optimization. r14/r15 belong to globals and
// exception records; r12/r13 are preserved by every native function.
class KrtNativeRegisterAllocation { public int32[] registers; public int32 locals; public int32 used; }

KrtNativeRegisterAllocation KrtNativeAllocateRegisters(KrtNativeModule module, int32 function_index, int32 first, int32 last) {
    int32 locals = module.local_counts[function_index];
    KrtNativeRegisterAllocation allocation = new KrtNativeRegisterAllocation();
    allocation.registers = new int32[locals];
    allocation.locals = locals;
    if (KrtDriverOptimization == 0 || locals == 0 || locals > 1024) { return allocation; }
    int32 length = last-first;
    bool[] leaders = new bool[length]; leaders[0] = true;
    int32 index = first;
    while (index < last) {
        int32 op = module.ops[index];
        // Unwinding restores a handler's rbp/rsp, rather than register locals.
        // Handler functions retain their values in their original frame slots.
        if (op == 50 || op == 51 || op == 53 || op == 54) { delete leaders; return allocation; }
        if (op == 17 || op == 18) {
            int32 target = (int32)module.args[index];
            if (target < first || target >= last) { delete leaders; return null; }
            leaders[target-first] = true;
            if (op == 18) {
                target = (int32)module.extra[index];
                if (target < first || target >= last) { delete leaders; return null; }
                leaders[target-first] = true;
            }
        }
        if ((op == 17 || op == 18 || op == 20 || op == 52) && index+1 < last) { leaders[index+1-first] = true; }
        index = index+1;
    }
    int32 blocks = 0; index = 0;
    while (index < length) { if (leaders[index]) { blocks = blocks+1; } index = index+1; }
    int32 words = (locals+63)/64;
    // Large functions remain correct using the existing spill slots.
    if (blocks*words > 1048576) { delete leaders; return allocation; }
    int32[] starts = new int32[blocks+1]; int32[] owners = new int32[length];
    int32 block = -1; index = 0;
    while (index < length) {
        if (leaders[index]) { block = block+1; starts[block] = first+index; }
        owners[index] = block; index = index+1;
    }
    starts[blocks] = last; delete leaders;
    int32[] left_edges = new int32[blocks]; int32[] right_edges = new int32[blocks];
    uint64[] uses = new uint64[blocks*words]; uint64[] definitions = new uint64[blocks*words];
    uint64[] live_in = new uint64[blocks*words]; uint64[] live_out = new uint64[blocks*words];
    int32[] begin = new int32[locals]; int32[] end = new int32[locals]; int32[] weight = new int32[locals];
    bool[] escapes = new bool[locals];
    int32 slot = 0;
    while (slot < locals) { begin[slot] = last; end[slot] = -1; slot = slot+1; }
    block = 0;
    while (block < blocks) {
        int32 stop = starts[block+1]-1; int32 op = module.ops[stop];
        left_edges[block] = -1; right_edges[block] = -1;
        if (op == 17 || op == 18) {
            left_edges[block] = owners[(int32)module.args[stop]-first];
            if (op == 18) { right_edges[block] = owners[(int32)module.extra[stop]-first]; }
        } else if (op != 20 && op != 52 && block+1 < blocks) { left_edges[block] = block+1; }
        index = starts[block];
        while (index <= stop) {
            op = module.ops[index];
            if (op == 2 || op == 3 || op == 29) {
                slot = (int32)module.args[index];
                if (slot < 0 || slot >= locals) { return null; }
                if (index < begin[slot]) { begin[slot] = index; }
                if (index > end[slot]) { end[slot] = index; }
                weight[slot] = weight[slot]+1;
                int32 word = block*words+slot/64; uint64 mask = (uint64)1 << (slot%64);
                if (op == 3) { definitions[word] = definitions[word] | mask; }
                else if ((definitions[word] & mask) == 0) { uses[word] = uses[word] | mask; }
                if (op == 29) { escapes[slot] = true; }
            }
            index = index+1;
        }
        block = block+1;
    }
    // Monotone backward dataflow handles arbitrary branch joins and backedges.
    bool changed = true;
    while (changed) {
        changed = false; block = blocks-1;
        while (block >= 0) {
            int32 word = 0;
            while (word < words) {
                uint64 outgoing = 0;
                if (left_edges[block] >= 0) { outgoing = live_in[left_edges[block]*words+word]; }
                if (right_edges[block] >= 0) { outgoing = outgoing | live_in[right_edges[block]*words+word]; }
                int32 cell = block*words+word;
                uint64 incoming = uses[cell] | (outgoing & ~definitions[cell]);
                if (incoming != live_in[cell] || outgoing != live_out[cell]) {
                    live_in[cell] = incoming; live_out[cell] = outgoing; changed = true;
                }
                word = word+1;
            }
            block = block-1;
        }
    }
    slot = 0;
    while (slot < locals) {
        if (slot < module.parameter_counts[function_index] && end[slot] >= first) { begin[slot] = first; }
        block = 0; uint64 mask = (uint64)1 << (slot%64);
        while (block < blocks) {
            int32 cell = block*words+slot/64;
            if ((live_in[cell] & mask) != 0 && starts[block] < begin[slot]) { begin[slot] = starts[block]; }
            if ((live_out[cell] & mask) != 0 && starts[block+1]-1 > end[slot]) { end[slot] = starts[block+1]-1; }
            block = block+1;
        }
        slot = slot+1;
    }
    // Prefer values with repeated accesses; disjoint intervals share a register.
    int32[] registers = allocation.registers;
    int32 round = 0;
    while (round < locals) {
        int32 selected = -1; int32 best = 0; slot = 0;
        while (slot < locals) {
            if (!escapes[slot] && weight[slot] > best) { selected = slot; best = weight[slot]; }
            slot = slot+1;
        }
        if (selected < 0) { break; }
        weight[selected] = 0; int32 register_index = 1;
        while (register_index <= 2) {
            bool available = true; slot = 0;
            while (slot < locals) {
                if (registers[slot] == register_index && begin[selected] <= end[slot] && begin[slot] <= end[selected]) { available = false; }
                slot = slot+1;
            }
            if (available) {
                registers[selected] = register_index;
                allocation.used = allocation.used | (1 << (register_index-1)); break;
            }
            register_index = register_index+1;
        }
        round = round+1;
    }
    delete starts; delete owners; delete left_edges; delete right_edges;
    delete uses; delete definitions; delete live_in; delete live_out;
    delete begin; delete end; delete weight; delete escapes;
    return allocation;
}

bool KrtKroNativeRegisterFrame(KrtKroObject output, ref int32 pc, int32 register_index, int32 slot, bool restore) {
    // mov [rbp+disp32],r12/r13 or mov r12/r13,[rbp+disp32].
    return KrtKroNativeByte(output,ref pc,76) && KrtKroNativeByte(output,ref pc,restore ? 139 : 137) &&
        KrtKroNativeByte(output,ref pc,register_index == 1 ? 165 : 173) && KrtKroNativeU32(output,ref pc,-8*(slot+1));
}

bool KrtKroNativePreserveRegisters(KrtKroObject output, ref int32 pc, int32 first_slot, bool restore) {
    return KrtKroNativeRegisterFrame(output,ref pc,1,first_slot,restore) &&
        KrtKroNativeRegisterFrame(output,ref pc,2,first_slot+1,restore);
}

bool KrtKroNativeAllocatedLoad(KrtKroObject output, ref int32 pc, int32 slot, KrtNativeRegisterAllocation allocation) {
    int32 register_index = allocation.registers[slot];
    if (register_index == 0) { return KrtKroNativeFrameLoad(output,ref pc,slot); }
    return KrtKroNativeByte(output,ref pc,65) && KrtKroNativeByte(output,ref pc,register_index == 1 ? 84 : 85);
}

bool KrtKroNativeAllocatedStore(KrtKroObject output, ref int32 pc, int32 slot, KrtNativeRegisterAllocation allocation, bool pop_value) {
    int32 register_index = allocation.registers[slot];
    if (register_index == 0) {
        return (!pop_value || KrtKroNativeByte(output,ref pc,88)) && KrtKroNativeFrameStore(output,ref pc,slot);
    }
    if (pop_value) { return KrtKroNativeByte(output,ref pc,65) && KrtKroNativeByte(output,ref pc,register_index == 1 ? 92 : 93); }
    return KrtKroNativeByte(output,ref pc,73) && KrtKroNativeByte(output,ref pc,137) && KrtKroNativeByte(output,ref pc,register_index == 1 ? 196 : 197);
}

// The two top expression values stay in r10/rax within a basic block. Deeper
// values spill in stack order; calls, helper instructions and CFG edges flush
// the cache so all predecessor paths agree on the physical operand stack.
bool KrtKroNativeTemporaryOp(int32 op) {
    return (op >= 0 && op <= 15) || op == 27 || op == 28 || op == 31 || op == 32;
}

bool KrtKroNativeTemporaryFlush(KrtKroObject output, ref int32 pc, ref int32 count) {
    if (count == 2 && (!KrtKroNativeByte(output,ref pc,65) || !KrtKroNativeByte(output,ref pc,82))) { return false; }
    if (count > 0 && !KrtKroNativeByte(output,ref pc,80)) { return false; }
    count = 0; return true;
}

bool KrtKroNativeTemporaryPush(KrtKroObject output, ref int32 pc, ref int32 count) {
    if (count == 2 && (!KrtKroNativeByte(output,ref pc,65) || !KrtKroNativeByte(output,ref pc,82))) { return false; }
    if (count > 0 && !KrtKroNativeCode(output,ref pc,0xc28949,3)) { return false; }
    if (count < 2) { count = count+1; } return true;
}

bool KrtKroNativeTemporaryPop(KrtKroObject output, ref int32 pc, ref int32 count) {
    if (count == 2 && !KrtKroNativeCode(output,ref pc,0xd0894c,3)) { return false; }
    if (count > 0) { count = count-1; } return true;
}

bool KrtKroNativeTemporaryCast(KrtKroObject output, ref int32 pc, int32 width) {
    if (width == 8 || width == -8) { return true; }
    if (width > 1000 || width < -1000) { return KrtKroNativeIntegerNormalize(output,ref pc,width); }
    if (width == -1 || width == -2) {
        return KrtKroNativeCode(output,ref pc,0x0f48,2) && KrtKroNativeByte(output,ref pc,width == -1 ? 190 : 191) && KrtKroNativeByte(output,ref pc,192);
    }
    if (width == -4) { return KrtKroNativeCode(output,ref pc,0xc089,2); }
    if (width == 1 || width == 2) {
        return KrtKroNativeByte(output,ref pc,15) && KrtKroNativeByte(output,ref pc,width == 1 ? 182 : 183) && KrtKroNativeByte(output,ref pc,192);
    }
    if (width == 4) { return KrtKroNativeCode(output,ref pc,0xc06348,3); }
    return false;
}

bool KrtKroNativeTemporaryInstruction(KrtNativeModule module, KrtKroObject output, ref int32 pc, int32 index,
                                     KrtNativeRegisterAllocation allocation, ref int32 count) {
    int32 op = module.ops[index]; int32 slot = (int32)module.args[index];
    if (op == 0) { return true; }
    if (op == 1 || op == 2) {
        if (!KrtKroNativeTemporaryPush(output,ref pc,ref count)) { return false; }
        if (op == 1) { return KrtKroNativeCode(output,ref pc,0xb848,2) && KrtKroNativeU64(output,ref pc,module.args[index]); }
        if (slot < 0 || slot >= allocation.locals) { return false; }
        int32 register_index = allocation.registers[slot];
        if (register_index > 0) { return KrtKroNativeCode(output,ref pc,register_index == 1 ? 0xe0894c : 0xe8894c,3); }
        int32 displacement = -8*(slot+1);
        if (displacement >= -128) { return KrtKroNativeCode(output,ref pc,0x458b48,3) && KrtKroNativeByte(output,ref pc,displacement); }
        return KrtKroNativeCode(output,ref pc,0x858b48,3) && KrtKroNativeU32(output,ref pc,displacement);
    }
    if (op == 3) {
        if (slot < 0 || slot >= allocation.locals) { return false; }
        if (count == 0 && !KrtKroNativeByte(output,ref pc,88)) { return false; }
        return KrtKroNativeAllocatedStore(output,ref pc,slot,allocation,false) && KrtKroNativeTemporaryPop(output,ref pc,ref count);
    }
    if (op >= 4 && op <= 13) {
        if (count > 0 && !KrtKroNativeCode(output,ref pc,0xc38948,3)) { return false; }
        if (count == 2 && !KrtKroNativeCode(output,ref pc,0xd0894c,3)) { return false; }
        if (count == 1 && !KrtKroNativeByte(output,ref pc,88)) { return false; }
        if (count == 0 && (!KrtKroNativeByte(output,ref pc,91) || !KrtKroNativeByte(output,ref pc,88))) { return false; }
        count = 1; return KrtKroNativeBinaryResult(output,ref pc,op,module.extra[index] != 0,false);
    }
    if (op == 27) {
        if (count == 0) { return KrtKroNativeByte(output,ref pc,88); }
        return KrtKroNativeTemporaryPop(output,ref pc,ref count);
    }
    if (op == 32) {
        if (count == 0) { count = 1; return KrtKroNativeCode(output,ref pc,0x24048b48,4); }
        return KrtKroNativeTemporaryPush(output,ref pc,ref count);
    }
    if (count == 0) { if (!KrtKroNativeByte(output,ref pc,88)) { return false; } count = 1; }
    if (op == 14 || op == 15) {
        return KrtKroNativeCode(output,ref pc,0xf748,2) && KrtKroNativeByte(output,ref pc,op == 14 ? 216 : 208);
    }
    if (op == 28) { return KrtKroNativeTemporaryCast(output,ref pc,slot); }
    if (op == 31) {
        return KrtKroNativeCode(output,ref pc,0xc08548,3) && KrtKroNativeCode(output,ref pc,0xc0940f,3) && KrtKroNativeCode(output,ref pc,0xc0b60f,3);
    }
    return false;
}

// ===== Runtime type tables =====
// Runtime records have stable symbols for every relocated address. A consumer
// can share a descriptor without importing the defining module's machine code.
class KrtKroRuntimeSymbol {
    public int32 offset;
    public int32 symbol;
    public KrtKroRuntimeSymbol next;
}

bool KrtKroRuntimeAddress(KrtNativeModule module,KrtKroObject output,ref int32 pc,int32 type) {
    if (type < 0 || type >= module.runtime_type_count || module.runtime_code_count >= module.count) { return false; }
    if (module.runtime_code_offsets == null) {
        module.runtime_code_offsets = new int32[module.count]; module.runtime_code_targets = new int32[module.count];
    }
    if (!KrtKroNativeCode(output,ref pc,0x058d48,3)) { return false; }
    int32 index = module.runtime_code_count; module.runtime_code_offsets[index] = pc; module.runtime_code_targets[index] = type;
    module.runtime_code_count = index+1;
    return KrtKroNativeU32(output,ref pc,0) && KrtKroNativeByte(output,ref pc,80);
}

int32 KrtKroRuntimeAddSymbol(KrtKroObject output,KrtLinkName name,int32 offset,int32 size,int32 section,int32 binding,ref int32 position) {
    if (name == null || !name.valid || name.length < 1 || name.length > 1048576) { return -1; }
    int32 index = output.symbol_count;
    KrtKroLibrarySymbol(output,index,position,offset,size,section);
    KrtKroLibraryWord(output.symbol_bytes,index*32+16,binding);
    if (section == 0) { KrtKroLibraryWord(output.symbol_bytes,index*32+20,1); }
    int32 character = 0;
    while (character < name.length) { output.string_bytes[position] = name.bytes[character]; character = character+1; position = position+1; }
    output.string_bytes[position] = 0; position = position+1; output.symbol_count = index+1; return index;
}

KrtLinkName KrtKroRuntimeName(KrtAbiBytes identity,int32 letter) {
    KrtLinkName name = KrtModuleDescriptorName(identity);
    if (name.valid) { name.bytes[4] = (byte)letter; }
    return name;
}

KrtKroRuntimeSymbol KrtKroRuntimeMap(KrtKroRuntimeSymbol head,int32 offset,int32 symbol) {
    KrtKroRuntimeSymbol item = new KrtKroRuntimeSymbol(); item.offset = offset; item.symbol = symbol; item.next = head; return item;
}
int32 KrtKroRuntimeFind(KrtKroRuntimeSymbol head,int32 offset) {
    while (head != null) { if (head.offset == offset) { return head.symbol; } head = head.next; } return -1;
}

bool KrtKroRuntimeDescriptors(KrtNativeModule module,KrtAstNode ast,int64 source,KrtKroObject output) {
    if (module.runtime_type_count == 0) { return module.runtime_code_count == 0; }
    if (module.runtime_bytes == null || module.runtime_length < 0 || module.runtime_length > 16777216) { return false; }
    int32 symbols_added = module.runtime_type_count*4; int64 names_added = 0;
    KrtNativeRuntimeType record = module.runtime_types;
    while (record != null) {
        names_added = names_added + (int64)(record.identity.count*2+16)*4;
        KrtNativeRuntimeMethod method = record.methods;
        while (method != null) {
            symbols_added = symbols_added+2;
            KrtLinkName implementation = KrtModuleImplementationName(method.target,ast,source);
            if (!implementation.valid) { return false; }
            names_added = names_added + method.identity.count*2+16 + implementation.length+1;
            method = method.next;
        }
        record = record.next;
    }
    int32 old_symbols = output.symbol_count; int32 old_names = output.strtab_size;
    if (symbols_added > 1048576-old_symbols || names_added > 67108864-old_names || output.rodata_size > 67108864-module.runtime_length-15) { return false; }
    byte[] symbols = new byte[(old_symbols+symbols_added)*32+1]; int32 index = 0;
    while (index < old_symbols*32) { symbols[index] = output.symbol_bytes[index]; index = index+1; }
    byte[] names = new byte[(int32)names_added+old_names+1]; index = 0;
    while (index < old_names) { names[index] = output.string_bytes[index]; index = index+1; }
    delete output.symbol_bytes; delete output.string_bytes; output.symbol_bytes = symbols; output.string_bytes = names;
    int32 blob_base = (output.rodata_size+15)&-16; byte[] rodata = new byte[blob_base+module.runtime_length]; index = 0;
    while (index < output.rodata_size) { rodata[index] = output.rodata_bytes[index]; index = index+1; }
    index = 0; while (index < module.runtime_length) { rodata[blob_base+index] = module.runtime_bytes[index]; index = index+1; }
    delete output.rodata_bytes; output.rodata_bytes = rodata; output.rodata_size = blob_base+module.runtime_length;
    int32 position = old_names; int32[] descriptor_symbols = new int32[module.runtime_type_count];
    KrtKroRuntimeSymbol addresses = null; KrtKroRuntimeSymbol functions = null;
    record = module.runtime_types;
    while (record != null) {
        int32 symbol = KrtKroRuntimeAddSymbol(output,KrtModuleDescriptorName(record.identity),blob_base+record.offset,96,2,2,ref position);
        if (symbol < 0) { return false; } descriptor_symbols[record.index] = symbol;
        symbol = KrtKroRuntimeAddSymbol(output,KrtKroRuntimeName(record.identity,75),blob_base+record.key_offset,record.identity.count,2,2,ref position);
        if (symbol < 0) { return false; } addresses = KrtKroRuntimeMap(addresses,record.key_offset,symbol);
        int32 interface_count = (int32)KrtNativeRuntimeRead(module.runtime_bytes,record.offset+56);
        if (interface_count > 0) {
            symbol = KrtKroRuntimeAddSymbol(output,KrtKroRuntimeName(record.identity,73),blob_base+record.interfaces_offset,interface_count*8,2,2,ref position);
            if (symbol < 0) { return false; } addresses = KrtKroRuntimeMap(addresses,record.interfaces_offset,symbol);
        }
        int32 method_count = 0; KrtNativeRuntimeMethod method = record.methods;
        while (method != null) { method_count = method_count+1; method = method.next; }
        if (method_count > 0) {
            symbol = KrtKroRuntimeAddSymbol(output,KrtKroRuntimeName(record.identity,77),blob_base+record.methods_offset,method_count*40,2,2,ref position);
            if (symbol < 0) { return false; } addresses = KrtKroRuntimeMap(addresses,record.methods_offset,symbol);
        }
        method = record.methods; index = 0;
        while (method != null) {
            symbol = KrtKroRuntimeAddSymbol(output,KrtKroRuntimeName(method.identity,75),blob_base+method.key_offset,method.identity.count,2,2,ref position);
            if (symbol < 0) { return false; } addresses = KrtKroRuntimeMap(addresses,method.key_offset,symbol);
            int32 target = (int32)method.target.value; int32 section = target < 0 ? 0 : 1;
            int32 offset = target < 0 ? 0 : module.function_offsets[target];
            int32 size = target < 0 ? 0 : module.function_sizes[target];
            symbol = KrtKroRuntimeAddSymbol(output,KrtModuleImplementationName(method.target,ast,source),offset,size,section,target < 0 ? 1 : 2,ref position);
            if (symbol < 0) { return false; } functions = KrtKroRuntimeMap(functions,record.methods_offset+index*40+24,symbol);
            method = method.next; index = index+1;
        }
        record = record.next;
    }
    int32 previous_text = output.text_reloc_count; int32 previous_data = output.rodata_reloc_count;
    int32 text_count = previous_text+module.runtime_code_count;
    int32 data_count = previous_data+module.runtime_relocation_count;
    byte[] relocations = new byte[(text_count+data_count)*16+1]; index = 0;
    while (index < previous_text*16) { relocations[index] = output.text_relocation_bytes[index]; index = index+1; }
    index = 0;
    while (index < module.runtime_code_count) {
        int32 site = (previous_text+index)*16;
        KrtKroLibraryWord(relocations,site,module.runtime_code_offsets[index]);
        KrtKroLibraryWord(relocations,site+4,descriptor_symbols[module.runtime_code_targets[index]]);
        KrtKroLibraryWord(relocations,site+8,3); index = index+1;
    }
    index = 0; while (index < previous_data*16) { relocations[text_count*16+index] = output.text_relocation_bytes[previous_text*16+index]; index = index+1; }
    index = text_count+previous_data; KrtNativeRuntimeRelocation relocation = module.runtime_relocations;
    while (relocation != null) {
        int32 symbol = relocation.kind == 0 ? KrtKroRuntimeFind(addresses,relocation.target) :
            (relocation.kind == 1 ? descriptor_symbols[relocation.target] : KrtKroRuntimeFind(functions,relocation.offset));
        if (symbol < 0) { return false; }
        KrtKroLibraryWord(relocations,index*16,blob_base+relocation.offset); KrtKroLibraryWord(relocations,index*16+4,symbol);
        KrtKroLibraryWord(relocations,index*16+8,1); index = index+1; relocation = relocation.next;
    }
    delete output.text_relocation_bytes; output.text_relocation_bytes = relocations;
    output.strtab_size = position; output.text_reloc_count = text_count; output.rodata_reloc_count = data_count;
    output.total_reloc_count = text_count+data_count; output.relocation_count = output.total_reloc_count; return true;
}

// ===== SSA register allocation =====
class KrtSsaAllocation {
    public int32[] registers; public int32[] spills; public int32[] frame_counts;
}

KrtSsaAllocation KrtSsaAllocate(KrtSsaModule ssa) {
    KrtSsaAllocation allocation = new KrtSsaAllocation();
    allocation.registers = new int32[ssa.count]; allocation.spills = new int32[ssa.count];
    allocation.frame_counts = new int32[ssa.function_count];
    int32 function_index = 0;
    while (function_index < ssa.function_count) {
        int32 first = ssa.starts[function_index]; int32 last = ssa.ends[function_index]; int32 values = last-first;
        int32 first_block = ssa.function_blocks[function_index]; int32 blocks = ssa.function_block_counts[function_index];
        int32[] begin = new int32[values]; int32[] end = new int32[values];
        int32 value = first;
        while (value < last) {
            begin[value-first] = ssa.ops[value] == 101 ? ssa.block_starts[ssa.value_blocks[value]] : value;
            end[value-first] = value; value = value+1;
        }
        int32 words = (values+63)/64;
        bool enabled = KrtDriverOptimization > 0 && !ssa.handlers[function_index] && (int64)blocks*words <= 4194304;
        if (enabled) {
            uint64[] definitions = new uint64[blocks*words]; uint64[] uses = new uint64[blocks*words];
            uint64[] edges = new uint64[blocks*words]; uint64[] live_in = new uint64[blocks*words]; uint64[] live_out = new uint64[blocks*words];
            int32 block = first_block;
            while (block < first_block+blocks) {
                value = ssa.block_starts[block];
                while (value < ssa.block_ends[block]) {
                    if (ssa.results[value]) {
                        int32 relative = value-first; int32 cell = (block-first_block)*words+relative/64;
                        definitions[cell] = definitions[cell] | ((uint64)1 << (relative%64));
                    }
                    int32 operand = 0;
                    while (operand < ssa.operand_counts[value]) {
                        int32 position = ssa.operand_starts[value]+operand; int32 incoming = ssa.operands[position]; int32 relative = incoming-first;
                        uint64 mask = (uint64)1 << (relative%64);
                        if (ssa.ops[value] == 101) {
                            int32 predecessor = ssa.phi_predecessors[position]; int32 cell = (predecessor-first_block)*words+relative/64;
                            edges[cell] = edges[cell] | mask;
                            if (ssa.block_ends[predecessor]-1 > end[relative]) { end[relative] = ssa.block_ends[predecessor]-1; }
                        } else {
                            int32 cell = (block-first_block)*words+relative/64;
                            if ((definitions[cell] & mask) == 0) { uses[cell] = uses[cell] | mask; }
                            if (value > end[relative]) { end[relative] = value; }
                        }
                        operand = operand+1;
                    }
                    value = value+1;
                }
                block = block+1;
            }
            bool changed = true;
            while (changed) {
                changed = false; block = first_block+blocks-1;
                while (block >= first_block) {
                    int32 word = 0;
                    while (word < words) {
                        int32 cell = (block-first_block)*words+word; uint64 outgoing = edges[cell];
                        if (ssa.block_left[block] >= 0) { outgoing = outgoing | live_in[(ssa.block_left[block]-first_block)*words+word]; }
                        if (ssa.block_right[block] >= 0) { outgoing = outgoing | live_in[(ssa.block_right[block]-first_block)*words+word]; }
                        uint64 incoming = uses[cell] | (outgoing & ~definitions[cell]);
                        if (incoming != live_in[cell] || outgoing != live_out[cell]) { live_in[cell] = incoming; live_out[cell] = outgoing; changed = true; }
                        word = word+1;
                    }
                    block = block-1;
                }
            }
            value = first;
            while (value < last) {
                int32 relative = value-first; uint64 mask = (uint64)1 << (relative%64); block = first_block;
                while (block < first_block+blocks) {
                    int32 cell = (block-first_block)*words+relative/64;
                    if ((live_in[cell] & mask) != 0 && ssa.block_starts[block] < begin[relative]) { begin[relative] = ssa.block_starts[block]; }
                    if ((live_out[cell] & mask) != 0 && ssa.block_ends[block]-1 > end[relative]) { end[relative] = ssa.block_ends[block]-1; }
                    block = block+1;
                }
                value = value+1;
            }
            delete definitions; delete uses; delete edges; delete live_in; delete live_out;
            // Bucket intervals by their live-range start, then apply linear
            // scan. A shorter interval can evict the active value ending last.
            int32[] buckets = new int32[values]; int32[] next = new int32[values];
            int32 relative = 0; while (relative < values) { buckets[relative] = -1; next[relative] = -1; relative = relative+1; }
            value = first;
            while (value < last) {
                if (ssa.results[value] && ssa.uses[value] > 0) {
                    int32 start = begin[value-first]-first; next[value-first] = buckets[start]; buckets[start] = value;
                }
                value = value+1;
            }
            int32 one = -1; int32 two = -1; relative = 0;
            while (relative < values) {
                value = buckets[relative];
                while (value >= 0) {
                    int32 position = first+relative;
                    if (one >= 0 && end[one-first] < position) { one = -1; }
                    if (two >= 0 && end[two-first] < position) { two = -1; }
                    int32 register_index = 0;
                    if (one < 0) { register_index = 1; }
                    else if (two < 0) { register_index = 2; }
                    else {
                        int32 victim = end[one-first] > end[two-first] ? one : two;
                        if (end[victim-first] > end[value-first]) { register_index = allocation.registers[victim]; allocation.registers[victim] = 0; }
                    }
                    if (register_index > 0) {
                        allocation.registers[value] = register_index;
                        if (register_index == 1) { one = value; } else { two = value; }
                    }
                    value = next[value-first];
                }
                relative = relative+1;
            }
            delete buckets; delete next;
        }
        int32 frame = ssa.source.local_counts[function_index]; value = first;
        while (value < last) {
            if (ssa.results[value] && ssa.uses[value] > 0 && allocation.registers[value] == 0) { allocation.spills[value] = frame; frame = frame+1; }
            value = value+1;
        }
        allocation.frame_counts[function_index] = frame;
        delete begin; delete end; function_index = function_index+1;
    }
    return allocation;
}

bool KrtKroSsaLoad(KrtSsaModule ssa, KrtSsaAllocation allocation, KrtKroObject output, ref int32 pc, int32 value) {
    if (value < 0 || value >= ssa.count || !ssa.results[value]) { return false; }
    int32 register_index = allocation.registers[value];
    if (register_index > 0) { return KrtKroNativeByte(output,ref pc,65) && KrtKroNativeByte(output,ref pc,register_index == 1 ? 84 : 85); }
    return KrtKroNativeFrameLoad(output,ref pc,allocation.spills[value]);
}

bool KrtKroSsaStore(KrtSsaModule ssa, KrtSsaAllocation allocation, KrtKroObject output, ref int32 pc, int32 value) {
    if (ssa.uses[value] == 0) { return true; }
    int32 register_index = allocation.registers[value];
    if (register_index > 0) { return KrtKroNativeCode(output,ref pc,register_index == 1 ? 0xc48949 : 0xc58949,3); }
    return KrtKroNativeFrameStore(output,ref pc,allocation.spills[value]);
}

bool KrtKroSsaEdge(KrtSsaModule ssa, KrtSsaAllocation allocation, KrtKroObject output, ref int32 pc, int32 predecessor, int32 target) {
    if (target < 0 || target >= ssa.block_count) { return false; }
    int32 first = ssa.block_phis[target]; int32 last = first+ssa.block_phi_counts[target]; int32 value = first;
    // Read all incoming values before writing destinations, including cycles.
    while (value < last) {
        if (ssa.ops[value] == 101 && ssa.uses[value] > 0) {
            int32 operand = 0; bool found = false;
            while (operand < ssa.operand_counts[value]) {
                int32 position = ssa.operand_starts[value]+operand;
                if (ssa.phi_predecessors[position] == predecessor) { if (!KrtKroSsaLoad(ssa,allocation,output,ref pc,ssa.operands[position])) { return false; } found = true; break; }
                operand = operand+1;
            }
            if (!found) { return false; }
        }
        value = value+1;
    }
    value = last-1;
    while (value >= first) {
        if (ssa.ops[value] == 101 && ssa.uses[value] > 0 && (!KrtKroNativeByte(output,ref pc,88) || !KrtKroSsaStore(ssa,allocation,output,ref pc,value))) { return false; }
        value = value-1;
    }
    return true;
}

bool KrtKroSsaRead(KrtSsaModule ssa, KrtSsaAllocation allocation, KrtKroObject output, ref int32 pc, int32 value) {
    if (value < 0 || value >= ssa.count || !ssa.results[value]) { return false; }
    int32 register_index = allocation.registers[value];
    if (register_index > 0) { return KrtKroNativeCode(output,ref pc,register_index == 1 ? 0xe0894c : 0xe8894c,3); }
    int32 displacement = -8*(allocation.spills[value]+1);
    return KrtKroNativeCode(output,ref pc,0x858b48,3) && KrtKroNativeU32(output,ref pc,displacement);
}

bool KrtKroSsaScalarOp(int32 op) {
    return op == 1 || op == 2 || op == 3 || (op >= 4 && op <= 16) || op == 28 || op == 31 || op == 100;
}

bool KrtKroSsaScalar(KrtSsaModule ssa, KrtSsaAllocation allocation, KrtKroObject output, ref int32 pc, int32 value) {
    int32 op = ssa.ops[value]; int32 operands = ssa.operand_counts[value]; int32 start = ssa.operand_starts[value];
    if (operands > 1) {
        if (!KrtKroSsaRead(ssa,allocation,output,ref pc,ssa.operands[start+1]) || !KrtKroNativeCode(output,ref pc,0xc38948,3)) { return false; }
    }
    if (operands > 0 && !KrtKroSsaRead(ssa,allocation,output,ref pc,ssa.operands[start])) { return false; }
    if (op == 1) { if (!KrtKroNativeCode(output,ref pc,0xb848,2) || !KrtKroNativeU64(output,ref pc,ssa.args[value])) { return false; } }
    else if (op == 2 || op == 100) {
        if (!KrtKroNativeCode(output,ref pc,0x858b48,3) || !KrtKroNativeU32(output,ref pc,-8*((int32)ssa.args[value]+1))) { return false; }
    } else if (op == 3) { return KrtKroNativeFrameStore(output,ref pc,(int32)ssa.args[value]); }
    else if (op >= 4 && op <= 13) { if (!KrtKroNativeBinaryResult(output,ref pc,op,ssa.extra[value] != 0,false)) { return false; } }
    else if (op == 14 || op == 15) { if (!KrtKroNativeCode(output,ref pc,0xf748,2) || !KrtKroNativeByte(output,ref pc,op == 14 ? 216 : 208)) { return false; } }
    else if (op == 16) {
        int32 condition = 149; int64 comparison = ssa.args[value]; bool is_unsigned = ssa.extra[value] != 0;
        if (comparison == 61) { condition = 148; }
        else if (comparison == 60) { condition = is_unsigned ? 146 : 156; }
        else if (comparison == 62) { condition = is_unsigned ? 151 : 159; }
        else if (comparison == 102) { condition = is_unsigned ? 150 : 158; }
        else if (comparison == 103) { condition = is_unsigned ? 147 : 157; }
        if (!KrtKroNativeCode(output,ref pc,0xd83948,3) || !KrtKroNativeByte(output,ref pc,15) || !KrtKroNativeByte(output,ref pc,condition) || !KrtKroNativeByte(output,ref pc,192) || !KrtKroNativeCode(output,ref pc,0xc0b60f,3)) { return false; }
    } else if (op == 28) { if (!KrtKroNativeTemporaryCast(output,ref pc,(int32)ssa.args[value])) { return false; } }
    else if (op == 31) {
        if (!KrtKroNativeCode(output,ref pc,0xc08548,3) || !KrtKroNativeCode(output,ref pc,0xc0940f,3) || !KrtKroNativeCode(output,ref pc,0xc0b60f,3)) { return false; }
    }
    return KrtKroSsaStore(ssa,allocation,output,ref pc,value);
}

// ===== SSA code generation =====
// Native emission consumes SSA value operands and CFG edges directly.
bool KrtKroEmitSsaModule(KrtSsaModule ssa, KrtKroObject output) {
    if (!KrtSsaValidate(ssa)) { return false; }
    KrtNativeModule module = ssa.source;
    module.runtime_code_count = 0;
    KrtSsaAllocation allocation = KrtSsaAllocate(ssa);
    if (allocation == null) { return false; }
    if (module == null || output == null || module.count <= 0 || module.count > 16777216 || module.function_count <= 0 ||
        module.function_count > 16384 || module.ops == null || module.args == null || module.extra == null ||
        module.starts == null || module.local_counts == null || module.parameter_counts == null || (!module.library_mode && module.entry < 0) || module.entry >= module.function_count ||
        module.data_length < 0 || module.data_length > 262144) { return false; }
    int64 estimated = (int64)module.function_count*640 + module.data_length + 4096;
    int32 estimate_function = 0;
    while (estimate_function < module.function_count) { estimated = estimated+(int64)module.local_counts[estimate_function]*8; estimate_function = estimate_function+1; }
    int32 estimate_index = 0;
    while (estimate_index < ssa.count) {
        int32 operation = ssa.ops[estimate_index];
        if (operation == 101 && ssa.uses[estimate_index] > 0) { estimated = estimated+(int64)ssa.operand_counts[estimate_index]*24; }
        else if (operation != 0) {
            estimated = estimated+64+(int64)ssa.operand_counts[estimate_index]*16;
            if (operation == 24) { estimated = estimated+128; }
            if (operation >= 35 && operation <= 54) { estimated = estimated+512; }
            if (operation >= 60 && operation <= 69) { estimated = estimated+1024; }
            if (operation == 75) { estimated=estimated+160; }
            if (operation == 22 && (ssa.extra[estimate_index] == 16 || ssa.extra[estimate_index] == -16)) { estimated = estimated+256; }
        }
        estimate_index = estimate_index+1;
    }
    if (estimated > 67108860) { return false; }
    int32 capacity = (int32)estimated;
    if (capacity < 4096) { capacity = 4096; }
    int32 words = (capacity + 3) / 4;
    if (words > 16777216) { return false; }
    if (!KrtKroBeginText(output, words)) { return false; }
    int32[] block_offsets = new int32[ssa.block_count];
    int32[] function_offsets = new int32[module.function_count];
    module.function_offsets = function_offsets;
    int32[] function_sizes = new int32[module.function_count]; module.function_sizes = function_sizes;
    int32 patch_capacity = ssa.count*4 + ssa.block_count*4 + 64;
    int32[] patch_offsets = new int32[patch_capacity];
    int32[] patch_targets = new int32[patch_capacity];
    int32[] patch_kinds = new int32[patch_capacity];
    module.external_reloc_offsets = new int32[patch_capacity]; module.external_reloc_targets = new int32[patch_capacity];
    int32[] external_offsets = module.external_reloc_offsets; int32[] external_targets = module.external_reloc_targets;
    bool[] external_used = module.external_used;
    int32 patch_count = 0;
    int32 pc = 0;
    // ArkLink enters the text section base for compact objects. Emit the
    // selected entry function first so that this remains valid even when the
    // source was normalized helper-first. Function ids and call relocations
    // still use their original module indices.
    int32 emit_index = 0;
    while (emit_index < module.function_count) {
        int32 function_index = emit_index;
        if (!module.library_mode && emit_index == 0) { function_index = module.entry; }
        else if (!module.library_mode && emit_index <= module.entry) { function_index = emit_index - 1; }
        int32 first_block = ssa.function_blocks[function_index];
