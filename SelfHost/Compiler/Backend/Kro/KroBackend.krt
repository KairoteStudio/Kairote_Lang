bool KrtKroNativeStringConcat(KrtKroObject output, ref int32 pc) {
    // Count into r8/r9, then save both inputs and counts on the operand stack.
    // The allocator consumes len(lhs)+len(rhs)+1 and returns payload or null.
    if (!(KrtKroNativeStringCode(output, ref pc, 37516162200066394, 7) &&
        KrtKroNativeStringCode(output, ref pc, 347996538303689, 7) &&
        KrtKroNativeStringCode(output, ref pc, 66358822201291776, 7) &&
        KrtKroNativeStringCode(output, ref pc, 59256292768826868, 7) &&
        KrtKroNativeStringCode(output, ref pc, 11254966127732, 7) &&
        KrtKroNativeStringCode(output, ref pc, 68939112761591156, 7) &&
        KrtKroNativeStringCode(output, ref pc, 21481439191192145, 7) &&
        KrtKroNativeStringCode(output, ref pc, 36953245801562249, 7) &&
        KrtKroNativeStringCode(output, ref pc, 5243328, 3))) { return false; }
