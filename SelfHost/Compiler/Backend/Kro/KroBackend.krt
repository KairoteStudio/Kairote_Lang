    while(declaration!=null){
        KrtAbiSignature signature=KrtAbiFunction(declaration,ast,source,true);
        if(signature.uses_struct&&KrtKroLibraryPublicDefinition(declaration,signature)){return true;}
        declaration=declaration.next;
    }
