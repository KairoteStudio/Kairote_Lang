            bytes[18] = (byte)((object.text_word4 >> 16) & 255);
            bytes[19] = (byte)((object.text_word4 >> 24) & 255);
            bytes[20] = (byte)(object.text_word5 & 255);
            bytes[21] = (byte)((object.text_word5 >> 8) & 255);
            bytes[22] = (byte)((object.text_word5 >> 16) & 255);
            bytes[23] = (byte)((object.text_word5 >> 24) & 255);
            bytes[24] = (byte)(object.text_word6 & 255);
        }
        if (object.text_size == 29) {
            bytes[16] = (byte)(object.text_word4 & 255);
            bytes[17] = (byte)((object.text_word4 >> 8) & 255);
            bytes[18] = (byte)((object.text_word4 >> 16) & 255);
            bytes[19] = (byte)((object.text_word4 >> 24) & 255);
            bytes[20] = (byte)(object.text_word5 & 255);
            bytes[21] = (byte)((object.text_word5 >> 8) & 255);
            bytes[22] = (byte)((object.text_word5 >> 16) & 255);
            bytes[23] = (byte)((object.text_word5 >> 24) & 255);
            bytes[24] = (byte)(object.text_word6 & 255);
            bytes[25] = (byte)((object.text_word6 >> 8) & 255);
            bytes[26] = (byte)((object.text_word6 >> 16) & 255);
            bytes[27] = (byte)(object.text_word7 & 255);
            bytes[28] = (byte)((object.text_word7 >> 8) & 255);
        }
        if (object.text_size == 27) {
            bytes[16] = (byte)(object.text_word4 & 255); bytes[17] = (byte)((object.text_word4 >> 8) & 255);
            bytes[18] = (byte)((object.text_word4 >> 16) & 255); bytes[19] = (byte)((object.text_word4 >> 24) & 255);
            bytes[20] = (byte)(object.text_word5 & 255); bytes[21] = (byte)((object.text_word5 >> 8) & 255);
            bytes[22] = (byte)((object.text_word5 >> 16) & 255); bytes[23] = (byte)((object.text_word5 >> 24) & 255);
            bytes[24] = (byte)(object.text_word6 & 255); bytes[25] = (byte)((object.text_word6 >> 8) & 255);
            bytes[26] = (byte)((object.text_word6 >> 16) & 255);
        }
        if (object.text_size == 31) {
            bytes[16] = (byte)(object.text_word4 & 255);
            bytes[17] = (byte)((object.text_word4 >> 8) & 255);
            bytes[18] = (byte)((object.text_word4 >> 16) & 255);
            bytes[19] = (byte)((object.text_word4 >> 24) & 255);
            bytes[20] = (byte)(object.text_word5 & 255);
            bytes[21] = (byte)((object.text_word5 >> 8) & 255);
            bytes[22] = (byte)((object.text_word5 >> 16) & 255);
            bytes[23] = (byte)((object.text_word5 >> 24) & 255);
            bytes[24] = (byte)(object.text_word6 & 255);
            bytes[25] = (byte)((object.text_word6 >> 8) & 255);
            bytes[26] = (byte)((object.text_word6 >> 16) & 255);
            bytes[27] = (byte)((object.text_word6 >> 24) & 255);
            bytes[28] = (byte)(object.text_word7 & 255);
            bytes[29] = (byte)((object.text_word7 >> 8) & 255);
            bytes[30] = (byte)((object.text_word7 >> 16) & 255);
        }
        return syscall(1, file_descriptor, (int64)bytes, object.text_size, 0, 0, 0) == object.text_size;
    }
}

bool KrtKroWriteHeader(KrtKroObject object, int64 file_descriptor) {
    if (!KrtKroObjectIsValid(object)) { return false; }
    unsafe(using krt.mem;) {
        byte* header = stackalloc byte[64];
        int32 index = 0;
        while (index < 64) { header[index] = 0; index = index + 1; }
        int32* words = stackalloc int32[16];
        words[0] = object.magic; words[1] = object.version; words[2] = 0; words[3] = object.entry_point;
        words[4] = object.text_size; words[5] = object.rodata_size; words[6] = object.data_size; words[7] = object.bss_size;
        words[8] = object.text_reloc_count; words[9] = object.rodata_reloc_count; words[10] = object.data_reloc_count;
        words[11] = object.bss_align; words[12] = object.symbol_count; words[13] = object.strtab_size;
        words[14] = object.total_reloc_count; words[15] = 0;
        int32 word = 0;
        while (word < 16) {
            int32 value = words[word];
            int32 offset = word * 4;
            header[offset] = (byte)(value & 255);
            header[offset + 1] = (byte)((value >> 8) & 255);
            header[offset + 2] = (byte)((value >> 16) & 255);
            header[offset + 3] = (byte)((value >> 24) & 255);
            word = word + 1;
        }
        return syscall(1, file_descriptor, (int64)header, 64, 0, 0, 0) == 64;
    }
}

// The minimal writer emits one main symbol or a helper/main pair, with no relocations.
bool KrtKroWriteSymbols(KrtKroObject object, int64 file_descriptor) {
    if (object.symbol_bytes != null) {
        byte[] data = object.data_bytes; byte[] symbols = object.symbol_bytes; byte[] names = object.string_bytes;
        byte[] relocations = object.text_relocation_bytes;
        return KrtKroWriteBytes(data, object.data_size, file_descriptor) &&
            KrtKroWriteBytes(symbols, object.symbol_count * 32, file_descriptor) &&
            KrtKroWriteBytes(relocations, object.total_reloc_count * 16, file_descriptor) &&
            KrtKroWriteBytes(names, object.strtab_size, file_descriptor);
    }
    if ((object.symbol_count != 1 && object.symbol_count != 2) ||
        (object.symbol_count == 1 && object.strtab_size != 6) || (object.symbol_count == 2 && object.strtab_size != 13)) { return false; }
    unsafe(using krt.mem;) {
        int32 symbol_bytes = object.symbol_count * 32;
        byte* data = stackalloc byte[64];
        int32 index = 0;
        while (index < symbol_bytes) { data[index] = 0; index = index + 1; }
        if (object.symbol_count == 2) { data[0] = 1; }
        data[8] = (byte)(object.symbol_count == 2 ? ((object.text_size == 22 || object.text_size == 27) ? 3 : 6) : object.text_size);
        data[4] = (byte)(object.entry_symbol_value & 255);
        data[5] = (byte)((object.entry_symbol_value >> 8) & 255);
        data[6] = (byte)((object.entry_symbol_value >> 16) & 255);
        data[7] = (byte)((object.entry_symbol_value >> 24) & 255);
        data[12] = 1;
        data[16] = 1;
        data[20] = 1;
        if (object.symbol_count == 2) {
            data[32] = 8; data[36] = (byte)(object.text_size == 22 || object.text_size == 27 ? 3 : 6); data[40] = (byte)(object.text_size - (object.text_size == 22 || object.text_size == 27 ? 3 : 6)); data[44] = 1; data[48] = 1; data[52] = 1;
        }
        if (syscall(1, file_descriptor, (int64)data, symbol_bytes, 0, 0, 0) != symbol_bytes) { return false; }
        byte* strings = stackalloc byte[13];
        strings[0] = 0;
        if (object.symbol_count == 1) {
            strings[1] = 109; strings[2] = 97; strings[3] = 105; strings[4] = 110; strings[5] = 0;
        } else {
            strings[1] = 104; strings[2] = 101; strings[3] = 108; strings[4] = 112; strings[5] = 101; strings[6] = 114;
            strings[7] = 0; strings[8] = 109; strings[9] = 97; strings[10] = 105; strings[11] = 110; strings[12] = 0;
        }
        int32 string_bytes = object.symbol_count == 2 ? 13 : 6;
        return syscall(1, file_descriptor, (int64)strings, string_bytes, 0, 0, 0) == string_bytes;
    }
}

bool KrtKroWriteObjectToPath(KrtKroObject object, string path) {
    int64 file_descriptor = syscall(2, (int64)path, 577, 420, 0, 0, 0);
    if (file_descriptor < 0) { return false; }
    bool result = KrtKroWriteHeader(object, file_descriptor) && KrtKroWriteText(object, file_descriptor) &&
        KrtKroWriteBytes(object.rodata_bytes,object.rodata_size,file_descriptor) && KrtKroWriteSymbols(object, file_descriptor);
    syscall(3, file_descriptor, 0, 0, 0, 0, 0);
    return result;
}

bool KrtKroEmitIrFunction(KrtIrFunction ir_function, KrtKroObject output) {
    if (!KrtIrValidateFunction(ir_function)) { return false; }
    if (ir_function.block_count != 1) { return false; }
    if (ir_function.instruction_count < 0) { return false; }
    output.text_word0 = 0;
    output.text_word1 = 0;
    output.text_word2 = 0;
    output.text_word3 = 0;
    output.text_word4 = 0;
    output.text_word5 = 0;
    output.magic = 5198411;
    output.version = 2;
    output.architecture = 34404;
    output.entry_point = 0;
    output.text_reloc_count = 0;
    output.rodata_reloc_count = 0;
    output.data_reloc_count = 0;
    output.bss_align = 0;
    output.total_reloc_count = 0;
    output.strtab_size = 6;
    if (ir_function.instruction_count == 0) {
        output.text_size = 0;
        output.rodata_size = 0;
        output.data_size = 0;
        output.bss_size = 0;
        output.symbol_count = 0;
        output.relocation_count = 0;
        return KrtKroObjectIsValid(output);
    }
    if (ir_function.instruction_count == 2 && ir_function.opcodes[0] == (int32)KrtIrOpcode.Constant &&
        ir_function.opcodes[1] == (int32)KrtIrOpcode.Return) {
        // x86-64: mov eax, imm32 (B8) followed by ret (C3).
        int64 immediate = ir_function.immediates[0];
        if (immediate < -2147483648 || immediate > 2147483647) { return false; }
        output.text_word0 = 184 | ((int32)(immediate & 255) << 8) |
            ((int32)((immediate >> 8) & 255) << 16) |
            ((int32)((immediate >> 16) & 255) << 24);
        output.text_word1 = (int32)((immediate >> 24) & 255) | (195 << 8);
        output.text_size = 6;
    } else if (ir_function.instruction_count == 2 && ir_function.opcodes[0] == (int32)KrtIrOpcode.LoadLocal &&
               ir_function.opcodes[1] == (int32)KrtIrOpcode.Return && ir_function.lefts[0] == -2) {
        // System V AMD64 first int32 argument arrives in EDI.
        output.text_word0 = 139 | (199 << 8) | (195 << 16);
        output.text_word1 = 0;
        output.text_size = 3;
    } else if (ir_function.instruction_count == 4 && ir_function.opcodes[0] == (int32)KrtIrOpcode.Constant &&
               ir_function.opcodes[1] == (int32)KrtIrOpcode.StoreLocal &&
               ir_function.opcodes[2] == (int32)KrtIrOpcode.LoadLocal &&
               ir_function.opcodes[3] == (int32)KrtIrOpcode.Return && ir_function.rights[1] == 0 &&
               ir_function.lefts[2] == 0) {
        // push rbp; mov rbp,rsp; mov dword [rbp-8],imm32; mov eax,[rbp-8]; pop rbp; ret.
        int64 immediate_local = ir_function.immediates[0];
        if (immediate_local < -2147483648 || immediate_local > 2147483647) { return false; }
        output.text_word0 = 85 | (72 << 8) | (137 << 16) | (229 << 24);
        output.text_word1 = 199 | (69 << 8) | (248 << 16) | ((int32)(immediate_local & 255) << 24);
        output.text_word2 = (int32)((immediate_local >> 8) & 255) | ((int32)((immediate_local >> 16) & 255) << 8) |
            ((int32)((immediate_local >> 24) & 255) << 16) | (139 << 24);
        output.text_word3 = 69 | (248 << 8) | (93 << 16) | (195 << 24);
        output.text_size = 16;
    } else if (ir_function.instruction_count == 6 && ir_function.opcodes[0] == (int32)KrtIrOpcode.Constant &&
               ir_function.opcodes[1] == (int32)KrtIrOpcode.StoreLocal && ir_function.opcodes[2] == (int32)KrtIrOpcode.Constant &&
               ir_function.opcodes[3] == (int32)KrtIrOpcode.StoreLocal && ir_function.opcodes[4] == (int32)KrtIrOpcode.LoadLocal &&
               ir_function.opcodes[5] == (int32)KrtIrOpcode.Return && ir_function.rights[1] == 0 && ir_function.rights[3] == 1 &&
               ir_function.lefts[4] == 1) {
        int64 first = ir_function.immediates[0];
        int64 second = ir_function.immediates[2];
        if (first < -2147483648 || first > 2147483647 || second < -2147483648 || second > 2147483647) { return false; }
        output.text_word0 = 85 | (72 << 8) | (137 << 16) | (229 << 24);
        output.text_word1 = 199 | (69 << 8) | (248 << 16) | ((int32)(first & 255) << 24);
        output.text_word2 = (int32)((first >> 8) & 255) | ((int32)((first >> 16) & 255) << 8) | ((int32)((first >> 24) & 255) << 16) | (199 << 24);
        output.text_word3 = 69 | (244 << 8) | ((int32)(second & 255) << 16) | ((int32)((second >> 8) & 255) << 24);
        output.text_word4 = (int32)((second >> 16) & 255) | ((int32)((second >> 24) & 255) << 8) | (139 << 16) | (69 << 24);
        output.text_word5 = 244 | (93 << 8) | (195 << 16);
        output.text_size = 23;
    } else if (ir_function.instruction_count == 9 && ir_function.opcodes[0] == (int32)KrtIrOpcode.StackAlloc &&
               ir_function.opcodes[1] == (int32)KrtIrOpcode.Constant && ir_function.opcodes[2] == (int32)KrtIrOpcode.AddressOffset &&
               ir_function.opcodes[3] == (int32)KrtIrOpcode.Constant && ir_function.opcodes[4] == (int32)KrtIrOpcode.Store &&
               ir_function.opcodes[5] == (int32)KrtIrOpcode.Constant && ir_function.opcodes[6] == (int32)KrtIrOpcode.AddressOffset &&
               ir_function.opcodes[7] == (int32)KrtIrOpcode.Load && ir_function.opcodes[8] == (int32)KrtIrOpcode.Return &&
               ir_function.immediates[0] <= 128 && ir_function.immediates[1] == 0 && ir_function.immediates[5] == 0 &&
               ir_function.immediates[4] == 1 && ir_function.immediates[7] == 1) {
        int64 stored = ir_function.immediates[3];
        if (stored < 0 || stored > 255) { return false; }
        // push rbp; mov rbp,rsp; sub rsp,16; lea rax,[rbp-4]; mov byte [rax],imm;
        // lea rax,[rbp-4]; movzx eax,byte [rax]; leave; ret.
        output.text_word0 = 85 | (72 << 8) | (137 << 16) | (229 << 24);
        output.text_word1 = 72 | (131 << 8) | (236 << 16) | (16 << 24);
        output.text_word2 = 72 | (141 << 8) | (69 << 16) | (252 << 24);
        output.text_word3 = 198 | ((int32)stored << 16) | (72 << 24);
        output.text_word4 = 141 | (69 << 8) | (252 << 16) | (15 << 24);
        output.text_word5 = 182 | (0 << 8) | (201 << 16) | (195 << 24);
        output.text_size = 23;
    } else { return false; }
    output.rodata_size = 0;
    output.data_size = 0;
    output.bss_size = 0;
    output.symbol_count = 1;
    output.relocation_count = 0;
    return KrtKroObjectIsValid(output);
}

// ---------------------------------------------------------------------------
// Native stack-IR backend
// ---------------------------------------------------------------------------
// NativeIr deliberately has no register-allocation dependency.  Values are
// kept on the machine stack between instructions while locals live in fixed
// rbp-relative slots.  This makes the emitter deterministic and keeps calls,
// branches and memory operations equally simple.

bool KrtKroNativeByte(KrtKroObject object, ref int32 pc, int32 value) {
    if (!KrtKroEmitTextByte(object, pc, value & 255)) { return false; }
    pc = pc + 1;
    return true;
}

bool KrtKroNativeU32(KrtKroObject object, ref int32 pc, int32 value) {
    if (!KrtKroEmitTextU32(object, pc, value)) { return false; }
    pc = pc + 4;
    return true;
}

bool KrtKroNativeU64(KrtKroObject object, ref int32 pc, int64 value) {
    if (!KrtKroNativeU32(object, ref pc, (int32)(value & 4294967295)) ||
        !KrtKroNativeU32(object, ref pc, (int32)((value >> 32) & 4294967295))) { return false; }
    return true;
}

bool KrtKroNativeFrameLoad(KrtKroObject object, ref int32 pc, int32 slot) {
    int32 displacement = -8 * (slot + 1);
    if (displacement >= -128 && displacement <= 127) {
        return KrtKroNativeByte(object, ref pc, 72) && KrtKroNativeByte(object, ref pc, 139) &&
            KrtKroNativeByte(object, ref pc, 69) && KrtKroNativeByte(object, ref pc, displacement) &&
            KrtKroNativeByte(object, ref pc, 80);
    }
    return KrtKroNativeByte(object, ref pc, 72) && KrtKroNativeByte(object, ref pc, 139) &&
        KrtKroNativeByte(object, ref pc, 133) && KrtKroNativeU32(object, ref pc, displacement) &&
        KrtKroNativeByte(object, ref pc, 80);
}

bool KrtKroNativeFrameStore(KrtKroObject object, ref int32 pc, int32 slot) {
    int32 displacement = -8 * (slot + 1);
    if (displacement >= -128 && displacement <= 127) {
        return KrtKroNativeByte(object, ref pc, 72) && KrtKroNativeByte(object, ref pc, 137) &&
            KrtKroNativeByte(object, ref pc, 69) && KrtKroNativeByte(object, ref pc, displacement);
    }
    return KrtKroNativeByte(object, ref pc, 72) && KrtKroNativeByte(object, ref pc, 137) &&
        KrtKroNativeByte(object, ref pc, 133) && KrtKroNativeU32(object, ref pc, displacement);
}

bool KrtKroNativeMoveArg(KrtKroObject object, ref int32 pc, int32 arg_index) {
    // System V integer argument registers: rdi, rsi, rdx, rcx, r8, r9.
    if (arg_index == 0) { return KrtKroNativeByte(object, ref pc, 72) && KrtKroNativeByte(object, ref pc, 137) && KrtKroNativeByte(object, ref pc, 199); }
    if (arg_index == 1) { return KrtKroNativeByte(object, ref pc, 72) && KrtKroNativeByte(object, ref pc, 137) && KrtKroNativeByte(object, ref pc, 198); }
    if (arg_index == 2) { return KrtKroNativeByte(object, ref pc, 72) && KrtKroNativeByte(object, ref pc, 137) && KrtKroNativeByte(object, ref pc, 194); }
    if (arg_index == 3) { return KrtKroNativeByte(object, ref pc, 72) && KrtKroNativeByte(object, ref pc, 137) && KrtKroNativeByte(object, ref pc, 193); }
    if (arg_index == 4) { return KrtKroNativeByte(object, ref pc, 73) && KrtKroNativeByte(object, ref pc, 137) && KrtKroNativeByte(object, ref pc, 192); }
    if (arg_index == 5) { return KrtKroNativeByte(object, ref pc, 73) && KrtKroNativeByte(object, ref pc, 137) && KrtKroNativeByte(object, ref pc, 193); }
    return false;
}

bool KrtKroNativeMoveSyscallArg(KrtKroObject object, ref int32 pc, int32 arg_index) {
    if (arg_index == 3) { return KrtKroNativeByte(object, ref pc, 73) && KrtKroNativeByte(object, ref pc, 137) && KrtKroNativeByte(object, ref pc, 194); }
    return KrtKroNativeMoveArg(object, ref pc, arg_index);
}

bool KrtKroNativeBinary(KrtKroObject object, ref int32 pc, int32 opcode, bool is_unsigned) {
    // Stack order is lhs, rhs.  Pop rhs into rbx and lhs into rax.
    if (!KrtKroNativeByte(object, ref pc, 91) || !KrtKroNativeByte(object, ref pc, 88)) { return false; }
    return KrtKroNativeBinaryResult(object,ref pc,opcode,is_unsigned,true);
}

bool KrtKroNativeBinaryResult(KrtKroObject object, ref int32 pc, int32 opcode, bool is_unsigned, bool push_value) {
    if (opcode == 4) { return KrtKroNativeByte(object, ref pc, 72) && KrtKroNativeByte(object, ref pc, 1) && KrtKroNativeByte(object, ref pc, 216) && (!push_value || KrtKroNativeByte(object, ref pc, 80)); }
    if (opcode == 5) { return KrtKroNativeByte(object, ref pc, 72) && KrtKroNativeByte(object, ref pc, 41) && KrtKroNativeByte(object, ref pc, 216) && (!push_value || KrtKroNativeByte(object, ref pc, 80)); }
    if (opcode == 6) { return KrtKroNativeByte(object, ref pc, 72) && KrtKroNativeByte(object, ref pc, 15) && KrtKroNativeByte(object, ref pc, 175) && KrtKroNativeByte(object, ref pc, 195) && (!push_value || KrtKroNativeByte(object, ref pc, 80)); }
    if (opcode == 7 || opcode == 8) {
        if (is_unsigned) {
            if (!KrtKroNativeByte(object, ref pc, 49) || !KrtKroNativeByte(object, ref pc, 210)) { return false; }
        } else if (!KrtKroNativeByte(object, ref pc, 72) || !KrtKroNativeByte(object, ref pc, 153)) { return false; }
        if (!KrtKroNativeByte(object, ref pc, 72) || !KrtKroNativeByte(object, ref pc, 247) || !KrtKroNativeByte(object, ref pc, is_unsigned ? 243 : 251)) { return false; }
        if (opcode == 8 && (!KrtKroNativeByte(object, ref pc, 72) || !KrtKroNativeByte(object, ref pc, 137) || !KrtKroNativeByte(object, ref pc, 208))) { return false; }
        return !push_value || KrtKroNativeByte(object, ref pc, 80);
    }
    if (opcode == 9) { return KrtKroNativeByte(object, ref pc, 72) && KrtKroNativeByte(object, ref pc, 33) && KrtKroNativeByte(object, ref pc, 216) && (!push_value || KrtKroNativeByte(object, ref pc, 80)); }
    if (opcode == 10) { return KrtKroNativeByte(object, ref pc, 72) && KrtKroNativeByte(object, ref pc, 9) && KrtKroNativeByte(object, ref pc, 216) && (!push_value || KrtKroNativeByte(object, ref pc, 80)); }
    if (opcode == 11) { return KrtKroNativeByte(object, ref pc, 72) && KrtKroNativeByte(object, ref pc, 49) && KrtKroNativeByte(object, ref pc, 216) && (!push_value || KrtKroNativeByte(object, ref pc, 80)); }
    if (opcode == 12) { return KrtKroNativeByte(object, ref pc, 72) && KrtKroNativeByte(object, ref pc, 137) && KrtKroNativeByte(object, ref pc, 217) && KrtKroNativeByte(object, ref pc, 72) && KrtKroNativeByte(object, ref pc, 211) && KrtKroNativeByte(object, ref pc, 224) && (!push_value || KrtKroNativeByte(object, ref pc, 80)); }
    if (opcode == 13) { return KrtKroNativeByte(object, ref pc, 72) && KrtKroNativeByte(object, ref pc, 137) && KrtKroNativeByte(object, ref pc, 217) && KrtKroNativeByte(object, ref pc, 72) && KrtKroNativeByte(object, ref pc, 211) && KrtKroNativeByte(object, ref pc, is_unsigned ? 232 : 248) && (!push_value || KrtKroNativeByte(object, ref pc, 80)); }
    return false;
}

bool KrtKroNativeFlowEdge(int32[] depths, int32[] queue, ref int32 tail, int32 target, int32 first, int32 last, int32 depth) {
    if (target < first || target >= last || depth < 0) { return false; }
    if (depths[target] >= 0) { return depths[target] == depth; }
    depths[target] = depth;
    queue[tail] = target;
    tail = tail + 1;
    return true;
}

bool KrtKroNativeMemoryLoad(KrtKroObject output, ref int32 pc, int32 width) {
    if (width > 1000 || width < -1000) { return KrtKroNativeMemoryLoad(output, ref pc, KrtKroNativeIntegerStorage(width)) && KrtKroNativeIntegerNormalize(output, ref pc, width); }
    if (width == 16 || width == -16) { return KrtKroNativeWideLoad(output, ref pc); }
    if (width == -1 || width == -2) {
        return KrtKroNativeByte(output, ref pc, 72) && KrtKroNativeByte(output, ref pc, 15) &&
            KrtKroNativeByte(output, ref pc, width == -1 ? 190 : 191) && KrtKroNativeByte(output, ref pc, 0);
    }
    if (width == -4) { return KrtKroNativeByte(output, ref pc, 139) && KrtKroNativeByte(output, ref pc, 0); }
    if (width == -8) { width = 8; }
    if (width == 1) { return KrtKroNativeByte(output, ref pc, 15) && KrtKroNativeByte(output, ref pc, 182) && KrtKroNativeByte(output, ref pc, 0); }
    if (width == 2) { return KrtKroNativeByte(output, ref pc, 15) && KrtKroNativeByte(output, ref pc, 183) && KrtKroNativeByte(output, ref pc, 0); }
    if (width == 4) { return KrtKroNativeByte(output, ref pc, 72) && KrtKroNativeByte(output, ref pc, 99) && KrtKroNativeByte(output, ref pc, 0); }
