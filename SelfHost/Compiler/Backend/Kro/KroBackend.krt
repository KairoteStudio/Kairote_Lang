bool KrtKroLibraryNeedsAbi(KrtNativeModule module,KrtAstNode ast,int64 source) {
    // Scalar-only objects retain the existing compact symbol-table contract.
    KrtAstNode type=ast.declarations;bool has_struct=false;
    while(type!=null){if(type.value>=1&&type.value<=5){has_struct=true;break;}type=type.next;}
    if(!has_struct){return false;}
