    return KrtKroNativeCode(output,ref pc,0x8d48,2) && KrtKroNativeByte(output,ref pc,0x8d) &&
        KrtKroNativeU32(output,ref pc,displacement) && KrtKroNativeCode(output,ref pc,0x018948,3) &&
        KrtKroNativeCode(output,ref pc,0x08518948,4) && KrtKroNativeCode(output,ref pc,0xc88948,3);
