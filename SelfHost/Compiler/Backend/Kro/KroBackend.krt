        // Access-hidden names need disambiguation inside a combined module.
        if (!KrtNativeAccessExported(declaration)) {
            name = name - 1; KrtLinkName suffix = KrtLinkNameNew(); KrtLinkText(suffix,"$local"); KrtLinkNumber(suffix,index);
            byte[] suffix_bytes = suffix.bytes; byte[] names_bytes = output.string_bytes; int32 character = 0;
            while (character < suffix.length) { names_bytes[name] = suffix_bytes[character]; name = name + 1; character = character + 1; }
            names_bytes[name] = 0; name = name + 1;
        }
        index = index + 1; declaration = declaration.next;
    }
    output.strtab_size = name;
    return KrtKroObjectIsValid(output);
}

bool KrtKroLibraryPublicSignature(KrtAstNode function_node, KrtAstNode ast, int64 source) {
    return KrtNativeAbiSignatureSupported(function_node,ast,source);
}

bool KrtKroLibraryPublicDefinition(KrtAstNode declaration,KrtAbiSignature signature) {
    return !declaration.native_closure_function&&!declaration.native_abstract&&KrtNativeAccessExported(declaration)&&declaration.op!=230&&declaration.op!=241&&declaration.native_generic_origin==null&&
        signature.supported&&signature.contract.ok&&
        (declaration.native_owner==null||(declaration.native_owner.native_generic_parameters==null&&
            (declaration.native_owner.native_generic_origin==null||declaration.native_owner.value==2||declaration.native_owner.value==1)));
