    }
    if (node.kind == KrtAstKind.Ternary) {
        int64 condition = 0; int64 condition_high = 0;
        if (!KrtKroLibraryValue(node.left, ref condition, ref condition_high)) { return false; }
        KrtAstNode selected = node.alternate;
        if (condition != 0 || condition_high != 0) { selected = node.right; }
        if (!KrtKroLibraryValue(selected, ref low, ref high)) { return false; }
        return KrtKroLibraryNormalize(node, ref low, ref high);
    }
    if (node.kind != KrtAstKind.Binary || KrtNativeWideKind(node.left) || KrtNativeWideKind(node.right)) { return false; }
    int64 left = 0; int64 right = 0; int64 ignored = 0;
    if (!KrtKroLibraryValue(node.left, ref left, ref ignored)) { return false; }
    if (node.op == 104 && left == 0) { return true; }
    if (node.op == 105 && left != 0) { low = 1; return true; }
    if (!KrtKroLibraryValue(node.right, ref right, ref ignored)) { return false; }
    bool unsigned_value = node.native_unsigned;
    if (node.op == 61 || node.op == 101 || node.op == 60 || node.op == 62 || node.op == 102 || node.op == 103) {
        KrtAstNode promoted = KrtAstMake(KrtAstKind.Type, 0, 0); KrtNativePromoteNumber(promoted, node.left, node.right, false); unsigned_value = promoted.native_unsigned;
    }
    if (node.op == 43) { low = left + right; }
    else if (node.op == 45) { low = left - right; }
    else if (node.op == 42) { low = left * right; }
    else if (node.op == 47 || node.op == 37) {
        if (right == 0) { return false; }
        if (unsigned_value) { low = node.op == 47 ? (int64)((uint64)left / (uint64)right) : (int64)((uint64)left % (uint64)right); }
        else if (left == (-9223372036854775807 - 1) && right == -1) { low = node.op == 47 ? left : 0; }
        else { low = node.op == 47 ? left / right : left % right; }
    }
