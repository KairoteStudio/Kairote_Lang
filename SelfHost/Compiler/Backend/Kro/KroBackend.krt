// ===== Floating point encoding =====
// Encode a short instruction sequence from its little-endian bytes.
bool KrtKroNativeCode(KrtKroObject output, ref int32 pc, int64 bytes, int32 count) {
    int32 i = 0;
    while (i < count) {
        if (!KrtKroNativeByte(output, ref pc, (int32)(bytes & 255))) { return false; }
        bytes = bytes >> 8; i = i + 1;
    }
    return true;
}

bool KrtKroNativeFloatConvert(KrtKroObject output, ref int32 pc, int32 origin_format, int32 target_format) {
    if ((origin_format != 0 && origin_format != -8 && origin_format != 4 && origin_format != 8) || (target_format != 0 && target_format != -8 && target_format != 4 && target_format != 8)) { return false; }
    if (origin_format == target_format) { return true; }
    if (!(KrtKroNativeCode(output, ref pc, 88, 1))) { return false; }
    if (origin_format == 4) {
    if (!(KrtKroNativeCode(output, ref pc, 25350287483866982, 7) &&
        KrtKroNativeCode(output, ref pc, 192, 1))) { return false; }
    } else if (origin_format == 8) {
    if (!(KrtKroNativeCode(output, ref pc, 826480216166, 5))) { return false; }
    } else if (origin_format == -8) {
    if (!(KrtKroNativeCode(output, ref pc, 38641337473467720, 7) &&
        KrtKroNativeCode(output, ref pc, 65813776772924353, 7) &&
        KrtKroNativeCode(output, ref pc, 11838755007105352, 7) &&
        KrtKroNativeCode(output, ref pc, 1666586227241664, 7) &&
        KrtKroNativeCode(output, ref pc, 825339365618, 5))) { return false; }
    } else {
    if (!(KrtKroNativeCode(output, ref pc, 825339365618, 5))) { return false; }
    }
    if (target_format == 4) {
    if (!(KrtKroNativeCode(output, ref pc, 35482781053751282, 7) &&
        KrtKroNativeCode(output, ref pc, 192, 1))) { return false; }
    } else if (target_format == 8) {
    if (!(KrtKroNativeCode(output, ref pc, 826748651622, 5))) { return false; }
    } else if (target_format == -8) {
    if (!(KrtKroNativeCode(output, ref pc, 47432, 7) &&
        KrtKroNativeCode(output, ref pc, 30979051065958400, 7) &&
        KrtKroNativeCode(output, ref pc, 4911248631097033, 7) &&
        KrtKroNativeCode(output, ref pc, 4302332113981426, 7) &&
        KrtKroNativeCode(output, ref pc, 18006401536802860, 7) &&
        KrtKroNativeCode(output, ref pc, 54091639688398315, 7))) { return false; }
    } else {
    if (!(KrtKroNativeCode(output, ref pc, 825372920050, 5))) { return false; }
    }
    return KrtKroNativeCode(output, ref pc, 80, 1);
}

bool KrtKroNativeFloatBinary(KrtKroObject output, ref int32 pc, int32 operation, int32 width) {
    if (width != 4 && width != 8) { return false; }
    if (operation == 37) {
        // x87 FPREM computes remainder without overflowing the quotient.
        if (!KrtKroNativeCode(output, ref pc, width == 4 ? 36 * 65536 + 4 * 256 + 217 : 36 * 65536 + 4 * 256 + 221, 3) ||
            !KrtKroNativeByte(output, ref pc, width == 4 ? 217 : 221) ||
            !KrtKroNativeCode(output, ref pc, 8 * 65536 + 36 * 256 + 68, 3)) { return false; }
    if (!(KrtKroNativeCode(output, ref pc, 1342464520616153, 7) &&
        KrtKroNativeCode(output, ref pc, 63349, 2))) { return false; }
        if (!KrtKroNativeByte(output, ref pc, width == 4 ? 217 : 221)) { return false; }
    if (!(KrtKroNativeCode(output, ref pc, 36953318207530076, 7) &&
        KrtKroNativeCode(output, ref pc, 2244, 2))) { return false; }
        return true;
    }
    int32 opcode = operation == 43 ? 88 : operation == 45 ? 92 : operation == 42 ? 89 : operation == 47 ? 94 : -1;
    if (opcode < 0) { return false; }
    if (!(KrtKroNativeCode(output, ref pc, 54164207446677593, 7) &&
        KrtKroNativeCode(output, ref pc, 865134921830, 5))) { return false; }
    if (!KrtKroNativeByte(output, ref pc, width == 4 ? 243 : 242) || !KrtKroNativeByte(output, ref pc, 15) || !KrtKroNativeByte(output, ref pc, opcode) || !KrtKroNativeByte(output, ref pc, 193)) { return false; }
    if (width == 4) {
    if (!(KrtKroNativeCode(output, ref pc, 3229486950, 4))) { return false; }
    } else {
    if (!(KrtKroNativeCode(output, ref pc, 826748651622, 5))) { return false; }
    }
    return KrtKroNativeCode(output, ref pc, 80, 1);
}

bool KrtKroNativeFloatCompare(KrtKroObject output, ref int32 pc, int32 operation, int32 width) {
    if (width != 4 && width != 8) { return false; }
    int32 condition = operation == 61 ? 148 : operation == 101 ? 149 : operation == 60 ? 146 : operation == 102 ? 150 : operation == 62 ? 151 : operation == 103 ? 147 : -1;
    if (condition < 0) { return false; }
    if (!(KrtKroNativeCode(output, ref pc, 54164207446677593, 7) &&
        KrtKroNativeCode(output, ref pc, 865134921830, 5))) { return false; }
    if (width == 8 && !KrtKroNativeByte(output, ref pc, 102)) { return false; }
    if (!(KrtKroNativeCode(output, ref pc, 12660239, 3))) { return false; }
    if (!KrtKroNativeByte(output, ref pc, 15) || !KrtKroNativeByte(output, ref pc, condition) || !KrtKroNativeByte(output, ref pc, 192)) { return false; }
    if (operation == 101) {
    if (!(KrtKroNativeCode(output, ref pc, 893500168719, 5))) { return false; }
    } else {
    if (!(KrtKroNativeCode(output, ref pc, 893902822159, 5))) { return false; }
    }
    return KrtKroNativeCode(output, ref pc, 1354806799, 4);
}

bool KrtKroNativeFloatUnary(KrtKroObject output, ref int32 pc, int32 operation, int32 width, int32 increment) {
    if (width != 4 && width != 8) { return false; }
    if (operation == 43) {
    if (!(KrtKroNativeCode(output, ref pc, 3632875611, 4))) { return false; }
        if (!KrtKroNativeMemoryLoad(output, ref pc, width == 4 ? -4 : 8)) { return false; }
    if (!(KrtKroNativeCode(output, ref pc, 20560, 2))) { return false; }
        if (!KrtKroNativeCode(output, ref pc, 184 * 256 + 72, 2) || !KrtKroNativeU64(output, ref pc, increment)) { return false; }
    if (!(KrtKroNativeCode(output, ref pc, 80, 1))) { return false; }
        if (!KrtKroNativeFloatConvert(output, ref pc, 0, width) || !KrtKroNativeFloatBinary(output, ref pc, 43, width)) { return false; }
    if (!(KrtKroNativeCode(output, ref pc, 88, 1))) { return false; }
        return KrtKroNativeMemoryStore(output, ref pc, width);
    }
    if (!(KrtKroNativeCode(output, ref pc, 88, 1))) { return false; }
    if (operation == 41) {
        if (!KrtKroNativeCode(output, ref pc, 185 * 256 + 72, 2) || !KrtKroNativeU64(output, ref pc, width == 4 ? 2147483648 : -9223372036854775807 - 1)) { return false; }
    if (!(KrtKroNativeCode(output, ref pc, 13119816, 3))) { return false; }
    } else if (operation == 42) {
        if (width == 4) {
    if (!(KrtKroNativeCode(output, ref pc, 57553, 2))) { return false; }
        } else {
    if (!(KrtKroNativeCode(output, ref pc, 14733640, 3))) { return false; }
        }
    if (!(KrtKroNativeCode(output, ref pc, 211888180860175, 6))) { return false; }
    } else { return false; }
    return KrtKroNativeCode(output, ref pc, 80, 1);
}

// ===== Global data and symbols =====
bool KrtKroNativeGlobalAddress(KrtNativeModule module,KrtKroObject output,ref int32 pc,int32 slot) {
    if(slot<0||slot>=module.global_count||module.global_entries==null||module.global_entries[slot]==null||module.global_reloc_count>=module.count*2){return false;}
    if(module.global_reloc_offsets==null){module.global_reloc_offsets=new int32[module.count*2];module.global_reloc_slots=new int32[module.count*2];}
    KrtNativeGlobalEntry entry=module.global_entries[slot];
    if(!entry.module_guard&&slot==entry.declaration.native_global-1&&(entry.declaration.syntax_modifiers&1024)!=0){
        // An explicit extern field carries no initializer syntax. Its defining
        // module supplies a stable initialization alias. Preserve every volatile
        // register, the callable environment and the live expression stack;
        // the alias can call arbitrary code or unwind through the current frame.
        if(!KrtKroNativeCode(output,ref pc,0x5756525150,5)){return false;}
        if(!KrtKroNativeCode(output,ref pc,0x51415041,4)||!KrtKroNativeCode(output,ref pc,0x53415241,4)||
           !KrtKroNativeCode(output,ref pc,0xe08948,3)||!KrtKroNativeCode(output,ref pc,0xf0e48348,4)||
           !KrtKroNativeCode(output,ref pc,0x10ec8348,4)||!KrtKroNativeCode(output,ref pc,0x0824448948,5)||!KrtKroNativeByte(output,ref pc,232)){return false;}
        int32 call=module.global_reloc_count;module.global_reloc_offsets[call]=pc;module.global_reloc_slots[call]=-slot-1;module.global_reloc_count=call+1;
        if(!KrtKroNativeU32(output,ref pc,0)||!KrtKroNativeCode(output,ref pc,0x0824648b48,5)||
           !KrtKroNativeCode(output,ref pc,0x5a415b41,4)||!KrtKroNativeCode(output,ref pc,0x58415941,4)||
           !KrtKroNativeCode(output,ref pc,0x58595a5e5f,5)){return false;}
    }
    if(!KrtKroNativeCode(output,ref pc,0x058d48,3)){return false;}
    int32 index=module.global_reloc_count;module.global_reloc_offsets[index]=pc;module.global_reloc_slots[index]=slot;module.global_reloc_count=index+1;
    return KrtKroNativeU32(output,ref pc,0)&&KrtKroNativeByte(output,ref pc,80);
}

bool KrtKroNativeGlobalsStart(KrtKroObject output, ref int32 pc, int32 slots) {
    return slots>=0&&slots<=65536;
}

bool KrtKroNativeGuardEnter(KrtKroObject output,ref int32 pc){
    // The owner allows recursive reads in the initializing thread. Contending
    // threads wait until the release store publishes initialized storage.
    if(!KrtKroNativeByte(output,ref pc,95)||!KrtKroNativeCode(output,ref pc,0x023f8348,4)||!KrtKroNativeCode(output,ref pc,0x840f,2)){return false;}
    int32 cached=pc;
    if(!KrtKroNativeU32(output,ref pc,0)||!KrtKroNativeByte(output,ref pc,184)||!KrtKroNativeU32(output,ref pc,186)||
       !KrtKroNativeCode(output,ref pc,0x050f,2)||!KrtKroNativeCode(output,ref pc,0xc08949,3)){return false;}
    int32 loop=pc;
    if(!KrtKroNativeCode(output,ref pc,0xc031,2)||!KrtKroNativeByte(output,ref pc,186)||!KrtKroNativeU32(output,ref pc,1)||
       !KrtKroNativeCode(output,ref pc,0x17b10f48f0,5)||!KrtKroNativeCode(output,ref pc,0x840f,2)){return false;}
    int32 claimed=pc;if(!KrtKroNativeU32(output,ref pc,0)||!KrtKroNativeCode(output,ref pc,0x02f88348,4)||!KrtKroNativeCode(output,ref pc,0x840f,2)){return false;}
    int32 complete=pc;if(!KrtKroNativeU32(output,ref pc,0)||!KrtKroNativeCode(output,ref pc,0x0847394c,4)||!KrtKroNativeCode(output,ref pc,0x840f,2)){return false;}
    int32 recursive=pc;
    if(!KrtKroNativeU32(output,ref pc,0)||!KrtKroNativeCode(output,ref pc,0x90f3,2)||!KrtKroNativeByte(output,ref pc,233)||!KrtKroNativeU32(output,ref pc,loop-pc-4)){return false;}
    if(!KrtKroEmitTextU32(output,claimed,pc-claimed-4)||!KrtKroNativeCode(output,ref pc,0x0847894c,4)||
       !KrtKroNativeByte(output,ref pc,184)||!KrtKroNativeU32(output,ref pc,1)||!KrtKroNativeByte(output,ref pc,80)||!KrtKroNativeByte(output,ref pc,233)){return false;}
    int32 done=pc;if(!KrtKroNativeU32(output,ref pc,0)||!KrtKroEmitTextU32(output,cached,pc-cached-4)||!KrtKroEmitTextU32(output,complete,pc-complete-4)||!KrtKroEmitTextU32(output,recursive,pc-recursive-4)||
       !KrtKroNativeCode(output,ref pc,0xc031,2)||!KrtKroNativeByte(output,ref pc,80)){return false;}
    return KrtKroEmitTextU32(output,done,pc-done-4);
}

bool KrtKroNativeGuardFinish(KrtKroObject output,ref int32 pc,int32 success){
    return (success==0||success==1)&&KrtKroNativeByte(output,ref pc,95)&&
        KrtKroNativeCode(output,ref pc,0x0847c748,4)&&KrtKroNativeU32(output,ref pc,0)&&
        KrtKroNativeCode(output,ref pc,0x07c748,3)&&KrtKroNativeU32(output,ref pc,success==1?2:0);
}

bool KrtKroNativeIndirectCall(KrtKroObject output, ref int32 pc, int32 arity, int32 scratch) {
    if (arity < 0 || arity > 129) { return false; }
    int32 argument = arity - 1;
    while (argument >= 6) {
        if (!KrtKroNativeByte(output, ref pc, 88) || !KrtKroNativeFrameStore(output, ref pc, scratch + argument - 6)) { return false; }
        argument = argument - 1;
    }
    while (argument >= 0) {
        if (!KrtKroNativeByte(output, ref pc, 88) || !KrtKroNativeMoveArg(output, ref pc, argument)) { return false; }
        argument = argument - 1;
    }
    if (!KrtKroNativeByte(output, ref pc, 88) || !KrtKroNativeFrameStore(output, ref pc, scratch + 124) ||
        !KrtKroNativeCode(output, ref pc, 0xe08948, 3) || !KrtKroNativeFrameStore(output, ref pc, scratch + 123) ||
        !KrtKroNativeCode(output, ref pc, 0xf0e48348, 4)) { return false; }
    int32 stacked = arity > 6 ? arity - 6 : 0;
    if ((stacked & 1) != 0 && !KrtKroNativeCode(output, ref pc, 0x08ec8348, 4)) { return false; }
    argument = stacked - 1;
    while (argument >= 0) {
        if (!KrtKroNativeFrameLoad(output, ref pc, scratch + argument)) { return false; }
        argument = argument - 1;
    }
    // Raw code addresses remain unchanged. A negative callable tags a heap
    // descriptor containing the code address and its shared environment.
    // r10 carries the environment without shifting any source or sret argument.
    if (!KrtKroNativeCode(output, ref pc, 0x858b48, 3) || !KrtKroNativeU32(output, ref pc, -8 * (scratch + 125)) ||
        !KrtKroNativeCode(output, ref pc, 0xc08548, 3) || !KrtKroNativeCode(output, ref pc, 0x850f, 2)) { return false; }
    int32 nonnull = pc;
    if (!KrtKroNativeU32(output, ref pc, 0) ||
        !KrtKroNativeByte(output, ref pc, 191) || !KrtKroNativeU32(output, ref pc, 127) ||
        !KrtKroNativeByte(output, ref pc, 184) || !KrtKroNativeU32(output, ref pc, 60) ||
        !KrtKroNativeCode(output, ref pc, 0x0b0f050f, 4) ||
        !KrtKroEmitTextU32(output, nonnull, pc - nonnull - 4) ||
        !KrtKroNativeCode(output, ref pc, 0xd23145, 3) ||
        !KrtKroNativeCode(output, ref pc, 0xc08548, 3) || !KrtKroNativeCode(output, ref pc, 0x890f, 2)) { return false; }
    int32 raw = pc;
    if (!KrtKroNativeU32(output, ref pc, 0) ||
        !KrtKroNativeCode(output, ref pc, 0x3ff0ba0f48, 5) ||
        !KrtKroNativeCode(output, ref pc, 0x08508b4c, 4) ||
        !KrtKroNativeCode(output, ref pc, 0x008b48, 3) ||
        !KrtKroEmitTextU32(output, raw, pc - raw - 4) ||
        !KrtKroNativeCode(output, ref pc, 0xd0ff, 2) ||
        !KrtKroNativeCode(output, ref pc, 0xa58b48, 3) || !KrtKroNativeU32(output, ref pc, -8 * (scratch + 124))) { return false; }
    return KrtKroNativeByte(output, ref pc, 80);
}

bool KrtKroNativeClosureEnvironment(KrtKroObject output, ref int32 pc) {
    return KrtKroNativeCode(output, ref pc, 0x5241, 2);
}

// Global symbol emission.
// Every mutable declaration has an exact stable data identity. IR retains VM
// slots; native references use relocations and survive independent compilation.
bool KrtKroGlobalSymbols(KrtNativeModule module,KrtAstNode ast,int64 source,KrtKroObject output){
    if(module.global_count==0){return module.global_reloc_count==0;}
    KrtNativeGlobalEntry entry=ast.native_globals.first;int32 count=0;int64 names=0;
    while(entry!=null){
        if(!entry.declaration.native_readonly){
            count=count+(entry.module_guard?1:3);names=names+entry.symbol_name.length+1;
            if(!entry.module_guard){names=names+entry.guard_name.length+entry.initializer_name.length+2;}
        }
        entry=entry.next;
    }
    if(count>1048576-output.symbol_count||names>67108864-output.strtab_size||module.global_count>65536){return false;}
    int32 old_symbols=output.symbol_count;int32 old_names=output.strtab_size;
    byte[] symbols=new byte[(old_symbols+count)*32+1];byte[] strings=new byte[old_names+(int32)names+1];int32 index=0;
    while(index<old_symbols*32){symbols[index]=output.symbol_bytes[index];index=index+1;}
    index=0;while(index<old_names){strings[index]=output.string_bytes[index];index=index+1;}
    delete output.symbol_bytes;delete output.string_bytes;output.symbol_bytes=symbols;output.string_bytes=strings;
    // Slot offsets also provide naturally aligned storage for wide values and
    // inline structures. Imported entries occupy no defined symbol in it.
    byte[] data=new byte[module.global_count*8];delete output.data_bytes;output.data_bytes=data;output.data_size=module.global_count*8;
    int32[] slot_symbols=new int32[module.global_count];int32[] initializer_symbols=new int32[module.global_count];index=0;
    while(index<module.global_count){slot_symbols[index]=-1;initializer_symbols[index]=-1;index=index+1;}
    int32 initializer_offset=-1;int32 initializer_size=0;
    if(module.initializer_index>=0){
        if(module.initializer_index>=module.function_count||module.function_offsets==null||module.function_sizes==null){return false;}
        initializer_offset=module.function_offsets[module.initializer_index];initializer_size=module.function_sizes[module.initializer_index];
    }
    int32 position=old_names;entry=ast.native_globals.first;
    while(entry!=null){
        if(!entry.declaration.native_readonly){
            bool defined=!entry.imported||entry.weak;int32 binding=entry.module_guard?0:(defined&&entry.weak?2:1);int32 section=defined?3:0;
            int32 slot=entry.declaration.native_global-1;int32 offset=defined?slot*8:0;
            int32 symbol=KrtKroRuntimeAddSymbol(output,entry.symbol_name,offset,defined?entry.storage_size:0,section,binding,ref position);
            if(symbol<0){return false;}KrtKroLibraryWord(output.symbol_bytes,symbol*32+20,2);slot_symbols[slot]=symbol;
            if(!entry.module_guard){
                symbol=KrtKroRuntimeAddSymbol(output,entry.guard_name,defined?entry.guard_slot*8:0,defined?16:0,section,binding,ref position);
                if(symbol<0){return false;}KrtKroLibraryWord(output.symbol_bytes,symbol*32+20,2);slot_symbols[entry.guard_slot]=symbol;
                if(defined&&entry.static_data){
                    int32 part=0;
                    while(part<entry.storage_size){
                        data[offset+part]=(byte)(((part<8?entry.static_low:entry.static_high)>>((part%8)*8))&255);part=part+1;
                    }
                    KrtKroLibraryWord(data,entry.guard_slot*8,2);
                }
                if(defined&&initializer_offset<0){
                    initializer_offset=output.text_size;int32 pc=initializer_offset;
                    if(output.text_words==null&&!KrtKroBeginText(output,1)){return false;}
                    if(!KrtKroNativeCode(output,ref pc,0xc3c031,3)){return false;}initializer_size=3;
                }
                symbol=KrtKroRuntimeAddSymbol(output,entry.initializer_name,defined?initializer_offset:0,defined?initializer_size:0,defined?1:0,binding,ref position);
                if(symbol<0){return false;}KrtKroLibraryWord(output.symbol_bytes,symbol*32+20,1);initializer_symbols[slot]=symbol;
            }
        }
        entry=entry.next;
    }
    output.strtab_size=position;int32 old_relocs=output.text_reloc_count;
    if(module.global_reloc_count>4194304-old_relocs){return false;}
    byte[] relocations=new byte[(old_relocs+module.global_reloc_count)*16+1];index=0;
    while(index<old_relocs*16){relocations[index]=output.text_relocation_bytes[index];index=index+1;}
    delete output.text_relocation_bytes;output.text_relocation_bytes=relocations;index=0;
    while(index<module.global_reloc_count){
        int32 slot=module.global_reloc_slots[index];bool initializer=slot<0;if(initializer){slot=-slot-1;}
        if(slot<0||slot>=module.global_count||(initializer?initializer_symbols[slot]:slot_symbols[slot])<0){return false;}
        int32 record=(old_relocs+index)*16;KrtKroLibraryWord(relocations,record,module.global_reloc_offsets[index]);
        KrtKroLibraryWord(relocations,record+4,initializer?initializer_symbols[slot]:slot_symbols[slot]);KrtKroLibraryWord(relocations,record+8,3);KrtKroLibraryWord(relocations,record+12,0);index=index+1;
    }
