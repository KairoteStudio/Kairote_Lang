bool KrtKroNativeGlobalAddress(KrtNativeModule module,KrtKroObject output,ref int32 pc,int32 slot) {
    if(slot<0||slot>=module.global_count||module.global_entries==null||module.global_entries[slot]==null||module.global_reloc_count>=module.count*2){return false;}
    if(module.global_reloc_offsets==null){module.global_reloc_offsets=new int32[module.count*2];module.global_reloc_slots=new int32[module.count*2];}
    KrtNativeGlobalEntry entry=module.global_entries[slot];
    if(!entry.module_guard&&slot==entry.declaration.native_global-1&&(entry.declaration.syntax_modifiers&1024)!=0){
        // An explicit extern field carries no initializer syntax. Its defining
        // module supplies a stable initialization alias. Preserve every volatile
        // register, the callable environment and the live expression stack;
        // the alias can call arbitrary code or unwind through the current frame.
        if(!KrtKroNativeCode(output,ref pc,0x5756525150,5)){return false;}
        if(!KrtKroNativeCode(output,ref pc,0x51415041,4)||!KrtKroNativeCode(output,ref pc,0x53415241,4)||
           !KrtKroNativeCode(output,ref pc,0xe08948,3)||!KrtKroNativeCode(output,ref pc,0xf0e48348,4)||
           !KrtKroNativeCode(output,ref pc,0x10ec8348,4)||!KrtKroNativeCode(output,ref pc,0x0824448948,5)||!KrtKroNativeByte(output,ref pc,232)){return false;}
        int32 call=module.global_reloc_count;module.global_reloc_offsets[call]=pc;module.global_reloc_slots[call]=-slot-1;module.global_reloc_count=call+1;
        if(!KrtKroNativeU32(output,ref pc,0)||!KrtKroNativeCode(output,ref pc,0x0824648b48,5)||
           !KrtKroNativeCode(output,ref pc,0x5a415b41,4)||!KrtKroNativeCode(output,ref pc,0x58415941,4)||
           !KrtKroNativeCode(output,ref pc,0x58595a5e5f,5)){return false;}
    }
    if(!KrtKroNativeCode(output,ref pc,0x058d48,3)){return false;}
    int32 index=module.global_reloc_count;module.global_reloc_offsets[index]=pc;module.global_reloc_slots[index]=slot;module.global_reloc_count=index+1;
    return KrtKroNativeU32(output,ref pc,0)&&KrtKroNativeByte(output,ref pc,80);
}

bool KrtKroNativeGlobalsStart(KrtKroObject output, ref int32 pc, int32 slots) {
    return slots>=0&&slots<=65536;
}

bool KrtKroNativeGuardEnter(KrtKroObject output,ref int32 pc){
    // The owner allows recursive reads in the initializing thread. Contending
    // threads wait until the release store publishes initialized storage.
    if(!KrtKroNativeByte(output,ref pc,95)||!KrtKroNativeCode(output,ref pc,0x023f8348,4)||!KrtKroNativeCode(output,ref pc,0x840f,2)){return false;}
    int32 cached=pc;
    if(!KrtKroNativeU32(output,ref pc,0)||!KrtKroNativeByte(output,ref pc,184)||!KrtKroNativeU32(output,ref pc,186)||
       !KrtKroNativeCode(output,ref pc,0x050f,2)||!KrtKroNativeCode(output,ref pc,0xc08949,3)){return false;}
    int32 loop=pc;
    if(!KrtKroNativeCode(output,ref pc,0xc031,2)||!KrtKroNativeByte(output,ref pc,186)||!KrtKroNativeU32(output,ref pc,1)||
       !KrtKroNativeCode(output,ref pc,0x17b10f48f0,5)||!KrtKroNativeCode(output,ref pc,0x840f,2)){return false;}
    int32 claimed=pc;if(!KrtKroNativeU32(output,ref pc,0)||!KrtKroNativeCode(output,ref pc,0x02f88348,4)||!KrtKroNativeCode(output,ref pc,0x840f,2)){return false;}
    int32 complete=pc;if(!KrtKroNativeU32(output,ref pc,0)||!KrtKroNativeCode(output,ref pc,0x0847394c,4)||!KrtKroNativeCode(output,ref pc,0x840f,2)){return false;}
    int32 recursive=pc;
    if(!KrtKroNativeU32(output,ref pc,0)||!KrtKroNativeCode(output,ref pc,0x90f3,2)||!KrtKroNativeByte(output,ref pc,233)||!KrtKroNativeU32(output,ref pc,loop-pc-4)){return false;}
    if(!KrtKroEmitTextU32(output,claimed,pc-claimed-4)||!KrtKroNativeCode(output,ref pc,0x0847894c,4)||
       !KrtKroNativeByte(output,ref pc,184)||!KrtKroNativeU32(output,ref pc,1)||!KrtKroNativeByte(output,ref pc,80)||!KrtKroNativeByte(output,ref pc,233)){return false;}
    int32 done=pc;if(!KrtKroNativeU32(output,ref pc,0)||!KrtKroEmitTextU32(output,cached,pc-cached-4)||!KrtKroEmitTextU32(output,complete,pc-complete-4)||!KrtKroEmitTextU32(output,recursive,pc-recursive-4)||
       !KrtKroNativeCode(output,ref pc,0xc031,2)||!KrtKroNativeByte(output,ref pc,80)){return false;}
    return KrtKroEmitTextU32(output,done,pc-done-4);
}

bool KrtKroNativeGuardFinish(KrtKroObject output,ref int32 pc,int32 success){
    return (success==0||success==1)&&KrtKroNativeByte(output,ref pc,95)&&
        KrtKroNativeCode(output,ref pc,0x0847c748,4)&&KrtKroNativeU32(output,ref pc,0)&&
        KrtKroNativeCode(output,ref pc,0x07c748,3)&&KrtKroNativeU32(output,ref pc,success==1?2:0);
}

bool KrtKroNativeIndirectCall(KrtKroObject output, ref int32 pc, int32 arity, int32 scratch) {
    if (arity < 0 || arity > 129) { return false; }
    int32 argument = arity - 1;
    while (argument >= 6) {
        if (!KrtKroNativeByte(output, ref pc, 88) || !KrtKroNativeFrameStore(output, ref pc, scratch + argument - 6)) { return false; }
        argument = argument - 1;
    }
    while (argument >= 0) {
        if (!KrtKroNativeByte(output, ref pc, 88) || !KrtKroNativeMoveArg(output, ref pc, argument)) { return false; }
        argument = argument - 1;
    }
    if (!KrtKroNativeByte(output, ref pc, 88) || !KrtKroNativeFrameStore(output, ref pc, scratch + 124) ||
        !KrtKroNativeCode(output, ref pc, 0xe08948, 3) || !KrtKroNativeFrameStore(output, ref pc, scratch + 123) ||
        !KrtKroNativeCode(output, ref pc, 0xf0e48348, 4)) { return false; }
    int32 stacked = arity > 6 ? arity - 6 : 0;
    if ((stacked & 1) != 0 && !KrtKroNativeCode(output, ref pc, 0x08ec8348, 4)) { return false; }
    argument = stacked - 1;
    while (argument >= 0) {
        if (!KrtKroNativeFrameLoad(output, ref pc, scratch + argument)) { return false; }
        argument = argument - 1;
    }
    // Raw code addresses remain unchanged. A negative callable tags a heap
    // descriptor containing the code address and its shared environment.
    // r10 carries the environment without shifting any source or sret argument.
    if (!KrtKroNativeCode(output, ref pc, 0x858b48, 3) || !KrtKroNativeU32(output, ref pc, -8 * (scratch + 125)) ||
        !KrtKroNativeCode(output, ref pc, 0xc08548, 3) || !KrtKroNativeCode(output, ref pc, 0x850f, 2)) { return false; }
    int32 nonnull = pc;
    if (!KrtKroNativeU32(output, ref pc, 0) ||
        !KrtKroNativeByte(output, ref pc, 191) || !KrtKroNativeU32(output, ref pc, 127) ||
        !KrtKroNativeByte(output, ref pc, 184) || !KrtKroNativeU32(output, ref pc, 60) ||
        !KrtKroNativeCode(output, ref pc, 0x0b0f050f, 4) ||
        !KrtKroEmitTextU32(output, nonnull, pc - nonnull - 4) ||
        !KrtKroNativeCode(output, ref pc, 0xd23145, 3) ||
        !KrtKroNativeCode(output, ref pc, 0xc08548, 3) || !KrtKroNativeCode(output, ref pc, 0x890f, 2)) { return false; }
    int32 raw = pc;
    if (!KrtKroNativeU32(output, ref pc, 0) ||
        !KrtKroNativeCode(output, ref pc, 0x3ff0ba0f48, 5) ||
        !KrtKroNativeCode(output, ref pc, 0x08508b4c, 4) ||
        !KrtKroNativeCode(output, ref pc, 0x008b48, 3) ||
        !KrtKroEmitTextU32(output, raw, pc - raw - 4) ||
        !KrtKroNativeCode(output, ref pc, 0xd0ff, 2) ||
        !KrtKroNativeCode(output, ref pc, 0xa58b48, 3) || !KrtKroNativeU32(output, ref pc, -8 * (scratch + 124))) { return false; }
    return KrtKroNativeByte(output, ref pc, 80);
}

bool KrtKroNativeClosureEnvironment(KrtKroObject output, ref int32 pc) {
    return KrtKroNativeCode(output, ref pc, 0x5241, 2);
}
