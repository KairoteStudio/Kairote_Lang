        else if (op == 50) {
            KrtVmHandler handler = new KrtVmHandler(); handler.frame = frame; handler.slot = (int32)extra; handler.target = (int32)argument; handler.depth = state.depth;
            handler.previous = state.handler; state.handler = handler;
        }
        else if (op == 51) {
            if (state.handler == null || state.handler.frame != frame || state.handler.slot != argument) { state.failed = true; }
            else { KrtVmHandler removed = state.handler; state.handler = removed.previous; delete removed; }
        }
        else if (op == 52) {
            int64 type = KrtVmPop(state); int64 value = KrtVmPop(state); KrtVmHandler handler = state.handler;
            if (handler == null) { KrtDriverError("E_VM","uncaught VM exception"); KrtVmDispose(state); return 127; }
            while (state.frame != handler.frame) { KrtVmFrame expired = state.frame; state.frame = expired.previous; KrtVmLeave(state,expired); }
            state.handler = handler.previous; state.depth = handler.depth; state.frame.pc = handler.target;
            KrtVmWrite(state.frame.locals,((int64)handler.slot + 1) * 8,type,8); KrtVmWrite(state.frame.locals,((int64)handler.slot + 2) * 8,value,8);
            delete handler;
        }
        else if (op == 53 || op == 54) {
            int64 slot = argument + 1; if (op == 53) { slot = argument + 2; } KrtVmPush(state,KrtVmRead(frame.locals,slot * 8,8));
        }
        else if (op == 60) {
            int64 operand = KrtVmPop(state); int64 value = 0;
            if (argument == 2) { value = (int64)KrtVmWideValue(state,operand); }
            else if (argument == 5) { value = KrtVmWideBox(state,KrtVmWideValue(state,operand)); }
            else if (argument == 1) { value = KrtVmWideBox(state,(int128)(uint64)operand); }
            else { value = KrtVmWideBox(state,(int128)operand); }
            KrtVmPush(state,value);
        }
        else if (op == 61 || op == 62) {
            int64 right = KrtVmPop(state); int64 left = KrtVmPop(state); int64 value = 0;
            if (op == 61) { value = KrtVmWideBinary(state,left,right,(int32)argument,extra != 0); }
            else { value = KrtVmWideCompare(state,left,right,(int32)argument,extra != 0); }
            KrtVmPush(state,value);
        }
        else if (op == 63) {
            int64 operand = KrtVmPop(state); int128 wide = KrtVmWideValue(state,operand); int64 value = 0;
            if (argument == 33) { value = wide == 0 ? 1 : 0; }
            else if (argument == 45) { value = KrtVmWideBox(state,-wide); }
            else { value = KrtVmWideBox(state,~wide); }
            KrtVmPush(state,value);
        }
        else if (op == 66) {
            int64 pointer=state.wide_inline?KrtVmWideBox(state,0):KrtVmAllocate(state,16,0,false);
            if (pointer != 0) { KrtVmWrite(pointer,0,argument,8); KrtVmWrite(pointer,8,extra,8); }
            KrtVmPush(state,pointer);
        }
        else if (op == 67) {
            int64 address = KrtVmPop(state); int64 width = 8; if (extra != 0) { width = 16; }
            int64 old = KrtVmLoad(state,address,width); int128 wide = KrtVmWideValue(state,old);
            int64 updated = KrtVmWideBox(state,wide + (int128)argument); KrtVmStore(state,address,updated,width); KrtVmPush(state,old);
        }
        else if (op == 68) { int64 operand = KrtVmPop(state); KrtVmPush(state,KrtVmWideFloat(state,operand,(int32)argument,(int32)extra)); }
        else if (op == 69) {
            int64 address = KrtVmPop(state); int64 pointer = KrtVmLoad(state,address,8);
            if (pointer == 0 && !state.failed) { pointer = KrtVmWideBox(state,0); KrtVmStore(state,address,pointer,8); }
            KrtVmPush(state,pointer);
        }
        else if (op == 70) {
            if (argument < 0 || extra <= 0 || argument > frame.aggregate_size || extra > frame.aggregate_size - argument) { state.failed = true; }
            else { KrtVmPush(state,frame.aggregate_base + argument); }
        }
        else if (op == 71) {
            int64 source_address = KrtVmPop(state); int64 destination = KrtVmPop(state);
            if (KrtVmMemory(state,source_address,argument) && KrtVmWritable(state,destination,argument)) {
                unsafe(using krt.mem;) {
                    byte* target = (byte*)destination; byte* input = (byte*)source_address; int64 part = 0;
                    if (destination > source_address && destination - source_address < argument) {
                        part = argument; while (part > 0) { part = part - 1; target[part] = input[part]; }
                    } else { while (part < argument) { target[part] = input[part]; part = part + 1; } }
                }
            }
        }
        else if (op == 72) {
            int64 destination = KrtVmPop(state);
            if (KrtVmWritable(state,destination,argument)) {
                unsafe(using krt.mem;) { byte* target = (byte*)destination; int64 part = 0;
                    while (part < argument) { target[part] = 0; part = part + 1; }
                }
            }
        }
        else { state.failed = true; }
    }
    bool failed = state.failed; KrtVmDispose(state);
    if (failed) { KrtDriverError("E_VM","invalid VM operation, memory address or stack state"); return 1; }
    return (int32)result;
}

bool KrtVmReadArtifact(int64 path, KrtDriverBuffer artifact) {
    artifact.ok = false;
    int64 descriptor = syscall(2,path,0,0,0,0,0); if (descriptor < 0) { return false; }
    unsafe(using krt.mem;) {
        byte* information = stackalloc byte[144];
        if (syscall(5,descriptor,(int64)information,0,0,0,0) != 0 || (KrtVmRead((int64)information,24,4) & 61440) != 32768) { syscall(3,descriptor,0,0,0,0,0); return false; }
        int64 size = KrtVmRead((int64)information,48,8);
        if (size < 10 || size > 67108864) { syscall(3,descriptor,0,0,0,0,0); return false; }
        int64 data = KrtDriverAlloc(size); if (data == 0) { syscall(3,descriptor,0,0,0,0,0); return false; }
        int64 read = 0;
        while (read < size) {
            int64 count = syscall(0,descriptor,data + read,size - read,0,0,0);
            if (count == -4) { continue; } if (count <= 0) { syscall(3,descriptor,0,0,0,0,0); return false; } read = read + count;
        }
        byte extra = 0; int64 end = syscall(0,descriptor,(int64)&extra,1,0,0,0);
        while (end == -4) { end = syscall(0,descriptor,(int64)&extra,1,0,0,0); }
        syscall(3,descriptor,0,0,0,0,0); if (end != 0) { return false; }
        artifact.data = data; artifact.length = size; artifact.ok = true; return true;
    }
}

int32 KrtVmExecute(KrtNativeModule module) { return KrtVmExecuteVersion(module,6); }

int32 KrtVmRun(int64 path) {
    KrtDriverBuffer artifact = new KrtDriverBuffer();
    if (!KrtVmReadArtifact(path,artifact)) { KrtDriverError("E_VM","unable to read bytecode file (maximum 64 MiB)"); return 1; }
    if (artifact.length < 10 || KrtVmRead(artifact.data,0,4) != 0x45534243) { KrtDriverError("E_VM","invalid bytecode header"); return 1; }
    int64 version = KrtVmRead(artifact.data,4,2);
    if (version == 1) { return KrtVmRunV1(artifact); }
    KrtNativeModule module = new KrtNativeModule();
    if ((version < 2 || version > 6) || !KrtVmReadV2(artifact,module)) {
        if(module.runtime_pointer!=0){syscall(11,module.runtime_pointer,module.runtime_length,0,0,0,0);}
        KrtDriverError("E_VM","invalid or unsupported bytecode file"); return 1;
    }
    int32 result=KrtVmExecuteVersion(module,(int32)version);
    if(module.runtime_pointer!=0){syscall(11,module.runtime_pointer,module.runtime_length,0,0,0,0);module.runtime_pointer=0;}
    return result;
}

// Wide-integer bytecode values.
// EBC6 wide values use persistent inline storage for language values and a
// separate fixed scratch address for every producing instruction. Earlier
// bytecode retains its original immutable pointer-wide local ABI.
class KrtVmWideLayout {
    public int32[] offsets;
    public int32[] sizes;
}
int32 KrtVmWideScratchBytes(int32 op,int64 argument,int64 extra) {
    if(op==67){return 32;}
    if((op==22&&KrtVmStorage(extra)==16)||(op==60&&argument!=2)||op==61||
        (op==63&&argument!=33)||op==66||(op==68&&argument>=3)){return 16;}
    return 0;
}
KrtVmWideLayout KrtVmMakeWideLayout(KrtNativeModule module) {
    KrtVmWideLayout layout=new KrtVmWideLayout();
    layout.offsets=new int32[module.count];layout.sizes=new int32[module.function_count];
    int32 function_index=0;
    while(function_index<module.function_count){
        int32 first=module.starts[function_index];int32 last=module.count;
        if(function_index+1<module.function_count){last=module.starts[function_index+1];}
        int32 size=0;int32 index=first;
        while(index<last){
            int32 bytes=KrtVmWideScratchBytes(module.ops[index],module.args[index],module.extra[index]);
            layout.offsets[index]=-1;
            if(bytes>0){
                if(size>67108864-bytes){delete layout.offsets;delete layout.sizes;delete layout;return null;}
                layout.offsets[index]=size;size=size+bytes;
            }
            index=index+1;
        }
        layout.sizes[function_index]=size;function_index=function_index+1;
    }
    return layout;
}
int64 KrtVmWideBox(KrtVmState state, int128 value) {
    int64 pointer=0;
    if(state.wide_inline){
        KrtVmFrame frame=state.frame;
        if(frame==null||frame.wide_cursor<0||frame.wide_cursor>frame.wide_limit-16){state.failed=true;return 0;}
        pointer=frame.wide_base+frame.wide_cursor;frame.wide_cursor=frame.wide_cursor+16;
    }else{pointer=KrtVmAllocate(state,16,0,false);}
    if (pointer != 0) { unsafe(using krt.mem;) { *(int128*)pointer = value; } }
    return pointer;
}
int128 KrtVmWideValue(KrtVmState state, int64 pointer) {
    if (pointer == 0) { return 0; }
    if (!KrtVmMemory(state,pointer,16)) { return 0; }
    unsafe(using krt.mem;) { return *(int128*)pointer; }
}
int64 KrtVmWideBinary(KrtVmState state, int64 left, int64 right, int32 operation, bool unsigned_value) {
    int128 a = KrtVmWideValue(state,left); int128 b = KrtVmWideValue(state,right); int128 result = 0;
    if (operation == 43) { result = a + b; }
    else if (operation == 45) { result = a - b; }
    else if (operation == 42) { result = a * b; }
    else if (operation == 38) { result = a & b; }
    else if (operation == 124) { result = a | b; }
    else if (operation == 94) { result = a ^ b; }
    else if (operation == 106) { result = a << ((int64)b & 127); }
    else if (operation == 107) { if (unsigned_value) { result = (int128)((uint128)a >> ((int64)b & 127)); } else { result = a >> ((int64)b & 127); } }
    else if (operation == 47 || operation == 37) {
        if (b == 0) { state.failed = true; return 0; }
        if (unsigned_value) { if (operation == 47) { result = (int128)((uint128)a / (uint128)b); } else { result = (int128)((uint128)a % (uint128)b); } }
        else { if (operation == 47) { result = a / b; } else { result = a % b; } }
    }
    else { state.failed = true; return 0; }
    return KrtVmWideBox(state,result);
}
int64 KrtVmWideCompare(KrtVmState state, int64 left, int64 right, int32 operation, bool unsigned_value) {
    int128 a = KrtVmWideValue(state,left); int128 b = KrtVmWideValue(state,right); bool result = false;
    if (operation == 61) { result = a == b; } else if (operation == 101) { result = a != b; }
    else if (unsigned_value) {
        if (operation == 60) { result = (uint128)a < (uint128)b; } else if (operation == 62) { result = (uint128)a > (uint128)b; }
        else if (operation == 102) { result = (uint128)a <= (uint128)b; } else if (operation == 103) { result = (uint128)a >= (uint128)b; }
    }
    else {
        if (operation == 60) { result = a < b; } else if (operation == 62) { result = a > b; }
        else if (operation == 102) { result = a <= b; } else if (operation == 103) { result = a >= b; }
    }
    return result ? 1 : 0;
}
int64 KrtVmWideFloat(KrtVmState state, int64 operand, int32 mode, int32 width) {
    if (mode == 1 || mode == 2) {
        int128 value = KrtVmWideValue(state,operand); float64 number = 0.0;
        if (width == 4) {
            if (mode == 1) { number = (float64)(float32)value; } else { number = (float64)(float32)(uint128)value; }
        } else {
            if (mode == 1) { number = (float64)value; } else { number = (float64)(uint128)value; }
        }
        return KrtVmFloatBits(number,width);
    }
    float64 number = KrtVmFloatValue(operand,width); int128 value = 0;
    if (mode == 3) { value = (int128)number; } else { value = (int128)(uint128)number; }
    return KrtVmWideBox(state,value);
}

// ===== Legacy bytecode =====
// Reader for the seed's EBC v1. Seed files contain one main chunk and no
// function table; unresolved global/function opcodes are rejected explicitly.
class KrtVmLegacyValue { public int32 kind; public int64 value; }
class KrtVmLegacyState {
    public KrtVmLegacyValue[] stack;
    public KrtVmLegacyValue[] locals;
    public KrtVmLegacyValue[] constants;
    public int32 depth;
    public int32 constant_count;
    public bool failed;
}
KrtVmLegacyValue KrtVmLegacyMake(int32 kind, int64 value) {
    KrtVmLegacyValue item = new KrtVmLegacyValue(); item.kind = kind; item.value = value; return item;
}
KrtVmLegacyValue KrtVmLegacyNumber(float64 number) {
    unsafe(using krt.mem;) { return KrtVmLegacyMake(2,*(int64*)&number); }
}
float64 KrtVmLegacyDouble(KrtVmLegacyValue item) {
    int64 bits = item.value; unsafe(using krt.mem;) { return *(float64*)&bits; }
}
bool KrtVmLegacyTrue(KrtVmLegacyValue item) {
    if (item == null || item.kind == 1) { return false; }
    if (item.kind == 0) { return item.value != 0; }
    if (item.kind == 2) { return KrtVmLegacyDouble(item) != 0.0; }
    return true;
}
void KrtVmLegacyPush(KrtVmLegacyState state, KrtVmLegacyValue item) {
    if (state.depth >= 262144 || item == null) { state.failed = true; return; }
    state.stack[state.depth] = item; state.depth = state.depth + 1;
}
KrtVmLegacyValue KrtVmLegacyPop(KrtVmLegacyState state) {
    if (state.depth <= 0) { state.failed = true; return KrtVmLegacyMake(1,0); }
    state.depth = state.depth - 1; return state.stack[state.depth];
}

bool KrtVmLegacyRead(KrtDriverBuffer artifact, KrtVmLegacyState state, ref int32 count) {
    int64 size = KrtVmRead(artifact.data,6,4);
    if (size <= 0 || size > 262144 || 14 + size * 5 > artifact.length) { return false; }
    count = (int32)size; int64 position = 10 + size * 5; int64 constants = KrtVmRead(artifact.data,position,4); position = position + 4;
    if (constants > 65536) { return false; }
    state.constant_count = (int32)constants; state.constants = new KrtVmLegacyValue[(int32)constants];
    int32 index = 0;
    while (index < constants) {
        if (position + 4 > artifact.length) { return false; }
        int64 kind = KrtVmRead(artifact.data,position,4); position = position + 4; int64 value = 0;
        if (kind == 0) { if (position >= artifact.length) { return false; } value = KrtVmRead(artifact.data,position,1); position = position + 1; if (value > 1) { return false; } }
        else if (kind == 1) { }
        else if (kind == 2) { if (position + 8 > artifact.length) { return false; } value = KrtVmRead(artifact.data,position,8); position = position + 8; }
        else if (kind == 4) {
            if (position + 2 > artifact.length) { return false; }
            int64 length = KrtVmRead(artifact.data,position,2); position = position + 2;
            if (length > artifact.length - position) { return false; }
            value = KrtDriverCopyString(artifact.data + position,length); if (value == 0) { return false; } position = position + length;
        }
        else { return false; }
        state.constants[index] = KrtVmLegacyMake((int32)kind,value); index = index + 1;
    }
    if (position != artifact.length) { return false; }
    // Validate instructions before execution, including jump boundaries.
    bool[] boundary = new bool[count + 1]; int32 pc = 0;
    while (pc < count) {
        boundary[pc] = true; int32 op = (int32)KrtVmRead(artifact.data,10 + pc,1); int32 width = 1;
        if (op == 0 || op == 5 || op == 6 || op == 25) { width = 2; }
        else if (op >= 20 && op <= 22) { width = 3; }
        else if (op == 7 || op == 8 || op == 9 || op == 23 || op > 27) { return false; }
        if (pc + width > count) { return false; }
        if (op == 0 && KrtVmRead(artifact.data,11 + pc,1) >= constants) { return false; }
        pc = pc + width;
    }
    boundary[count] = true; pc = 0;
    while (pc < count) {
        int32 op = (int32)KrtVmRead(artifact.data,10 + pc,1); int32 width = 1;
        if (op == 0 || op == 5 || op == 6 || op == 25) { width = 2; }
        else if (op >= 20 && op <= 22) {
            width = 3; int32 offset = (int32)KrtVmRead(artifact.data,11 + pc,2); int32 target = pc + 3 + offset;
            if (op == 22) { target = pc + 3 - offset; }
            if (target < 0 || target >= count || !boundary[target]) { return false; }
        }
        pc = pc + width;
    }
    return true;
}

bool KrtVmLegacyPrint(KrtVmLegacyValue item) {
    if (item.kind == 0) { if (item.value != 0) { KrtDriverPrint("true"); } else { KrtDriverPrint("false"); } }
    else if (item.kind == 1) { KrtDriverPrint("null"); }
    else if (item.kind == 4) { KrtDriverPrint((string)item.value); }
    else if (item.kind == 2) {
        int64 text = KrtVmNumberText(item.value); if (text == 0) { return false; } KrtDriverPrint((string)text);
    }
    else { return false; }
    KrtDriverPrint("\n"); return true;
}

int32 KrtVmRunV1(KrtDriverBuffer artifact) {
    KrtVmLegacyState state = new KrtVmLegacyState(); int32 count = 0;
    if (!KrtVmLegacyRead(artifact,state,ref count)) { KrtDriverError("E_VM","invalid or unsupported version 1 bytecode"); return 1; }
    state.stack = new KrtVmLegacyValue[262144]; state.locals = new KrtVmLegacyValue[256]; int32 index = 0;
    while (index < 256) { state.locals[index] = KrtVmLegacyMake(1,0); index = index + 1; }
    int32 pc = 0;
    while (pc >= 0 && pc < count && !state.failed) {
        int32 op = (int32)KrtVmRead(artifact.data,10 + pc,1); pc = pc + 1;
        if (op == 0) { int32 slot = (int32)KrtVmRead(artifact.data,10 + pc,1); pc = pc + 1; KrtVmLegacyPush(state,state.constants[slot]); }
        else if (op == 1 || op == 2 || op == 3) { int64 value = 0; if (op == 2) { value = 1; } KrtVmLegacyPush(state,KrtVmLegacyMake(op == 1 ? 1 : 0,value)); }
        else if (op == 4) { KrtVmLegacyPop(state); }
        else if (op == 5 || op == 6) {
            int32 slot = (int32)KrtVmRead(artifact.data,10 + pc,1); pc = pc + 1;
            if (op == 5) { KrtVmLegacyPush(state,state.locals[slot]); }
            else if (state.depth <= 0) { state.failed = true; }
            else { state.locals[slot] = state.stack[state.depth - 1]; }
        }
        else if (op >= 10 && op <= 16) {
            KrtVmLegacyValue right = KrtVmLegacyPop(state); KrtVmLegacyValue left = KrtVmLegacyPop(state);
            if (op == 10) {
                bool equal = false;
                if (left.kind == right.kind) {
                    if (left.kind == 2) { equal = KrtVmLegacyDouble(left) == KrtVmLegacyDouble(right); }
                    else if (left.kind == 4) { equal = KrtDriverStringEqual(left.value,right.value); }
                    else { equal = left.value == right.value; }
                }
                KrtVmLegacyPush(state,KrtVmLegacyMake(0,equal ? 1 : 0));
            }
            else if (left.kind != 2 || right.kind != 2) { state.failed = true; }
            else {
                float64 a = KrtVmLegacyDouble(left); float64 b = KrtVmLegacyDouble(right);
                if (op == 11 || op == 12) { bool relation = false; if (op == 11) { relation = a > b; } else { relation = a < b; } KrtVmLegacyPush(state,KrtVmLegacyMake(0,relation ? 1 : 0)); }
                else { float64 number = 0.0; if (op == 13) { number = a + b; } else if (op == 14) { number = a - b; } else if (op == 15) { number = a * b; } else { number = a / b; }
                    KrtVmLegacyPush(state,KrtVmLegacyNumber(number));
                }
            }
        }
        else if (op == 17) { KrtVmLegacyValue item = KrtVmLegacyPop(state); bool truth = KrtVmLegacyTrue(item); KrtVmLegacyPush(state,KrtVmLegacyMake(0,truth ? 0 : 1)); }
        else if (op == 18) { KrtVmLegacyValue item = KrtVmLegacyPop(state); if (item.kind != 2) { state.failed = true; } else { KrtVmLegacyPush(state,KrtVmLegacyNumber(-KrtVmLegacyDouble(item))); } }
        else if (op == 19) { if (!KrtVmLegacyPrint(KrtVmLegacyPop(state))) { state.failed = true; } }
        else if (op >= 20 && op <= 22) {
            int32 offset = (int32)KrtVmRead(artifact.data,10 + pc,2); pc = pc + 2;
            if (op == 20) { pc = pc + offset; }
            else if (op == 22) { pc = pc - offset; }
            else if (state.depth <= 0) { state.failed = true; }
            else if (!KrtVmLegacyTrue(state.stack[state.depth - 1])) { pc = pc + offset; }
        }
        else if (op == 24 || op == 27) {
            if (op == 27) { return 0; }
            KrtVmLegacyValue item = KrtVmLegacyPop(state);
            if (state.failed) { break; }
            if (item.kind == 2) { return (int32)KrtVmLegacyDouble(item); }
            if (item.kind == 0) { return (int32)item.value; }
            if (item.kind == 1) { return 0; } state.failed = true;
        }
        else if (op == 25) { pc = pc + 1; }
        else if (op == 26) {
            KrtVmLegacyValue item = KrtVmLegacyPop(state);
            if (item.kind != 2) { state.failed = true; }
            else { KrtVmLegacyPush(state,KrtVmLegacyMake(4,KrtDriverNumber((int64)KrtVmLegacyDouble(item)))); }
        }
        else { state.failed = true; }
    }
    KrtDriverError("E_VM","invalid version 1 VM stack, value or execution state"); return 1;
}

// ===== Runtime type validation =====
// EBC5 carries address-free runtime records. Validate their complete structure
// before replacing relocations with VM addresses or callable indices.
class KrtVmRuntimeSchema {
    public KrtNativeModule module;
    public int64 data;
    public int32 length;
    public byte[] occupied;
    public int32[] kinds;
    public int32[] targets;
    public int32[] bases;
    public int32 consumed;
}

bool KrtVmRuntimeRange(KrtVmRuntimeSchema schema,int64 start,int64 length,int32 alignment) {
    return start >= 0 && length >= 0 && start <= schema.length && length <= schema.length-start &&
        (start & (alignment-1)) == 0;
}
bool KrtVmRuntimeClaim(KrtVmRuntimeSchema schema,int64 start,int64 length,int32 alignment,byte role) {
    if (!KrtVmRuntimeRange(schema,start,length,alignment)) { return false; }
    int32 index=(int32)start; int32 end=(int32)(start+length);
    // Interned canonical keys may share precisely the same immutable range.
    // Separate first-byte markers prohibit partial or differently sized aliases.
    if(role==2&&length>0&&schema.occupied[index]==5){
