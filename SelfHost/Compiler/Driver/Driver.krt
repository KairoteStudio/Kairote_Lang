// ===== Object ABI validation =====
// Native pre-link ABI2/ABI3 validation. KRO payloads remain normal linker inputs;
// their exact contracts are checked before any executable is published.
class KrtDriverAbiRecord {
    public int64 path;
    public int64 nominal;
    public int64 nominal_length;
    public int64 contract;
    public int64 contract_length;
    public int64 name;
    public bool defined;
    public int32 kind;
    public bool weak;
    public uint64 hash;
    public int64 definition_path;
    public KrtDriverAbiRecord hash_next;
    public KrtDriverAbiRecord next;
}
class KrtDriverAbiMapping {
    public int64 data;
    public int64 length;
    public KrtDriverAbiMapping next;
}
class KrtDriverAbiState {
    public KrtDriverAbiRecord records;
    public KrtDriverAbiRecord tail;
    public KrtDriverAbiRecord[] buckets;
    public int32 capacity;
    public int32 count;
    public KrtDriverAbiMapping mappings;
}
int64 KrtDriverAbiWord(int64 data,int64 offset){unsafe(using krt.mem;){byte* bytes=(byte*)data;return(int64)bytes[offset]|((int64)bytes[offset+1]<<8)|((int64)bytes[offset+2]<<16)|((int64)bytes[offset+3]<<24);}}
bool KrtDriverAbiRange(int64 offset,int64 size,int64 length){return offset>=0&&size>=0&&offset<=length&&size<=length-offset;}
bool KrtDriverAbiEqual(int64 left,int64 left_length,int64 right,int64 right_length){if(left_length!=right_length){return false;}unsafe(using krt.mem;){byte* first=(byte*)left;byte* second=(byte*)right;int64 index=0;while(index<left_length){if(first[index]!=second[index]){return false;}index=index+1;}}return true;}
uint64 KrtDriverAbiHash(int64 data,int64 length){uint64 hash=14695981039346656037;unsafe(using krt.mem;){byte* bytes=(byte*)data;int64 index=0;while(index<length){hash=(hash^(uint64)bytes[index])*1099511628211;index=index+1;}}return hash;}
bool KrtDriverAbiFailure(string code,int64 path,string message){KrtDriverError(code,(string)KrtDriverConcat(KrtDriverConcat(path,(int64)": "),(int64)message));return false;}
int64 KrtDriverAbiSymbolName(KrtDriverBuffer object,int64 symbols,int64 strings,int64 string_length,int64 index){
    int64 offset=KrtDriverAbiWord(object.data,symbols+index*32);if(offset>=string_length){return 0;}
    unsafe(using krt.mem;){byte* bytes=(byte*)(object.data+strings);int64 length=0;while(length<string_length-offset&&bytes[offset+length]!=0){length=length+1;}if(length==string_length-offset){return 0;}return object.data+strings+offset;}
}
// Objects use a checked mapping, independently of the source-reader budget.
bool KrtDriverAbiReadBinary(int64 path,KrtDriverBuffer buffer){
    int64 descriptor=syscall(2,path,0,0,0,0,0);if(descriptor<0){return false;}
    int64 length=syscall(8,descriptor,0,2,0,0,0);
    if(length<=0||length>1073741824){syscall(3,descriptor,0,0,0,0,0);return false;}
    int64 data=syscall(9,0,length,1,2,descriptor,0);syscall(3,descriptor,0,0,0,0,0);
    if(data<0&&data>=-4095){return false;}buffer.data=data;buffer.length=length;buffer.ok=true;return true;
}
bool KrtDriverAbiInsert(KrtDriverAbiState state,KrtDriverAbiRecord record){
    if(state.capacity==0){state.capacity=256;state.buckets=new KrtDriverAbiRecord[256];}
    if(state.count>=state.capacity*3/4&&state.capacity<1048576){
        state.capacity=state.capacity*2;KrtDriverAbiRecord[] buckets=new KrtDriverAbiRecord[state.capacity];
        KrtDriverAbiRecord existing=state.records;
        while(existing!=null){int32 slot=(int32)(existing.hash&(uint64)(state.capacity-1));existing.hash_next=buckets[slot];buckets[slot]=existing;existing=existing.next;}
        delete state.buckets;state.buckets=buckets;
    }
    record.hash=KrtDriverAbiHash(record.nominal,record.nominal_length);
    int32 slot=(int32)(record.hash&(uint64)(state.capacity-1));KrtDriverAbiRecord existing=state.buckets[slot];
    while(existing!=null){
        if(record.hash==existing.hash&&KrtDriverAbiEqual(record.nominal,record.nominal_length,existing.nominal,existing.nominal_length)){
            if(!KrtDriverAbiEqual(record.contract,record.contract_length,existing.contract,existing.contract_length)){
                return KrtDriverAbiFailure("E_ABI_LAYOUT",record.path,(string)KrtDriverConcat((int64)"contract conflicts with ",existing.path));
            }
            if(record.kind!=existing.kind){return KrtDriverAbiFailure("E_ABI_MANIFEST",record.path,"ABI record kinds disagree");}
            if(record.kind!=2&&record.defined&&existing.defined&&!record.weak&&!existing.weak){return KrtDriverAbiFailure("E_ABI_SYMBOL",record.path,(string)KrtDriverConcat((int64)"duplicate public native definition in ",existing.definition_path));}
            if(record.defined&&(!existing.defined||existing.weak)){existing.defined=true;existing.weak=record.weak;existing.definition_path=record.path;}delete record;return true;
        }
        existing=existing.hash_next;
    }
    if(state.count>=1048576){return KrtDriverAbiFailure("E_ABI_MANIFEST",record.path,"ABI contract index exceeds 1048576 entries");}
    if(record.defined){record.definition_path=record.path;}
    record.hash_next=state.buckets[slot];state.buckets[slot]=record;state.count=state.count+1;
    if(state.records==null){state.records=record;}else{state.tail.next=record;}state.tail=record;return true;
}
bool KrtDriverAbiReadManifest(int64 path,KrtDriverAbiState state,KrtDriverBuffer object,int64 symbols,int64 strings,int64 string_length,int64 count,int64 text,int64 manifest,int64 manifest_size,int32 version,bool types,bool[] required,bool[] recorded){
    if(manifest_size<16||KrtDriverAbiWord(object.data,manifest)!=0x32494241){return KrtDriverAbiFailure("E_ABI_MANIFEST",path,"invalid ABI manifest header");}
    if(KrtDriverAbiWord(object.data,manifest+4)!=version){return KrtDriverAbiFailure("E_ABI_VERSION",path,"unsupported ABI manifest version");}
    int64 records=KrtDriverAbiWord(object.data,manifest+8);int64 length=KrtDriverAbiWord(object.data,manifest+12);
    if(length!=manifest_size||records>(types?1048576:count)){return KrtDriverAbiFailure("E_ABI_MANIFEST",path,"invalid ABI manifest record count or length");}
    int64 position=16;int64 record_index=0;
    while(record_index<records){
        if(!KrtDriverAbiRange(position,16,length)){return KrtDriverAbiFailure("E_ABI_MANIFEST",path,"truncated ABI record header");}
        int64 symbol=KrtDriverAbiWord(object.data,manifest+position);int64 defined=KrtDriverAbiWord(object.data,manifest+position+4);
        int64 nominal_length=KrtDriverAbiWord(object.data,manifest+position+8);int64 contract_length=KrtDriverAbiWord(object.data,manifest+position+12);position=position+16;
        if(types){
            if(symbol!=4294967295||defined!=2||nominal_length<18||contract_length<nominal_length+12||!KrtDriverAbiRange(position,nominal_length+contract_length,length)){
                return KrtDriverAbiFailure("E_ABI_MANIFEST",path,"invalid type contract record");
            }
            KrtDriverAbiRecord record=new KrtDriverAbiRecord();record.path=path;record.defined=true;record.kind=2;
            record.nominal=object.data+manifest+position;record.nominal_length=nominal_length;record.contract=record.nominal+nominal_length;record.contract_length=contract_length;
            if(!KrtDriverAbiEqual(record.nominal,6,(int64)"_KRTT$",6)||!KrtDriverAbiEqual(record.contract,8,(int64)"KRTTYPE3",8)||
               !KrtDriverAbiEqual(record.contract+8,nominal_length,record.nominal,nominal_length)){
                return KrtDriverAbiFailure("E_ABI_MANIFEST",path,"invalid canonical type identity");
            }
            if(!KrtDriverAbiInsert(state,record)){return false;}
            position=position+nominal_length+contract_length;record_index=record_index+1;continue;
        }
        if(symbol>=count||(defined!=0&&defined!=1&&(defined!=5||version!=3))||!required[(int32)symbol]||recorded[(int32)symbol]||nominal_length<6||contract_length<nominal_length+18||
           !KrtDriverAbiRange(position,nominal_length+contract_length,length)){
            return KrtDriverAbiFailure("E_ABI_MANIFEST",path,"invalid or duplicate ABI record");
        }
        int64 section=KrtDriverAbiWord(object.data,symbols+symbol*32+12);int64 binding=KrtDriverAbiWord(object.data,symbols+symbol*32+16);
        int64 value=KrtDriverAbiWord(object.data,symbols+symbol*32+4);int64 size=KrtDriverAbiWord(object.data,symbols+symbol*32+8);
        int64 symbol_type=KrtDriverAbiWord(object.data,symbols+symbol*32+20);
        if(symbol_type!=1||((defined==1||defined==5)&&(section!=1||binding!=(defined==5?2:1)||!KrtDriverAbiRange(value,size,text)))||
           (defined==0&&(section!=0||binding!=1||value!=0||size!=0))){
            return KrtDriverAbiFailure("E_ABI_MANIFEST",path,"ABI record disagrees with symbol definition");
        }
        KrtDriverAbiRecord record=new KrtDriverAbiRecord();record.path=path;record.defined=defined==1||defined==5;record.weak=defined==5;
        record.nominal=object.data+manifest+position;record.nominal_length=nominal_length;record.contract=record.nominal+nominal_length;record.contract_length=contract_length;
        record.name=KrtDriverAbiSymbolName(object,symbols,strings,string_length,symbol);
        bool named=KrtDriverStartsWith(record.name,"_KRT3$");
        if((named&&version!=3)||!KrtDriverAbiEqual(record.nominal,6,(int64)"_KRT1$",6)||!KrtDriverAbiEqual(record.contract,7,(int64)(named?"KRTABI3":"KRTABI2"),7)||
           !KrtDriverAbiEqual(record.contract+7,nominal_length,record.nominal,nominal_length)){
            return KrtDriverAbiFailure("E_ABI_MANIFEST",path,"invalid canonical contract identity");
        }
        KrtLinkName expected=KrtLinkNameNew();KrtLinkText(expected,named?"_KRT3$":"_KRT2$");
        unsafe(using krt.mem;){byte* nominal=(byte*)record.nominal;int64 character=6;while(character<nominal_length){if(nominal[character]==0){expected.valid=false;break;}KrtLinkByte(expected,nominal[character]);character=character+1;}}
        KrtLinkText(expected,"$H");KrtAbiHex(expected,KrtDriverAbiHash(record.contract,contract_length));
        if(!expected.valid||KrtDriverStringLength(record.name)!=expected.length){return KrtDriverAbiFailure("E_ABI_MANIFEST",path,"invalid ABI symbol name");}
        unsafe(using krt.mem;){byte* actual=(byte*)record.name;int32 character=0;
            while(character<expected.length&&actual[character]==expected.bytes[character]){character=character+1;}
            if(character!=expected.length||actual[character]!=0){return KrtDriverAbiFailure("E_ABI_MANIFEST",path,"ABI symbol fingerprint disagrees with exact contract");}
        }
        if(!KrtDriverAbiInsert(state,record)){return false;}
        recorded[(int32)symbol]=true;position=position+nominal_length+contract_length;record_index=record_index+1;
    }
    if(position!=length){return KrtDriverAbiFailure("E_ABI_MANIFEST",path,"trailing ABI record bytes");}
    return true;
}
bool KrtDriverAbiReadStorage(int64 path,KrtDriverAbiState state,KrtDriverBuffer object,int64 symbols,int64 strings,int64 string_length,int64 index,int64 text,int64 data){
    int64 name=KrtDriverAbiSymbolName(object,symbols,strings,string_length,index);
    if(!KrtDriverStartsWith(name,"_KRTG3$")&&!KrtDriverStartsWith(name,"_KRTJ3$")&&!KrtDriverStartsWith(name,"_KRTL3$")){return true;}
    bool initializer=KrtDriverStartsWith(name,"_KRTL3$");int64 symbol=symbols+index*32;
    int64 section=KrtDriverAbiWord(object.data,symbol+12);int64 binding=KrtDriverAbiWord(object.data,symbol+16);
    int64 offset=KrtDriverAbiWord(object.data,symbol+4);int64 size=KrtDriverAbiWord(object.data,symbol+8);
    if((binding!=1&&binding!=2)||KrtDriverAbiWord(object.data,symbol+20)!=(initializer?1:2)||
       (section!=0&&(section!=(initializer?1:3)||!KrtDriverAbiRange(offset,size,initializer?text:data)))||
       (section==0&&(binding!=1||offset!=0||size!=0))){return KrtDriverAbiFailure("E_ABI_MANIFEST",path,"invalid native storage or initializer symbol");}
    KrtDriverAbiRecord record=new KrtDriverAbiRecord();record.path=path;record.nominal=name;record.nominal_length=KrtDriverStringLength(name);
    record.contract=name;record.contract_length=0;record.name=name;record.kind=1;record.defined=section!=0;record.weak=binding==2;
    return KrtDriverAbiInsert(state,record);
}

bool KrtDriverAbiRead(int64 path,KrtDriverAbiState state){
    KrtDriverBuffer object=new KrtDriverBuffer();if(!KrtDriverAbiReadBinary(path,object)){return KrtDriverAbiFailure("E_ABI_MANIFEST",path,"unable to map object contracts (object budget: 1 GiB)");}
    KrtDriverAbiMapping mapping=new KrtDriverAbiMapping();mapping.data=object.data;mapping.length=object.length;mapping.next=state.mappings;state.mappings=mapping;
    if(object.length<64||KrtDriverAbiWord(object.data,0)!=5198411||KrtDriverAbiWord(object.data,4)!=2){return KrtDriverAbiFailure("E_ABI_MANIFEST",path,"invalid KRO header");}
    int64 text=KrtDriverAbiWord(object.data,16);int64 rodata=KrtDriverAbiWord(object.data,20);int64 data=KrtDriverAbiWord(object.data,24);
    int64 count=KrtDriverAbiWord(object.data,48);int64 string_length=KrtDriverAbiWord(object.data,52);int64 relocations=KrtDriverAbiWord(object.data,56);
    int64 relocation_sum=KrtDriverAbiWord(object.data,32)+KrtDriverAbiWord(object.data,36)+KrtDriverAbiWord(object.data,40);
    int64 rodata_start=64+text;int64 symbols=rodata_start+rodata+data;int64 strings=symbols+count*32+relocations*16;
    if(count>1048576||relocations>4194304||relocations!=relocation_sum||!KrtDriverAbiRange(64,text+rodata+data,object.length)||
       !KrtDriverAbiRange(symbols,count*32+relocations*16,object.length)||!KrtDriverAbiRange(strings,string_length,object.length)){
        return KrtDriverAbiFailure("E_ABI_MANIFEST",path,"KRO tables exceed object bounds");
    }
    int64[] manifests=new int64[3];int64[] sizes=new int64[3];int32 marker=0;
    while(marker<3){manifests[marker]=-1;marker=marker+1;}
    bool[] required=new bool[(int32)count];bool[] recorded=new bool[(int32)count];int64 index=0;
    while(index<count){
        int64 name=KrtDriverAbiSymbolName(object,symbols,strings,string_length,index);if(name==0){return KrtDriverAbiFailure("E_ABI_MANIFEST",path,"invalid symbol string");}
        marker=-1;
        if(KrtDriverStringEqual(name,(int64)"_KRT_ABI2_MANIFEST")){marker=0;}
        else if(KrtDriverStringEqual(name,(int64)"_KRT_ABI3_MANIFEST")){marker=1;}
        else if(KrtDriverStringEqual(name,(int64)"_KRT_ABI3_TYPES")){marker=2;}
        if(marker>=0){
            int64 offset=KrtDriverAbiWord(object.data,symbols+index*32+4);int64 size=KrtDriverAbiWord(object.data,symbols+index*32+8);
            if(manifests[marker]>=0||KrtDriverAbiWord(object.data,symbols+index*32+12)!=2||KrtDriverAbiWord(object.data,symbols+index*32+16)!=0||KrtDriverAbiWord(object.data,symbols+index*32+20)!=2||!KrtDriverAbiRange(offset,size,rodata)){
                return KrtDriverAbiFailure("E_ABI_MANIFEST",path,"manifest must be one local read-only symbol");
            }
            manifests[marker]=rodata_start+offset;sizes[marker]=size;
        }
        if(KrtDriverStartsWith(name,"_KRT2$")||KrtDriverStartsWith(name,"_KRT3$")){required[(int32)index]=true;}
        index=index+1;
    }
    marker=0;while(marker<3){
        if(manifests[marker]>=0&&!KrtDriverAbiReadManifest(path,state,object,symbols,strings,string_length,count,text,manifests[marker],sizes[marker],marker==0?2:3,marker==2,required,recorded)){return false;}
        marker=marker+1;
    }
    index=0;while(index<count){if(!KrtDriverAbiReadStorage(path,state,object,symbols,strings,string_length,index,text,data)){return false;}index=index+1;}
    index=0;while(index<count){if(required[(int32)index]&&!recorded[(int32)index]){return KrtDriverAbiFailure("E_ABI_MANIFEST",path,"native ABI symbol is missing its contract record");}index=index+1;}
    return true;
}
void KrtDriverAbiDispose(KrtDriverAbiState state){
    KrtDriverAbiRecord record=state.records;while(record!=null){KrtDriverAbiRecord next=record.next;delete record;record=next;}
    KrtDriverAbiMapping mapping=state.mappings;while(mapping!=null){KrtDriverAbiMapping next=mapping.next;syscall(11,mapping.data,mapping.length,0,0,0,0);delete mapping;mapping=next;}
    if(state.buckets!=null){delete state.buckets;}delete state;
}
bool KrtDriverAbiCheckContracts(KrtDriverPath objects,bool require_definitions){
    KrtDriverAbiState state=new KrtDriverAbiState();KrtDriverPath object=objects;
    while(object!=null){if(!KrtDriverAbiRead(object.value,state)){KrtDriverAbiDispose(state);return false;}object=object.next;}
    KrtDriverAbiRecord record=state.records;
    while(record!=null){
        if(require_definitions&&!record.defined){KrtDriverAbiFailure("E_ABI_SYMBOL",record.path,(string)KrtDriverConcat((int64)(record.kind==1?"missing native storage or initializer definition: ":(KrtDriverStartsWith(record.name,"_KRT2$")?"missing public ABI2 definition: ":"missing public ABI3 definition: ")),record.name));KrtDriverAbiDispose(state);return false;}
        record=record.next;
    }
    KrtDriverAbiDispose(state);return true;
}
bool KrtDriverAbiValidate(KrtDriverPath objects){return KrtDriverAbiCheckContracts(objects,true);}

// ===== Artifact output =====
// Text artifacts are emitted directly by the native compiler.
static int32 KrtDriverArtifactTarget = 0;
static KrtDriverBuffer KrtDriverLastVm = null;

bool KrtArtifactText(int64 descriptor, string text) {
    return KrtDriverWriteAll(descriptor,(int64)text,KrtDriverStringLength((int64)text));
}

string KrtArtifactOp(int32 op) {
    if (op == 0) { return "nop"; } if (op == 1) { return "const"; }
    if (op == 2) { return "load.local"; } if (op == 3) { return "store.local"; }
    if (op == 4) { return "add"; } if (op == 5) { return "sub"; } if (op == 6) { return "mul"; }
    if (op == 7) { return "div"; } if (op == 8) { return "mod"; }
    if (op == 9) { return "and"; } if (op == 10) { return "or"; } if (op == 11) { return "xor"; }
    if (op == 12) { return "shl"; } if (op == 13) { return "shr"; }
    if (op == 14) { return "neg"; } if (op == 15) { return "not"; } if (op == 16) { return "compare"; }
    if (op == 17) { return "jump"; } if (op == 18) { return "branch"; }
    if (op == 19) { return "call"; } if (op == 20) { return "return"; }
    if (op == 21) { return "address"; } if (op == 22) { return "load"; } if (op == 23) { return "store"; }
    if (op == 24) { return "allocate"; } if (op == 25) { return "data"; }
    if (op == 26) { return "syscall"; } if (op == 27) { return "drop"; } if (op == 28) { return "cast"; }
    if (op == 29) { return "ref"; } if (op == 30) { return "stack.allocate"; }
    if (op == 31) { return "bool.not"; } if (op == 32) { return "dup"; }
    if (op == 33) { return "post.increment"; } if (op == 34) { return "free"; }
    if (op == 35) { return "string.equal"; } if (op == 36) { return "string.concat"; } if (op == 37) { return "string.length"; }
    if (op == 38) { return "float.convert"; } if (op == 39) { return "float.binary"; } if (op == 40) { return "float.compare"; }
    if (op == 41) { return "float.neg"; } if (op == 42) { return "float.bool"; } if (op == 43) { return "float.post.increment"; }
    if (op == 44) { return "global.address"; } if (op == 45) { return "function.address"; } if (op == 46) { return "call.indirect"; }
    if (op == 50) { return "try.enter"; } if (op == 51) { return "try.leave"; } if (op == 52) { return "throw"; }
    if (op == 53) { return "catch.value"; } if (op == 54) { return "catch.type"; }
    if (op == 60) { return "wide.convert"; } if (op == 61) { return "wide.binary"; } if (op == 62) { return "wide.compare"; }
    if (op == 63) { return "wide.unary"; } if (op == 66) { return "wide.literal"; } if (op == 67) { return "wide.post.increment"; }
    if (op == 68) { return "wide.float"; } if (op == 69) { return "wide.ref"; }
    if (op == 70) { return "aggregate.address"; } if (op == 71) { return "aggregate.copy"; } if (op == 72) { return "aggregate.zero"; }
    if (op == 73) { return "closure.environment"; }
    if (op == 74) { return "type.descriptor"; }
    if (op == 75) { return "global.guard.enter"; } if (op == 76) { return "global.guard.finish"; }
    return "unknown";
}

bool KrtArtifactWriteIr(KrtNativeModule module, int64 descriptor) {
    if (module == null) { return KrtArtifactText(descriptor,"; data-only module\n"); }
    if (module.ssa != null) { return KrtSsaWriteIr(module.ssa,descriptor); }
    if (!KrtArtifactText(descriptor,"; Kairote native stack IR\n")) { return false; }
    int32 function_index = 0;
    while (function_index < module.function_count) {
        int64 header = KrtDriverConcat((int64)"function ",KrtDriverNumber(function_index));
        header = KrtDriverConcat(header,KrtDriverConcat((int64)" params=",KrtDriverNumber(module.parameter_counts[function_index])));
        header = KrtDriverConcat(header,KrtDriverConcat((int64)" locals=",KrtDriverNumber(module.local_counts[function_index])));
        if (function_index == module.entry) { header = KrtDriverConcat(header,(int64)" entry"); }
        if (!KrtArtifactText(descriptor,(string)header) || !KrtArtifactText(descriptor," {\n")) { return false; }
        int32 index = module.starts[function_index]; int32 last = module.count;
        if (function_index + 1 < module.function_count) { last = module.starts[function_index + 1]; }
        while (index < last) {
            int64 line = KrtDriverConcat((int64)"  ",KrtDriverNumber(index));
            line = KrtDriverConcat(line,KrtDriverConcat((int64)": ",(int64)KrtArtifactOp(module.ops[index])));
            line = KrtDriverConcat(line,KrtDriverConcat((int64)" ",KrtDriverNumber(module.args[index])));
            line = KrtDriverConcat(line,KrtDriverConcat((int64)" ",KrtDriverNumber(module.extra[index])));
            if (!KrtArtifactText(descriptor,(string)line) || !KrtArtifactText(descriptor,"\n")) { return false; }
            index = index + 1;
        }
        if (!KrtArtifactText(descriptor,"}\n")) { return false; }
        function_index = function_index + 1;
    }
    return true;
}

bool KrtArtifactIr(KrtNativeModule module, int64 path) {
    int64 descriptor = syscall(2,path,577,420,0,0,0); if (descriptor < 0) { return false; }
    bool result = KrtArtifactWriteIr(module,descriptor);
    if (syscall(3,descriptor,0,0,0,0,0) != 0) { result = false; }
    return result;
}

int32 KrtArtifactWord(byte[] bytes, int32 offset) {
    return (int32)bytes[offset] | ((int32)bytes[offset+1] << 8) | ((int32)bytes[offset+2] << 16) | ((int32)bytes[offset+3] << 24);
}

int64 KrtArtifactSymbol(KrtKroObject object, int32 symbol_index) {
    if (object.symbol_bytes == null || object.string_bytes == null || symbol_index < 0 || symbol_index >= object.symbol_count) { return 0; }
    int32 offset = KrtArtifactWord(object.symbol_bytes,symbol_index*32);
    if (offset < 0 || offset >= object.strtab_size) { return 0; }
    int32 length = 0; while (offset+length < object.strtab_size && object.string_bytes[offset+length] != 0) { length = length + 1; }
    int64 name = KrtDriverAlloc(length+1);
    unsafe(using krt.mem;) {
        byte* target = (byte*)name; int32 index = 0;
        while (index < length) { target[index] = object.string_bytes[offset+index]; index = index+1; }
        target[length] = 0;
    }
    return name;
}

bool KrtArtifactAssembly(KrtKroObject object, KrtNativeModule module, int64 path) {
    if (object == null || module == null || object.text_words == null) { return false; }
    int64 descriptor = syscall(2,path,577,420,0,0,0); if (descriptor < 0) { return false; }
    bool ok = KrtArtifactText(descriptor,"# Kairote x86-64 native code; assemble with GNU as.\n.section .text\n");
    int32[] labels = new int32[object.text_size+1]; int32 function_index = 0;
    while (function_index < module.function_count) {
        int32 offset = module.function_offsets[function_index];
        if (offset < 0 || offset >= object.text_size) { ok = false; break; }
        labels[offset] = function_index+1; function_index = function_index+1;
    }
    int32 position = 0; int32 relocation = 0; int32 next_relocation = -1;
    if (object.text_reloc_count > 0) { next_relocation = KrtArtifactWord(object.text_relocation_bytes,0); }
    unsafe(using krt.mem;) {
        byte* line = stackalloc byte[128]; byte* digits = (byte*)(int64)"0123456789abcdef";
        while (position < object.text_size && ok) {
            if (labels[position] > 0) {
                function_index = labels[position]-1;
                int64 label = KrtDriverConcat((int64)".Lkrt_function_",KrtDriverNumber(function_index));
                ok = KrtArtifactText(descriptor,(string)label) && KrtArtifactText(descriptor,":\n");
                if (function_index == module.entry) { ok = ok && KrtArtifactText(descriptor,".global _start\n.global main\n_start:\nmain:\n"); }
                if (object.symbol_bytes != null) {
                    int64 name = KrtArtifactSymbol(object,function_index);
                    if (name != 0 && !KrtDriverWord(name,"main") && KrtArtifactWord(object.symbol_bytes,function_index*32+16) != 0) {
                        ok = ok && KrtArtifactText(descriptor,".global \"") && KrtArtifactText(descriptor,(string)name) && KrtArtifactText(descriptor,"\"\n\"") && KrtArtifactText(descriptor,(string)name) && KrtArtifactText(descriptor,"\":\n");
                    }
                }
                if (!ok) { break; }
            }
            if (position == next_relocation) {
                int32 symbol_index = KrtArtifactWord(object.text_relocation_bytes,relocation*16+4);
                int64 name = KrtArtifactSymbol(object,symbol_index);
                if (name == 0 || KrtArtifactWord(object.text_relocation_bytes,relocation*16+8) != 3) { ok = false; break; }
                ok = KrtArtifactText(descriptor,".long \"") && KrtArtifactText(descriptor,(string)name) && KrtArtifactText(descriptor,"\" - . - 4\n");
                position = position+4; relocation = relocation+1; next_relocation = -1;
                if (relocation < object.text_reloc_count) { next_relocation = KrtArtifactWord(object.text_relocation_bytes,relocation*16); }
                continue;
            }
            line[0]=46; line[1]=98; line[2]=121; line[3]=116; line[4]=101; line[5]=32;
            int32 length = 6; int32 count = 0;
            while (position < object.text_size && count < 16 && position != next_relocation) {
                if (count > 0 && labels[position] > 0) { break; }
                if (count > 0) { line[length]=44; length=length+1; }
                int32 value = (object.text_words[position/4] >> ((position%4)*8)) & 255;
                line[length]=48; line[length+1]=120; line[length+2]=digits[value/16]; line[length+3]=digits[value%16]; length=length+4;
                position=position+1; count=count+1;
            }
