// ===== Project building and cache =====
// Native project discovery, globbing, lifecycle and successful-build cache.
// The manifest is length-prefixed binary data so arbitrary filesystem names
// never need a host-language serializer or shell interpretation.
class KrtProjectGlob {
    public KrtDriverPath paths;
    public int32 depth;
    public bool ok;
}
class KrtProjectRecord {
    public int64 output;
    public int64 cached;
    public uint64 hash;
    public KrtProjectRecord next;
}
class KrtProjectManifest {
    public bool valid;
    public uint64 key;
    public uint64 artifact_hash;
    public int64 project;
    public int64 output;
    public KrtProjectRecord objects;
}
int32 KrtProjectPathCompare(int64 first, int64 second) {
    unsafe(using krt.mem;) { byte* a = (byte*)first; byte* b = (byte*)second; int64 i = 0;
        while (a[i] == b[i]) { if (a[i] == 0) { return 0; } i++; }
        return a[i] < b[i] ? -1 : 1;
    }
}
KrtDriverPath KrtProjectSortedPath(KrtDriverPath head, int64 path) {
    KrtDriverPath previous = null; KrtDriverPath current = head;
    while (current != null && KrtProjectPathCompare(current.value,path) < 0) { previous = current; current = current.next; }
    if (current != null && KrtDriverStringEqual(current.value,path)) { return head; }
    KrtDriverPath item = new KrtDriverPath(); item.value = path; item.next = current;
    if (previous == null) { return item; } previous.next = item; return head;
}
bool KrtProjectPublish(int64 source, int64 target, bool executable) {
    return KrtDriverMakeDirectories(KrtDriverDirectory(target)) && KrtDriverPublish(source,target,executable);
}
uint64 KrtProjectHashBytes(uint64 hash, int64 data, int64 length) {
    unsafe(using krt.mem;) { byte* bytes = (byte*)data; int64 i = 0;
        while (i < length) { hash = (hash ^ (uint64)bytes[i])*1099511628211; i++; }
    } return hash;
}
uint64 KrtProjectHashString(uint64 hash, int64 value) {
    hash = KrtProjectHashBytes(hash,value,KrtDriverStringLength(value)); return (hash ^ 255)*1099511628211;
}
uint64 KrtProjectFileHash(int64 path) {
    if (!KrtDriverFileExists(path)) { return 0; }
    int64 descriptor = syscall(2,path,0,0,0,0,0); if (descriptor < 0) { return 0; }
    int64 data = KrtDriverAlloc(8192); if (data == 0) { syscall(3,descriptor,0,0,0,0,0); return 0; }
    uint64 hash = 14695981039346656037;
    while (true) {
        int64 count = syscall(0,descriptor,data,8192,0,0,0);
        if (count == -4) { continue; }
        if (count < 0) { syscall(3,descriptor,0,0,0,0,0); return 0; }
        if (count == 0) { break; } hash = KrtProjectHashBytes(hash,data,count);
    }
    syscall(3,descriptor,0,0,0,0,0); return hash;
}
int64 KrtProjectHex(uint64 value) {
    int64 result = KrtDriverAlloc(17);
    unsafe(using krt.mem;) { byte* bytes = (byte*)result; byte* digits = (byte*)(int64)"0123456789abcdef"; int64 index = 16;
        bytes[index] = 0; while (index > 0) { index--; bytes[index] = digits[value % 16]; value = value/16; }
    } return result;
}
int64 KrtProjectName(int64 path) {
    int64 length = KrtDriverStringLength(path); int64 index = length;
    unsafe(using krt.mem;) { byte* bytes = (byte*)path; while (index > 0 && bytes[index-1] != 47) { index--; } }
    return KrtDriverCopyString(path+index,length-index);
}
bool KrtProjectPatternMatch(int64 pattern, int64 name) {
    // '*' backtracking is linear in common filename patterns. Bracket classes
    // and '?' use byte matching, matching filesystem glob's path semantics.
    unsafe(using krt.mem;) { byte* p = (byte*)pattern; byte* n = (byte*)name;
        int64 pi = 0; int64 ni = 0; int64 star = -1; int64 retry = 0;
        if (n[0] == 46 && p[0] != 46) { return false; }
        while (n[ni] != 0) {
            if (p[pi] == 42) { star = pi++; retry = ni; continue; }
            bool matched = p[pi] == 63 || (p[pi] != 0 && p[pi] == n[ni]); int64 next = pi+1;
            if (p[pi] == 91) {
                int64 end = pi+1; while (p[end] != 0 && p[end] != 93) { end++; }
                if (p[end] == 93) {
                    int64 cursor = pi+1; bool negate = p[cursor] == 33; if (negate) { cursor++; } bool found = false;
                    while (cursor < end) { if (cursor+2 < end && p[cursor+1] == 45) {
                            if (n[ni] >= p[cursor] && n[ni] <= p[cursor+2]) { found = true; } cursor += 3;
                        } else { if (n[ni] == p[cursor]) { found = true; } cursor++; }
                    } matched = negate ? !found : found; next = end+1;
                }
            }
            if (matched) { pi = next; ni++; }
            else if (star >= 0) { pi = star+1; retry++; ni = retry; }
            else { return false; }
        } while (p[pi] == 42) { pi++; } return p[pi] == 0;
    }
}
void KrtProjectGlobWalk(KrtProjectGlob glob, int64 directory, int64 pattern) {
    if (!glob.ok) { return; } glob.depth = glob.depth+1;
    if (glob.depth > 128) { KrtDriverError("E_INPUT","source pattern directory nesting limit exceeded"); glob.ok = false; glob.depth = glob.depth-1; return; }
    int64 length = KrtDriverStringLength(pattern); int64 end = 0;
    unsafe(using krt.mem;) { byte* bytes = (byte*)pattern; while (end < length && bytes[end] != 47) { end++; } }
    int64 component = KrtDriverCopyString(pattern,end); int64 remainder = 0; if (end < length) { remainder = pattern+end+1; }
    if (KrtProjectEqual(component,"**")) {
        if (remainder != 0) { KrtProjectGlobWalk(glob,directory,remainder); }
        KrtDriverPath entries = KrtDriverListEntries(directory);
        while (entries != null) {
            int64 name = KrtProjectName(entries.value); bool hidden = false;
            unsafe(using krt.mem;) { hidden = ((byte*)name)[0] == 46; }
            if (!hidden) {
                if (KrtDriverIsDirectory(entries.value)) { KrtProjectGlobWalk(glob,entries.value,pattern); }
                else if (remainder == 0 && KrtDriverFileExists(entries.value)) { glob.paths = KrtProjectSortedPath(glob.paths,entries.value); }
            } entries = entries.next;
        }
    } else {
        bool magic = false;
        unsafe(using krt.mem;) { byte* bytes = (byte*)component; int64 i = 0;
            while (bytes[i] != 0) { if (bytes[i] == 42 || bytes[i] == 63 || bytes[i] == 91) { magic = true; } i++; }
        }
        KrtDriverPath entries = null;
        if (magic) { entries = KrtDriverListEntries(directory); }
        else { int64 direct = KrtDriverJoinPath(directory,component); if (KrtDriverFileExists(direct) || KrtDriverIsDirectory(direct)) { entries = KrtProjectAppend(null,direct,false); } }
        while (entries != null) {
            if (!magic || KrtProjectPatternMatch(component,KrtProjectName(entries.value))) {
                if (remainder != 0 && KrtDriverIsDirectory(entries.value)) { KrtProjectGlobWalk(glob,entries.value,remainder); }
                else if (remainder == 0 && KrtDriverFileExists(entries.value) && !KrtDriverIsDirectory(entries.value)) { glob.paths = KrtProjectSortedPath(glob.paths,KrtDriverAbsolutePath(entries.value)); }
            } entries = entries.next;
        }
    } glob.depth = glob.depth-1;
}
KrtDriverPath KrtProjectGlobPaths(int64 directory, int64 pattern) {
    KrtProjectGlob glob = new KrtProjectGlob(); glob.ok = true;
    unsafe(using krt.mem;) { if (((byte*)pattern)[0] == 47) { directory = (int64)"/"; pattern++; } }
    KrtProjectGlobWalk(glob,directory,pattern); if (glob.ok) { return glob.paths; } return null;
}
KrtDriverPath KrtProjectSpecs(int64 value) {
    KrtDriverPath specs = null; int64 length = KrtDriverStringLength(value); int64 index = 0;
    unsafe(using krt.mem;) { byte* bytes = (byte*)value;
        while (index < length) {
            while (index < length && (bytes[index] == 32 || bytes[index] == 9 || bytes[index] == 44 || bytes[index] == 59)) { index++; }
            int64 start = index;
            while (index < length && bytes[index] != 32 && bytes[index] != 9 && bytes[index] != 44 && bytes[index] != 59) { index++; }
            if (index > start) { specs = KrtProjectAppend(specs,KrtDriverCopyString(value+start,index-start),false); }
        }
    } return specs;
}
bool KrtProjectAdd(KrtProject project, int64 path) {
    path = KrtDriverAbsolutePath(path);
    if (!KrtDriverFileExists(path) || KrtDriverIsDirectory(path)) { KrtDriverError("E_INPUT",(string)KrtProjectCat((int64)"source or library not found: ",path)); return false; }
    if (KrtProjectEnds(KrtProjectLower(path),".kro")) { project.objects = KrtProjectAppend(project.objects,path,true); }
    else { project.sources = KrtProjectAppend(project.sources,path,true); } return true;
}
int64 KrtProjectLibraryRelative(int64 library) {
    int64 length = KrtDriverStringLength(library); if (KrtProjectEnds(library,".*")) { length -= 2; }
    int64 relative = KrtDriverCopyString(library,length);
    unsafe(using krt.mem;) { byte* bytes = (byte*)relative; int64 i = 0; while (i < length) { if (bytes[i] == 46) { bytes[i] = 47; } i++; } }
    return relative;
}
bool KrtProjectResolveLibraries(KrtProject project, int64 library_root) {
    KrtDriverPath specifications = null; KrtDriverPath original = project.libraries;
    while (original != null) {
        int64 direct = KrtDriverJoinPath(project.directory,original.value);
        if (KrtDriverFileExists(direct) || KrtDriverIsDirectory(direct)) { specifications = KrtProjectAppend(specifications,original.value,false); }
        else { KrtDriverPath parts = KrtProjectSpecs(original.value); while (parts != null) { specifications = KrtProjectAppend(specifications,parts.value,false); parts = parts.next; } }
        original = original.next;
    }
    KrtDriverPath item = specifications;
    while (item != null) {
        int64 selected = KrtDriverJoinPath(project.directory,item.value);
        if (!KrtDriverFileExists(selected) && !KrtDriverIsDirectory(selected)) {
            selected = 0;
            if (!KrtProjectEnds(item.value,".krt") && !KrtProjectEnds(item.value,".kro")) {
                int64 relative = KrtProjectLibraryRelative(item.value);
                KrtDriverPath search = KrtProjectAppend(null,project.directory,false);
                search = KrtProjectAppend(search,KrtDriverJoinPath(project.directory,(int64)"libs"),false);
                KrtDriverPath include = project.includes; while (include != null) { search = KrtProjectAppend(search,include.value,true); include = include.next; }
                search = KrtProjectAppend(search,library_root,true); search = KrtProjectAppend(search,KrtDriverJoinPath(library_root,(int64)"System"),true);
                while (search != null && selected == 0) {
                    int64 candidate = KrtDriverJoinPath(search.value,relative);
                    if (KrtDriverFileExists(candidate) || KrtDriverIsDirectory(candidate)) { selected = candidate; }
                    else if (!KrtProjectEnds(item.value,".*")) { candidate = KrtProjectCat(candidate,(int64)".krt"); if (KrtDriverFileExists(candidate)) { selected = candidate; } }
                    search = search.next;
                }
            }
        }
        if (selected == 0) { KrtDriverError("E_IMPORT",(string)KrtProjectCat((int64)"library not found: ",item.value)); return false; }
        if (KrtDriverIsDirectory(selected)) {
            KrtDriverPath matches = KrtDriverListKrtFiles(selected);
            if (matches == null) { KrtDriverError("E_IMPORT","library contains no source files"); return false; }
            while (matches != null) { if (!KrtProjectAdd(project,matches.value)) { return false; } matches = matches.next; }
        } else if (!KrtProjectAdd(project,selected)) { return false; }
        item = item.next;
    } return true;
}
int64 KrtProjectFind(int64 path) {
    path = KrtDriverAbsolutePath(path);
    if (KrtDriverIsDirectory(path)) {
        int64 candidate = KrtDriverJoinPath(path,(int64)"project.krt"); if (KrtDriverFileExists(candidate)) { return candidate; }
        candidate = KrtDriverJoinPath(path,(int64)"project.json"); if (KrtDriverFileExists(candidate)) { return candidate; }
        KrtDriverError("E_PROJECT","no project.krt or project.json found"); return 0;
    } if (!KrtDriverFileExists(path)) { KrtDriverError("E_PROJECT","project file not found"); return 0; } return path;
}
bool KrtProjectKind(int64 kind) {
    return KrtProjectEqual(kind,"console") || KrtProjectEqual(kind,"exe") || KrtProjectEqual(kind,"system") || KrtProjectEqual(kind,"web") || KrtProjectEqual(kind,"library") || KrtProjectEqual(kind,"lib") || KrtProjectEqual(kind,"dll");
}
bool KrtProjectIsLibrary(KrtProject project) {
    return KrtProjectEqual(project.kind,"library") || KrtProjectEqual(project.kind,"lib") || KrtProjectEqual(project.kind,"dll");
}
int32 KrtProjectOptimization(int64 text) {
    if (KrtDriverStartsWith(text,"-O")) { text += 2; } else if (KrtDriverStartsWith(text,"O")) { text++; }
    if (KrtDriverStringLength(text) != 1) { return -1; }
    unsafe(using krt.mem;) { int32 level = (int32)((byte*)text)[0]-48; if (level >= 0 && level <= 3) { return level; } }
    return -1;
}
int32 KrtProjectTarget(int64 text) {
    if (KrtProjectEqual(text,"elf") || KrtProjectEqual(text,"linux-x86_64") || KrtProjectEqual(text,"exe")) { return 0; }
    if (KrtProjectEqual(text,"eo")) { return 1; } if (KrtProjectEqual(text,"ir")) { return 2; }
    if (KrtProjectEqual(text,"asm")) { return 3; } if (KrtProjectEqual(text,"vm")) { return 4; } return -1;
}
bool KrtProjectExecutable(KrtDriverOptions options) {
    return !options.object_mode && options.target < 2;
}
KrtProject KrtProjectLoad(int64 path, int64 configuration, int64 library_root, bool clean) {
    path = KrtProjectFind(path); if (path == 0) { return null; }
    KrtProject project = new KrtProject(); project.path = path; project.directory = KrtDriverDirectory(path); project.configuration = configuration;
    // Cleaning follows only the last successful manifest, so a changed or
    // invalid configuration and deleted dependencies cannot block cleanup.
    if (clean) { return project; }
    KrtDriverBuffer source = new KrtDriverBuffer(); KrtDriverReadFile(path,source);
    if (!source.ok) { KrtDriverError("E_PROJECT","unable to read project configuration"); return null; }
    if (KrtSourcesUtf8Error(source.data,source.length) >= 0) { KrtDriverError("E_ENCODING","project configuration is not valid UTF-8"); return null; }
    if (!KrtProjectParse(project,source)) { return null; }
    if (project.name == 0) { project.name = KrtProjectName(project.directory); } if (project.kind == 0) { project.kind = (int64)"console"; }
    if (project.optimization == 0) { project.optimization = (int64)"2"; } if (project.target == 0) { project.target = (int64)"elf"; }
    if (!KrtProjectKind(project.kind)) { KrtDriverError("E_PROJECT","unsupported project type; choose console, system, or library"); return null; }
    if (KrtProjectOptimization(project.optimization) < 0) { KrtDriverError("E_OPTION","project optimization level must be 0, 1, 2 or 3"); return null; }
    if (KrtProjectTarget(project.target) < 0) { KrtDriverError("E_OPTION","native project target must be elf, linux-x86_64, exe, eo, ir, asm or vm"); return null; }
    KrtDriverPath include = project.includes;
    while (include != null) { include.value = KrtDriverAbsolutePath(KrtDriverJoinPath(project.directory,include.value)); include = include.next; }
    if (!clean) {
        if (project.patterns == null) { KrtDriverError("E_PROJECT","no Sources defined"); return null; }
        KrtDriverPath pattern = project.patterns;
        while (pattern != null) { KrtDriverPath matches = KrtProjectGlobPaths(project.directory,pattern.value);
            if (matches == null) {
                KrtDriverPath parts = KrtProjectSpecs(pattern.value);
                while (parts != null) { KrtDriverPath selected = KrtProjectGlobPaths(project.directory,parts.value);
                    if (selected == null) { KrtDriverError("E_INPUT",(string)KrtProjectCat((int64)"source pattern matched no files: ",parts.value)); return null; }
                    while (selected != null) { matches = KrtProjectAppend(matches,selected.value,true); selected = selected.next; } parts = parts.next;
                }
                if (matches == null) { KrtDriverError("E_INPUT",(string)KrtProjectCat((int64)"source pattern matched no files: ",pattern.value)); return null; }
            }
            while (matches != null) { if (!KrtDriverStringEqual(matches.value,path) && !KrtProjectAdd(project,matches.value)) { return null; } matches = matches.next; }
            pattern = pattern.next;
        }
        if (!KrtProjectResolveLibraries(project,library_root)) { return null; }
        if (project.sources == null) { KrtDriverError("E_PROJECT","no source files selected"); return null; }
    }
    if (project.output == 0) { project.output = KrtProjectCat(KrtProjectCat((int64)"bin/",configuration),KrtProjectCat((int64)"/",project.name)); }
    bool separator = false;
    unsafe(using krt.mem;) { byte* bytes = (byte*)project.output; int64 i = 0; while (bytes[i] != 0) { if (bytes[i] == 47 || bytes[i] == 92) { separator = true; } i++; } }
    if (!separator) { project.output = KrtProjectCat(KrtProjectCat((int64)"bin/",KrtDriverPlatform()),KrtProjectCat((int64)"/",project.output)); }
    if (KrtProjectIsLibrary(project) && !KrtProjectEnds(project.output,".kro")) { project.output = KrtProjectCat(project.output,(int64)".kro"); }
    project.output = KrtDriverAbsolutePath(KrtDriverJoinPath(project.directory,project.output)); return project;
}
int64 KrtProjectCache(KrtProject project) {
    int64 identifier = KrtProjectHex(KrtProjectHashString(14695981039346656037,project.path));
    return KrtDriverJoinPath(KrtDriverJoinPath(project.directory,(int64)".krtcache"),identifier);
}
void KrtProjectStore64(int64 data, int64 offset, uint64 value) {
    unsafe(using krt.mem;) { byte* bytes = (byte*)data; int64 i = 0; while (i < 8) { bytes[offset+i] = (byte)(value & 255); value = value >> 8; i++; } }
}
uint64 KrtProjectRead64(int64 data, int64 offset) {
    unsafe(using krt.mem;) { byte* bytes = (byte*)data; uint64 value = 0; int64 i = 8;
        while (i > 0) { i--; value = (value << 8) | (uint64)bytes[offset+i]; } return value;
    }
}
int64 KrtProjectStoreString(int64 data, int64 offset, int64 text) {
    int64 length = KrtDriverStringLength(text); KrtProjectStore64(data,offset,(uint64)length); offset += 8;
    unsafe(using krt.mem;) { byte* target = (byte*)data; byte* source = (byte*)text; int64 i = 0; while (i < length) { target[offset+i] = source[i]; i++; } }
    return offset+length;
}
class KrtProjectManifestReader { public int64 data; public int64 length; public int64 position; public bool ok; }
uint64 KrtProjectManifestNumber(KrtProjectManifestReader reader) {
    if (!reader.ok || reader.position > reader.length-8) { reader.ok = false; return 0; }
    uint64 value = KrtProjectRead64(reader.data,reader.position); reader.position = reader.position+8; return value;
}
int64 KrtProjectManifestString(KrtProjectManifestReader reader) {
    uint64 length = KrtProjectManifestNumber(reader);
    if (!reader.ok || length > (uint64)(reader.length-reader.position)) { reader.ok = false; return 0; }
    int64 result = KrtDriverCopyString(reader.data+reader.position,(int64)length); reader.position = reader.position+(int64)length; return result;
}
KrtProjectManifest KrtProjectReadManifest(int64 cache, int64 project_path) {
    KrtProjectManifest manifest = new KrtProjectManifest(); KrtDriverBuffer file = new KrtDriverBuffer(); KrtDriverReadFile(KrtDriverJoinPath(cache,(int64)"manifest.krtcache"),file);
    if (!file.ok || file.length < 48 || KrtProjectRead64(file.data,0) != 3620692004850487883) { return manifest; }
    KrtProjectManifestReader reader = new KrtProjectManifestReader(); reader.data = file.data; reader.length = file.length; reader.position = 8; reader.ok = true;
    manifest.key = KrtProjectManifestNumber(reader); manifest.artifact_hash = KrtProjectManifestNumber(reader);
    manifest.project = KrtProjectManifestString(reader); manifest.output = KrtProjectManifestString(reader); uint64 count = KrtProjectManifestNumber(reader);
    if (count > 16384) { return manifest; } KrtProjectRecord tail = null; uint64 i = 0;
    while (reader.ok && i < count) { KrtProjectRecord record = new KrtProjectRecord(); record.output = KrtProjectManifestString(reader); record.cached = KrtProjectManifestString(reader);
        record.hash = KrtProjectManifestNumber(reader); if (tail == null) { manifest.objects = record; } else { tail.next = record; } tail = record; i++;
    }
    manifest.valid = reader.ok && reader.position == reader.length && KrtDriverStringEqual(manifest.project,project_path); return manifest;
}
bool KrtProjectWriteManifest(int64 cache, KrtProjectManifest manifest) {
    int64 size = 48+KrtDriverStringLength(manifest.project)+KrtDriverStringLength(manifest.output); uint64 count = 0; KrtProjectRecord record = manifest.objects;
    while (record != null) { size += 24+KrtDriverStringLength(record.output)+KrtDriverStringLength(record.cached); count++; record = record.next; }
    int64 data = KrtDriverAlloc(size); KrtProjectStore64(data,0,3620692004850487883); KrtProjectStore64(data,8,manifest.key); KrtProjectStore64(data,16,manifest.artifact_hash);
    int64 offset = KrtProjectStoreString(data,24,manifest.project); offset = KrtProjectStoreString(data,offset,manifest.output); KrtProjectStore64(data,offset,count); offset += 8;
    record = manifest.objects; while (record != null) { offset = KrtProjectStoreString(data,offset,record.output); offset = KrtProjectStoreString(data,offset,record.cached);
        KrtProjectStore64(data,offset,record.hash); offset += 8; record = record.next;
    }
    int64 temporary = KrtDriverJoinPath(cache,(int64)"manifest.pending");
    return KrtDriverWriteFile(temporary,data,size) && KrtProjectPublish(temporary,KrtDriverJoinPath(cache,(int64)"manifest.krtcache"),false);
}
bool KrtProjectBelow(int64 directory, int64 path) {
    int64 length = KrtDriverStringLength(directory); int64 count = KrtDriverStringLength(path); if (count <= length) { return false; }
    unsafe(using krt.mem;) { byte* a = (byte*)directory; byte* b = (byte*)path; int64 i = 0;
        while (i < length) { if (a[i] != b[i]) { return false; } i++; } return b[length] == 47;
    }
}
bool KrtProjectOutputSafe(KrtProject project, KrtDriverOptions options, KrtSourceBundle bundle, int64 output, int64 cache) {
    if (KrtDriverStringEqual(output,project.path) || KrtDriverStringEqual(output,options.compiler) || KrtDriverStringEqual(output,options.linker)) { KrtDriverError("E_OUTPUT","output would overwrite an input file or tool"); return false; }
    KrtDriverPath object = project.objects; while (object != null) { if (KrtDriverStringEqual(output,object.value)) { KrtDriverError("E_OUTPUT","output would overwrite an input file"); return false; } object = object.next; }
    KrtSourceFile file = bundle.files; while (file != null) { if (KrtDriverStringEqual(output,file.path)) { KrtDriverError("E_OUTPUT","output would overwrite an input file"); return false; } file = file.order_next; }
    if (KrtDriverStringEqual(cache,output) || KrtProjectBelow(cache,output)) { KrtDriverError("E_OUTPUT","output must be outside the project cache"); return false; } return true;
}
uint64 KrtProjectBuildKey(KrtProject project, KrtDriverOptions options, KrtSourceBundle bundle) {
    uint64 hash = KrtProjectHashString(14695981039346656037,(int64)"native-project-cache-v2"); hash = KrtProjectHashString(hash,project.configuration);
    hash = KrtProjectHashString(hash,options.output); hash = KrtProjectHashString(hash,project.kind); hash = KrtProjectHashString(hash,options.library_root);
    hash = KrtProjectHashString(hash,KrtProjectDecimal(options.optimization)); hash = KrtProjectHashString(hash,KrtProjectDecimal(options.target));
    int64 target_kind = (int64)"native-target"; if (options.eo_executable) { target_kind = (int64)"eo-executable"; }
    hash = KrtProjectHashString(hash,target_kind);
    if (options.keep_temp) { hash = KrtProjectHashString(hash,(int64)"keep-temp"); hash = KrtProjectHashString(hash,KrtDriverRetainedObject(options,bundle)); }
    KrtDriverBuffer configuration = new KrtDriverBuffer(); KrtDriverReadFile(project.path,configuration); hash = KrtProjectHashBytes(hash,configuration.data,configuration.length);
    KrtDriverPath directory = options.includes; while (directory != null) { hash = KrtProjectHashString(hash,directory.value); directory = directory.next; }
    KrtSourceFile file = bundle.files; while (file != null) { hash = KrtProjectHashString(hash,file.path); hash = KrtProjectHashBytes(hash,file.original,file.length); file = file.order_next; }
    KrtDriverPath objects = project.objects; while (objects != null) { hash = KrtProjectHashString(hash,objects.value); hash = (hash ^ KrtProjectFileHash(objects.value))*1099511628211; objects = objects.next; }
    hash = KrtProjectHashString(hash,options.compiler); hash = (hash ^ KrtProjectFileHash(options.compiler))*1099511628211;
    if (!options.object_mode) { hash = KrtProjectHashString(hash,options.linker); hash = (hash ^ KrtProjectFileHash(options.linker))*1099511628211; }
    return hash;
}
KrtDriverOptions KrtProjectOptions(KrtDriverOptions original) {
    KrtDriverOptions result = new KrtDriverOptions(); result.compiler = original.compiler; result.linker = original.linker;
    result.library_root = original.library_root; result.configuration = original.configuration; result.includes = original.includes;
    result.object_mode = original.object_mode; result.check = original.check; result.rebuild = original.rebuild;
    result.optimization = original.optimization; result.optimization_set = original.optimization_set;
    result.target = original.target; result.target_set = original.target_set; result.eo_executable = original.eo_executable;
    result.keep_temp = original.keep_temp; result.show_ir = original.show_ir;
    result.retained_output = original.retained_output; result.jobs = original.jobs;
    return result;
}
bool KrtProjectRestore(KrtProjectManifest manifest, int64 cache, int64 output, bool executable) {
    if (!manifest.valid) { return false; } int64 artifact = KrtDriverJoinPath(cache,(int64)"artifact");
    if (!KrtDriverFileExists(artifact) || KrtProjectFileHash(artifact) != manifest.artifact_hash) { return false; }
    KrtProjectRecord object = manifest.objects;
    while (object != null) { int64 cached = KrtDriverJoinPath(cache,object.cached);
        if (!KrtDriverFileExists(cached) || KrtProjectFileHash(cached) != object.hash) { return false; } object = object.next;
    }
    if (!KrtDriverFileExists(output) || KrtProjectFileHash(output) != manifest.artifact_hash) { if (!KrtProjectPublish(artifact,output,executable)) { return false; } }
    object = manifest.objects; while (object != null) {
        if (!KrtDriverFileExists(object.output) || KrtProjectFileHash(object.output) != object.hash) {
            if (!KrtProjectPublish(KrtDriverJoinPath(cache,object.cached),object.output,false)) { return false; }
