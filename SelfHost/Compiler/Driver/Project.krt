int64 KrtProjectObjectOutput(KrtProject project, int64 source) {
    int64 relative = 0;
    if (KrtProjectBelow(project.directory,source)) { relative = source+KrtDriverStringLength(project.directory)+1; }
    else { relative = KrtProjectCat(KrtProjectCat((int64)"_external/",KrtProjectHex(KrtProjectHashString(14695981039346656037,source))),KrtProjectCat((int64)"-",KrtProjectName(source))); }
