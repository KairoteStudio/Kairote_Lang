    int64 configuration = KrtProjectCat((int64)"// Native Kairote project\nfunction Configure(Project p) {\n    p.Name(",KrtProjectJsonQuote(name));
    configuration = KrtProjectCat(configuration,KrtProjectCat((int64)");\n    p.Type(",KrtProjectJsonQuote(kind)));
    configuration = KrtProjectCat(configuration,(int64)");\n    p.Sources(\"src/**/*.krt\");\n    p.Output(");
    configuration = KrtProjectCat(configuration,KrtProjectJsonQuote(KrtProjectCat((int64)"bin/${config}/",name))); configuration = KrtProjectCat(configuration,(int64)");\n}\n");
    int64 project_path = KrtDriverJoinPath(directory,(int64)"project.krt"); int64 ignore = (int64)"bin/\nobj/\n.krtcache/\n";
    if (!KrtDriverWriteFile(filename,source,KrtDriverStringLength(source)) || !KrtDriverWriteFile(project_path,configuration,KrtDriverStringLength(configuration)) || !KrtDriverWriteFile(KrtDriverJoinPath(directory,(int64)".gitignore"),ignore,KrtDriverStringLength(ignore))) { KrtDriverError("E_OUTPUT","unable to write new project"); return 1; }
    if (companion_name != 0 && !KrtDriverWriteFile(KrtDriverJoinPath(source_dir,companion_name),companion_source,KrtDriverStringLength(companion_source))) { KrtDriverError("E_OUTPUT","unable to write new project source"); return 1; }
    KrtDriverPrint((string)KrtProjectCat((int64)"created: ",KrtProjectCat(project_path,(int64)"\n"))); return 0;
