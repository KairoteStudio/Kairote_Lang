int32 KrtProjectClean(KrtProject project) {
    int64 cache = KrtProjectCache(project); KrtProjectManifest manifest = KrtProjectReadManifest(cache,project.path);
    if (manifest.valid) {
        if (KrtDriverFileExists(manifest.output) && KrtProjectFileHash(manifest.output) == manifest.artifact_hash) {
