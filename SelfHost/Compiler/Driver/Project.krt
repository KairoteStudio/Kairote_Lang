int64 KrtProjectJsonQuote(int64 value) {
    int64 length = KrtDriverStringLength(value); int64 result = KrtDriverAlloc(length*6+3); int64 count = 0;
    unsafe(using krt.mem;) { byte* source = (byte*)value; byte* output = (byte*)result; byte* digits = (byte*)(int64)"0123456789abcdef"; output[count++] = 34; int64 i = 0;
        while (i < length) { int64 b = source[i++]; if (b == 34 || b == 92) { output[count++] = 92; output[count++] = (byte)b; }
            else if (b < 32) { output[count++] = 92; output[count++] = 117; output[count++] = 48; output[count++] = 48; output[count++] = digits[b/16]; output[count++] = digits[b%16]; }
            else { output[count++] = (byte)b; }
        } output[count++] = 34; output[count] = 0;
    } return result;
}
int32 KrtProjectNew(KrtDriverOptions options) {
    KrtDriverPath positional = options.sources;
    if (positional == null || positional.next == null || positional.next.next != null) { KrtDriverError("E_OPTION","new requires a project type and directory"); return 1; }
    int64 kind = positional.value; int64 directory = KrtDriverAbsolutePath(positional.next.value);
    if (!KrtProjectKind(kind)) { KrtDriverError("E_PROJECT","unsupported project type; choose console, system, or library"); return 1; }
    if (KrtDriverFileExists(directory) || (KrtDriverIsDirectory(directory) && KrtDriverListEntries(directory) != null)) { KrtDriverError("E_PROJECT","destination is not empty"); return 1; }
    int64 name = KrtProjectName(directory); if (options.name != 0) { name = options.name; }
    bool invalid = KrtDriverStringLength(name) == 0 || KrtProjectEqual(name,".") || KrtProjectEqual(name,"..");
    unsafe(using krt.mem;) { byte* bytes = (byte*)name; int64 i = 0; while (bytes[i] != 0) { if (bytes[i] == 47 || bytes[i] == 92 || bytes[i] == 10 || bytes[i] == 13) { invalid = true; } i++; } }
    if (invalid) { KrtDriverError("E_PROJECT","project name must not contain a path separator or newline"); return 1; }
    int64 source_dir = KrtDriverJoinPath(directory,(int64)"src"); if (!KrtDriverMakeDirectories(source_dir)) { KrtDriverError("E_OUTPUT","unable to create project directory"); return 1; }
    bool library = KrtProjectEqual(kind,"library") || KrtProjectEqual(kind,"lib") || KrtProjectEqual(kind,"dll");
    int64 source = (int64)"using System.Console;\n\nint32 main() {\n    Console.WriteLine(\"Hello, Kairote!\");\n    return 0;\n}\n";
    int64 source_name = (int64)"main.krt";
    if (library) { source = (int64)"int64 Add(int64 left, int64 right) { return left + right; }\n"; source_name = (int64)"library.krt"; }
    int64 companion_name = 0; int64 companion_source = 0;
    if (library) { companion_name = (int64)"exports.krt"; companion_source = (int64)"void export_symbols() { }\n"; }
    else if (KrtProjectEqual(kind,"web")) {
        source_name = (int64)"app.krt";
        source = (int64)"using System.Console;\n\nvoid handle_request() {\n    Console.Write(\"HTTP/1.1 200 OK\\r\\nContent-Type: text/html\\r\\n\\r\\n<h1>Hello from Kairote Lang Web!</h1>\");\n}\n\nint32 main() {\n    configure_routes();\n    handle_request();\n    return 0;\n}\n";
        companion_name = (int64)"routes.krt"; companion_source = (int64)"void configure_routes() { }\n";
    } else if (KrtProjectEqual(kind,"system")) {
        source_name = (int64)"kernel.krt";
        source = (int64)"int32 main() {\n    init_drivers();\n    syscall(1, 1, (int64)\"System.Everything is ready\\n\", 27, 0, 0, 0);\n    return 0;\n}\n";
        companion_name = (int64)"drivers.krt"; companion_source = (int64)"void init_drivers() { }\n";
    }
