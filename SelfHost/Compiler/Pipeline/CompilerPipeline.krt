// Stage-0 callable compiler entry point. It owns the pipeline but emits no C.
static KrtNativeModule KrtDriverLastModule = null;
class KrtCompileWorkspace {
    public KrtLexer lexer;
    public KrtToken token;
    public KrtParser parser;
    public KrtAstNode unit;
    public KrtNativeModule module;
}
class KrtCompileAstQueue {
    public KrtAstNode[] nodes;
    public int32 count;
    public int32 capacity;
    public bool ok;
    public KrtUsingScope scopes;
    public KrtNativeSignatureCache signatures;
    public KrtNativeGeneratorPlan generators;
    public KrtNativeCapture captures;
    public KrtNativeCellOwner cell_owners;
}
static KrtCompileWorkspace KrtDriverLastWorkspace = null;

void KrtCompileReleaseAbiBytes(KrtAbiBytes bytes) {
    if (bytes == null) { return; }
    if (bytes.data != null) { delete bytes.data; }
    delete bytes;
}

void KrtCompileReleaseSsa(KrtSsaModule ssa) {
    if (ssa == null) { return; }
    delete ssa.ops; delete ssa.args; delete ssa.extra;
    delete ssa.types; delete ssa.widths; delete ssa.results;
    delete ssa.semantic_types; delete ssa.semantic_widths;
    delete ssa.operand_starts; delete ssa.operand_counts; delete ssa.operands;
    delete ssa.phi_predecessors; delete ssa.uses; delete ssa.value_blocks;
    delete ssa.starts; delete ssa.ends; delete ssa.function_blocks; delete ssa.function_block_counts;
    delete ssa.block_starts; delete ssa.block_ends; delete ssa.block_phis; delete ssa.block_phi_counts;
    delete ssa.block_functions; delete ssa.block_left; delete ssa.block_right; delete ssa.handlers;
    delete ssa;
}

void KrtCompileReleaseModule(KrtNativeModule module) {
    if (module == null) { return; }
    KrtCompileReleaseSsa(module.ssa); module.ssa = null;
    if (module.runtime_build_keys != null) {
        int32 bucket = 0;
        while (bucket < 4096) {
            KrtNativeRuntimeKey key = module.runtime_build_keys[bucket];
            while (key != null) { KrtNativeRuntimeKey next = key.next; delete key; key = next; }
            bucket = bucket + 1;
        }
        delete module.runtime_build_keys; module.runtime_build_keys = null;
    }
    if (module.runtime_build_bytes != null) {
        delete module.runtime_build_bytes.data; delete module.runtime_build_bytes;
        module.runtime_build_bytes = null;
    }
    KrtNativeRuntimeType runtime_type = module.runtime_types;
    while (runtime_type != null) {
        KrtNativeRuntimeType next_type = runtime_type.next;
        KrtNativeRuntimeMethod method = runtime_type.methods;
        while (method != null) {
            KrtNativeRuntimeMethod next_method = method.next;
            KrtCompileReleaseAbiBytes(method.identity);
            delete method; method = next_method;
        }
        KrtCompileReleaseAbiBytes(runtime_type.identity);
        delete runtime_type; runtime_type = next_type;
    }
    KrtNativeRuntimeRelocation relocation = module.runtime_relocations;
    while (relocation != null) {
        KrtNativeRuntimeRelocation next = relocation.next; delete relocation; relocation = next;
    }
    KrtNativeExceptionFrame frame = module.allocated_exception_frames;
    while (frame != null) {
        KrtNativeExceptionFrame next = frame.allocated_next; delete frame; frame = next;
    }
    delete module.runtime_buckets; delete module.runtime_bytes; delete module.runtime_offsets;
    delete module.runtime_code_offsets; delete module.runtime_code_targets;
    delete module.ops; delete module.args; delete module.extra;
    delete module.starts; delete module.local_counts; delete module.parameter_counts;
    delete module.aggregate_return_sizes; delete module.aggregate_return_alignments;
    delete module.hidden_result_slots; delete module.function_frame_bytes;
    delete module.global_entries; delete module.global_reloc_offsets; delete module.global_reloc_slots;
    delete module.function_offsets; delete module.function_sizes; delete module.external_used;
    delete module.external_reloc_offsets; delete module.external_reloc_targets;
    delete module.function_name_starts; delete module.function_name_lengths; delete module.data_storage;
    delete module;
}

void KrtCompileReleaseAstState(KrtAstNode unit) {
    if (unit == null) { return; }
    KrtNativeFunctionIndexInvalidate(unit);
    KrtGenericRegistry registry = unit.native_generic_registry;
    if (registry != null) {
        delete registry.declarations; delete registry.arguments; delete registry.instances; delete registry.states;
        delete registry;
        unit.native_generic_registry = null;
    }
    KrtNativeGlobalState globals = unit.native_globals;
    if (globals != null) {
        KrtNativeGlobalEntry entry = globals.first;
        while (entry != null) {
            KrtNativeGlobalEntry next = entry.next;
            if (entry.symbol_name != null) { delete entry.symbol_name.bytes; delete entry.symbol_name; }
            if (entry.guard_name != null && entry.guard_name != entry.symbol_name) { delete entry.guard_name.bytes; delete entry.guard_name; }
            if (entry.initializer_name != null) { delete entry.initializer_name.bytes; delete entry.initializer_name; }
            if (entry.module_guard && entry.declaration != null) { delete entry.declaration; }
            delete entry; entry = next;
        }
        delete globals;
        unit.native_globals = null;
    }
    KrtInheritanceStack inheritance = unit.native_inheritance_stack;
    if (inheritance != null) {
        delete inheritance.types; delete inheritance.cycle_types; delete inheritance;
        unit.native_inheritance_stack = null;
    }
    unit.native_function_index = null;
}

bool KrtCompileAstPush(KrtCompileAstQueue queue, KrtAstNode node) {
    if (!queue.ok || node == null || node.native_destroy_mark) { return queue.ok; }
    node.native_destroy_mark = true;
    if (queue.count == queue.capacity) {
        if (queue.capacity > 16777216) { node.native_destroy_mark = false; queue.ok = false; return false; }
        int32 capacity = queue.capacity == 0 ? 128 : queue.capacity * 2;
        KrtAstNode[] expanded = new KrtAstNode[capacity];
        if (expanded == null) { node.native_destroy_mark = false; queue.ok = false; return false; }
        int32 index = 0;
        while (index < queue.count) { expanded[index] = queue.nodes[index]; index = index + 1; }
        delete queue.nodes; queue.nodes = expanded; queue.capacity = capacity;
    }
    queue.nodes[queue.count] = node; queue.count = queue.count + 1; return true;
}

void KrtCompileAstQueueScope(KrtCompileAstQueue queue, KrtUsingScope scope) {
    while (queue.ok && scope != null && !scope.destroy_mark) {
        scope.destroy_mark = true; scope.release_next = queue.scopes; queue.scopes = scope;
        KrtCompileAstPush(queue,scope.imports); KrtCompileAstPush(queue,scope.namespace_scope);
        scope = scope.parent;
    }
}

void KrtCompileAstQueueSignature(KrtCompileAstQueue queue, KrtNativeSignatureCache signature) {
    if (!queue.ok || signature == null || signature.destroy_mark) { return; }
    signature.destroy_mark = true; signature.release_next = queue.signatures; queue.signatures = signature;
    KrtCompileAstPush(queue,signature.module); KrtCompileAstPush(queue,signature.scope);
    KrtCompileAstPush(queue,signature.context); KrtCompileAstPush(queue,signature.owner); KrtCompileAstPush(queue,signature.result);
    KrtCompileAstQueueScope(queue,signature.using_scope);
    int32 index = 0;
    while (queue.ok && signature.parameters != null && index < signature.parameter_count) {
        KrtCompileAstPush(queue,signature.parameters[index]); index = index + 1;
    }
}

void KrtCompileAstQueueGenerator(KrtCompileAstQueue queue, KrtNativeGeneratorPlan generator) {
    if (!queue.ok || generator == null || generator.destroy_mark) { return; }
    generator.destroy_mark = true; generator.release_next = queue.generators; queue.generators = generator;
    KrtCompileAstPush(queue,generator.factory); KrtCompileAstPush(queue,generator.body);
    KrtCompileAstPush(queue,generator.sequence_type); KrtCompileAstPush(queue,generator.cursor_type);
    KrtCompileAstPush(queue,generator.enumerable_type); KrtCompileAstPush(queue,generator.enumerator_type);
    KrtCompileAstPush(queue,generator.element_type); KrtCompileAstPush(queue,generator.get_method);
    KrtCompileAstPush(queue,generator.move_method); KrtCompileAstPush(queue,generator.current_method);
    KrtCompileAstPush(queue,generator.dispose_method); KrtCompileAstPush(queue,generator.get_requirement);
    KrtCompileAstPush(queue,generator.move_requirement); KrtCompileAstPush(queue,generator.current_requirement);
    KrtCompileAstPush(queue,generator.dispose_requirement); KrtCompileAstPush(queue,generator.parameters);
}

void KrtCompileAstQueueCapture(KrtCompileAstQueue queue, KrtNativeCapture capture) {
    while (queue.ok && capture != null && !capture.destroy_mark) {
        capture.destroy_mark = true; capture.release_next = queue.captures; queue.captures = capture;
        KrtCompileAstPush(queue,capture.provider); KrtCompileAstPush(queue,capture.declaration);
        capture = capture.next;
    }
}

void KrtCompileAstQueueCellOwners(KrtCompileAstQueue queue, KrtNativeCellOwner owner) {
    while (queue.ok && owner != null && !owner.destroy_mark) {
        owner.destroy_mark = true; owner.release_next = queue.cell_owners; queue.cell_owners = owner;
        KrtCompileAstPush(queue,owner.declaration); owner = owner.next;
    }
}

void KrtCompileAstReleaseMarks(KrtCompileAstQueue queue) {
    int32 index = 0;
    while (index < queue.count) { queue.nodes[index].native_destroy_mark = false; index = index + 1; }
    KrtUsingScope scope = queue.scopes;
    while (scope != null) { KrtUsingScope next = scope.release_next; scope.destroy_mark = false; scope.release_next = null; scope = next; }
    KrtNativeSignatureCache signature = queue.signatures;
    while (signature != null) { KrtNativeSignatureCache next = signature.release_next; signature.destroy_mark = false; signature.release_next = null; signature = next; }
    KrtNativeGeneratorPlan generator = queue.generators;
    while (generator != null) { KrtNativeGeneratorPlan next = generator.release_next; generator.destroy_mark = false; generator.release_next = null; generator = next; }
    KrtNativeCapture capture = queue.captures;
    while (capture != null) { KrtNativeCapture next = capture.release_next; capture.destroy_mark = false; capture.release_next = null; capture = next; }
    KrtNativeCellOwner owner = queue.cell_owners;
    while (owner != null) { KrtNativeCellOwner next = owner.release_next; owner.destroy_mark = false; owner.release_next = null; owner = next; }
    delete queue.nodes; delete queue;
}

bool KrtCompileReleaseAstGraph(KrtAstNode root, KrtNativeModule module, KrtUsingScope parser_scope) {
    KrtCompileAstQueue queue = new KrtCompileAstQueue();
    if (queue == null) { return false; }
    queue.ok = true; KrtCompileAstPush(queue,root);
    KrtCompileAstQueueScope(queue,parser_scope);
    if (module != null) {
        KrtCompileAstPush(queue,module.ast); KrtCompileAstPush(queue,module.function_ast);
        KrtCompileAstPush(queue,module.external_head); KrtCompileAstQueueGenerator(queue,module.generator);
        KrtNativeExceptionFrame allocated_frame = module.allocated_exception_frames;
        while (queue.ok && allocated_frame != null) {
            KrtCompileAstPush(queue,allocated_frame.finally_body); allocated_frame = allocated_frame.allocated_next;
        }
    }
    if (root != null) {
        KrtGenericRegistry registry = root.native_generic_registry;
        if (registry != null) {
            int32 slot = 0;
            while (queue.ok && slot < registry.capacity) {
                if (registry.declarations != null) { KrtCompileAstPush(queue,registry.declarations[slot]); }
                if (registry.arguments != null) { KrtCompileAstPush(queue,registry.arguments[slot]); }
                if (registry.instances != null) { KrtCompileAstPush(queue,registry.instances[slot]); }
                slot = slot + 1;
            }
        }
        KrtNativeGlobalState globals = root.native_globals;
        if (globals != null) {
            KrtCompileAstPush(queue,globals.initializer);
            KrtNativeGlobalEntry entry = globals.first;
            while (queue.ok && entry != null) {
                if (!entry.module_guard) { KrtCompileAstPush(queue,entry.declaration); }
                KrtCompileAstPush(queue,entry.owner); KrtCompileAstPush(queue,entry.assignment); entry = entry.next;
            }
        }
        KrtInheritanceStack inheritance = root.native_inheritance_stack;
        if (inheritance != null) {
            int32 index = 0;
            while (queue.ok && inheritance.types != null && index < inheritance.depth) { KrtCompileAstPush(queue,inheritance.types[index]); index = index + 1; }
            index = 0;
            while (queue.ok && inheritance.cycle_types != null && index < inheritance.cycle_depth) { KrtCompileAstPush(queue,inheritance.cycle_types[index]); index = index + 1; }
        }
        KrtNativeFunctionIndex function_index = root.native_function_index;
        if (function_index != null) {
            int32 slot = 0;
            while (queue.ok && function_index.buckets != null && slot < function_index.capacity) {
                KrtNativeFunctionBucket bucket = function_index.buckets[slot];
                if (bucket != null) {
                    KrtNativeFunctionEntry entry = bucket.first;
                    while (queue.ok && entry != null) { KrtCompileAstPush(queue,entry.declaration); entry = entry.next; }
                }
                slot = slot + 1;
            }
        }
    }
    KrtNativeRuntimeType runtime_type = module == null ? null : module.runtime_types;
    while (runtime_type != null && queue.ok) { KrtCompileAstPush(queue,runtime_type.shape); runtime_type = runtime_type.next; }
    int32 index = 0;
    while (queue.ok && index < queue.count) {
        KrtAstNode node = queue.nodes[index]; index = index + 1;
        KrtCompileAstPush(queue,node.left); KrtCompileAstPush(queue,node.right); KrtCompileAstPush(queue,node.next);
        KrtCompileAstPush(queue,node.alternate); KrtCompileAstPush(queue,node.body); KrtCompileAstPush(queue,node.declarations);
        KrtCompileAstPush(queue,node.native_member_first); KrtCompileAstPush(queue,node.native_member_next);
        KrtCompileAstPush(queue,node.syntax_type); KrtCompileAstPush(queue,node.syntax_suffixes);
        KrtCompileAstPush(queue,node.syntax_array_size); KrtCompileAstPush(queue,node.syntax_parameter_types);
        KrtCompileAstPush(queue,node.syntax_permissions); KrtCompileAstPush(queue,node.syntax_declarations);
        KrtCompileAstPush(queue,node.native_type); KrtCompileAstPush(queue,node.native_element_type);
        KrtCompileAstPush(queue,node.native_object_type); KrtCompileAstPush(queue,node.native_function_pointer);
        KrtCompileAstPush(queue,node.native_scope); KrtCompileAstPush(queue,node.native_generic_parameters);
        KrtCompileAstPush(queue,node.native_constraints); KrtCompileAstPush(queue,node.native_type_arguments);
        KrtCompileAstPush(queue,node.native_generic_origin); KrtCompileAstPush(queue,node.native_instances);
        KrtCompileAstPush(queue,node.native_owner); KrtCompileAstPush(queue,node.native_target);
        KrtCompileAstPush(queue,node.native_external_next); KrtCompileAstPush(queue,node.native_base);
        KrtCompileAstPush(queue,node.native_interfaces); KrtCompileAstPush(queue,node.native_base_call);
        KrtCompileAstPush(queue,node.native_dispatch_slot); KrtCompileAstPush(queue,node.native_variable);
        KrtCompileAstPush(queue,node.native_lexical_block); KrtCompileAstPush(queue,node.native_lexical_function);
        KrtCompileAstPush(queue,node.native_closure_signature); KrtCompileAstPush(queue,node.native_closure_expected_type);
        KrtCompileAstPush(queue,node.native_context);
        KrtCompileAstQueueScope(queue,node.native_using_scope);
        KrtCompileAstQueueSignature(queue,node.native_signature_cache);
        KrtCompileAstQueueGenerator(queue,node.native_generator);
        KrtCompileAstQueueCapture(queue,node.native_captures);
        KrtCompileAstQueueCellOwners(queue,node.native_cell_owners);
    }
    if (!queue.ok) { KrtCompileAstReleaseMarks(queue); return false; }
    KrtCompileReleaseAstState(root);

    KrtNativeSignatureCache signature = queue.signatures;
    while (signature != null) {
        KrtNativeSignatureCache next = signature.release_next;
        delete signature.parameters; delete signature.parameter_starts; delete signature.parameter_lengths;
        delete signature; signature = next;
    }
    KrtUsingScope scope = queue.scopes;
    while (scope != null) { KrtUsingScope next = scope.release_next; delete scope; scope = next; }
    KrtNativeGeneratorPlan generator = queue.generators;
    while (generator != null) {
        KrtNativeGeneratorPlan next = generator.release_next;
        KrtNativeGeneratorResume resume = generator.resumes;
        while (resume != null) { KrtNativeGeneratorResume following = resume.next; delete resume; resume = following; }
        delete generator; generator = next;
    }
    KrtNativeCapture capture = queue.captures;
    while (capture != null) { KrtNativeCapture next = capture.release_next; delete capture; capture = next; }
    KrtNativeCellOwner owner = queue.cell_owners;
    while (owner != null) { KrtNativeCellOwner next = owner.release_next; delete owner; owner = next; }
    index = 0;
    while (index < queue.count) {
        KrtAstNode node = queue.nodes[index]; index = index + 1;
        if (node.owns_parameter_starts) { delete node.parameter_starts; }
        if (node.owns_parameter_lengths) { delete node.parameter_lengths; }
        if (node.owns_parameter_type_starts) { delete node.parameter_type_starts; }
        if (node.owns_parameter_type_lengths) { delete node.parameter_type_lengths; }
        if (node.owns_parameter_refs) { delete node.parameter_refs; }
        delete node;
    }
    delete queue.nodes; delete queue; return true;
}

void KrtCompileWorkspaceRelease(KrtCompileWorkspace workspace) {
    if (workspace == null) { return; }
    if (KrtDriverLastModule == workspace.module) { KrtDriverLastModule = null; }
    if (workspace.parser != null) {
        KrtParserDiagnostic diagnostic = workspace.parser.diagnostics;
        while (diagnostic != null) {
            KrtParserDiagnostic next = diagnostic.next; delete diagnostic; diagnostic = next;
        }
    }
    KrtUsingScope parser_scope = workspace.parser == null ? null : workspace.parser.current_using_scope;
    if (!KrtCompileReleaseAstGraph(workspace.unit,workspace.module,parser_scope)) {
        KrtCompileReleaseAstState(workspace.unit);
    }
    KrtCompileReleaseModule(workspace.module);
    if (workspace.parser != null) { delete workspace.parser; }
    if (workspace.token != null) { delete workspace.token; }
    if (workspace.lexer != null) { delete workspace.lexer; }
    delete workspace;
}

bool KrtCompileSource(string source, int32 source_length, KrtKroObject output) {
    KrtLexer lexer = new KrtLexer();
    KrtToken token = new KrtToken();
    KrtParser parser = new KrtParser();
    KrtIrFunction ir_function = new KrtIrFunction();
    bool ok = false;
    unsafe(using krt.mem;) {
        if (!KrtLexerInit(lexer, (byte*)(int64)source, source_length)) {
            delete ir_function; delete parser; delete token; delete lexer; return false;
        }
    }
    KrtParserInit(parser, lexer, token);
    KrtAstNode compilation_unit = KrtParserParseCompilationUnit(parser);
    KrtSemanticOrderHelperFirst(compilation_unit, lexer.source);
    KrtAstNode unit = compilation_unit.left;
    KrtAstNode main_unit = null;
    while (unit != null) {
        if (KrtSemanticIsMain(unit, lexer.source)) { main_unit = unit; break; }
        unit = unit.next;
    }
    unit = main_unit;
    bool semantic_ok = false;
    if (!ok && compilation_unit.child_count == 2 && parser.errors == 0 && KrtSemanticValidateFunctionNames(compilation_unit, lexer.source) &&
        KrtSemanticResolveModuleCalls(compilation_unit, lexer.source) &&
        KrtSemanticValidateEntryPoint(compilation_unit, lexer.source) &&
        KrtKroEmitConstantTwoArgumentCall(compilation_unit, output)) {
        ok = true;
    } else if (!ok && compilation_unit.child_count == 2 && parser.errors == 0 && KrtSemanticValidateFunctionNames(compilation_unit, lexer.source) &&
        KrtSemanticResolveModuleCalls(compilation_unit, lexer.source) &&
        KrtSemanticValidateEntryPoint(compilation_unit, lexer.source) &&
        KrtSemanticValidateConstantArgumentCall(compilation_unit, lexer.source) &&
        KrtKroEmitConstantArgumentCall(compilation_unit, output)) {
        ok = true;
    } else if (!ok && parser.errors == 0 && KrtSemanticValidateFunctionNames(compilation_unit, lexer.source) &&
        KrtSemanticValidateEntryPoint(compilation_unit, lexer.source) && compilation_unit.child_count == 2 &&
        KrtSemanticValidateConstantHelperCall(compilation_unit, lexer.source) &&
        KrtKroEmitConstantHelperCall(compilation_unit, output)) {
        ok = true;
    } else if (!ok && compilation_unit.child_count == 1) { semantic_ok = KrtSemanticValidateFunction(unit); }
    else if (!ok) {
        // Preserve compact constant objects for the original object API.
        // General executable compilation uses KrtCompileNativeSource below.
        semantic_ok = KrtSemanticInlineConstantCall(compilation_unit, lexer.source) &&
            unit != null && KrtSemanticValidateFunction(unit);
    }
    if (!ok && parser.errors == 0 && KrtSemanticValidateFunctionNames(compilation_unit, lexer.source) &&
        KrtSemanticValidateEntryPoint(compilation_unit, lexer.source) && semantic_ok && unit != null && KrtSemanticBindLocals(unit, lexer.source) &&
        KrtIrLowerReturnFunction(unit, ir_function)) {
        ok = KrtKroEmitIrFunction(ir_function, output);
    }
    if (!ok && parser.errors == 0) { ok = KrtCompileNativeSource(source, source_length, output); }
    delete ir_function;
    delete compilation_unit;
    delete parser;
    delete token;
    delete lexer;
    return ok;
}

bool KrtCompileSourceToFd(string source, int32 source_length, int64 file_descriptor) {
    KrtKroObject object = new KrtKroObject();
    if (!KrtCompileSource(source, source_length, object)) {
        delete object;
        return false;
    }
    bool header_ok = KrtKroWriteHeader(object, file_descriptor);
    bool text_ok = header_ok && KrtKroWriteText(object, file_descriptor);
    bool symbols_ok = text_ok && KrtKroWriteSymbols(object, file_descriptor);
    delete object;
    return header_ok && text_ok && symbols_ok;
}

bool KrtCompileSourceToPath(string source, int32 source_length, string path) {
    int64 file_descriptor = syscall(2, (int64)path, 577, 420, 0, 0, 0);
    if (file_descriptor < 0) { return false; }
    bool result = KrtCompileSourceToFd(source, source_length, file_descriptor);
    syscall(3, file_descriptor, 0, 0, 0, 0, 0);
    return result;
}

// Executable compilation always uses the complete module pipeline. The compact
// KrtCompileSource entry above remains available for the original object ABI.
bool KrtCompileNativeSource(string source, int32 source_length, KrtKroObject output) {
    return KrtCompileNativeSourceMode(source, source_length, output, false);
}

bool KrtCompileNativeSourceMode(string source, int32 source_length, KrtKroObject output, bool library_mode) {
    KrtCompilerDiagnostics previous = KrtCurrentDiagnostics;
    KrtCompilerDiagnostics report = new KrtCompilerDiagnostics(); report.limit = 64; report.stage = KrtDiagnosticStage.Parser;
    KrtCurrentDiagnostics = report;
    bool result = KrtCompileNativeSourceModeCore(source,source_length,output,library_mode);
    if (!result) { KrtErrorReportFlush(report); }
    KrtCurrentDiagnostics = previous; return result;
}

bool KrtCompileNativeSourceModeCore(string source, int32 source_length, KrtKroObject output, bool library_mode) {
    if (KrtDriverLastWorkspace != null) {
        KrtCompileWorkspaceRelease(KrtDriverLastWorkspace);
        KrtDriverLastWorkspace = null;
    }
    KrtCompileWorkspace workspace = new KrtCompileWorkspace();
    bool result = KrtCompileNativeSourceModeCoreRun(source, source_length, output, library_mode, workspace);
    if (result) { KrtDriverLastWorkspace = workspace; }
    else { KrtCompileWorkspaceRelease(workspace); }
    return result;
}

bool KrtCompileNativeSourceModeCoreRun(string source, int32 source_length, KrtKroObject output, bool library_mode,
                                       KrtCompileWorkspace workspace) {
    int32 original_length = source_length;
    bool print_runtime = KrtPrintRuntimeRequired((int64)source,source_length);
    if (print_runtime) {
        int64 original = KrtDriverCopyString((int64)source,source_length);
        int64 extended = KrtDriverConcat(original,(int64)KrtPrintRuntimeSource());
        if (extended == 0) { return false; }
        source = (string)extended; source_length = (int32)KrtDriverStringLength(extended);
    }
    KrtLexer lexer = new KrtLexer(); workspace.lexer = lexer;
    KrtToken token = new KrtToken(); workspace.token = token;
    KrtParser parser = new KrtParser(); workspace.parser = parser;
    KrtNativeModule native_module = new KrtNativeModule(); workspace.module = native_module;
    unsafe(using krt.mem;) {
        if (!KrtLexerInit(lexer, (byte*)(int64)source, source_length)) { return false; }
    }
    KrtParserInit(parser, lexer, token);
    KrtAstNode unit = KrtParserParseCompilationUnit(parser);
    workspace.unit = unit;
    if (print_runtime) {
        KrtAstNode helper = unit.left;
        while (helper != null) { if (helper.start >= original_length) { helper.op = 241; } helper = helper.next; }
    }
    if (parser.errors != 0) {
        KrtParserDiagnostic diagnostic = parser.diagnostics;
        if (diagnostic == null) { KrtDiagnostic("E_PARSE",7,parser.error_start); }
        while (diagnostic != null) {
            KrtDiagnosticMessage("E_PARSE",7,diagnostic.position,diagnostic.message); diagnostic = diagnostic.next;
        }
        return false;
    }
    if(!KrtModulesMarkImportedAst(unit)||!KrtModulesMergeImportedAst(unit,lexer.source)){return false;}
    KrtCurrentDiagnostics.stage = KrtDiagnosticStage.Names;
    if (!KrtNativeValidateAccess(unit,lexer.source,native_module)) { return false; }
    if (!KrtNativeResolvePrototypes(unit, lexer.source)) { KrtDiagnostic("E_LINKAGE", 9, 0); return false; }
    bool has_main = false; KrtAstNode candidate = unit.left;
    while (candidate != null) { if (KrtSemanticIsMain(candidate, lexer.source)) { has_main = true; } candidate = candidate.next; }
    library_mode = library_mode && !has_main;
    if (!KrtSemanticValidateFunctionNames(unit, lexer.source) || (!library_mode && !KrtSemanticValidateEntryPoint(unit, lexer.source))) {
        KrtDiagnostic("E_MODULE", 8, 0); return false;
    }
    if (library_mode && unit.left == null && unit.declarations == null && unit.body==null) {
        if (!KrtKroEmitLibraryData(unit, lexer.source, output)) { KrtDiagnostic("E_LIBRARY_DATA", 14, unit.start); return false; }
        return KrtKroModuleMetadata(unit,lexer.source,output);
    }
    if (library_mode) { unit.op = 240; }
    KrtCurrentDiagnostics.stage = KrtDiagnosticStage.Types;
    if (!KrtNativeLowerModule(unit, lexer.source, native_module)) {
        if (KrtErrorReportHasErrors()) { return false; }
        if (unit.native_error == 1) { KrtDiagnostic("E_CONDITIONAL_ARRAY", 19, native_module.error_start); }
        else if (unit.native_error == 2) { KrtDiagnostic("E_ARGUMENT_COUNT", 16, native_module.error_start); }
        else if (unit.native_error == 3) { KrtDiagnostic("E_WRITABLE_REF", 14, native_module.error_start); }
        else if (unit.native_error == 4) { KrtDiagnostic("E_UNDEFINED_METHOD", 18, native_module.error_start); }
        else if (unit.native_error == 5) { KrtDiagnostic("E_NOT_NULLABLE", 14, native_module.error_start); }
        else if (unit.native_error == 6) { KrtDiagnostic("E_GENERIC_CONSTRAINT", 20, native_module.error_start); }
        else if (unit.native_error == 7) { KrtDiagnostic("E_SWITCH", 8, native_module.error_start); }
        else if (unit.native_error == 8) { KrtInheritanceDiagnostic(unit,native_module.error_start); }
        else if (unit.native_error == 9) { KrtDiagnostic("E_ARGUMENT_NAME", 15, native_module.error_start); }
        else if (unit.native_error == 10) { KrtDiagnostic("E_ACCESS", 8, native_module.error_start); }
        else if (unit.native_error == 11) { KrtDiagnostic("E_MODIFIER", 10, native_module.error_start); }
        else if (unit.native_error == 12) { KrtDiagnostic("E_LAYOUT", 8, native_module.error_start); }
        else if (unit.native_error == 13) { KrtDiagnostic("E_ABI_UNSUPPORTED", 17, native_module.error_start); }
        else if (unit.native_error == 14) { KrtDiagnostic("E_CAPTURE_BORROW", 16, native_module.error_start); }
        else if (unit.native_error == 15) { KrtDiagnostic("E_BOXING", 8, native_module.error_start); }
        else if (unit.native_error == 16) { KrtDiagnostic("E_ITERATOR", 10, native_module.error_start); }
        else { KrtDiagnostic("E_LOWER", 7, native_module.error_start); }
        return false;
    }
    if (library_mode && KrtDriverArtifactTarget != 2 && KrtDriverArtifactTarget != 4 &&
        (KrtKroLibraryStaticData(native_module,unit)||native_module.function_count==0)) {
        if(!KrtKroEmitLibrarySections(native_module,unit,lexer.source,output)){KrtDiagnostic("E_LIBRARY_DATA",14,unit.start);return false;}
        return KrtKroModuleMetadata(unit,lexer.source,output);
    }
    KrtCurrentDiagnostics.stage = KrtDiagnosticStage.Optimization;
    if (!KrtNativeOptimize(native_module, KrtDriverOptimization)) { KrtDiagnostic("E_OPTIMIZE", 10, 0); return false; }
    native_module.ssa = KrtSsaBuild(native_module,unit,lexer.source);
    if (native_module.ssa == null || !KrtSsaOptimize(native_module.ssa,KrtDriverOptimization)) { KrtDiagnostic("E_SSA",5,0); return false; }
    KrtDriverLastModule = native_module;
    if (KrtDriverArtifactTarget == 2) { return true; }
    if (KrtDriverArtifactTarget == 4) {
        KrtDriverLastVm = new KrtDriverBuffer();
        if (!KrtVmEmit(native_module,KrtDriverLastVm)) { KrtDiagnostic("E_VM", 4, 0); return false; }
        return true;
    }
    KrtCurrentDiagnostics.stage = KrtDiagnosticStage.Backend;
    if (!KrtKroEmitNativeModule(native_module, output)) { KrtDiagnostic("E_EMIT", 6, 0); return false; }
    if (!KrtKroLibraryFunctions(native_module, unit, lexer.source, output)) { KrtDiagnostic("E_LIBRARY_SYMBOL", 16, 0); return false; }
    return KrtKroModuleMetadata(unit,lexer.source,output);
}

void KrtDiagnostic(string code, int32 code_length, int64 position) {
    KrtDiagnosticMessage(code,code_length,position,null);
}

void KrtDiagnosticWrite(string code, int32 code_length, int64 position, string message) {
    KrtDriverLastErrorCode = (int64)code;
    if (KrtDriverQuiet) { return; }
    if (KrtDriverActiveBundle != null) {
        KrtSourcesDiagnosticDetails(KrtDriverActiveBundle, code, code_length, position, message);
        return;
    }
    syscall(1, 2, (int64)code, code_length, 0, 0, 0);
    syscall(1, 2, (int64)" at byte ", 9, 0, 0, 0);
    unsafe(using krt.mem;) {
        byte* digits = stackalloc byte[24];
        int32 index = 23; digits[index] = 10;
        if (position < 0) { position = 0; }
        while (true) {
            index = index - 1;
            digits[index] = (byte)(48 + position % 10);
            position = position / 10;
            if (position == 0) { break; }
        }
        syscall(1, 2, (int64)(digits + index), 24 - index, 0, 0, 0);
    }
}

// Read legacy protocol input through the same heap-backed I/O as the CLI.
bool KrtCompilePath(string input_path, string output_path) {
    KrtDriverBuffer source = new KrtDriverBuffer();
    if (!KrtDriverReadFile((int64)input_path,source)) { KrtDiagnostic("E_INPUT",7,0); return false; }
    if (source.length < 0 || source.length > 16777216) { KrtDiagnostic("E_SIZE",6,source.length); return false; }
    KrtKroObject object = new KrtKroObject();
    int64 library_marker = syscall(2,(int64)"library.mode",0,0,0,0,0);
    bool library_mode = library_marker >= 0;
    if (library_mode) { syscall(3,library_marker,0,0,0,0,0); }
    if (!KrtCompileNativeSourceMode((string)source.data,(int32)source.length,object,library_mode)) { return false; }
    if (!KrtKroWriteObjectToPath(object,output_path)) { KrtDiagnostic("E_OUTPUT",8,0); return false; }
    return true;
}
