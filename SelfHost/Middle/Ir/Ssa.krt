                        previous = previous+1;
                    }
                } else if (ssa.value_blocks[incoming] == block && incoming >= value) { return false; }
                operand = operand+1;
            }
            value = value+1;
        }
        block = block+1;
    }
    return KrtSsaValidateDominance(ssa);
}

bool KrtSsaValidateDominance(KrtSsaModule ssa) {
    int32 function_index = 0;
    while (function_index < ssa.function_count) {
        int32 first = ssa.function_blocks[function_index]; int32 blocks = ssa.function_block_counts[function_index];
        int32 words = (blocks+63)/64;
        if (blocks <= 0 || (int64)blocks*words > 16777216) { return false; }
        int32[] heads = new int32[blocks]; int32[] next = new int32[blocks*2]; int32[] predecessors = new int32[blocks*2];
        int32[] queue = new int32[blocks]; bool[] reachable = new bool[blocks]; uint64[] dominators = new uint64[blocks*words];
        int32 relative = 0; while (relative < blocks) { heads[relative] = -1; relative = relative+1; }
        int32 edge = 0; int32 block = first;
        while (block < first+blocks) {
            int32 side = 0;
            while (side < 2) {
                int32 target = side == 0 ? ssa.block_left[block] : ssa.block_right[block];
                if (target >= 0) { predecessors[edge] = block; next[edge] = heads[target-first]; heads[target-first] = edge; edge = edge+1; }
                side = side+1;
            }
            block = block+1;
        }
        int32 head = 0; int32 tail = 1; queue[0] = first; reachable[0] = true;
        while (head < tail) {
            block = queue[head]; head = head+1; int32 side = 0;
            while (side < 2) {
                int32 target = side == 0 ? ssa.block_left[block] : ssa.block_right[block];
                if (target >= 0 && !reachable[target-first]) { reachable[target-first] = true; queue[tail] = target; tail = tail+1; }
                side = side+1;
            }
        }
        relative = 0;
        while (relative < blocks) {
            int32 word = 0;
            while (word < words) { dominators[relative*words+word] = relative == 0 || !reachable[relative] ? 0 : (uint64)-1; word = word+1; }
            dominators[relative*words+relative/64] = dominators[relative*words+relative/64] | ((uint64)1 << (relative%64));
            relative = relative+1;
        }
        bool changed = true;
        while (changed) {
            changed = false; relative = 1;
            while (relative < blocks) {
                if (reachable[relative]) {
                    int32 word = 0;
                    while (word < words) {
                        uint64 bits = (uint64)-1; int32 item = heads[relative]; bool found = false;
                        while (item >= 0) {
                            int32 predecessor = predecessors[item]-first;
                            if (reachable[predecessor]) { bits = bits & dominators[predecessor*words+word]; found = true; }
                            item = next[item];
                        }
                        if (!found) { return false; }
                        if (word == relative/64) { bits = bits | ((uint64)1 << (relative%64)); }
                        int32 cell = relative*words+word;
                        if (dominators[cell] != bits) { dominators[cell] = bits; changed = true; }
                        word = word+1;
                    }
                }
                relative = relative+1;
            }
        }
        block = first;
        while (block < first+blocks) {
            int32 value = ssa.block_starts[block];
            while (value < ssa.block_ends[block]) {
                int32 operand = 0;
                while (operand < ssa.operand_counts[value]) {
                    int32 position = ssa.operand_starts[value]+operand; int32 incoming = ssa.operands[position];
                    int32 use_block = ssa.ops[value] == 101 ? ssa.phi_predecessors[position] : block;
                    int32 definition = ssa.value_blocks[incoming]-first;
                    if (reachable[use_block-first] && (dominators[(use_block-first)*words+definition/64] & ((uint64)1 << (definition%64))) == 0) { return false; }
                    if (ssa.ops[value] == 101 && (ssa.types[incoming] != ssa.types[value] || ssa.widths[incoming] != ssa.widths[value])) { return false; }
                    operand = operand+1;
                }
                value = value+1;
            }
            block = block+1;
        }
        delete heads; delete next; delete predecessors; delete queue; delete reachable; delete dominators;
        function_index = function_index+1;
    }
    return true;
}

bool KrtSsaWriteIr(KrtSsaModule ssa, int64 descriptor) {
    if (!KrtSsaValidate(ssa) || !KrtArtifactText(descriptor,"; Kairote typed SSA IR\n")) { return false; }
    int32 function_index = 0;
    while (function_index < ssa.function_count) {
        int64 header = KrtDriverConcat((int64)"function ",KrtDriverNumber(function_index));
        if (!KrtArtifactText(descriptor,(string)header) || !KrtArtifactText(descriptor," {\n")) { return false; }
        int32 block = ssa.function_blocks[function_index]; int32 last = block+ssa.function_block_counts[function_index];
        while (block < last) {
            int64 label = KrtDriverConcat((int64)"bb",KrtDriverNumber(block));
            if (!KrtArtifactText(descriptor,(string)label) || !KrtArtifactText(descriptor,":\n")) { return false; }
            int32 value = ssa.block_starts[block];
            while (value < ssa.block_ends[block]) {
                int32 op = ssa.ops[value];
                if (op != 0) {
                    int64 line = (int64)"  ";
                    if (ssa.results[value]) {
                        line = KrtDriverConcat(line,KrtDriverConcat((int64)"%",KrtDriverNumber(value)));
                        string kind = "i";
                        line = KrtDriverConcat(line,KrtDriverConcat((int64)":",(int64)kind));
                        line = KrtDriverConcat(line,KrtDriverConcat(KrtDriverNumber(ssa.widths[value]),(int64)" = "));
                    }
                    string name = op == 100 ? "parameter" : op == 101 ? "phi" : KrtArtifactOp(op);
                    line = KrtDriverConcat(line,(int64)name);
                    if (op == 1 || op == 100 || op == 17 || op == 18 || op == 19 || op == 28 || op == 29 || op == 2 || op == 3 || op == 50 || op == 70 || op == 71 || op == 72) {
                        line = KrtDriverConcat(line,KrtDriverConcat((int64)" ",KrtDriverNumber(ssa.args[value])));
                        if (op == 18 || op == 70 || op == 71 || op == 72) { line = KrtDriverConcat(line,KrtDriverConcat((int64)" ",KrtDriverNumber(ssa.extra[value]))); }
                    }
                    int32 operand = 0;
                    while (operand < ssa.operand_counts[value]) {
                        int32 position = ssa.operand_starts[value]+operand;
                        if (op == 101) { line = KrtDriverConcat(line,KrtDriverConcat((int64)" [bb",KrtDriverNumber(ssa.phi_predecessors[position]))); line = KrtDriverConcat(line,(int64)":"); }
                        else { line = KrtDriverConcat(line,(int64)" "); }
                        line = KrtDriverConcat(line,KrtDriverConcat((int64)"%",KrtDriverNumber(ssa.operands[position])));
                        if (op == 101) { line = KrtDriverConcat(line,(int64)"]"); }
                        operand = operand+1;
                    }
                    if (ssa.results[value] && ssa.semantic_types[value] != 1 && ssa.semantic_types[value] != 0) {
                        string semantic = ssa.semantic_types[value] == 2 ? "float" : ssa.semantic_types[value] == 3 ? "pointer" : ssa.semantic_types[value] == 5 ? "aggregate-address" : "boxed-wide";
                        line = KrtDriverConcat(line,KrtDriverConcat((int64)" ; ",(int64)semantic));
                        int32 semantic_width = ssa.semantic_widths[value]; if (semantic_width < 0) { semantic_width = -semantic_width; }
                        line = KrtDriverConcat(line,KrtDriverNumber(semantic_width*8));
                    }
                    if (!KrtArtifactText(descriptor,(string)line) || !KrtArtifactText(descriptor,"\n")) { return false; }
                }
                value = value+1;
            }
            block = block+1;
        }
        if (!KrtArtifactText(descriptor,"}\n")) { return false; }
        function_index = function_index+1;
    }
    return true;
}
