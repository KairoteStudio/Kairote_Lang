    int32 allocated = KrtNativeEmit(module, (int32)KrtNativeOp.Branch, -1, -1);
    int64 identity = KrtNativeExceptionType(expression, module_ast);
    if (allocated < 0 || identity < 0 || KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, expression.local_slot, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.Const, identity, 0) < 0 || KrtNativeEmit(module, (int32)KrtNativeOp.Store, 0, 8) < 0) { return false; }
    if (expression.native_target != null) {
        if (KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, expression.local_slot, 0) < 0) { return false; }
        if (!KrtNativeLowerArguments(expression.right, expression.native_target, 1, module_ast, module, source)) { return false; }
        if (KrtNativeEmit(module, (int32)KrtNativeOp.Call, expression.native_target.value, expression.native_target.parameter_count) < 0 || KrtNativeEmit(module, (int32)KrtNativeOp.Drop, 0, 0) < 0) { return false; }
    }
    module.args[allocated] = allocated + 1; module.extra[allocated] = module.count;
    return KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, expression.local_slot, 0) >= 0;
}

bool KrtNativeLowerArrayLiteral(KrtAstNode expression, KrtAstNode module_ast, KrtNativeModule module, int64 source) {
    int32 stride = KrtNativeSemanticStride(expression);
    if (stride <= 0 || KrtNativeEmit(module, (int32)KrtNativeOp.Const, expression.child_count, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.Allocate, stride, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.Dup, 0, 0) < 0) { return false; }
    int32 allocated = KrtNativeEmit(module, (int32)KrtNativeOp.Branch, -1, -1);
    if (allocated < 0) { return false; }
    KrtAstNode element = expression.left; int32 index = 0;
    KrtAstNode item_type = KrtNativeArrayElement(expression);
    while (element != null) {
        if (KrtNativeEmit(module, (int32)KrtNativeOp.Dup, 0, 0) < 0 ||
            KrtNativeEmit(module, (int32)KrtNativeOp.Address, 0, index * stride) < 0 ||
            !KrtNativeLowerExpression(element, module_ast, module, source)) { return false; }
        if (KrtNativeInlineValue(item_type)) {
            if (!KrtNativeLowerAggregateCopy(item_type,module)) { return false; }
        } else if (!KrtNativeConvertValue(module, element, item_type) ||
            KrtNativeEmit(module, (int32)KrtNativeOp.Store, 0, stride) < 0) { return false; }
        element = element.next; index = index + 1;
    }
    module.args[allocated] = allocated + 1; module.extra[allocated] = module.count;
    return index == expression.child_count;
}

bool KrtNativeLowerForeach(KrtAstNode statement, KrtAstNode module_ast, KrtAstNode unit, KrtNativeModule module, int64 source, int32[] breaks, int32[] continues, ref int32 depth) {
    if (depth >= 64 || !KrtNativeLowerExpression(statement.right, module_ast, module, source) ||
        KrtNativeEmit(module, (int32)KrtNativeOp.StoreLocal, statement.native_offset, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.Const, 0, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.StoreLocal, statement.native_size, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, statement.native_offset, 0) < 0) { return false; }
    int32 nonnull = KrtNativeEmit(module, (int32)KrtNativeOp.Branch, -1, -1);
    if (nonnull < 0 || KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, statement.native_offset, 0) < 0) { return false; }
    if (statement.right.native_string) {
        if (KrtNativeEmit(module, (int32)KrtNativeOp.StringLength, 0, 0) < 0) { return false; }
    } else if (statement.right.native_fixed_length > 0) {
        if (KrtNativeEmit(module,(int32)KrtNativeOp.Drop,0,0) < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.Const,statement.right.native_fixed_length,0) < 0) { return false; }
    } else if (KrtNativeEmit(module, (int32)KrtNativeOp.Address, 0, -16) < 0 || KrtNativeEmit(module, (int32)KrtNativeOp.Load, 0, 8) < 0) { return false; }
    if (KrtNativeEmit(module, (int32)KrtNativeOp.StoreLocal, statement.local_slot, 0) < 0) { return false; }
    int32 condition = module.count;
    if (KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, statement.native_size, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, statement.local_slot, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.Compare, 60, 0) < 0) { return false; }
    int32 branch = KrtNativeEmit(module, (int32)KrtNativeOp.Branch, -1, -1);
    if (branch < 0) { return false; }
    if (KrtNativeInlineValue(statement.left) && !KrtNativeLowerAggregateFrame(statement.left,module)) { return false; }
    if (KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, statement.native_offset, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, statement.native_size, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.Address, 1, KrtNativeSemanticStride(statement.right)) < 0) { return false; }
    KrtAstNode item = KrtNativeArrayElement(statement.right);
    if (KrtNativeInlineValue(statement.left)) {
        if (!KrtNativeLowerAggregateCopy(statement.left,module)) { return false; }
    } else if (KrtNativeEmit(module, (int32)KrtNativeOp.Load, 0, KrtNativeWidth(item)) < 0 ||
        !KrtNativeConvertValue(module, item, statement.left) ||
        KrtNativeEmit(module, (int32)KrtNativeOp.StoreLocal, statement.left.local_slot, 0) < 0) { return false; }
    breaks[depth] = -1; continues[depth] = -1; depth = depth + 1;
    if (!KrtNativeLowerBlock(statement.body, module_ast, unit, module, source, breaks, continues, ref depth)) { return false; }
    int32 continue_target = module.count;
    if (KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, statement.native_size, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.Const, 1, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.Add, 0, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.StoreLocal, statement.native_size, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.Jump, condition, 0) < 0) { return false; }
    int32 end = module.count; depth = depth - 1;
    module.args[nonnull] = nonnull + 1; module.extra[nonnull] = end;
    module.args[branch] = branch + 1; module.extra[branch] = end;
    return KrtNativePatchLoop(module, breaks[depth], end) && KrtNativePatchLoop(module, continues[depth], continue_target);
}
