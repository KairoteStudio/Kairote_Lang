        }
        if (expression.op != 61 && expression.op != 101 && expression.op != 102 && expression.op != 103 && expression.op != 60 && expression.op != 62) { return false; }
        return KrtNativeEmit(module, (int32)KrtNativeOp.Compare, expression.op, (expression.left.native_unsigned && expression.left.native_width == 8) || (expression.right.native_unsigned && expression.right.native_width == 8) ? 1 : 0) >= 0;
    }
    if (expression.kind == KrtAstKind.Ternary) {
        if (!KrtNativeLowerTruth(expression.left, module_ast, module, source)) { return false; }
        int32 branch = KrtNativeEmit(module, (int32)KrtNativeOp.Branch, -1, -1);
        if (branch < 0 || !KrtNativeLowerExpression(expression.right, module_ast, module, source) || !KrtNativeConvertValue(module, expression.right, expression)) { return false; }
        int32 jump = KrtNativeEmit(module, (int32)KrtNativeOp.Jump, -1, 0);
        if (jump < 0) { return false; }
        int32 alternate = module.count;
        if (!KrtNativeLowerExpression(expression.alternate, module_ast, module, source) || !KrtNativeConvertValue(module, expression.alternate, expression)) { return false; }
        module.args[branch] = branch + 1; module.extra[branch] = alternate; module.args[jump] = module.count;
        return true;
    }
    if (expression.kind == KrtAstKind.Call) {
        if (expression.op == 222) { return KrtNativeLowerBaseConstructor(expression, module_ast, module, source); }
        if (expression.native_virtual) { return KrtNativeLowerDispatch(expression, module_ast, module, source); }
        KrtAstNode callee = expression.left;
        int32 function_index_local = -1;
        bool is_syscall = KrtNativeIsSyscall(callee, source);
        if (expression.native_target != null) { function_index_local = (int32)expression.native_target.value; }
        else if (callee != null && callee.kind == KrtAstKind.Identifier) { function_index_local = KrtNativeFindFunction(module_ast, callee, source); }
        else if (callee != null && callee.kind == KrtAstKind.Member) { function_index_local = KrtNativeFindMemberFunction(module_ast, callee, source); }
        int32 argument_count = 0; KrtAstNode argument = expression.right;
        if (KrtNativeInlineValue(expression) && !KrtNativeLowerAggregateFrame(expression,module)) { return false; }
        if (callee != null && callee.kind == KrtAstKind.Member && !callee.native_static) {
            if (!KrtNativeLowerCallReceiver(expression,callee.left,module_ast,module,source)) { return false; }
            argument_count = argument_count + 1;
        }
        if (expression.native_target != null) {
            if (!KrtNativeLowerArguments(argument, expression.native_target, argument_count, module_ast, module, source)) { return false; }
            argument_count = expression.native_target.parameter_count;
        } else {
            while (argument != null) {
                if (!KrtNativeLowerExpression(argument, module_ast, module, source)) { return false; }
                argument_count = argument_count + 1; argument = argument.next;
            }
        }
        if (is_syscall) {
            if (argument_count < 1 || argument_count > 7) { return false; }
            return KrtNativeEmit(module, (int32)KrtNativeOp.Syscall, 0, argument_count) >= 0;
        }
        if (function_index_local < 0 && (expression.native_target == null || expression.native_target.op != 221)) { module.errors = module.errors + 1; return false; }
        KrtAstNode function_node = expression.native_target;
        if (function_node == null) {
            function_node = module_ast.left; int32 index = 0;
            while (function_node != null && index < function_index_local) { function_node = function_node.next; index = index + 1; }
        }
        if (function_node == null || function_node.parameter_count != argument_count) { return false; }
        if (KrtNativeInlineValue(expression)) {
            return KrtNativeEmit(module,(int32)KrtNativeOp.Call,function_index_local,argument_count + 1) >= 0;
        }
        return KrtNativeEmit(module, (int32)KrtNativeOp.Call, function_index_local, argument_count) >= 0 &&
            (KrtNativeWideKind(expression) ? KrtNativeNormalizeWide(module,expression) : KrtNativeEmit(module, (int32)KrtNativeOp.Cast, KrtNativeValueWidth(expression), 0) >= 0);
    }
    return false;
}

bool KrtNativePatchLoop(KrtNativeModule module, int32 head, int32 target) {
    while (head >= 0) {
        if (head >= module.count || module.ops[head] != (int32)KrtNativeOp.Jump) { return false; }
        int32 next = (int32)module.extra[head]; module.args[head] = target; module.extra[head] = 0; head = next;
    }
    return true;
}

bool KrtNativeLowerStatement(KrtAstNode statement, KrtAstNode module_ast, KrtAstNode unit, KrtNativeModule module, int64 source, int32[] breaks, int32[] continues, ref int32 depth) {
    if (statement == null) { return false; }
    if (statement.kind == KrtAstKind.UsingDirective) { return true; }
    if (statement.kind == KrtAstKind.Print) { return KrtNativeLowerPrint(statement,module_ast,module,source); }
    if (statement.kind == KrtAstKind.Block) { return KrtNativeLowerBlock(statement, module_ast, unit, module, source, breaks, continues, ref depth); }
    if (statement.kind == KrtAstKind.Try) { return KrtNativeLowerTry(statement, module_ast, unit, module, source, breaks, continues, ref depth); }
    if (statement.kind == KrtAstKind.Switch) { return KrtNativeLowerSwitch(statement, module_ast, unit, module, source, breaks, continues, ref depth); }
    if (statement.kind == KrtAstKind.Throw) { return KrtNativeLowerThrow(statement, module_ast, module, source); }
    if (statement.kind == KrtAstKind.Variable) {
        if (KrtNativeInlineValue(statement)) {
            if (!KrtNativeLowerAggregateFrame(statement,module)) { return false; }
            if (statement.left == null) { return KrtNativeLowerAggregateZero(statement,module); }
            return KrtNativeLowerExpression(statement.left,module_ast,module,source) && KrtNativeLowerAggregateCopy(statement,module);
        }
        if (statement.local_slot < 0) { return false; }
        if (statement.left == null) { if (KrtNativeEmit(module, (int32)KrtNativeOp.Const, 0, 0) < 0) { return false; } }
        else if (!KrtNativeLowerExpression(statement.left, module_ast, module, source)) { return false; }
        return KrtNativeConvertValue(module, statement.left, statement) &&
            KrtNativeEmit(module, (int32)KrtNativeOp.StoreLocal, KrtNativeSlot(statement.local_slot), 0) >= 0;
    }
    if (statement.kind == KrtAstKind.Assign) {
        if (statement.left == null || statement.right == null) { return false; }
        if (statement.left.native_fixed_length > 0) { return KrtNativeLowerFixedArrayAssignment(statement,module_ast,module,source); }
        if (KrtNativeInlineValue(statement.left)) {
            return KrtNativeLowerLValue(statement.left,module_ast,module,source) &&
                KrtNativeLowerExpression(statement.right,module_ast,module,source) && KrtNativeLowerAggregateCopy(statement.left,module);
        }
        if (statement.left.kind == KrtAstKind.Identifier && statement.left.native_global == 0 && !statement.left.native_ref) {
            if (statement.left.local_slot == -1 || !KrtNativeLowerExpression(statement.right, module_ast, module, source)) { return false; }
            return KrtNativeConvertValue(module, statement.right, statement.left) &&
                KrtNativeEmit(module, (int32)KrtNativeOp.StoreLocal, KrtNativeSlot(statement.left.local_slot), 0) >= 0;
        }
        return KrtNativeLowerLValue(statement.left, module_ast, module, source) &&
            KrtNativeLowerExpression(statement.right, module_ast, module, source) &&
            KrtNativeConvertValue(module, statement.right, statement.left) &&
            KrtNativeEmit(module, (int32)KrtNativeOp.Store, 0, KrtNativeWidth(statement.left)) >= 0;
    }
    if (statement.kind == KrtAstKind.CompoundAssign) { return KrtNativeLowerCompound(statement,module_ast,module,source); }
    if (statement.kind == KrtAstKind.Expression || statement.kind == KrtAstKind.Delete) {
        if (statement.left == null) { return statement.kind == KrtAstKind.Expression; }
        int32 discard = statement.kind == KrtAstKind.Delete ? (int32)KrtNativeOp.Free : (int32)KrtNativeOp.Drop;
        return KrtNativeLowerExpression(statement.left, module_ast, module, source) && KrtNativeEmit(module, discard, 0, 0) >= 0;
    }
    if (statement.kind == KrtAstKind.Return) {
        bool is_void = unit.op == 220 || unit.type_length == 0 || KrtNativeSpanWord(source, unit.type_start, unit.type_length, "void");
        if ((statement.left == null && !is_void) || (statement.left != null && is_void)) { return false; }
        if (!is_void && KrtNativeInlineValue(unit)) {
            if (unit.native_hidden_result_slot < 0 || statement.left == null ||
                KrtNativeEmit(module,(int32)KrtNativeOp.LoadLocal,unit.native_hidden_result_slot,0) < 0 ||
                !KrtNativeLowerExpression(statement.left,module_ast,module,source) || !KrtNativeLowerAggregateCopy(unit,module) ||
                KrtNativeEmit(module,(int32)KrtNativeOp.LoadLocal,unit.native_hidden_result_slot,0) < 0) { return false; }
            return KrtNativeLowerCleanup(module_ast,unit,module,source,breaks,continues,ref depth,true) &&
                KrtNativeEmit(module,(int32)KrtNativeOp.Return,0,1) >= 0;
        }
        if (statement.left != null && !KrtNativeLowerExpression(statement.left, module_ast, module, source)) { return false; }
        if (statement.left != null && !KrtNativeConvertValue(module, statement.left, unit)) { return false; }
        return KrtNativeLowerCleanup(module_ast, unit, module, source, breaks, continues, ref depth, true) &&
            KrtNativeEmit(module, (int32)KrtNativeOp.Return, 0, statement.left == null ? 0 : 1) >= 0;
    }
    if (statement.kind == KrtAstKind.Unsafe || statement.kind == KrtAstKind.Point) {
        return KrtNativeLowerBlock(statement.left, module_ast, unit, module, source, breaks, continues, ref depth);
    }
    if (statement.kind == KrtAstKind.If) {
        if (!KrtNativeLowerTruth(statement.left, module_ast, module, source)) { return false; }
        int32 branch = KrtNativeEmit(module, (int32)KrtNativeOp.Branch, -1, -1);
        if (branch < 0 || !KrtNativeLowerBlock(statement.right, module_ast, unit, module, source, breaks, continues, ref depth)) { return false; }
        int32 jump = KrtNativeEmit(module, (int32)KrtNativeOp.Jump, -1, 0);
        if (jump < 0) { return false; }
        int32 alternate = module.count;
        if (statement.alternate != null && !KrtNativeLowerStatement(statement.alternate, module_ast, unit, module, source, breaks, continues, ref depth)) { return false; }
        module.args[branch] = branch + 1; module.extra[branch] = alternate; module.args[jump] = module.count;
        return true;
    }
    if (statement.kind == KrtAstKind.Foreach) { return KrtNativeLowerForeach(statement, module_ast, unit, module, source, breaks, continues, ref depth); }
    if (statement.kind == KrtAstKind.While || statement.kind == KrtAstKind.DoWhile || statement.kind == KrtAstKind.For) {
        if (depth >= 64) { return false; }
        if (statement.kind == KrtAstKind.For && statement.left != null &&
            !KrtNativeLowerStatement(statement.left, module_ast, unit, module, source, breaks, continues, ref depth)) { return false; }
        int32 condition = module.count; int32 branch = -1; int32 body_start = module.count;
        KrtAstNode body = statement.right;
        if (statement.kind == KrtAstKind.While) {
            if (!KrtNativeLowerTruth(statement.left, module_ast, module, source)) { return false; }
            branch = KrtNativeEmit(module, (int32)KrtNativeOp.Branch, -1, -1);
            if (branch < 0) { return false; }
            body_start = module.count;
        } else if (statement.kind == KrtAstKind.For) {
            if (statement.right == null) { if (KrtNativeEmit(module, (int32)KrtNativeOp.Const, 1, 0) < 0) { return false; } }
            else if (!KrtNativeLowerTruth(statement.right, module_ast, module, source)) { return false; }
            branch = KrtNativeEmit(module, (int32)KrtNativeOp.Branch, -1, -1);
            if (branch < 0) { return false; }
            body_start = module.count; body = statement.body;
        } else { body = statement.left; }
        breaks[depth] = -1; continues[depth] = -1; depth = depth + 1;
        if (!KrtNativeLowerBlock(body, module_ast, unit, module, source, breaks, continues, ref depth)) { return false; }
        int32 continue_target = condition;
        if (statement.kind == KrtAstKind.For) {
            continue_target = module.count;
            if (statement.alternate != null) {
                if (statement.alternate.kind == KrtAstKind.Assign || statement.alternate.kind == KrtAstKind.CompoundAssign || statement.alternate.kind == KrtAstKind.Expression) {
                    if (!KrtNativeLowerStatement(statement.alternate,module_ast,unit,module,source,breaks,continues,ref depth)) { return false; }
                } else if (!KrtNativeLowerExpression(statement.alternate,module_ast,module,source) || KrtNativeEmit(module,(int32)KrtNativeOp.Drop,0,0) < 0) { return false; }
            }
        }
        if (statement.kind == KrtAstKind.DoWhile) {
            continue_target = module.count;
            if (!KrtNativeLowerTruth(statement.right, module_ast, module, source)) { return false; }
            branch = KrtNativeEmit(module, (int32)KrtNativeOp.Branch, body_start, -1);
            if (branch < 0) { return false; }
        } else if (KrtNativeEmit(module, (int32)KrtNativeOp.Jump, condition, 0) < 0) { return false; }
        int32 end = module.count; module.args[branch] = body_start; module.extra[branch] = end;
        depth = depth - 1;
        return KrtNativePatchLoop(module, breaks[depth], end) && KrtNativePatchLoop(module, continues[depth], continue_target);
    }
    if (statement.kind == KrtAstKind.Break || statement.kind == KrtAstKind.Continue) {
        int32 context = depth - 1;
        if (statement.kind == KrtAstKind.Continue) { while (context >= 0 && continues[context] == -2) { context = context - 1; } }
        if (context < 0 || !KrtNativeLowerCleanupAtDepth(module_ast, unit, module, source, breaks, continues, ref depth, false, context + 1)) { return false; }
        int32 head = statement.kind == KrtAstKind.Break ? breaks[context] : continues[context];
        int32 jump = KrtNativeEmit(module, (int32)KrtNativeOp.Jump, -1, head);
        if (jump < 0) { return false; }
        if (statement.kind == KrtAstKind.Break) { breaks[context] = jump; }
        else { continues[context] = jump; }
        return true;
    }
    return false;
}

bool KrtNativeLowerBlock(KrtAstNode block, KrtAstNode module_ast, KrtAstNode unit, KrtNativeModule module, int64 source, int32[] breaks, int32[] continues, ref int32 depth) {
    if (block == null || block.kind != KrtAstKind.Block) { return false; }
    KrtAstNode statement = block.left;
    while (statement != null) {
        if (!KrtNativeLowerStatement(statement, module_ast, unit, module, source, breaks, continues, ref depth)) { return false; }
        // Binding has checked every source statement. Only normal completion
        // reaches the next statement in this block; abrupt paths retain their
        // enclosing loop, switch and exception cleanup targets.
        if ((KrtNativeSwitchStatementFlow(statement) & 1) == 0) { break; }
        statement = statement.next;
    }
    return true;
}

bool KrtNativeAlwaysReturns(KrtAstNode statement) {
    // Return and throw both terminate a function. A switch consumes its own
    // breaks, and a loop still has a possible normal exit.
    return KrtNativeSwitchStatementFlow(statement) == 2;
}

bool KrtNativeLowerFunction(KrtAstNode module_ast, KrtAstNode unit, KrtNativeModule module, int64 source, int32 function_index) {
    module.lower_function_index = function_index;
    if (unit == null || unit.left == null || unit.native_locals < unit.parameter_count) { return false; }
    if (!unit.native_abstract && unit.type_length != 0 && !KrtNativeSpanWord(source, unit.type_start, unit.type_length, "void") && !KrtNativeAlwaysReturns(unit.left)) { return false; }
    module.exception_frame = null;
    module.starts[function_index] = module.count;
    module.parameter_counts[function_index] = unit.parameter_count;
    module.local_counts[function_index] = unit.native_locals;
    module.function_frame_bytes[function_index] = unit.native_frame_bytes;
    if (unit.op != 220 && KrtNativeInlineValue(unit)) {
        module.aggregate_return_sizes[function_index] = unit.native_storage_size;
        module.aggregate_return_alignments[function_index] = unit.native_alignment;
        module.hidden_result_slots[function_index] = unit.native_hidden_result_slot;
    }
    if (unit.native_abstract) { return KrtNativeLowerDispatchTrap(module) && KrtNativeEmit(module, (int32)KrtNativeOp.Const, 0, 0) >= 0 && KrtNativeEmit(module, (int32)KrtNativeOp.Return, 0, 1) >= 0; }
    int32[] breaks = new int32[64]; int32[] continues = new int32[64];
    int32 depth = 0;
    if (!KrtNativeLowerAggregateParameters(unit,module)) { return false; }
    if (!KrtNativeLowerBlock(unit.left, module_ast, unit, module, source, breaks, continues, ref depth)) { return false; }
    // A final return is also a target for branches that fall out of a trailing
    // conditional. It must exist even when the last emitted arm returns.
    if (KrtNativeEmit(module, (int32)KrtNativeOp.Const, 0, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.Return, 0, 1) < 0) { return false; }
    delete breaks; delete continues;
    return true;
}

bool KrtNativeLowerModule(KrtAstNode module_ast, int64 source, KrtNativeModule output) {
    if (module_ast == null || module_ast.kind != KrtAstKind.Program || output == null || !KrtNativeInit(output)) { return false; }
    output.library_mode = module_ast.op == 240;
    if (!KrtNativeValidateAccess(module_ast,source,output)) { return false; }
    if (!KrtNativePrepareInheritance(module_ast, source, output)) { return false; }
    if (!KrtNativePrepareGlobals(module_ast, source, output)) { return false; }
    if (!KrtNativePrepareModule(module_ast, source, output)) { return false; }
    if (output.library_mode && output.global_count != 0) { return false; }
    KrtAstNode declaration = module_ast.declarations;
    while (declaration != null) {
        if (declaration.op != 0 && declaration.native_generic_parameters == null) { output.error_start = declaration.start; return false; }
        declaration = declaration.next;
    }
    int32[] name_starts = output.function_name_starts; int32[] name_lengths = output.function_name_lengths;
    output.function_ast = module_ast.left;
    KrtAstNode function_node = module_ast.left; int32 count = 0; int32 entry = -1;
    while (function_node != null && count < 16384) {
        function_node.value = count;
        if (function_node.op == 230) { output.initializer_index = count; }
        name_starts[count] = (int32)function_node.name_start; name_lengths[count] = (int32)function_node.name_length;
        if (KrtSemanticIsMain(function_node, source)) { entry = count; }
        count = count + 1; function_node = function_node.next;
    }
    if (function_node != null || (!output.library_mode && (count <= 0 || entry < 0))) { return false; }
    output.function_count = count; output.entry = entry;
    function_node = module_ast.left; int32 index = 0;
    while (function_node != null) {
        if ((!function_node.native_bound && !KrtNativeBindFunction(function_node, module_ast, source)) ||
            !KrtNativeLowerFunction(module_ast, function_node, output, source, index)) {
            output.error_start = function_node.native_bound ? function_node.start : function_node.native_offset;
            return false;
        }
        function_node = function_node.next; index = index + 1;
    }
    output.data = 0;
    return output.errors == 0;
}

bool KrtNativeLowerNew(KrtAstNode expression, KrtAstNode module_ast, KrtNativeModule module, int64 source) {
    if (KrtNativeInlineValue(expression)) { return KrtNativeLowerAggregateNew(expression,module_ast,module,source); }
    if (expression.left != null) {
        int32 stride = KrtNativeSemanticStride(expression);
        if (stride <= 0 || !KrtNativeLowerExpression(expression.left, module_ast, module, source)) { return false; }
        return KrtNativeEmit(module, (int32)KrtNativeOp.Allocate, stride, 0) >= 0;
    }
    if (KrtNativeEmit(module, (int32)KrtNativeOp.Const, expression.native_size > 0 ? expression.native_size : 8, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.Allocate, 0, 0) < 0) { return false; }
    if (expression.local_slot < 0 || KrtNativeEmit(module, (int32)KrtNativeOp.StoreLocal, expression.local_slot, 0) < 0 ||
        KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, expression.local_slot, 0) < 0) { return false; }
