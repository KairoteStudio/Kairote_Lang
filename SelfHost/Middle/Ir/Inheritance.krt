bool KrtNativeLowerBaseConstructor(KrtAstNode expression, KrtAstNode module_ast, KrtNativeModule module, int64 source) {
    KrtAstNode target = expression.native_target;
    if (target == null) { return KrtNativeEmit(module, (int32)KrtNativeOp.Const, 0, 0) >= 0; }
    if (KrtNativeEmit(module, (int32)KrtNativeOp.LoadLocal, 0, 0) < 0) { return false; }
    return KrtNativeLowerArguments(expression.right, target, 1, module_ast, module, source) &&
        KrtNativeEmit(module, (int32)KrtNativeOp.Call, target.value, target.parameter_count) >= 0;
}
bool KrtNativeLowerCatchMatch(KrtAstNode expected,int32 slot,KrtAstNode ast,KrtNativeModule module) {
    return KrtNativeLowerRuntimeCatchMatch(expected,slot,module);
}
bool KrtNativeLowerClassThrow(KrtAstNode value,KrtAstNode ast,KrtNativeModule module,int64 source) {
    return KrtNativeLowerRuntimeThrow(value,ast,module,source);
}
