bool KrtNativeLowerGlobalAddress(KrtAstNode node, KrtNativeModule module) {
    return node.native_global > 0 && KrtNativeEmit(module, 44, node.native_global - 1, 0) >= 0;
}

bool KrtNativeLowerGlobalValue(KrtAstNode node, KrtNativeModule module) {
    if (KrtNativeInlineValue(node)) { return KrtNativeLowerGlobalAddress(node,module); }
    return KrtNativeLowerGlobalAddress(node, module) &&
        KrtNativeEmit(module, (int32)KrtNativeOp.Load, 0, KrtNativeValueWidth(node)) >= 0 && KrtNativeNormalizeWide(module,node);
}

bool KrtNativeLowerFunctionAddress(KrtAstNode node, KrtNativeModule module) {
    return node.native_target != null && KrtNativeEmit(module, 45, node.native_target.value, 0) >= 0;
}

bool KrtNativeLowerIndirectCall(KrtAstNode node, KrtAstNode ast, KrtNativeModule module, int64 source) {
    KrtAstNode signature = node.left.native_function_pointer;
    if (signature == null || !KrtNativeLowerExpression(node.left, ast, module, source)) { return false; }
    if (KrtNativeInlineValue(node)) {
        return KrtNativeLowerAggregateFrame(node,module) && KrtNativeLowerArguments(node.right,signature,0,ast,module,source) &&
            KrtNativeEmit(module,(int32)KrtNativeOp.IndirectCall,0,signature.parameter_count + 1) >= 0;
    }
    return KrtNativeLowerArguments(node.right, signature, 0, ast, module, source) &&
        KrtNativeEmit(module,46,0,signature.parameter_count) >= 0 && KrtNativeNormalizeWide(module,node);
}
