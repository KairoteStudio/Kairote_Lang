    if (!KrtNativeLowerBoxFault(module) || KrtNativeEmit(module,(int32)KrtNativeOp.Const,0,0) < 0) { return false; }
    if (!KrtNativePatchLoop(module,exits,module.count)) { return false; }
    int32 descriptor = KrtNativeBoxTemporary(module); int32 value = KrtNativeBoxTemporary(module); int32 box = KrtNativeBoxTemporary(module);
    if (descriptor < 0 || value < 0 || box < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.StoreLocal,descriptor,0) < 0 ||
        KrtNativeEmit(module,(int32)KrtNativeOp.CatchValue,slot,0) < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.StoreLocal,value,0) < 0 ||
        !KrtNativeRuntimeLoad(module,descriptor,88) || KrtNativeEmit(module,(int32)KrtNativeOp.Const,1,0) < 0 ||
        KrtNativeEmit(module,(int32)KrtNativeOp.And,0,0) < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.LoadLocal,value,0) < 0 ||
        KrtNativeEmit(module,(int32)KrtNativeOp.BoolNot,0,0) < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.And,0,0) < 0) { return false; }
    int32 absent = KrtNativeEmit(module,(int32)KrtNativeOp.Branch,-1,-1);
    if (absent < 0) { return false; } module.extra[absent] = module.count;
    // Reserve one or two full words, while retaining the exact logical byte
    // size in the header. The same allocation/copy serves every scalar code.
    if (!KrtNativeRuntimeLoad(module,descriptor,32) || KrtNativeEmit(module,(int32)KrtNativeOp.Const,8,0) < 0 ||
        KrtNativeEmit(module,(int32)KrtNativeOp.Compare,62,0) < 0) { return false; }
    int32 large = KrtNativeEmit(module,(int32)KrtNativeOp.Branch,-1,-1);
    if (large < 0) { return false; } module.args[large] = module.count;
    if (KrtNativeEmit(module,(int32)KrtNativeOp.Const,32,0) < 0) { return false; }
    int32 capacity = KrtNativeEmit(module,(int32)KrtNativeOp.Jump,-1,0); module.extra[large] = module.count;
    if (capacity < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.Const,24,0) < 0) { return false; } module.args[capacity] = module.count;
    if (KrtNativeEmit(module,(int32)KrtNativeOp.Allocate,0,0) < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.StoreLocal,box,0) < 0 ||
        KrtNativeEmit(module,(int32)KrtNativeOp.LoadLocal,box,0) < 0) { return false; }
    int32 allocated = KrtNativeEmit(module,(int32)KrtNativeOp.Branch,-1,-1);
    if (allocated < 0 || !KrtNativeLowerDispatchTrap(module)) { return false; }
    module.extra[allocated] = allocated+1; module.args[allocated] = module.count;
    if (KrtNativeEmit(module,(int32)KrtNativeOp.LoadLocal,box,0) < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.LoadLocal,descriptor,0) < 0 ||
        KrtNativeEmit(module,(int32)KrtNativeOp.Store,0,8) < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.LoadLocal,box,0) < 0 ||
        KrtNativeEmit(module,(int32)KrtNativeOp.Address,0,8) < 0 || !KrtNativeRuntimeLoad(module,descriptor,32) ||
        KrtNativeEmit(module,(int32)KrtNativeOp.Store,0,8) < 0 || !KrtNativeRuntimeLoad(module,descriptor,32) ||
        KrtNativeEmit(module,(int32)KrtNativeOp.Const,8,0) < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.Compare,62,0) < 0) { return false; }
    int32 wide = KrtNativeEmit(module,(int32)KrtNativeOp.Branch,-1,-1);
