        KrtNativeEmit(module,(int32)KrtNativeOp.LoadLocal,value,0) < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.Store,0,8) < 0) { return false; }
    module.args[copied] = module.count;
    if (KrtNativeEmit(module,(int32)KrtNativeOp.LoadLocal,box,0) < 0) { return false; }
    int32 done = KrtNativeEmit(module,(int32)KrtNativeOp.Jump,-1,0); module.args[absent] = module.count;
    if (done < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.Const,0,0) < 0) { return false; }
