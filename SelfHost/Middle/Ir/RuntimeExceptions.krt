        KrtNativeEmit(module,(int32)KrtNativeOp.LoadLocal,value,0) < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.AggregateCopy,16,16) < 0) { return false; }
    int32 copied = KrtNativeEmit(module,(int32)KrtNativeOp.Jump,-1,0); module.extra[wide] = module.count;
