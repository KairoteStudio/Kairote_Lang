bool KrtNativeLowerRuntimeReleasePacket(KrtNativeModule module,int32 slot) {
    if (KrtNativeEmit(module,(int32)KrtNativeOp.CatchType,slot,0) < 0 ||
        KrtNativeEmit(module,(int32)KrtNativeOp.Const,0,0) < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.Compare,60,0) < 0) { return false; }
