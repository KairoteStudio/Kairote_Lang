    if (pointer < 0 || descriptor < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.StoreLocal,pointer,0) < 0 ||
        KrtNativeEmit(module,(int32)KrtNativeOp.LoadLocal,pointer,0) < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.Dup,0,0) < 0) { return false; }
    int32 present = KrtNativeEmit(module,(int32)KrtNativeOp.Branch,-1,-1);
    if (present < 0) { return false; } module.args[present] = module.count;
    if (!KrtNativeRuntimeLoad(module,pointer,0) || KrtNativeEmit(module,(int32)KrtNativeOp.StoreLocal,descriptor,0) < 0 ||
        KrtNativeEmit(module,(int32)KrtNativeOp.LoadLocal,descriptor,0) < 0 ||
        KrtNativeEmit(module,(int32)KrtNativeOp.Const,(-9223372036854775807-1),0) < 0 ||
        KrtNativeEmit(module,(int32)KrtNativeOp.Or,0,0) < 0) { return false; }
    if (created) {
        if (KrtNativeEmit(module,(int32)KrtNativeOp.Const,3,0) < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.Or,0,0) < 0) { return false; }
    } else {
        if (!KrtNativeRuntimeLoad(module,descriptor,24) || KrtNativeEmit(module,(int32)KrtNativeOp.Const,1,0) < 0 ||
            KrtNativeEmit(module,(int32)KrtNativeOp.Compare,61,0) < 0 || !KrtNativeRuntimeLoad(module,descriptor,24) ||
            KrtNativeEmit(module,(int32)KrtNativeOp.Const,5,0) < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.Compare,61,0) < 0 ||
            KrtNativeEmit(module,(int32)KrtNativeOp.Or,0,0) < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.BoolNot,0,0) < 0 ||
            KrtNativeEmit(module,(int32)KrtNativeOp.Or,0,0) < 0) { return false; }
