bool KrtNativeLowerRuntimeCatchMatch(KrtAstNode expected,int32 slot,KrtNativeModule module) {
    if (KrtNativeObjectValue(expected)) {
        return KrtNativeEmit(module,(int32)KrtNativeOp.CatchType,slot,0) >= 0 &&
            KrtNativeEmit(module,(int32)KrtNativeOp.BoolNot,0,0) >= 0 && KrtNativeEmit(module,(int32)KrtNativeOp.BoolNot,0,0) >= 0;
    }
    int32 raw = -1;
    if (KrtNativeLegacyException(expected)) {
        if (KrtNativeEmit(module,(int32)KrtNativeOp.CatchType,slot,0) < 0 ||
            !KrtNativeLowerRuntimeExceptionType(expected,module) || KrtNativeEmit(module,(int32)KrtNativeOp.Compare,61,0) < 0) { return false; }
        raw = KrtNativeEmit(module,(int32)KrtNativeOp.Branch,-1,-1); if (raw < 0) { return false; } module.extra[raw] = module.count;
    }
    if (KrtNativeEmit(module,(int32)KrtNativeOp.CatchType,slot,0) < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.Const,0,0) < 0 ||
        KrtNativeEmit(module,(int32)KrtNativeOp.Compare,60,0) < 0) { return false; }
    int32 encoded = KrtNativeEmit(module,(int32)KrtNativeOp.Branch,-1,-1);
    if (encoded < 0) { return false; } module.args[encoded] = module.count;
    int32 descriptor = KrtNativeBoxTemporary(module);
    if (descriptor < 0 || !KrtNativeRuntimePacketType(module,slot) || KrtNativeEmit(module,(int32)KrtNativeOp.StoreLocal,descriptor,0) < 0 ||
        !KrtNativeLowerRuntimeDescriptorMatch(module,descriptor,expected,!KrtNativeReferenceObjectValue(expected))) { return false; }
    int32 done = KrtNativeEmit(module,(int32)KrtNativeOp.Jump,-1,0); module.extra[encoded] = module.count;
    if (done < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.Const,0,0) < 0) { return false; }
    int32 failed = KrtNativeEmit(module,(int32)KrtNativeOp.Jump,-1,0);
    if (failed < 0) { return false; }
    if (raw >= 0) { module.args[raw] = module.count; if (KrtNativeEmit(module,(int32)KrtNativeOp.Const,1,0) < 0) { return false; } }
    module.args[done] = module.count; module.args[failed] = module.count; return true;
}

KrtAstNode KrtNativeLegacyExceptionShape(int32 index) {
    KrtAstNode type = KrtAstMake(KrtAstKind.Type,0,0);
    if (index < 256) {
        type.native_bits = index/2+1; type.native_unsigned = (index&1) != 0;
        int32 width = 1; while (width*8 < type.native_bits && width < 16) { width = width*2; }
        type.native_width = width; type.native_wide = width == 16;
    } else if (index == 256) { type.native_boolean = true; type.native_unsigned = true; type.native_width = 1; type.native_bits = 1; }
    else if (index == 257) { type.native_string = true; type.native_width = 8; }
    else if (index == 258 || index == 259) { type.native_float = index == 258 ? 4 : 8; type.native_width = type.native_float; }
    else { type.native_character = true; type.native_width = 1; type.native_bits = 8; type.native_unsigned = true; }
    type.native_base_width = type.native_width; type.native_storage_size = type.native_width; type.native_alignment = type.native_width;
    return type;
}

bool KrtNativeLowerLegacyPacketBox(KrtNativeModule module,int32 slot) {
    int32 exits = -1; int32 index = 0;
    while (index <= 260) {
