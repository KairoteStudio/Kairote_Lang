bool KrtNativeLowerRuntimeThrow(KrtAstNode value,KrtAstNode ast,KrtNativeModule module,int64 source) {
    if (!KrtNativeLowerExpression(value,ast,module,source)) { return false; }
    if (KrtNativeLegacyException(value) && !KrtNativeWideKind(value)) {
        return KrtNativeLowerRuntimeExceptionType(value,module) && KrtNativeEmit(module,(int32)KrtNativeOp.Throw,0,0) >= 0;
    }
