bool KrtNativeLowerRuntimeExceptionType(KrtAstNode type,KrtNativeModule module) {
    if (KrtNativeLegacyException(type)) {
        int64 identity = KrtNativeExceptionType(type,module.ast);
        return identity >= 0 && KrtNativeEmit(module,(int32)KrtNativeOp.Const,identity,0) >= 0;
    }
    return KrtNativeLowerRuntimeDescriptor(type,module) &&
        KrtNativeEmit(module,(int32)KrtNativeOp.Const,(-9223372036854775807-1),0) >= 0 &&
        KrtNativeEmit(module,(int32)KrtNativeOp.Or,0,0) >= 0;
}
bool KrtNativeRuntimePacketType(KrtNativeModule module,int32 slot) {
    return KrtNativeEmit(module,(int32)KrtNativeOp.CatchType,slot,0) >= 0 &&
        KrtNativeEmit(module,(int32)KrtNativeOp.Const,9223372036854775804,0) >= 0 &&
        KrtNativeEmit(module,(int32)KrtNativeOp.And,0,0) >= 0;
