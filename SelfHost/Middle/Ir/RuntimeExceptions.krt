bool KrtNativeLowerRuntimeCatchValue(KrtAstNode expected,int32 slot,KrtNativeModule module) {
    if (KrtNativeReferenceObjectValue(expected)) {
        if (!KrtNativeObjectValue(expected)) {
            return KrtNativeEmit(module,(int32)KrtNativeOp.CatchValue,slot,0) >= 0 && KrtNativeRuntimeTransferPacket(module,slot) &&
                KrtNativeEmit(module,(int32)KrtNativeOp.StoreLocal,expected.local_slot,0) >= 0;
        }
        if (KrtNativeEmit(module,(int32)KrtNativeOp.CatchType,slot,0) < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.Const,0,0) < 0 ||
            KrtNativeEmit(module,(int32)KrtNativeOp.Compare,60,0) < 0) { return false; }
        int32 encoded = KrtNativeEmit(module,(int32)KrtNativeOp.Branch,-1,-1);
        if (encoded < 0) { return false; } module.args[encoded] = module.count;
        if (KrtNativeEmit(module,(int32)KrtNativeOp.CatchValue,slot,0) < 0 || !KrtNativeRuntimeTransferPacket(module,slot)) { return false; }
        int32 done = KrtNativeEmit(module,(int32)KrtNativeOp.Jump,-1,0); module.extra[encoded] = module.count;
        if (done < 0 || !KrtNativeLowerLegacyPacketBox(module,slot)) { return false; }
        module.args[done] = module.count;
        return KrtNativeEmit(module,(int32)KrtNativeOp.StoreLocal,expected.local_slot,0) >= 0;
    }
    if (KrtNativeInlineValue(expected) && !KrtNativeLowerAggregateFrame(expected,module)) { return false; }
    if (KrtNativeEmit(module,(int32)KrtNativeOp.CatchValue,slot,0) < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.CatchType,slot,0) < 0 ||
        KrtNativeEmit(module,(int32)KrtNativeOp.Const,0,0) < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.Compare,60,0) < 0) { return false; }
    int32 encoded = KrtNativeEmit(module,(int32)KrtNativeOp.Branch,-1,-1);
    if (encoded < 0) { return false; } module.args[encoded] = module.count;
    if (KrtNativeEmit(module,(int32)KrtNativeOp.Address,0,16) < 0 ||
        (!KrtNativeInlineValue(expected) && (KrtNativeEmit(module,(int32)KrtNativeOp.Load,0,KrtNativeValueWidth(expected)) < 0 || !KrtNativeNormalizeWide(module,expected)))) { return false; }
    module.extra[encoded] = module.count;
    if (KrtNativeInlineValue(expected)) { return KrtNativeLowerAggregateCopy(expected,module); }
    return KrtNativeEmit(module,(int32)KrtNativeOp.StoreLocal,expected.local_slot,0) >= 0;
}
