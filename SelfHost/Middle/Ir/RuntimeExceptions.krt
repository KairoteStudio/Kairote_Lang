// Negative packet type words contain an exact descriptor and ownership flags.
// Positive words retain the scalar exception ABI of independently built KROs.
bool KrtNativeLegacyException(KrtAstNode type) {
    return type != null && type.native_type == null && !type.native_array &&
        type.native_function_pointer == null && type.native_pointer_depth == 0;
