        KrtNativeEmit(module,(int32)KrtNativeOp.Const,-3,0) >= 0 &&
        KrtNativeEmit(module,(int32)KrtNativeOp.And,0,0) >= 0)) { return false; }
    bool saved = module.generator_raw_emit; module.generator_raw_emit = true;
    bool valid = KrtNativeEmit(module,(int32)KrtNativeOp.StoreLocal,slot+1,0) >= 0;
    module.generator_raw_emit = saved; module.extra[encoded] = module.count; return valid;
