    module.extra[present] = module.count;
    if (done < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.Const,0,0) < 0) { return false; }
    module.args[done] = module.count; return KrtNativeEmit(module,(int32)KrtNativeOp.Throw,0,0) >= 0;
