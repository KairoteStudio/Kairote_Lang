        if (KrtNativeEmit(module,(int32)KrtNativeOp.CatchType,slot,0) < 0 || KrtNativeEmit(module,(int32)KrtNativeOp.Const,code,0) < 0 ||
            KrtNativeEmit(module,(int32)KrtNativeOp.Compare,61,0) < 0) { return false; }
        int32 matched = KrtNativeEmit(module,(int32)KrtNativeOp.Branch,-1,-1); if (matched < 0) { return false; } module.args[matched] = module.count;
        if (!KrtNativeLowerRuntimeDescriptor(type,module)) { return false; }
        int32 exit = KrtNativeEmit(module,(int32)KrtNativeOp.Jump,-1,exits); if (exit < 0) { return false; }
        exits = exit; module.extra[matched] = module.count; index = index+1;
