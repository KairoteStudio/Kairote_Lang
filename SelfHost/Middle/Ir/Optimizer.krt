// Native optimization preserves instruction indices until relocation.
static int32 KrtDriverOptimization = 0;

int64 KrtNativeFoldCast(int64 value, int64 width) {
    int32 bits = 64; bool signed_value = false;
    if (width == 1 || width == -1) { bits = 8; signed_value = width < 0; }
    else if (width == 2 || width == -2) { bits = 16; signed_value = width < 0; }
    else if (width == 4 || width == -4) { bits = 32; signed_value = width > 0; }
    else if (width > 1000) { bits = (int32)(width - 1000); signed_value = true; }
    else if (width < -1000) { bits = (int32)(-width - 1000); }
    if (bits <= 0 || bits >= 64) { return value; }
    int64 mask = (int64)((uint64)1 << bits) - 1;
    value = value & mask;
    if (signed_value && (value & ((int64)1 << (bits - 1))) != 0) { value = value | ~mask; }
    return value;
}

bool KrtNativeFoldBinary(int32 op, int64 left, int64 right, bool unsigned_value, int64 relation, ref int64 result) {
    if (op == 4) { result = left + right; }
    else if (op == 5) { result = left - right; }
    else if (op == 6) { result = left * right; }
    else if (op == 7 || op == 8) {
        if (right == 0 || (!unsigned_value && left == -9223372036854775808 && right == -1)) { return false; }
        if (unsigned_value) { if (op == 7) { result = (int64)((uint64)left / (uint64)right); } else { result = (int64)((uint64)left % (uint64)right); } }
        else { if (op == 7) { result = left / right; } else { result = left % right; } }
    } else if (op == 9) { result = left & right; }
    else if (op == 10) { result = left | right; }
    else if (op == 11) { result = left ^ right; }
    else if (op == 12) { result = left << (right & 63); }
    else if (op == 13) { if (unsigned_value) { result = (int64)((uint64)left >> (right & 63)); } else { result = left >> (right & 63); } }
    else if (op == 16) {
        bool comparison = false;
        if (relation == 61) { comparison = left == right; }
        else if (relation == 101) { comparison = left != right; }
        else if (unsigned_value) {
            if (relation == 60) { comparison = (uint64)left < (uint64)right; }
            else if (relation == 62) { comparison = (uint64)left > (uint64)right; }
            else if (relation == 102) { comparison = (uint64)left <= (uint64)right; }
            else if (relation == 103) { comparison = (uint64)left >= (uint64)right; }
            else { return false; }
        } else {
            if (relation == 60) { comparison = left < right; }
            else if (relation == 62) { comparison = left > right; }
            else if (relation == 102) { comparison = left <= right; }
            else if (relation == 103) { comparison = left >= right; }
            else { return false; }
        }
        result = comparison ? 1 : 0;
    } else { return false; }
    return true;
}

class KrtNativeOptimizationState { public bool[] targets; }

KrtNativeOptimizationState KrtNativeOptimizationTargets(KrtNativeModule module) {
    bool[] targets = new bool[module.count + 1]; int32 index = 0;
    while (index < module.function_count) { targets[module.starts[index]] = true; index = index + 1; }
    index = 0;
    while (index < module.count) {
        int32 op = module.ops[index];
        if (op == 17 || op == 18 || op == 50) {
            int64 target = module.args[index]; if (target < 0 || target >= module.count) { return null; }
            targets[(int32)target] = true;
            if (op == 18) { target = module.extra[index]; if (target < 0 || target >= module.count) { return null; } targets[(int32)target] = true; }
        }
        index = index + 1;
    }
    KrtNativeOptimizationState state = new KrtNativeOptimizationState(); state.targets = targets; return state;
}

bool KrtNativeFoldConstants(KrtNativeModule module) {
    KrtNativeOptimizationState state = KrtNativeOptimizationTargets(module); if (state == null) { return false; }
    bool[] targets = state.targets;
    int32 function_index = 0;
    while (function_index < module.function_count) {
        int32 first = module.starts[function_index]; int32 last = module.count;
        if (function_index + 1 < module.function_count) { last = module.starts[function_index + 1]; }
        int32 index = first; int32 previous = -1; int32 earlier = -1;
        while (index < last) {
            int32 op = module.ops[index];
            if (targets[index]) { previous = -1; earlier = -1; }
            if (op == 0) { index = index + 1; continue; }
            bool folded = false;
            if (previous >= first && module.ops[previous] == 1 && !targets[index]) {
                int64 value = module.args[previous];
                if (op == 14 || op == 15 || op == 28 || op == 31) {
                    if (op == 14) { value = -value; }
                    else if (op == 15) { value = ~value; }
                    else if (op == 31) { value = value == 0 ? 1 : 0; }
                    else { value = KrtNativeFoldCast(value,module.args[index]); }
                    module.args[previous] = value; module.ops[index] = 0; folded = true;
                } else if (op == 27) { module.ops[previous] = 0; module.ops[index] = 0; previous = -1; earlier = -1; folded = true; }
                else if (op == 18) {
                    int64 target = module.args[index]; if (value == 0) { target = module.extra[index]; }
                    module.ops[previous] = 0; module.ops[index] = 17; module.args[index] = target; module.extra[index] = 0;
                    previous = -1; earlier = -1; folded = true;
                } else if (((op >= 4 && op <= 13) || op == 16) && earlier >= first && module.ops[earlier] == 1 && !targets[previous]) {
                    int64 result = 0;
                    if (KrtNativeFoldBinary(op,module.args[earlier],value,module.extra[index] != 0,module.args[index],ref result)) {
                        module.args[earlier] = result; module.ops[previous] = 0; module.ops[index] = 0;
                        previous = earlier; earlier = -1; folded = true;
                    }
                }
            }
            if (!folded) {
                if (op == 1 && previous >= first && module.ops[previous] == 1) { earlier = previous; previous = index; }
                else { earlier = -1; previous = index; }
                if (op == 17 || op == 18 || op == 20 || op == 50 || op == 52) { previous = -1; earlier = -1; }
            }
            index = index + 1;
        }
        function_index = function_index + 1;
    }
    delete targets; return true;
}

bool KrtNativeTailSafe(KrtNativeModule module, int32 function_index) {
    if (module.function_frame_bytes[function_index] > 0 || module.aggregate_return_sizes[function_index] > 0) { return false; }
    int32 first = module.starts[function_index]; int32 last = module.count;
    if (function_index + 1 < module.function_count) { last = module.starts[function_index + 1]; }
    int32 index = first;
    while (index < last) {
        int32 op = module.ops[index];
        // Frame addresses and exception frames must retain their lifetime.
        if (op == 29 || op == 30 || op == 50 || op == 51 || op == 52 || op == 69 || (op >= 70 && op <= 73)) { return false; }
        index = index + 1;
    }
    return true;
}

bool KrtNativeTailCalls(KrtNativeModule module) {
    KrtNativeOptimizationState state = KrtNativeOptimizationTargets(module); if (state == null) { return false; }
    bool[] targets = state.targets;
    int32[] old_ops = module.ops; int64[] old_args = module.args; int64[] old_extra = module.extra;
    int32[] old_starts = module.starts; int32 old_count = module.count;
    int32[] mapping = new int32[old_count + 1];
    int32 capacity = old_count * 2 + 1024; if (capacity > 16777216) { capacity = 16777216; }
    int32[] ops = new int32[capacity]; int64[] args = new int64[capacity]; int64[] extra = new int64[capacity];
    int32[] starts = new int32[16384]; int32 count = 0; int32 function_index = 0;
    while (function_index < module.function_count) {
        int32 first = old_starts[function_index]; int32 last = old_count;
        if (function_index + 1 < module.function_count) { last = old_starts[function_index + 1]; }
        starts[function_index] = count; bool safe = KrtNativeTailSafe(module,function_index); int32 index = first;
        while (index < last) {
            mapping[index] = count; int32 end = index + 1;
            bool tail = safe && old_ops[index] == 19 && old_args[index] == function_index && old_extra[index] == module.parameter_counts[function_index];
            if (tail) {
                while (end < last && (old_ops[end] == 0 || old_ops[end] == 28) && !targets[end]) { end = end + 1; }
                tail = end < last && old_ops[end] == 20 && old_extra[end] == 1 && !targets[end];
            }
            if (tail) {
                int32 parameter = module.parameter_counts[function_index];
                if (count + parameter + 1 >= capacity) { return false; }
                while (parameter > 0) { parameter = parameter - 1; ops[count] = 3; args[count] = parameter; extra[count] = 0; count = count + 1; }
                ops[count] = 17; args[count] = first; extra[count] = 0; count = count + 1;
                while (index < end) { index = index + 1; mapping[index] = count; }
                index = end + 1;
            } else {
                if (count >= capacity) { return false; }
                ops[count] = old_ops[index]; args[count] = old_args[index]; extra[count] = old_extra[index]; count = count + 1; index = index + 1;
            }
        }
        function_index = function_index + 1;
    }
    mapping[old_count] = count; int32 index = 0;
    while (index < count) {
        if (ops[index] == 17 || ops[index] == 18 || ops[index] == 50) { args[index] = mapping[(int32)args[index]]; }
        if (ops[index] == 18) { extra[index] = mapping[(int32)extra[index]]; }
        index = index + 1;
    }
    module.ops = ops; module.args = args; module.extra = extra; module.starts = starts; module.count = count; module.capacity = capacity;
    delete targets; delete mapping; delete old_ops; delete old_args; delete old_extra; delete old_starts;
    return true;
}

bool KrtNativeInlineCandidate(KrtNativeModule module, int32 callee) {
    if (module.function_frame_bytes[callee] > 0 || module.aggregate_return_sizes[callee] > 0) { return false; }
    if (callee < 0 || callee >= module.function_count || callee == module.entry || callee == module.initializer_index) { return false; }
    int32 first = module.starts[callee]; int32 last = module.count;
    if (callee + 1 < module.function_count) { last = module.starts[callee + 1]; }
    if (last - first > 64 || module.local_counts[callee] > 32) { return false; }
    int32 index = first; bool returns = false;
    while (index < last) {
        int32 op = module.ops[index];
        if (op == 20) { if (module.extra[index] != 1) { return false; } returns = true; }
        else if (op == 17 || op == 18) {
            if (module.args[index] < first || module.args[index] >= last ||
                (op == 18 && (module.extra[index] < first || module.extra[index] >= last))) { return false; }
        } else if (!((op >= 0 && op <= 16) || op == 25 || op == 27 || op == 28 || op == 31 || op == 32 || op == 35 || op == 37)) {
            // Frame addresses, calls and exception records retain call lifetime.
            return false;
        }
        index = index + 1;
    }
    return returns;
}

bool KrtNativeInlineHelpers(KrtNativeModule module) {
    int32[] old_ops = module.ops; int64[] old_args = module.args; int64[] old_extra = module.extra;
    int32[] old_starts = module.starts; int32 old_count = module.count;
    int32[] mapping = new int32[old_count + 1]; bool[] candidates = new bool[module.function_count];
    int32 function_index = 0;
    while (function_index < module.function_count) { candidates[function_index] = KrtNativeInlineCandidate(module,function_index); function_index = function_index + 1; }
    int32 capacity = old_count * 4 + 1024; if (capacity > 16777216) { capacity = 16777216; }
    int32[] ops = new int32[capacity]; int64[] args = new int64[capacity]; int64[] extra = new int64[capacity];
    bool[] original_target = new bool[capacity]; int32[] starts = new int32[16384]; int32 count = 0;
    // Every copy receives independent parameter and local slots. Arguments have
    // already been evaluated left-to-right and remain on the operand stack.
    function_index = 0;
    while (function_index < module.function_count) {
        int32 first = old_starts[function_index]; int32 last = old_count;
        if (function_index + 1 < module.function_count) { last = old_starts[function_index + 1]; }
        starts[function_index] = count; int32 index = first;
        while (index < last) {
            mapping[index] = count; int32 callee = -1;
            if (old_ops[index] == 19 && old_args[index] >= 0 && old_args[index] < module.function_count) { callee = (int32)old_args[index]; }
            bool inline_call = callee >= 0 && callee != function_index;
            if (inline_call) { inline_call = candidates[callee] && old_extra[index] == module.parameter_counts[callee]; }
            int32 callee_first = 0; int32 callee_last = 0; int32 slot_base = module.local_counts[function_index];
            if (inline_call) {
                callee_first = old_starts[callee]; callee_last = old_count;
                if (callee + 1 < module.function_count) { callee_last = old_starts[callee + 1]; }
                inline_call = slot_base + module.local_counts[callee] <= 8192 &&
                    count + callee_last - callee_first + module.parameter_counts[callee] + old_count - index < capacity;
            }
            if (inline_call) {
                int32 parameter = module.parameter_counts[callee];
                while (parameter > 0) {
                    parameter = parameter - 1; ops[count] = 3; args[count] = slot_base + parameter; extra[count] = 0; count = count + 1;
                }
                int32 clone_start = count; int32 clone_length = callee_last - callee_first;
                int32 clone_end = clone_start + clone_length; int32 source_index = callee_first;
                while (source_index < callee_last) {
                    int32 op = old_ops[source_index]; int64 arg = old_args[source_index]; int64 value = old_extra[source_index];
                    if (op == 2 || op == 3) { arg = slot_base + arg; }
                    else if (op == 20) { op = 17; arg = clone_end; value = 0; }
                    else if (op == 17 || op == 18) {
                        arg = clone_start + (int32)arg - callee_first;
                        if (op == 18) { value = clone_start + (int32)value - callee_first; }
                    }
                    ops[count] = op; args[count] = arg; extra[count] = value; count = count + 1;
                    source_index = source_index + 1;
                }
                module.local_counts[function_index] = slot_base + module.local_counts[callee];
            } else {
                if (count >= capacity) { return false; }
                ops[count] = old_ops[index]; args[count] = old_args[index]; extra[count] = old_extra[index]; original_target[count] = true;
                count = count + 1;
            }
            index = index + 1;
        }
        function_index = function_index + 1;
    }
    mapping[old_count] = count; int32 index = 0;
    while (index < count) {
        if (original_target[index]) {
            if (ops[index] == 17 || ops[index] == 18 || ops[index] == 50) { args[index] = mapping[(int32)args[index]]; }
            if (ops[index] == 18) { extra[index] = mapping[(int32)extra[index]]; }
        }
        index = index + 1;
    }
    module.ops = ops; module.args = args; module.extra = extra; module.starts = starts; module.count = count; module.capacity = capacity;
    delete candidates; delete original_target; delete mapping; delete old_ops; delete old_args; delete old_extra; delete old_starts;
    return true;
}

bool KrtNativeOptimize(KrtNativeModule module, int32 level) {
    if (level < 0 || level > 3 || module == null) { return false; }
    if (level >= 1 && !KrtNativeFoldConstants(module)) { return false; }
    if (level >= 2 && !KrtNativeTailCalls(module)) { return false; }
    if (level >= 3 && (!KrtNativeInlineHelpers(module) || !KrtNativeFoldConstants(module))) { return false; }
    return true;
}
