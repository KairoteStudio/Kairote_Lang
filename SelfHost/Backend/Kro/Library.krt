// Relocatable object sections are generated by the native compiler itself.

void KrtKroLibraryWord(byte[] bytes, int32 offset, int32 value) {
    int32 index = 0; while (index < 4) { bytes[offset + index] = (byte)((value >> (index * 8)) & 255); index = index + 1; }
}

void KrtKroLibrarySymbol(KrtKroObject output, int32 index, int32 name, int32 offset, int32 size, int32 section) {
    byte[] symbols = output.symbol_bytes;
    int32 position = index * 32;
    KrtKroLibraryWord(symbols, position, name);
    KrtKroLibraryWord(symbols, position + 4, offset);
    KrtKroLibraryWord(symbols, position + 8, size);
    KrtKroLibraryWord(symbols, position + 12, section);
    KrtKroLibraryWord(symbols, position + 16, 1);
    KrtKroLibraryWord(symbols, position + 20, section == 1 ? 1 : 2);
}

void KrtKroLibraryName(KrtKroObject output, int64 source, int64 start, int32 length, ref int32 position) {
    byte[] names = output.string_bytes;
    int32 index = 0;
    unsafe(using krt.mem;) {
        byte* text = (byte*)source;
        while (index < length) { names[position] = text[start + index]; position = position + 1; index = index + 1; }
    }
    names[position] = 0; position = position + 1;
}

bool KrtKroLibraryNormalize(KrtAstNode node, ref int64 low, ref int64 high) {
    if (node.native_float != 0) { return false; }
    if (KrtNativeWideKind(node)) { return true; }
    if (node.native_boolean) { low = low != 0 || high != 0 ? 1 : 0; }
    else {
        int32 bits = node.native_bits > 0 ? node.native_bits : node.native_width * 8;
        if (bits <= 0 || bits > 64) { return false; }
        if (bits < 64) {
            low = (low << (64 - bits)) >> (64 - bits);
            if (node.native_unsigned) { low = low & (((int64)1 << bits) - 1); }
        }
    }
    high = low < 0 && !node.native_unsigned ? -1 : 0; return true;
}

bool KrtKroLibraryValue(KrtAstNode node, ref int64 low, ref int64 high) {
    low = 0; high = 0;
    if (node == null || node.kind == KrtAstKind.Null) { return true; }
    if (node.kind == KrtAstKind.Integer || node.kind == KrtAstKind.Boolean) {
        low = node.value; high = node.native_wide ? node.native_high : (low < 0 && !node.native_unsigned ? -1 : 0); return true;
    }
    if (node.kind == KrtAstKind.Cast) {
        return KrtKroLibraryValue(node.left, ref low, ref high) && KrtKroLibraryNormalize(node, ref low, ref high);
    }
    if (node.kind == KrtAstKind.Unary) {
        if (!KrtKroLibraryValue(node.left, ref low, ref high)) { return false; }
        if (node.op == 45) { high = ~high + (low == 0 ? 1 : 0); low = -low; }
        else if (node.op == 126) { low = ~low; high = ~high; }
        else if (node.op == 33) { low = low == 0 && high == 0 ? 1 : 0; high = 0; }
        else if (node.op != 43) { return false; }
        return KrtKroLibraryNormalize(node, ref low, ref high);
    }
    if (node.kind == KrtAstKind.Ternary) {
        int64 condition = 0; int64 condition_high = 0;
        if (!KrtKroLibraryValue(node.left, ref condition, ref condition_high)) { return false; }
        KrtAstNode selected = node.alternate;
        if (condition != 0 || condition_high != 0) { selected = node.right; }
        if (!KrtKroLibraryValue(selected, ref low, ref high)) { return false; }
        return KrtKroLibraryNormalize(node, ref low, ref high);
    }
    if (node.kind != KrtAstKind.Binary || KrtNativeWideKind(node.left) || KrtNativeWideKind(node.right)) { return false; }
    int64 left = 0; int64 right = 0; int64 ignored = 0;
    if (!KrtKroLibraryValue(node.left, ref left, ref ignored)) { return false; }
    if (node.op == 104 && left == 0) { return true; }
    if (node.op == 105 && left != 0) { low = 1; return true; }
    if (!KrtKroLibraryValue(node.right, ref right, ref ignored)) { return false; }
    bool unsigned_value = node.native_unsigned;
    if (node.op == 61 || node.op == 101 || node.op == 60 || node.op == 62 || node.op == 102 || node.op == 103) {
        KrtAstNode promoted = KrtAstMake(KrtAstKind.Type, 0, 0); KrtNativePromoteNumber(promoted, node.left, node.right, false); unsigned_value = promoted.native_unsigned;
    }
    if (node.op == 43) { low = left + right; }
    else if (node.op == 45) { low = left - right; }
    else if (node.op == 42) { low = left * right; }
    else if (node.op == 47 || node.op == 37) {
        if (right == 0) { return false; }
        if (unsigned_value) { low = node.op == 47 ? (int64)((uint64)left / (uint64)right) : (int64)((uint64)left % (uint64)right); }
        else if (left == (-9223372036854775807 - 1) && right == -1) { low = node.op == 47 ? left : 0; }
        else { low = node.op == 47 ? left / right : left % right; }
    }
    else if (node.op == 38) { low = left & right; }
    else if (node.op == 124) { low = left | right; }
    else if (node.op == 94) { low = left ^ right; }
    else if (node.op == 106) { low = left << right; }
    else if (node.op == 107) { low = unsigned_value ? (int64)((uint64)left >> right) : left >> right; }
    else if (node.op == 61) { low = left == right ? 1 : 0; }
    else if (node.op == 101) { low = left != right ? 1 : 0; }
    else if (node.op == 60) { low = (unsigned_value ? (uint64)left < (uint64)right : left < right) ? 1 : 0; }
    else if (node.op == 62) { low = (unsigned_value ? (uint64)left > (uint64)right : left > right) ? 1 : 0; }
    else if (node.op == 102) { low = (unsigned_value ? (uint64)left <= (uint64)right : left <= right) ? 1 : 0; }
    else if (node.op == 103) { low = (unsigned_value ? (uint64)left >= (uint64)right : left >= right) ? 1 : 0; }
    else if (node.op == 104) { low = left != 0 && right != 0 ? 1 : 0; }
    else if (node.op == 105) { low = left != 0 || right != 0 ? 1 : 0; }
    else { return false; }
    return KrtKroLibraryNormalize(node, ref low, ref high);
}

bool KrtKroEmitLibraryData(KrtAstNode module, int64 source, KrtKroObject output) {
    int32 count = 0; int32 size = 0; int32 names = 1;
    KrtAstNode declaration = module.body;
    while (declaration != null) {
        KrtAstNode previous = module.body;
        while (previous != declaration) {
            if (KrtScopeEqual(previous.native_scope, declaration.native_scope, source) && KrtSemanticSameName(source, previous.name_start, previous.name_length, declaration.name_start, declaration.name_length)) { return false; }
            previous = previous.next;
        }
        if (!KrtNativeAnnotateType(declaration, module, source, declaration.type_start, declaration.type_length) ||
            declaration.native_type != null || declaration.native_array || declaration.native_stride != 0 ||
            declaration.native_string || declaration.native_float != 0 || declaration.native_function_pointer != null) { return false; }
        int32 width = KrtNativeWideKind(declaration) ? 16 : declaration.native_width;
        if (width <= 0 || width > 16 || count >= 65536) { return false; }
        declaration.native_offset = size; size = size + width; names = names + (int32)declaration.name_length + 1; count = count + 1;
        declaration = declaration.next;
    }
    output.magic = 5198411; output.version = 2; output.architecture = 34404;
    output.data_size = size; output.symbol_count = count; output.strtab_size = names;
    output.data_bytes = new byte[size + 1]; output.symbol_bytes = new byte[count * 32 + 1]; output.string_bytes = new byte[names];
    byte[] data = output.data_bytes;
    declaration = module.body; int32 index = 0; int32 name = 1;
    while (declaration != null) {
        KrtAstNode context = KrtAstMake(KrtAstKind.Function, declaration.start, 0); context.native_scope = declaration.native_scope;
        KrtNativeBinding binding = new KrtNativeBinding(); binding.module = module; binding.unit = context; binding.source = source; binding.error_start = -1;
        if (declaration.left != null && (!KrtNativeBindExpression(declaration.left, binding) || !KrtNativeCompatibleValue(declaration, declaration.left))) { return false; }
        int64 low = 0; int64 high = 0;
        if (!KrtKroLibraryValue(declaration.left, ref low, ref high) || !KrtKroLibraryNormalize(declaration, ref low, ref high)) { return false; }
        int32 width = KrtNativeWideKind(declaration) ? 16 : declaration.native_width;
        int32 part = 0;
        while (part < width) {
            data[declaration.native_offset + part] = (byte)(((part < 8 ? low : high) >> ((part % 8) * 8)) & 255); part = part + 1;
        }
        KrtKroLibrarySymbol(output, index, name, declaration.native_offset, width, 3);
        byte[] symbols = output.symbol_bytes;
        KrtKroLibraryWord(symbols, index * 32 + 16, declaration.native_static ? 0 : 1);
        KrtKroLibraryName(output, source, declaration.name_start, (int32)declaration.name_length, ref name);
        index = index + 1; declaration = declaration.next;
    }
    return KrtKroObjectIsValid(output);
}

bool KrtKroLibraryPublicSignature(KrtAstNode function_node, KrtAstNode ast, int64 source) {
    KrtAstNode signature = KrtAstMake(KrtAstKind.Function, function_node.start, function_node.length);
    signature.native_scope = function_node.native_scope; signature.native_context = function_node.native_context;
    signature.type_start = function_node.type_start; signature.type_length = function_node.type_length;
    signature.parameter_count = function_node.parameter_count;
    signature.parameter_type_starts = function_node.parameter_type_starts;
    signature.parameter_type_lengths = function_node.parameter_type_lengths;
    signature.parameter_refs = function_node.parameter_refs;
    if (!KrtNativePrepareFunctionShape(signature, ast, source) || !KrtNativeLinkTypeSupported(signature.native_type, 0)) { return false; }
    KrtAstNode parameter = signature.declarations;
    while (parameter != null) {
        if (!KrtNativeLinkTypeSupported(parameter, 0)) { return false; }
        parameter = parameter.next;
    }
    return true;
}

bool KrtKroLibraryFunctions(KrtNativeModule module, KrtAstNode ast, int64 source, KrtKroObject output) {
    int32[] offsets = module.function_offsets; int32[] sizes = module.function_sizes;
    KrtAstNode function_node = module.function_ast;
    bool[] used = module.external_used;
    int32 count = module.function_count; int32 index = 0;
    while (index < module.external_count) { if (used[index]) { count = count + 1; } index = index + 1; }
    output.symbol_count = count; output.symbol_bytes = new byte[count * 32 + 1]; output.string_bytes = new byte[count * 8192 + 1];
    byte[] string_bytes = output.string_bytes; byte[] symbols = output.symbol_bytes;
    int32 name = 1; index = 0; int32 symbol_index = 0;
    while (index < module.function_count) {
        KrtLinkName link_name = KrtNativeFunctionLinkName(function_node, ast, source, true);
        if (!link_name.valid) { return false; }
        if (index == module.entry) { link_name.length = 0; KrtLinkText(link_name, "main"); }
        // Named object types have module-local layout and runtime identities.
        // Keep those definitions internal until extern supports their ABI too.
        bool local = function_node.op == 230 || function_node.native_generic_origin != null ||
            !KrtKroLibraryPublicSignature(function_node, ast, source) ||
            (function_node.native_owner != null && (function_node.native_owner.native_generic_origin != null || function_node.native_owner.native_generic_parameters != null));
        if (local) { KrtLinkText(link_name, "$local"); KrtLinkNumber(link_name, index); }
        if (!link_name.valid) { return false; }
        KrtKroLibrarySymbol(output, symbol_index, name, offsets[index], sizes[index], 1);
        KrtKroLibraryWord(symbols, symbol_index * 32 + 16, local ? 0 : 1);
        byte[] bytes = link_name.bytes; int32 character = 0;
        while (character < link_name.length) { string_bytes[name] = bytes[character]; name = name + 1; character = character + 1; }
        string_bytes[name] = 0; name = name + 1;
        index = index + 1; symbol_index = symbol_index + 1; function_node = function_node.next;
    }
    int32[] external_symbols = new int32[module.external_count + 1]; index = 0;
    KrtAstNode external_node = module.external_head;
    while (index < module.external_count) {
        if (used[index]) {
            KrtLinkName link_name = KrtNativeFunctionLinkName(external_node, ast, source, true);
            if (!link_name.valid) { return false; }
            external_symbols[index] = symbol_index;
            KrtKroLibrarySymbol(output, symbol_index, name, 0, 0, 0);
            KrtKroLibraryWord(symbols, symbol_index * 32 + 20, 1);
            byte[] bytes = link_name.bytes; int32 character = 0;
            while (character < link_name.length) { string_bytes[name] = bytes[character]; name = name + 1; character = character + 1; }
            string_bytes[name] = 0; name = name + 1; symbol_index = symbol_index + 1;
        }
        index = index + 1; external_node = external_node.native_external_next;
    }
    output.strtab_size = name;
    output.text_reloc_count = module.external_reloc_count; output.total_reloc_count = module.external_reloc_count; output.relocation_count = module.external_reloc_count;
    output.text_relocation_bytes = new byte[module.external_reloc_count * 16 + 1];
    byte[] relocations = output.text_relocation_bytes;
    int32[] relocation_offsets = module.external_reloc_offsets; int32[] relocation_targets = module.external_reloc_targets;
    index = 0;
    while (index < module.external_reloc_count) {
        KrtKroLibraryWord(relocations, index * 16, relocation_offsets[index]);
        KrtKroLibraryWord(relocations, index * 16 + 4, external_symbols[relocation_targets[index]]);
        // ArkLink's PC32 is relative to the end of the four-byte field.
        KrtKroLibraryWord(relocations, index * 16 + 8, 3);
        KrtKroLibraryWord(relocations, index * 16 + 12, 0);
        index = index + 1;
    }
    return true;
}
