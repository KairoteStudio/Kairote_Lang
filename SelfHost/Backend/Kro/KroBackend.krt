enum KrtKroSection { Text = 1, ReadOnlyData = 2, Data = 3, Bss = 4 }
enum KrtKroRelocation { Absolute64 = 1, Address32 = 2, PcRelative32 = 3 }

class KrtKroObject {
    public int32 magic;
    public int32 version;
    public int32 text_size;
    public int32 rodata_size;
