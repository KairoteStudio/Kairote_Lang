bool KrtKroWriteBytes(byte[] bytes, int32 count, int64 descriptor) {
    if (count < 0 || (count > 0 && bytes == null)) { return false; }
    unsafe(using krt.mem;) {
        byte* buffer = stackalloc byte[4096]; int32 position = 0;
        while (position < count) {
            int32 chunk = count - position; if (chunk > 4096) { chunk = 4096; }
            int32 index = 0; while (index < chunk) { buffer[index] = bytes[position + index]; index = index + 1; }
            int32 written = 0;
            while (written < chunk) {
                int64 result = syscall(1, descriptor, (int64)(buffer + written), chunk - written, 0, 0, 0);
                if (result <= 0) { return false; } written = written + (int32)result;
            }
            position = position + chunk;
        }
    }
    return true;
}
