bool KrtKroBeginText(KrtKroObject object, int32 word_capacity) {
    if (object == null || word_capacity <= 0 || word_capacity > 1024) { return false; }
    object.text_words = new int32[word_capacity];
    object.text_word_count = word_capacity;
    object.text_size = 0;
    return true;
}

bool KrtKroEmitTextByte(KrtKroObject object, int32 offset, int32 value) {
    if (object == null || object.text_words == null || offset < 0 || offset >= object.text_word_count * 4 || value < 0 || value > 255) { return false; }
    int32 word_index = offset / 4;
    int32 shift = (offset % 4) * 8;
    int32 mask = 255 << shift;
    object.text_words[word_index] = (object.text_words[word_index] & ~mask) | (value << shift);
    if (offset + 1 > object.text_size) { object.text_size = offset + 1; }
    return true;
}

bool KrtKroEmitTextU32(KrtKroObject object, int32 offset, int32 value) {
    return KrtKroEmitTextByte(object, offset, value & 255) &&
        KrtKroEmitTextByte(object, offset + 1, (value >> 8) & 255) &&
        KrtKroEmitTextByte(object, offset + 2, (value >> 16) & 255) &&
        KrtKroEmitTextByte(object, offset + 3, (value >> 24) & 255);
}

bool KrtKroObjectIsValid(KrtKroObject object) {
    return object.magic == 5198411 && object.version == 2 && object.text_size >= 0 && object.rodata_size >= 0 && object.data_size >= 0 && object.bss_size >= 0 &&
