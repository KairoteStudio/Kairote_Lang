    public int32 text_word3;
    public int32 text_word4;
    public int32 text_word5;
    public int32 text_word6;
    public int32 text_word7;
    // Variable-length text storage for the real multi-function backend.
    // The legacy text_word fields remain as a compact compatibility path.
    public int32[] text_words;
    public int32 text_word_count;
    public int32 architecture;
    public int32 entry_point;
    public int32 text_reloc_count;
    public int32 rodata_reloc_count;
    public int32 data_reloc_count;
    public int32 bss_align;
    public int32 total_reloc_count;
    public int32 strtab_size;
