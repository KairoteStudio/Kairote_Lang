bool KrtKroEmitTextU32(KrtKroObject object, int32 offset, int32 value) {
    return KrtKroEmitTextByte(object, offset, value & 255) &&
        KrtKroEmitTextByte(object, offset + 1, (value >> 8) & 255) &&
        KrtKroEmitTextByte(object, offset + 2, (value >> 16) & 255) &&
        KrtKroEmitTextByte(object, offset + 3, (value >> 24) & 255);
}

