    if (!(KrtKroNativeCode(output, ref pc, 39204201443657032, 7) &&
        KrtKroNativeCode(output, ref pc, 0, 1))) { return false; }
    } else {
        if (mode == 5) {
    if (!(KrtKroNativeCode(output, ref pc, 39204227213460808, 7) &&
        KrtKroNativeCode(output, ref pc, 1384287476123728, 7) &&
        KrtKroNativeCode(output, ref pc, 3526475825, 4))) { return false; }
        } else if (mode == 0) {
    if (!(KrtKroNativeCode(output, ref pc, 39240, 2))) { return false; }
        } else if (mode == 1) {
    if (!(KrtKroNativeCode(output, ref pc, 53809, 2))) { return false; }
        } else { return false; }
        if (!KrtKroNativeWideBox(output, ref pc)) { return false; }
