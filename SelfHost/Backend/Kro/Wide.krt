// Wide integers use immutable 16-byte boxes in scalar slots and packed array storage.
bool KrtKroNativeWideBox(KrtKroObject output, ref int32 pc) {
    if (!(KrtKroNativeCode(output, ref pc, 70503322192, 5))) { return false; }
    if (!KrtKroNativeAllocate(output, ref pc, 0)) { return false; }
    if (!(KrtKroNativeCode(output, ref pc, 432418789677913, 7) &&
        KrtKroNativeCode(output, ref pc, 56445937812343112, 7))) { return false; }
    return true;
}

