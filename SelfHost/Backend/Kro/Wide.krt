bool KrtKroNativeWidePost(KrtKroObject output, ref int32 pc, int32 increment, bool packed) {
    if (!(KrtKroNativeCode(output, ref pc, 930016154459, 5))) { return false; }
    if (packed) { if (!KrtKroNativeWideLoad(output, ref pc)) { return false; } }
    else { if (!KrtKroNativeMemoryLoad(output, ref pc, 8)) { return false; } }
    if (!(KrtKroNativeCode(output, ref pc, 20560, 2))) { return false; }
    if (!KrtKroNativeCode(output, ref pc, 47176, 2) || !KrtKroNativeU64(output, ref pc, increment)) { return false; }
    if (!(KrtKroNativeCode(output, ref pc, 80, 1))) { return false; }
    if (!KrtKroNativeWideConvert(output, ref pc, 0) || !KrtKroNativeWideBinary(output, ref pc, 43, false)) { return false; }
    if (!(KrtKroNativeCode(output, ref pc, 1364941144, 4))) { return false; }
    return KrtKroNativeMemoryStore(output, ref pc, packed ? 16 : 8);
}

