    unsafe(using krt.mem;) { byte* bytes = (byte*)relative; while (dot > 0 && bytes[dot-1] != 46 && bytes[dot-1] != 47) { dot--; }
        if (dot == 0 || bytes[dot-1] == 47) { dot = length+1; }
    }
    relative = KrtProjectCat(KrtDriverCopyString(relative,dot-1),(int64)".kro");
    return KrtDriverAbsolutePath(KrtDriverJoinPath(KrtDriverJoinPath(project.directory,(int64)"obj"),relative));
