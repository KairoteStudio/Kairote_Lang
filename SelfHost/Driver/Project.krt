int32 KrtProjectInfo(KrtProject project) {
    int64 result = KrtProjectCat((int64)"{\"path\":",KrtProjectJsonQuote(project.path));
    result = KrtProjectCat(result,KrtProjectCat((int64)",\"name\":",KrtProjectJsonQuote(project.name)));
    result = KrtProjectCat(result,KrtProjectCat((int64)",\"type\":",KrtProjectJsonQuote(project.kind)));
    result = KrtProjectCat(result,KrtProjectCat((int64)",\"output\":",KrtProjectJsonQuote(project.output)));
    result = KrtProjectCat(result,KrtProjectCat((int64)",\"configuration\":",KrtProjectJsonQuote(project.configuration)));
    result = KrtProjectCat(result,KrtProjectCat((int64)",\"sources\":",KrtProjectInfoPaths(project.sources)));
    result = KrtProjectCat(result,KrtProjectCat((int64)",\"includes\":",KrtProjectInfoPaths(project.includes)));
    result = KrtProjectCat(result,KrtProjectCat((int64)",\"objects\":",KrtProjectInfoPaths(project.objects)));
    KrtDriverPrint((string)KrtProjectCat(result,(int64)"}\n")); return 0;
