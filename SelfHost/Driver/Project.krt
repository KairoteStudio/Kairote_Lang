            if (KrtDriverFileExists(record.output) && KrtProjectFileHash(record.output) == record.hash) { KrtDriverRemoveFile(record.output); } record = record.next;
        }
    }
    if (KrtDriverIsDirectory(cache)) { if (!KrtDriverRemoveTree(cache)) { KrtDriverError("E_OUTPUT","unable to remove project cache"); return 1; }
        KrtDriverPrint((string)KrtProjectCat((int64)"cleaned: ",KrtProjectCat(cache,(int64)"\n")));
