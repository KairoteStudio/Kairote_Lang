    if (vm_sidecar != 0) {
        if (!KrtProjectPublish(candidate,vm_sidecar,false)) { KrtDriverRemoveTree(temporary); return 1; }
        KrtProjectRecord record = new KrtProjectRecord(); record.output = vm_sidecar; record.cached = (int64)"artifact"; record.hash = KrtProjectFileHash(candidate);
