int32 KrtDriverProject(KrtDriverOptions options) {
    if (KrtProjectEqual(options.command,"new")) { return KrtProjectNew(options); }
    if (options.sources != null && options.sources.next != null) { KrtDriverError("E_OPTION","project command accepts one project path"); return 1; }
    int64 path = (int64)"."; if (options.sources != null) { path = options.sources.value; }
    KrtProject project = KrtProjectLoad(path,options.configuration,options.library_root,KrtProjectEqual(options.command,"clean"));
    if (project == null) { return 1; } if (KrtProjectEqual(options.command,"clean")) { return KrtProjectClean(project); }
    if (KrtProjectEqual(options.command,"project-info")) { return KrtProjectInfo(project); }
    return KrtProjectBuild(project,options);
}
