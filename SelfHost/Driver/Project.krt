int64 KrtProjectInfoPaths(KrtDriverPath paths) {
    int64 result = (int64)"["; bool first = true;
    while (paths != null) { if (!first) { result = KrtProjectCat(result,(int64)","); }
        result = KrtProjectCat(result,KrtProjectJsonQuote(paths.value)); first = false; paths = paths.next;
    } return KrtProjectCat(result,(int64)"]");
