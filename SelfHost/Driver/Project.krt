        while (current != null) { if (KrtDriverStringEqual(current.output,old.output)) { retained = true; } current = current.next; }
        if (!retained && KrtDriverFileExists(old.output) && KrtProjectFileHash(old.output) == old.hash) { KrtDriverRemoveFile(old.output); } old = old.next;
