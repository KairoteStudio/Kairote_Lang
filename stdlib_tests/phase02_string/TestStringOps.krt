using System.Console;
using System.String;

void main()
{
    string missing = null;

    Console.WriteLine(StringOps.Concat("Kai", "rote"));
    Console.WriteLine(StringOps.Concat(missing, "KRT"));
    Console.WriteLine(StringOps.Substring("Kairote", 1, 3));
    Console.WriteLine(StringOps.Substring("Kairote", 4));
    Console.WriteLine(StringOps.IndexOf("Kairote", 'r'));
    Console.WriteLine(StringOps.LastIndexOf("banana", 'a'));
    Console.WriteLine(StringOps.StartsWith("Kairote", "Kai"));
    Console.WriteLine(StringOps.EndsWith("Kairote", "rote"));
    Console.WriteLine(StringOps.Equals("KRT", "KRT"));
}
